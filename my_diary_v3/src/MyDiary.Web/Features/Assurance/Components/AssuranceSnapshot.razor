@code {

    private GapReportSettings _cfg = new();
    private List<BranchDto> _branches = new();
    private List<RegionDto> _regions = new();
    private List<ZoneDto> _zones = new();
    private string _selectedZone = "ALL";
    private string _selectedRegion = "ALL";
    private string _selectedBranch = "ALL";
    private bool _isZoneDisabled = false;
    private bool _isRegionDisabled = false;
    private bool _isBranchDisabled = false;
    // User claims for RBAC
    private string _loggedInRole = "CO";
    private string? _loggedInZoneSolid;
    private string? _loggedInRegionSolid;
    private string? _loggedInBranchSolid;
    private bool CanLoadReport => !_loading;
    private GapReportViewModel? _report;
    private List<AssuranceCategory> _categories = new();   
    private bool ExportDisabled => _report is null || _categories.Count == 0;
    private bool isLoading = true;
    private List<F360CategoryColor> _categoryColors = new();

    // Operations Dashboard state
    private string currentSolId = null;    
    private DataSet dashboardData;
    private bool _loading = false;

    private int scaleCode = 0;
    private bool CanViewAll = false;

    // private List<AssuranceExportService.Section> _sections = new();

    // Lookup helper: returns formatted value from AllData by parameter name
    private string V(string paramName)
    {
        if (_report is null) return "—";
        var row = _report.AllData.FirstOrDefault(r =>
            string.Equals(r.ParameterName, paramName, StringComparison.OrdinalIgnoreCase));
        if (row is null) return "—";
        return row.ActualCr.HasValue ? Fmt(row.ActualCr, row.DataType) : "—";
    }

    // Numeric lookup — returns the raw value formatted as number
    private string N(string paramName)
    {
        if (_report is null) return "";
        var row = _report.AllData.FirstOrDefault(r =>
            string.Equals(r.ParameterName, paramName, StringComparison.OrdinalIgnoreCase));
        if (row is null) return "";
        if (row.ActualCr.HasValue) return Fmt(row.ActualCr, row.DataType);
        return "";
    }

    private static string Fmt(decimal? v, string dataType)
    {
        if (v is null) return "—";
        return dataType switch
        {
            "PERCENTAGE" => $"{v.Value:0.##}%",
            "COUNT" => $"{v.Value:#,##0}",
            _ => $"{v.Value:#,##0.##}",
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _cfg = ReportConfig.Value;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _loggedInRole = user.FindFirst(ClaimTypes.Role)?.Value?.ToUpper() ?? user.FindFirst("Role")?.Value?.ToUpper() ?? "CO";
            _loggedInZoneSolid = user.FindFirst("zone_solid")?.Value;
            _loggedInRegionSolid = user.FindFirst("region_solid")?.Value;
            _loggedInBranchSolid = user.FindFirst("branch_solid")?.Value;

            int.TryParse(user.FindFirst("employee_scale_code")?.Value, out scaleCode);
            CanViewAll = _loggedInRole.Equals("co", StringComparison.OrdinalIgnoreCase) && scaleCode < 6;
        }
        try { _zones = await LandingDashboardService.GetZonesAsync(); }
        catch (Exception ex) { AppLogger.LogError(ex, "AssuranceSnapshot: Failed to load zones"); }
        if (_loggedInRole == "ZONE")
        {
            _selectedZone = _loggedInZoneSolid;
            _isZoneDisabled = true;
            if (!string.IsNullOrEmpty(_selectedZone))
                _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
        }
        else if (_loggedInRole == "REGION")
        {
            _selectedZone = _loggedInZoneSolid;
            _selectedRegion = _loggedInRegionSolid;
            _isZoneDisabled = true;
            _isRegionDisabled = true;
            if (!string.IsNullOrEmpty(_selectedZone))
                _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
            if (!string.IsNullOrEmpty(_selectedRegion))
                _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
        }
        else if (_loggedInRole == "BRANCH")
        {
            _selectedZone = _loggedInZoneSolid;
            _selectedRegion = _loggedInRegionSolid;
            _selectedBranch = _loggedInBranchSolid;
            _isZoneDisabled = true;
            _isRegionDisabled = true;
            _isBranchDisabled = true;
            if (!string.IsNullOrEmpty(_selectedZone))
                _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
            if (!string.IsNullOrEmpty(_selectedRegion))
                _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
        }
        else if (!CanViewAll && _zones.Count > 0)
        {
            // CO user with scale >= 6: no "All Zones" option, auto-select first zone
            _selectedZone = _zones.First().zone_solid;
            _selectedRegion = "ALL";
            _selectedBranch = "ALL";
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
        }

        // Auto-load report on page open (same as Focus 360) — uses the user's
        // default scope (branch user → their branch, zone → zone, CO → requires selection)
        // await LoadReport();
    }

    private async Task OnZoneChangedAsync(string? newValue)
    {
        _selectedZone = newValue ?? "ALL";
        _selectedRegion = "ALL";
        _selectedBranch = "ALL";
        _regions.Clear();
        _branches.Clear();
        _report = null;
        if (_selectedZone != "ALL")
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
    }

    private async Task OnRegionChangedAsync(string? newValue)
    {
        _selectedRegion = newValue ?? "ALL";
        _selectedBranch = "ALL";
        _branches.Clear();
        _report = null;
        if (_selectedRegion != "ALL")
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
    }

    private static string SectionLabel(GapReportViewModel r, string cat)

    { var c = r.CategoryColors.FirstOrDefault(x => string.Equals(x.Category, cat, StringComparison.OrdinalIgnoreCase)); return string.IsNullOrWhiteSpace(c?.SectionLabel) ? cat : c!.SectionLabel; }

    private static int SectionSort(GapReportViewModel r, string cat)

    { var c = r.CategoryColors.FirstOrDefault(x => string.Equals(x.Category, cat, StringComparison.OrdinalIgnoreCase)); return c?.SortOrder ?? 999; }

    private static string NiceSub(string sub, string cat) => string.IsNullOrWhiteSpace(sub) || string.Equals(sub, cat, StringComparison.OrdinalIgnoreCase) ? "" : sub;

    private string FileBase => $"Assurance_Snapshot_{_report?.Branch.BranchCode ?? "branch"}_{AppTime.Now:yyyyMMdd}";

    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("Assurance 360"), new("Assurance Snapshot")
    };

    private async Task OnBranchChangedAsync(string branch)
    {
        _selectedBranch = branch;
        _report = null;
    }
    private string GetPanelColor(string panelTitle, string type)
    {
        var color = _categoryColors.FirstOrDefault(x =>
            string.Equals(x.SectionLabel, panelTitle, StringComparison.OrdinalIgnoreCase));
        return color?.ColorHex ?? "#1b4a98"; // default blue
    }

    /// <summary>
    /// Resolves the effective SOL_ID based on dropdown selection (same as Focus360).
    /// Falls back to the logged-in user's scope when "All" is selected.
    /// </summary>
    private string ResolveEffectiveSolId()
    {
        if (_selectedBranch != "ALL" && !string.IsNullOrEmpty(_selectedBranch))
            return _selectedBranch.PadLeft(5, '0');
        if (_selectedRegion != "ALL" && !string.IsNullOrEmpty(_selectedRegion))
            return _selectedRegion.PadLeft(5, '0');
        if (_selectedZone != "ALL" && !string.IsNullOrEmpty(_selectedZone))
            return _selectedZone.PadLeft(5, '0');

        return _loggedInRole switch
        {
            "ZONE"   => (_loggedInZoneSolid ?? "00000").PadLeft(5, '0'),
            "REGION" => (_loggedInRegionSolid ?? "00000").PadLeft(5, '0'),
            "BRANCH" => (_loggedInBranchSolid ?? "00000").PadLeft(5, '0'),
            _        => (_loggedInBranchSolid ?? "00000").PadLeft(5, '0')
        };
    }

    private async Task LoadReport()
    {
        string resolvedSolId = ResolveEffectiveSolId();
        if (string.IsNullOrWhiteSpace(resolvedSolId) || resolvedSolId == "00000")
        {
            // CO user with "All" selected — show a helpful message instead of an empty report
            _report = null;
            Snackbar.Add("Please select a Zone, Region or Branch to load the report.", Severity.Info);
            return;
        }

        _loading = true; StateHasChanged();
        try
        {
            _report = await GapSvc.BuildReportAsync(resolvedSolId);
            _categories = await PanelSvc.GetPanelGridAsync(resolvedSolId);
            _categoryColors = await GapSvc.GetCategoryColorsAsync();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "AssuranceSnapshot: failed to load snapshot");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
            _report = null; _categories = new();
        }
        finally { _loading = false; }
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    private async Task DownloadExcel()
    {
        if (_report is null) return;

        var AppLogo = Assets.Resolve(_cfg.AppLogoPath);
        var CoLogo = Assets.Resolve(_cfg.LogoPath);
        var bytes = ExportSvc.ExportToExcel(_report, _categories, _categoryColors, _cfg.AssuranceReportName, _cfg.BankName, AppLogo, CoLogo);

        await JS.InvokeVoidAsync("focus360Download", $"{FileBase}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
    }

    private async Task DownloadCsv()
    {
        if (_report is null) return;
        var bytes = ExportSvc.ExportToCsv(_report, _categories, _cfg.AssuranceReportName, _cfg.BankName);
        await JS.InvokeVoidAsync("focus360Download", $"{FileBase}.csv", "text/csv", bytes);
    }

    private async Task DownloadPdf()
    {
        if (_report is null) return;
        try
        {
            var AppLogo = Assets.Resolve(_cfg.AppLogoPath);
            var CoLogo = Assets.Resolve(_cfg.LogoPath);

            var bytes = ExportSvc.ExportToPdf(_report, _categories, _categoryColors, _cfg.AssuranceReportName, _cfg.BankName, AppLogo, CoLogo);

            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("focus360DownloadStream", $"{FileBase}.pdf", streamRef);
        }
        catch (Exception ex) { AppLogger.LogError(ex, "AssuranceSnapshot: PDF export failed"); Snackbar.Add(UserFacingError.Generic, Severity.Error); }
    }
}
