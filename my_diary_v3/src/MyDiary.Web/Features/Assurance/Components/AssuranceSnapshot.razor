@page "/assurance-snapshot"
@page "/app/assurance-snapshot"
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using MudBlazor
@using MyDiary.Web.Features.Focus360.Components
@using MyDiary.Web.Features.Focus360.Models
@using MyDiary.Web.Features.Focus360.Services
@using MyDiary.Web.Features.Assurance.Services
@using MyDiary.Web.Features.Assurance.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyDiary.Web.Features.Landing_Dashboard_V2.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Services
@using MyDiary.Web.Features.OperationDashboard.Services
@using MyDiary.Web.Features.Shared.Components
@using global::RequestPortal.Web.Shared
@using Microsoft.AspNetCore.Components.Web
@using System.Data
@using MyDiary.Web.Core.Extensions
@inject IGapService GapSvc
@inject AssurancePanelService PanelSvc
@inject AssuranceExportService ExportSvc
@inject IOptions<GapReportSettings> ReportConfig
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject ILandingDashboardV2Service LandingDashboardService
@inject NavigationManager Nav
@inject IStaticAssetPathResolver Assets
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())

<PageTitle>@_cfg.AssuranceReportName</PageTitle>

<PageHeader PageKey="assurance-snapshot" Title="Assurance Snapshot"
            Crumbs="@(new List<PageHeader.Crumb>{ new("Assurance"), new("Assurance Snapshot") })"
            Subtitle="Financial Operational and Compliance Unit Snapshot" />

@* ── Filter Toolbar ──────────────────────────────────────────────────── *@
<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudPaper Elevation="0" Style="background-color: #ffffff;">
          @*   <MudCard Elevation="2" Style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <MudCardHeader Class="justify-center text-white"
                               Style="height:48px; font-weight:800; background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
                    <h2 class="ma-0" style="font-size:1.25rem; font-weight:800; color:white;">@_cfg.AssuranceReportName</h2>
                </MudCardHeader>
            </MudCard> *@

            @* ── Filter bar with RBAC-aware cascading dropdowns (same as Focus360) ── *@
            <MudGrid Spacing="2" Class="p-2 align-center">
                <MudItem xs="12" sm="2">
                    <MudSelect T="string" Label="Zone" Value="@_selectedZone" ValueChanged="OnZoneChangedAsync"
                               Disabled="@_isZoneDisabled" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                               aria-label="Select Zone">
                        @if (CanViewAll)
                        {
                            <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                        }
                        @foreach (var zone in _zones)
                        {
                            <MudSelectItem Value="@zone.zone_solid">@zone.zone_name_eng</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="string" Label="Region" Value="@_selectedRegion" ValueChanged="OnRegionChangedAsync"
                               Disabled="@_isRegionDisabled" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                               aria-label="Select Region">
                        <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                        @foreach (var region in _regions)
                        {
                            <MudSelectItem Value="@region.region_solid">@region.region_name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="string" Label="Branch" Value="@_selectedBranch" ValueChanged="OnBranchChangedAsync"
                               Disabled="@_isBranchDisabled" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                               aria-label="Select Branch">
                        <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem Value="@branch.SOL_ID">@branch.branch_name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2"></MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-right gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="LoadReport" Disabled="@_loading"
                               Style="white-space:nowrap">
                        @(_loading ? "Loading…" : "Load Report")
                    </MudButton>
                    @if (_report is not null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.GridOn"
                                   OnClick="DownloadExcel" Disabled="@ExportDisabled">Excel</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                   OnClick="DownloadPdf" Disabled="@ExportDisabled">PDF</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="DownloadCsv" Disabled="@ExportDisabled">CSV</MudButton>
                        @* <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="Print">Print</MudButton> *@
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-6" />
    }
    else if (_report is null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Select a Zone, Region or Branch and click Load Report to generate the Assurance Snapshot.</MudAlert>
    }
    else if (_categories.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            No assurance panel data found. Configure dbo.ASSURANCE_PANEL_DEF (see db/sqlserver/GAP_04_assurance_panels.sql).
        </MudAlert>
    }
    else
    {
        <div id="asr-report" class="asr-report">
            @* ── Report header — same style as Focus 360 (two logos + centred title) ── *@
            <div class="asr-banner">
                <img class="asr-logo asr-logo-left" src="images/My_Diary_Log-transparent.png" alt="My Diary" />
                <div class="asr-banner-center">
                    <div class="asr-banner-title">@_cfg.AssuranceReportName</div>
                    @if (!string.IsNullOrWhiteSpace(_cfg.BankName))
                    {
                        <div class="asr-banner-bank">@_cfg.BankName</div>
                    }
                    <div class="asr-banner-sub">
                        Union Bank of India &nbsp;|&nbsp; ZO/RO/Branch: @_report.Branch.BranchName (@_report.Branch.BranchCode)
                    </div>
                </div>
                <img class="asr-logo asr-logo-right" src="images/UBI_Logo.png" alt="Union Bank of India" />
            </div>

            <div class="asr-detail-band">Branch / ZO Details &nbsp; As on @((_report.AsOnDate ?? AppTime.Today).ToString("dd-MMM-yyyy"))</div>
            <table class="asr-tbl asr-head-tbl">
                <thead><tr><th>Branch</th><th>Code</th><th>Zone</th><th>Region</th><th>BM</th><th>Working Since</th>
                   @*  <th>Assurance Head</th>
                    <th>Working Since</th> *@
                </tr></thead>
                <tbody><tr>
                    <td>@_report.Branch.BranchName</td><td>@_report.Branch.BranchCode</td><td>@_report.Branch.ZoneName</td>
                    <td>@_report.Branch.RegionName</td><td>@_report.Branch.ZMBMName</td>
                    @* <td></td><td></td><td></td> *@
                </tr></tbody>
            </table>

            @* <div class="asr-page-title">Assurance Snapshot</div> *@

            @* ── Categories — red banner, containing one or more rows of side-by-side panels
                 (blue title bars), matching the old FOCUS-Assurance report exactly. Column
                 headers, row labels and panel grouping all come from the data-driven panel
                 grid (usp_Assurance_GetPanelGrid), not hardcoded per category. ── *@
            @foreach (var cat in _categories)
            {
                <div class="asr-section">
                <div class="asr-section-title" style="@($"background-color:{GetPanelColor(cat.Label,"category")}; color:white;")">@cat.Label</div>
                    <div class="asr-section-body">
                        @foreach (var group in cat.PanelRowGroups)
                        {
                            <div class="asr-panel-grid" style="@($"grid-template-columns:repeat({group.Panels.Count},1fr);")">
                                @foreach (var panel in group.Panels)
                                {
                                    <div class="asr-panel">
                                    <div class="asr-subhead"
                                         style="@($"background-color:{GetPanelColor(panel.Title, "title")}; color:white;")">
                                        @panel.Title
                                       @*  <div>
                                            @panel.AsOnDate
                                        </div> *@
                                    </div>
                                        <table class="asr-tbl">
                                            <thead>
                                                <tr>
                                                    @if (panel.Rows.Any(r => !string.IsNullOrEmpty(r.RowLabel)))
                                                    {
                                                        <th>@(panel.RowLabelHeader ?? "Parameter")</th>
                                                    }
                                                    @foreach (var ch in panel.ColumnHeaders)
                                                    {
                                                    <th class="asr-num" title="@ch">@ch</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in panel.Rows)
                                                {
                                                    <tr>
                                                        @if (panel.Rows.Any(r => !string.IsNullOrEmpty(r.RowLabel)))
                                                        {
                                                            <td>@row.RowLabel</td>
                                                        }
                                                        @foreach (var cell in row.Cells)
                                                        {
                                                            <td class="asr-num">@cell</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            @* ══ 9. OPERATIONS DASHBOARD ══════════════════════════════════════════════ *@
       @*  @if (dashboardData != null)
        {
            <MudPaper Elevation="1" Class="mb-3" Style="overflow:hidden">
                <div class="f360-sec-hdr" style="background:#0070C0">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Class="mr-2" />
                    Operations
                </div>
                <MudGrid Spacing="0" Class="flex-nowrap">
                    <MudItem xs="12" Style="border-right:1px solid #CFD8DC">
                        <F360SuspenseSundryPanel DashboardData="dashboardData" />
                    </MudItem>
                    <MudItem xs="6">
                        <F360DefaultingPanel DashboardData="dashboardData" />
                    </MudItem> 
                </MudGrid>
                <MudGrid Spacing="0" Class="flex-nowrap" Style="border-top:1px solid #CFD8DC">
                    <MudItem xs="6" Style="border-right:1px solid #CFD8DC">
                        <F360CashHoldingPanel DashboardData="dashboardData" />
                    </MudItem>
                    <MudItem xs="6">
                        <F360CustomerComplaintsPanel DashboardData="dashboardData" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        } *@
        </div>
    }
@* </div> *@


