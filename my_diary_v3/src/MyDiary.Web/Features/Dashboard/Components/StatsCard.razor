@using MudBlazor
<MudCard Elevation="2" Class="rounded-lg pa-3" Style="height: 100%;">
    <MudGrid Class="align-center" Spacing="2">
        <MudItem xs="5" Class="d-flex justify-center">
            <MudPaper Elevation="0" 
                      Class="d-flex justify-center align-center rounded-circle"
                      Style="@($"width: 60px; height: 60px; background-color: {GetColorHex()}; color: white;")">
                <MudIcon Icon="@Icon" Size="Size.Large" />
            </MudPaper>
        </MudItem>
        
        <MudItem xs="7">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Title</MudText>
            <MudText Typo="Typo.h5" Class="fw-bold">@Value</MudText>
        </MudItem>
    </MudGrid>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public Color Color { get; set; } = Color.Primary;

    private string GetColorHex()
    {
        // Mapping MudBlazor colors to KaiAdmin-like hex codes
        return Color switch
        {
            Color.Primary => "#1572E8",   // Blue
            Color.Secondary => "#6861CE", // Purple
            Color.Success => "#31CE36",   // Green
            Color.Warning => "#FFAD46",   // Orange
            Color.Error => "#F25961",     // Red
            _ => "#1572E8"
        };
    }
}