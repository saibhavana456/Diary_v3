@page "/branch-foundation"
@using global::RequestPortal.Web.Shared
@using MyDiary.Web.Features.BranchFoundation.Models
@using MyDiary.Web.Features.BranchFoundation.Services
@inject IBranchFoundationService Svc
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Branch Foundation Sheet - My Diary</PageTitle>

<PageHeader PageKey="branch-foundation"
            Title="Branch Foundation Sheet"
            Subtitle="Centralized dashboard for tracking branch establishment milestones and anniversaries."
            Crumbs="_crumbs" />

<MudPaper Class="pa-4 mb-4" Elevation="1">

    @* ROLE-BASED CASCADING FILTERS *@
    <MudGrid Class="mb-4" Spacing="2" AlignItems="AlignItems.Center">
        @if (_userRole == "CO")
        {
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Filter by Zone" @bind-Value="SelectedZone" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var z in _availableZones)
                    {
                        <MudSelectItem Value="@z">@z</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        @if (_userRole == "CO" || _userRole == "ZONE")
        {
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Filter by Region" @bind-Value="SelectedRegion" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var r in _availableRegions)
                    {
                        <MudSelectItem Value="@r">@r</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        @if (_userRole != "BRANCH")
        {
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Filter by Branch" @bind-Value="SelectedBranch" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var b in _availableBranchesForDropdown)
                    {
                        <MudSelectItem Value="@b.SolId">@b.BranchName (@b.SolId)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
    </MudGrid>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

        @* SECTION A: Main Display *@
        <MudTabPanel Text="Master List" Icon="@Icons.Material.Filled.List">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudTextField @bind-Value="_searchString" Placeholder="Search Name/Code..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:300px;" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportToExcel">Download Excel</MudButton>
            </div>

            <MudTable Items="@_filteredBranches" Hover="true" Dense="true" Striped="true" Loading="@_loading">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<BranchFoundationDto, object>(x=>x.SolId)">Branch Code</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BranchFoundationDto, object>(x=>x.BranchName)">Branch Name</MudTableSortLabel></MudTh>
                    <MudTh>Region / Zone</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BranchFoundationDto, object>(x=>x.EstDate)">Opening Date</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BranchFoundationDto, object>(x=>x.YearsCompleted)">Age (Yrs)</MudTableSortLabel></MudTh>
                    <MudTh>Anniversary</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Branch Code">@context.SolId</MudTd>
                    <MudTd DataLabel="Branch Name">@context.BranchName</MudTd>
                    <MudTd DataLabel="Region / Zone">@context.RegionName / @context.ZoneName</MudTd>
                    <MudTd DataLabel="Opening Date">@context.EstDate?.ToString("dd-MMM-yyyy")</MudTd>
                    <MudTd DataLabel="Age (Yrs)">@context.YearsCompleted</MudTd>
                    <MudTd DataLabel="Anniversary">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.AnniversaryDate</MudChip>
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new int[] { 50, 75, 100 }" /></PagerContent>
            </MudTable>
        </MudTabPanel>

        @* SECTION B: Upcoming Anniversaries *@
        <MudTabPanel Text="Upcoming Anniversaries" Icon="@Icons.Material.Filled.Event">
            <div class="d-flex align-center gap-4 mb-3">
                <MudAlert Severity="Severity.Info" Class="flex-grow-1 mb-0">Showing branches with anniversaries falling in the current month (<b>@DateTime.Today.ToString("MMMM")</b>) and next month (<b>@DateTime.Today.AddMonths(1).ToString("MMMM")</b>).</MudAlert>
                <MudSelect T="string" Label="Filter by Month" @bind-Value="_upcomingMonthFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 250px;">
                    
                    <MudSelectItem Value="@("Current")">Current Month (@DateTime.Today.ToString("MMM"))</MudSelectItem>
                    <MudSelectItem Value="@("Next")">Next Month (@DateTime.Today.AddMonths(1).ToString("MMM"))</MudSelectItem>
                    <MudSelectItem Value="@("All")">Both Current and Next Months</MudSelectItem>
                </MudSelect>
            </div>
            
            <MudTable Items="@_upcomingBranches" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh>Branch Code</MudTh>
                    <MudTh>Branch Name</MudTh>
                    <MudTh>Foundation Date</MudTh>
                    <MudTh>Anniversary Month</MudTh>
                    <MudTh>Years Completing</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Branch Code">@context.SolId</MudTd>
                    <MudTd DataLabel="Branch Name">@context.BranchName</MudTd>
                    <MudTd DataLabel="Foundation Date">@context.EstDate?.ToString("dd-MMM-yyyy")</MudTd>
                    <MudTd DataLabel="Anniversary Month">
                        <span style="font-weight:600; color:@(context.AnniversaryMonth == DateTime.Today.Month ? "#DC2626" : "#2563EB")">
                            @context.EstDate?.ToString("MMMM")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Years Completing">@(context.YearsCompleted + 1)</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new int[] { 50, 75, 100 }" /></PagerContent>
            </MudTable>
        </MudTabPanel>

        @* SECTION C: Jubilee / Centenary Milestones *@
        <MudTabPanel Text="Milestones Dashboard" Icon="@Icons.Material.Filled.Stars">
            <div class="d-flex align-center gap-4 mb-3">
                <MudAlert Severity="Severity.Success" Class="flex-grow-1 mb-0">Tracking branches completing milestones during the current financial year (<b>01 April @(_fyStart.Year) to 31 March @(_fyEnd.Year)</b>).</MudAlert>
                <MudSelect T="string" Label="Filter by Milestone" @bind-Value="_milestoneFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 250px;">
                    <MudSelectItem Value="@("All")">All Milestones</MudSelectItem>
                    <MudSelectItem Value="@("Silver")">Silver Jubilee (25 Years)</MudSelectItem>
                    <MudSelectItem Value="@("Golden")">Golden Jubilee (50 Years)</MudSelectItem>
                    <MudSelectItem Value="@("Centenary")">Centenary (100 Years)</MudSelectItem>
                </MudSelect>
            </div>
            
            <MudTable Items="@_milestoneBranches" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh>Branch Code</MudTh>
                    <MudTh>Branch Name</MudTh>
                    <MudTh>Opening Date</MudTh>
                    <MudTh>Milestone Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Branch Code">@context.Branch.SolId</MudTd>
                    <MudTd DataLabel="Branch Name">@context.Branch.BranchName</MudTd>
                    <MudTd DataLabel="Opening Date">@context.Branch.EstDate?.ToString("dd-MMM-yyyy")</MudTd>
                    <MudTd DataLabel="Milestone Details">
                        <MudChip T="string" Color="@context.BadgeColor" Size="Size.Small">@context.MilestoneText</MudChip>
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 50, 75, 100 }" /></PagerContent>
            </MudTable>
        </MudTabPanel>

    </MudTabs>
</MudPaper>

@code {
    private readonly List<PageHeader.Crumb> _crumbs = new() { new("Departments", "departmentsnew"), new("Branch Foundation") };

    private bool _loading = true;
    private string _searchString = "";
    private string _upcomingMonthFilter = "All";
    private string _milestoneFilter = "All";

    // User Scope
    private string _userRole = "CO"; // Defaults: CO, ZONE, REGION, BRANCH
    private string _userZone = "";
    private string _userRegion = "";
    private string _userSolId = "";

    // Selections
    private string? _selectedZone;
    private string? _selectedRegion;
    private string? _selectedBranch;

    // Properties with cascading reset logic
    private string? SelectedZone
    {
        get => _selectedZone;
        set { _selectedZone = value; _selectedRegion = null; _selectedBranch = null; }
    }
    private string? SelectedRegion
    {
        get => _selectedRegion;
        set { _selectedRegion = value; _selectedBranch = null; }
    }
    private string? SelectedBranch
    {
        get => _selectedBranch;
        set => _selectedBranch = value;
    }

    private DateTime _fyStart;
    private DateTime _fyEnd;

    // Master dataset for this user's maximum allowed scope
    private List<BranchFoundationDto> _allBranches = new();

    // Dynamic Filter Lists for Dropdowns
    private IEnumerable<string> _availableZones =>
        _allBranches.Select(b => b.ZoneName).Distinct().OrderBy(z => z);

    private IEnumerable<string> _availableRegions =>
        _allBranches.Where(b => string.IsNullOrEmpty(_selectedZone) || b.ZoneName == _selectedZone)
                    .Select(b => b.RegionName).Distinct().OrderBy(r => r);

    private IEnumerable<BranchFoundationDto> _availableBranchesForDropdown =>
        _allBranches.Where(b =>
            (string.IsNullOrEmpty(_selectedZone) || b.ZoneName == _selectedZone) &&
            (string.IsNullOrEmpty(_selectedRegion) || b.RegionName == _selectedRegion))
        .OrderBy(b => b.BranchName);

    // Filtered data bound to the grids
    private IEnumerable<BranchFoundationDto> _filteredBranches =>
        _availableBranchesForDropdown.Where(b =>
            (string.IsNullOrEmpty(_selectedBranch) || b.SolId == _selectedBranch) &&
            (string.IsNullOrEmpty(_searchString) ||
             b.BranchName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
             b.SolId.Contains(_searchString, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<BranchFoundationDto> _upcomingBranches =>
        _filteredBranches.Where(b => 
            (_upcomingMonthFilter == "All" && (b.AnniversaryMonth == DateTime.Today.Month || b.AnniversaryMonth == DateTime.Today.AddMonths(1).Month)) ||
            (_upcomingMonthFilter == "Current" && b.AnniversaryMonth == DateTime.Today.Month) ||
            (_upcomingMonthFilter == "Next" && b.AnniversaryMonth == DateTime.Today.AddMonths(1).Month)
        ).OrderBy(b => b.AnniversaryMonth).ThenBy(b => b.AnniversaryDate);

    private record MilestoneRow(BranchFoundationDto Branch, string MilestoneText, Color BadgeColor);

    private IEnumerable<MilestoneRow> _milestoneBranches
    {
        get
        {
            var list = new List<MilestoneRow>();
            foreach (var b in _filteredBranches.Where(x => x.EstDate.HasValue))
            {
                if ((_milestoneFilter == "All" || _milestoneFilter == "Silver") && b.IsMilestoneInCurrentFY(25, _fyStart, _fyEnd))
                    list.Add(new MilestoneRow(b, "Completing 25 Years (Silver Jubilee)", Color.Secondary));
                else if ((_milestoneFilter == "All" || _milestoneFilter == "Golden") && b.IsMilestoneInCurrentFY(50, _fyStart, _fyEnd))
                    list.Add(new MilestoneRow(b, "Completing 50 Years (Golden Jubilee)", Color.Warning));
                else if ((_milestoneFilter == "All" || _milestoneFilter == "Centenary") && b.IsMilestoneInCurrentFY(100, _fyStart, _fyEnd))
                    list.Add(new MilestoneRow(b, "Completing 100 Years (Centenary)", Color.Error));
            }
            return list.OrderBy(x => x.Branch.EstDate);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        _fyStart = today.Month >= 4 ? new DateTime(today.Year, 4, 1) : new DateTime(today.Year - 1, 4, 1);
        _fyEnd = _fyStart.AddYears(1).AddDays(-1);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        // Extract real claims. Adjust claim type strings to match your portal's exact terminology.
        _userRole = authState.User.FindFirst("privilege")?.Value?.ToUpper() ?? "CO";
        _userZone = authState.User.FindFirst("zone_name")?.Value ?? "";
        _userRegion = authState.User.FindFirst("region_name")?.Value ?? "";
        _userSolId = authState.User.FindFirst("br_solid")?.Value ?? "";

        // Scope the initial DB fetch based on the user's role mapping
        if (_userRole == "ZONE")
        {
            _allBranches = await Svc.GetBranchesAsync(zoneName: _userZone);
            _selectedZone = _userZone;
        }
        else if (_userRole == "REGION")
        {
            _allBranches = await Svc.GetBranchesAsync(regionName: _userRegion);
            _selectedRegion = _userRegion;
        }
        else if (_userRole == "BRANCH")
        {
            _allBranches = await Svc.GetBranchesAsync(solId: _userSolId);
            _selectedBranch = _userSolId;
        }
        else
        {
            // CO User - Fetch all
            _allBranches = await Svc.GetBranchesAsync();
        }

        _loading = false;
    }

    private async Task ExportToExcel()
    {
        var bytes = Svc.ExportToExcel(_filteredBranches.ToList());
        await JS.InvokeVoidAsync("appDownloadFile", $"Branch_Foundation_{DateTime.Now:yyyyMMdd}.xlsx", Convert.ToBase64String(bytes), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}