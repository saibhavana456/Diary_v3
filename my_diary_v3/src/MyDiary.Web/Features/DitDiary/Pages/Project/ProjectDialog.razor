@using MyDiary.Web.Features.DitDiary.Models.Entities
@using MyDiary.Web.Features.DitDiary.Services
@using MudBlazor
@inherits MudComponentBase
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IProjectMasterService ProjectService
@inject IJSRuntime JS
@inject ProjectBudgetService BudgetSvc
@inject IDialogService DialogService


<MudDialog DisableSidePadding="true">
    <DialogContent>
        @* This outer wrapper maintains the overall dialog height *@
        <div style="height: 80vh; display: flex; flex-direction: column; overflow: hidden;">
            
        

        
            <MudTabs Elevation="2" 
                     Rounded="true" 
                     Color="Color.Primary" 
                     ApplyEffectsToContainer="true" 
                     PanelClass="fixed-dialog-panel px-4 py-4" 
                     Style="flex-grow: 1;">

              


                        @* TAB 1: GENERAL & OWNERSHIP *@
                <MudTabPanel Text="Basic Details" Icon="@Icons.Material.Filled.Info">
                    <MudGrid Spacing="3" Class="mt-2">

                                @* --- PROJECT IDENTITY & NATURE (Split into 2 parts) --- *@
                        @* --- BUDGET ALLOCATION (read only) --- *@
                       

                                <MudItem xs="12" md="6" Class="mb-4">
                                    <MudPaper Elevation="2" Class="pa-3" Style="background-color: #f9f9f9; border-left: 4px solid #594ae2; height: 100%;">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Project Identity - Part B</b></MudText>
                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                            <tbody>
                                                <tr><td style="width:40%"><b>Benefits Bank</b></td><td>@Projects?.ProjectBenefitsBank</td></tr>
                                                <tr><td><b> Type</b></td><td>@Projects?.ProjectType</td></tr>
                                                <tr><td><b> Category</b></td><td>@Projects?.ProjectCategory</td></tr>
                                                <tr><td><b> Nature</b></td><td>@Projects?.ProjectNature</td></tr>
                                                <tr><td><b>IS IT and Business Same</b></td><td>@Projects?.IS_IT_BUSINESS_SAME</td></tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudPaper>
                                </MudItem>

                                @* --- OWNERSHIP SECTION (3 Tables in 1 Row) --- *@
                                @* Ownership - Business *@
                                <MudItem xs="12" md="4" Class="mb-4">
                                    <MudPaper Elevation="2" Class="pa-3" Style="background-color: #f0f4ff; border-top: 3px solid #2196f3; height: 100%;">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Ownership - Business</b></MudText>
                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                            <tbody>
                                                <tr><td><b>Dept</b></td><td>@Projects?.BUSINESS_OWNER_DEPT_NAME</td></tr>
                                                <tr><td><b>Section</b></td><td>@Projects?.BUSINESS_OWNER_SEC_NAME</td></tr>
                                                <tr><td><b>Owner</b></td><td>@Projects?.BUSINESS_OWNER_NAME</td></tr>
                                                <tr><td><b>Designation</b></td><td>@Projects?.BUSINESS_OWNER_DESIG</td></tr>
                                                <tr><td><b>IP No</b></td><td>@Projects?.BUSINESS_OWNER_IP_NO</td></tr>
                                                <tr><td><b>Mobile</b></td><td>@Projects?.BUSINESS_OWNER_MOBILE</td></tr>
                                                <tr><td><b>Email</b></td><td>@Projects?.BUSINESS_OWNER_EMAIL</td></tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudPaper>
                                </MudItem>

                                @* Ownership - IT *@
                                <MudItem xs="12" md="4" Class="mb-4">
                                    <MudPaper Elevation="2" Class="pa-3" Style="background-color: #f0f4ff; border-top: 3px solid #2196f3; height: 100%;">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Ownership - IT</b></MudText>
                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                            <tbody>
                                                <tr><td><b>Dept</b></td><td>@Projects?.IT_OWNER_DEPT_NAME</td></tr>
                                                <tr><td><b>Section</b></td><td>@Projects?.IT_OWNER_SEC_NAME</td></tr>
                                                <tr><td><b>Owner</b></td><td>@Projects?.IT_OWNER_NAME</td></tr>
                                                    <tr><td><b>Designation</b></td><td>@Projects?.IT_OWNER_DESIG</td></tr>
                                                <tr><td><b>IP No</b></td><td>@Projects?.IT_OWNER_IP_NO</td></tr>
                                                <tr><td><b>Mobile</b></td><td>@Projects?.IT_OWNER_MOBILE</td></tr>
                                                <tr><td><b>Email</b></td><td>@Projects?.IT_OWNER_EMAIL</td></tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudPaper>
                                </MudItem>

                                @* Supporting Owner Details *@
                                <MudItem xs="12" md="4" Class="mb-4">
                                    <MudPaper Elevation="2" Class="pa-3" Style="background-color: #f0f4ff; border-top: 3px solid #2196f3; height: 100%;">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Supporting Owner</b></MudText>
                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                            <tbody>
                                                <tr><td><b>Dept</b></td><td>@Projects?.SupportingOwnerDeptName</td></tr>
                                                <tr><td><b>Section</b></td><td>@Projects?.SupportingOwnerSecName</td></tr>
                                                <tr><td><b>Owner</b></td><td>@Projects?.SupportingOwnerName</td></tr>
                                                    <tr><td><b>Designation</b></td><td>@Projects?.SupportingOwnerDesig</td></tr>
                                                <tr><td><b>IP No</b></td><td>@Projects?.SupportingOwnerIpNo</td></tr>
                                                <tr><td><b>Mobile</b></td><td>@Projects?.SupportingOwnerMobile</td></tr>
                                                <tr><td><b>Email</b></td><td>@Projects?.SupportingOwnerEmail</td></tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudPaper>
                                </MudItem>

                              
                                @* --- ADMINISTRATIVE & SUMMARY SECTION (Grid Layout) --- *@
                                <MudItem xs="12" Class="mb-4">
                                    <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #ff9800; background-color: #fffcf5;">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>ADMIN APPROVAL DETAILS</b></MudText>
                                        <MudTable Items="@(new List<ProjectsMaster> { Projects ?? new() })" Dense="true" Bordered="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Authority</MudTh>
                                                <MudTh>Approval Date</MudTh>
                                                
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.AdminApprovalAuthority</MudTd>
                                                <MudTd>@context.AdminApprovalDate?.ToShortDateString()</MudTd>
                                              
                                            </RowTemplate>
                                        </MudTable>
                                    </MudPaper>
                                </MudItem>

                                    @* --- TIMELINE DETAILS (STACKED GRID FORMAT) --- *@
                                    <MudItem xs="12" Class="mb-4">
                                        <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #4caf50; background-color: #fafffa;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>TIMELINE DETAILS</b></MudText>

                                            <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;">
                                                <thead>
                                                    @* ROW 1: PLANNED LABELS *@
                                                    <tr style="background-color: rgba(0,0,0,0.03);">
                                                        <th style="font-size:0.75rem; width: 33.33%;"><b>Start Date (Planned)</b></th>
                                                        <th style="font-size:0.75rem; width: 33.33%;"><b>End Date (Planned)</b></th>
                                                        <th style="font-size:0.75rem; width: 33.33%;"><b>Baseline Timeline</b></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @* ROW 2: PLANNED DATA *@
                                                    <tr>
                                                        <td style="font-size:0.8rem;">@(Projects?.ProjectStartDate?.ToShortDateString() ?? "N/A")</td>
                                                        <td style="font-size:0.8rem;">@(Projects?.ProjectEndDate?.ToShortDateString() ?? "N/A")</td>
                                                        <td style="font-size:0.8rem;">@(Projects?.BaselineTimeline?.ToShortDateString() ?? "N/A")</td>
                                                    </tr>

                                                    @* ROW 3: ACTUAL/REVISED LABELS *@
                                                    <tr style="background-color: rgba(0,0,0,0.03);">
                                                        <th style="font-size:0.75rem;"><b>Actual Start Date</b></th>
                                                        <th style="font-size:0.75rem;"><b>Actual End Date</b></th>
                                                        <th style="font-size:0.75rem;"><b>Revised Timeline</b></th>
                                                    </tr>

                                                    @* ROW 4: ACTUAL/REVISED DATA *@
                                                    <tr>
                                                        <td style="font-size:0.8rem;">@(Projects?.ActualStartDate?.ToShortDateString() ?? "N/A")</td>
                                                        <td style="font-size:0.8rem;">@(Projects?.ActualEndDate?.ToShortDateString() ?? "N/A")</td>
                                                        <td style="font-size:0.8rem;">@(Projects?.RevisedTimeline?.ToShortDateString() ?? "N/A")</td>
                                                    </tr>
                                                </tbody>
                                            </MudSimpleTable>
                                        </MudPaper>
                                    </MudItem>



                                    @* --- PRESENT STATE (STACKED GRID FORMAT) --- *@
                                    <MudItem xs="12" Class="mb-4">
                                        <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #f44336; background-color: #fffafa;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>PRESENT STATE</b></MudText>

                                            <MudSimpleTable Dense="true" Bordered="true" Elevation="0">
                                                <thead>
                                                    @* ROW 1: LABELS FOR PHASE, COMP %, AND STATUS *@
                                                    <tr style="background-color: rgba(0,0,0,0.03);">
                                                        <th style="font-size:0.75rem; width: 33%;"><b>Current Phase</b></th>
                                                        <th style="font-size:0.75rem; width: 33%;"><b>Completion %</b></th>
                                                        <th style="font-size:0.75rem; width: 34%;"><b>Overall Status</b></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @* ROW 2: DATA FOR PHASE, COMP %, AND STATUS *@
                                                    <tr>
                                                        <td style="font-size:0.8rem;">@(Projects?.CurrentPhase ?? "N/A")</td>
                                                        <td style="font-size:0.8rem;"><b>@(Projects?.CompletePerc?.ToString() ?? "0")%</b></td>
                                                        <td style="font-size:0.8rem;">
                                                            <MudChip T="string" Color="@GetStatusColor(Projects?.OverallStatus)" Size="Size.Small">
                                                                @(Projects?.OverallStatus ?? "N/A")
                                                            </MudChip>
                                                        </td>
                                                    </tr>

                                                    @* ROW 3: LABELS FOR LAST REVIEW AND REMARKS *@
                                                    <tr style="background-color: rgba(0,0,0,0.03);">
                                                        <th style="font-size:0.75rem;"><b>Last Review Date</b></th>
                                                        <th colspan="2" style="font-size:0.75rem;"><b>Remarks</b></th>
                                                    </tr>

                                                    @* ROW 4: DATA FOR LAST REVIEW AND REMARKS *@
                                                    <tr>
                                                        <td style="font-size:0.8rem;">@(Projects?.LastReviewDate?.ToShortDateString() ?? "N/A")</td>
                                                        <td colspan="2" style="font-size:0.8rem; white-space: pre-wrap;">@Projects?.Remarks</td>
                                                    </tr>
                                                </tbody>
                                            </MudSimpleTable>
                                        </MudPaper>
                                    </MudItem>
                            </MudGrid>
                        </MudTabPanel>


                @* TAB 2: RFP & PROCUREMENT DETAILS *@
                <MudTabPanel Text="Procurement & Financials" Icon="@Icons.Material.Filled.ShoppingCart">
                    <MudGrid Spacing="3" Class="mt-2">

                        @* --- SECTION 1: RFP DETAILS (3 Fields per Row) --- *@
                        @* --- SECTION 1: RFP DETAILS (Split into 2 parts side-by-side) --- *@
                        <MudItem xs="12" md="6" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="background-color: #f9f9f9; border-left: 4px solid #594ae2; height: 100%;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>RFP Details - Part A</b></MudText>
                                <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                    <tbody>
                                        <tr><td style="width:40%"><b>Procure Type</b></td><td>@(Projects?.ProjectProcureType ?? "N/A")</td></tr>
                                        <tr><td><b>RFP Name</b></td><td>@(Projects?.RfpName ?? "N/A")</td></tr>
                                        <tr><td><b>Ref No.</b></td><td>@(Projects?.RfpRefNo ?? "N/A")</td></tr>
                                        <tr><td><b>App. Date</b></td><td>@(Projects?.RfpApprovedDate?.ToShortDateString() ?? "N/A")</td></tr>
                                        <tr><td><b>Publish Date</b></td><td>@(Projects?.RfpPublishDate?.ToShortDateString() ?? "N/A")</td></tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="6" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="background-color: #f9f9f9; border-left: 4px solid #594ae2; height: 100%;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>RFP Details - Part B</b></MudText>
                                <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                    <tbody>
                                        <tr><td style="width:40%"><b>Pre-Bid Date</b></td><td>@(Projects?.PreBidMeetingDate?.ToShortDateString() ?? "N/A")</td></tr>
                                        <tr><td><b>Sub. Date</b></td><td>@(Projects?.RfpSubmissionDate?.ToShortDateString() ?? "N/A")</td></tr>
                                        <tr><td><b>Comp. Date</b></td><td>@(Projects?.RfpCompletionDate?.ToShortDateString() ?? "N/A")</td></tr>
                                        <tr><td><b>Status</b></td><td>@(Projects?.RfpStatus ?? "N/A")</td></tr>
                                        @* Added an empty row so both Part A and Part B have exactly 5 rows and perfectly matching heights *@
                                        <tr><td>&nbsp;</td><td>&nbsp;</td></tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>

                        @* --- SECTION 2: FINANCIAL DETAILS (4 Fields in 1 Row) --- *@
                        <MudItem xs="12" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #2196f3; background-color: #f0f4ff;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Financial Details</b></MudText>

                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
                                            <th style="font-size:0.75rem; width: 25%;"><b>Authority</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>App. Date</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>Additional App.</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>Est. Cost</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-size:0.8rem;">@(Projects?.FinApprovalAuthority ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.FinApprovalDate?.ToShortDateString() ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.IsAdditionalAppvalAvailable ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.EstimatedCostProject?.ToString("C") ?? "N/A")</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>

                        @* --- SECTION 3: PO DETAILS (4 Fields in 1 Row) --- *@
                        <MudItem xs="12" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #ff9800; background-color: #fff9f0;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>PO Details</b></MudText>

                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
                                            <th style="font-size:0.75rem; width: 25%;"><b>PO Issued</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>PO Date</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>Add. PO Issued</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>Acceptance Date</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-size:0.8rem;">@(Projects?.IsPoIssued ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.PoDate?.ToShortDateString() ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.IsAdditionalPoIssued ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.PoAcceptanceDate?.ToShortDateString() ?? "N/A")</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>

                    </MudGrid>
                </MudTabPanel>


                @* --- TAB 3: SERVICE PROVIDER (VIEW MODE) --- *@
                <MudTabPanel Text="Vendor Details" Icon="@Icons.Material.Filled.Business">
                    <MudGrid Spacing="3" Class="mt-2">

                        @* --- SECTION 1: SERVICE PROVIDER DETAILS --- *@
                        <MudItem xs="12" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #594ae2; background-color: #f9f9f9;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Service Provider Details</b></MudText>

                                @* 1. SP Basic Info (3 in 1 row) *@
                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;" Class="mb-3">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
                                            <th style="font-size:0.75rem; width: 33.33%;"><b>SP Name</b></th>
                                            <th style="font-size:0.75rem; width: 33.33%;"><b>SP Type</b></th>
                                            <th style="font-size:0.75rem; width: 33.33%;"><b>Address</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-size:0.8rem;">@(Projects?.SpName ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpType ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpAddress ?? "N/A")</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>

                                @* 2. Statutory IDs (4 in 1 row) *@
                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
                                            <th style="font-size:0.75rem; width: 25%;"><b>PAN No</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>GST/TIN No</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>CIN No</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>DIN No</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-size:0.8rem;">@(Projects?.PanNo ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.TinGstNo ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.CinNo ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.DinNo ?? "N/A")</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>

                        @* --- SECTION 2: CONTACT PERSONNEL --- *@
                        <MudItem xs="12" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #2196f3; background-color: #f0f4ff;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>Contact Personnel</b></MudText>

                                @* 3. PM Details (4 in 1 row) *@
                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;" Class="mb-3">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
                                            <th style="font-size:0.75rem; width: 25%;"><b>PM Name</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>PM Designation</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>PM Mobile</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>PM Email</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-size:0.8rem;">@(Projects?.SpPmName ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpPmDesig ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpPmMobile ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpPmEmail ?? "N/A")</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>

                                @* 4. SPOC Details (4 in 1 row) *@
                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
                                            <th style="font-size:0.75rem; width: 25%;"><b>SPOC Name</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>SPOC Designation</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>SPOC Mobile</b></th>
                                            <th style="font-size:0.75rem; width: 25%;"><b>SPOC Email</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-size:0.8rem;">@(Projects?.SpSpocName ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpSpocDesig ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpSpocMobile ?? "N/A")</td>
                                            <td style="font-size:0.8rem;">@(Projects?.SpSpocEmail ?? "N/A")</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>

                        @* --- SECTION 3: SLA & COMPLIANCE --- *@
                        <MudItem xs="12" Class="mb-4">
                            <MudPaper Elevation="2" Class="pa-3" Style="border-left: 6px solid #ff9800; background-color: #fff9f0;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"><b>SLA & Compliance</b></MudText>

                                @* 5. SLA Dates Part 1 (3 in 1 row) *@
                                <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Style="overflow-x: auto;" Class="mb-3">
                                    <thead>
                                        <tr style="background-color: rgba(0,0,0,0.03);">
