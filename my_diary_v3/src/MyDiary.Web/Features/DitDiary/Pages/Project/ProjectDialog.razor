@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProjectsMaster Projects { get; set; } = new();
    [Parameter] public ProjectMilestone Milestone { get; set; } = new();
    [Parameter] public ProjectIssue ProjectIssue { get; set; } = new();
    [Parameter] public ProjectResource ProjectResource { get; set; } = new();
    [Parameter] public Document Document { get; set; } = new();





    private List<ProjectMilestone> MilestoneList = new();
    private List<ProjectIssue> IssueList = new();
    private List<ProjectResource> ResourceList = new();
    private List<Document> DocumentList = new();

    private AllocInfo? _viewCapital;
    private AllocInfo? _viewRevenue;
    private string? _viewFyLabel;

    protected override async Task OnInitializedAsync()
    {
        if (Projects != null && !string.IsNullOrEmpty(Projects.ProjectCode))
        {
            // USE THESE METHODS to fetch multiple records for the grids
            MilestoneList = await ProjectService.GetMilestoneListByProjectAsync(Projects.ProjectCode);
            IssueList = await ProjectService.GetIssueListByProjectAsync(Projects.ProjectCode);
            ResourceList = await ProjectService.GetResourceListByProjectAsync(Projects.ProjectCode);
            DocumentList = await ProjectService.GetDocumentListByProjectAsync(Projects.ProjectCode);
        }

        if (Projects != null && Projects.ProjectId > 0)
        {
            var fyId = await BudgetSvc.GetCurrentFyIdAsync();
            var fys = await BudgetSvc.GetFinancialYearsAsync();
            if (fyId == 0 && fys.Count > 0) fyId = fys[0].FyId;
            _viewFyLabel = fys.FirstOrDefault(f => f.FyId == fyId)?.FyLabel;

            // A project can now carry both kinds of budget.
            _viewCapital = await BudgetSvc.GetAllocationAsync("CAPITAL", Projects.ProjectId, fyId);
            _viewRevenue = await BudgetSvc.GetAllocationAsync("REVENUE", Projects.ProjectId, fyId);
        }
    }

    private void Close() => MudDialog.Close();

    private string FormatCurrency(string? value)
    {
        if (decimal.TryParse(value, out var result))
            return result.ToString("N2");
        return value ?? "0.00";
    }

    private async Task LoadMilestones()
    {
        if (!string.IsNullOrEmpty(Projects?.ProjectCode))
        {
            // Fetching all records from the milestone table filtered by ProjectCode
            var result = await ProjectService.GetMilestoneListByProjectAsync(Projects.ProjectCode);
            if (result != null)
            {
                MilestoneList = result;
            }
        }
    }

    private async Task LoadIssues()
    {
        if (!string.IsNullOrEmpty(Projects?.ProjectCode))
        {
            // Make sure this method is added to your Service/Interface
            var result = await ProjectService.GetIssueListByProjectAsync(Projects.ProjectCode);
            if (result != null)
            {
                IssueList = result;
            }
        }
    }

    private async Task LoadResources()
    {
        if (!string.IsNullOrEmpty(Projects?.ProjectCode))
        {
            // Fetching all records from the resource table filtered by ProjectCode
            var result = await ProjectService.GetResourceListByProjectAsync(Projects.ProjectCode);
            if (result != null)
            {
                ResourceList = result;
            }
        }
    }
    private async Task LoadDocuments()
    {
        if (!string.IsNullOrEmpty(Projects?.ProjectCode))
        {
            var result = await ProjectService.GetDocumentListByProjectAsync(Projects.ProjectCode);
            if (result != null)
            {
                DocumentList = result;
            }
        }
    }

    private Color GetStatusColor(string? status) => status?.ToLower() switch
    {
        "go live" or "completed" => Color.Success,
        "uat" or "in progress" or "implementation" => Color.Info,
        "delayed" or "overdue" => Color.Error,
        "drop" or "dropped" => Color.Dark,
        _ => Color.Default
    };

    private async Task DownloadFile(Document doc)
    {
        if (doc.FileContent == null || doc.FileContent.Length == 0)
        {
            Snackbar.Add("No file data available for download.", Severity.Warning);
            return;
        }

        try
        {
            // Convert byte array to Base64 for the JS helper
            var base64 = Convert.ToBase64String(doc.FileContent);

            // Ensure you have the 'downloadFileFromBase64' script in your index.html
            await JS.InvokeVoidAsync("downloadFileFromBase64",
                doc.FileName ?? "document_download",
                base64,
                doc.ContentType ?? "application/octet-stream");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Download failed: " + ex.Message, Severity.Error);
        }
    }
}

