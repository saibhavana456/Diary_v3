	private void AddResourceToList()
	{
		// 1. Check if form is totally empty
		if (string.IsNullOrWhiteSpace(ProjectResource.ResourceName) &&
			string.IsNullOrWhiteSpace(ProjectResource.ResourceRole) &&
			ProjectResource.ResourceStartDate == null)
		{
			Snackbar.Add("Please enter resource details before adding.", Severity.Warning);
			return;
		}

		// 2. STRICT VALIDATION: All fields mandatory upon adding
		if (string.IsNullOrWhiteSpace(ProjectResource.ResourceName) ||
			string.IsNullOrWhiteSpace(ProjectResource.ResourceDesig) ||
			string.IsNullOrWhiteSpace(ProjectResource.ResourceRole) ||
			string.IsNullOrWhiteSpace(ProjectResource.ResourceSkillset) ||
			string.IsNullOrWhiteSpace(ProjectResource.ResourceType) ||
			string.IsNullOrWhiteSpace(ProjectResource.ResourceRemark) ||
			ProjectResource.ResourceStartDate == null ||
			ProjectResource.ResourceEndDate == null)
		{
			Snackbar.Add("All fields are mandatory to add a resource to the list.", Severity.Error);
			return;
		}

		if (_editingResource != null)
		{
			// UPDATE MODE: Update the existing reference in the list
			_editingResource.ResourceName = ProjectResource.ResourceName;
			_editingResource.ResourceDesig = ProjectResource.ResourceDesig;
			_editingResource.ResourceRole = ProjectResource.ResourceRole;
			_editingResource.ResourceSkillset = ProjectResource.ResourceSkillset;
			_editingResource.ResourceType = ProjectResource.ResourceType;
			_editingResource.ResourceStartDate = ProjectResource.ResourceStartDate;
			_editingResource.ResourceEndDate = ProjectResource.ResourceEndDate;
			_editingResource.ResourceRemark = ProjectResource.ResourceRemark;

			_editingResource = null; // Clear edit mode
			Snackbar.Add("Resource updated successfully.", Severity.Success);
		}
		else
		{
			// ADD MODE: Create new instance
			ResourceList.Add(new ProjectResource
			{
				ResourceName = ProjectResource.ResourceName,
				ResourceDesig = ProjectResource.ResourceDesig,
				ResourceRole = ProjectResource.ResourceRole,
				ResourceSkillset = ProjectResource.ResourceSkillset,
				ResourceType = ProjectResource.ResourceType,
				ResourceStartDate = ProjectResource.ResourceStartDate,
				ResourceEndDate = ProjectResource.ResourceEndDate,
				ResourceRemark = ProjectResource.ResourceRemark,
				ProjectCode = Projects.ProjectCode
			});
			Snackbar.Add("Resource added to list.", Severity.Success);
		}

		ResetResourceForm();
	}
