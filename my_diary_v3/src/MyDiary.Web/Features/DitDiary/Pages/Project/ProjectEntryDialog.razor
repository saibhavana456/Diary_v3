@using MyDiary.Web.Features.DitDiary.Models.Entities
@using MyDiary.Web.Features.DitDiary.Services
@using MudBlazor
@inherits MudComponentBase
@inject IProjectMasterService ProjectService
@inject ProjectBudgetService BudgetSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IAdminMasterService AdminService
@inject IBudgetEntryService EntryService
@inject DitUserSession Session
<style>
	.mud-tab.mud-tab-active {
		background-color: rgba(var(--mud-palette-primary-rgb), 0.1) !important;
		color: var(--mud-palette-primary) !important;
		font-weight: bold;
		border-bottom: 3px solid var(--mud-palette-primary);
		border-radius: 4px 4px 0 0;
	}

	.mud-tab-slider {
		display: none !important;
	}

	.static-footer {
		border-top: 1px solid #e0e0e0;
		background: white;
	}

	.fixed-dialog-panel {
		overflow-y: auto;
		overflow-x: hidden;
		flex-grow: 1;
		height: 0;
	}

	.ml-row {
		align-items: flex-start !important;
	}

		.ml-row .ultra-compact-label {
			padding-top: 6px;
		}

	.multiline-input,
	.multiline-input .mud-input-control,
	.multiline-input .mud-input-slot,
	.multiline-input textarea {
		height: auto !important;
		min-height: unset !important;
	}

	/* Common alignment for Identity Part A and Part B */
	.identity-field-row {
		display: grid;
		grid-template-columns: 26% minmax(0, 74%);
		align-items: start;
		width: 100%;
		column-gap: 6px;
		margin-bottom: 4px;
	}

		/* Identity field labels */
		.identity-field-row > .ultra-compact-label {
			width: 100% !important;
			min-width: 0 !important;
			margin: 0;
			padding-top: 7px !important;
			padding-right: 6px;
			box-sizing: border-box;
			color: #212121 !important;
			font-size: 0.78rem !important;
			font-weight: 600 !important;
			line-height: 1.25;
			white-space: normal;
		}

		/* Make all MudBlazor fields fill the second grid column */
		.identity-field-row > .mud-input-control {
			width: 100% !important;
			min-width: 0 !important;
			margin: 0 !important;
		}

	/* Single-line fields */
	.identity-singleline-field {
		width: 100% !important;
		min-width: 0 !important;
		margin: 0 !important;
	}

		.identity-singleline-field input {
			color: #212121 !important;
			font-size: 0.78rem !important;
			font-weight: 500 !important;
			white-space: nowrap;
			overflow-x: auto;
		}

	/* Multiline field component */
	.identity-multiline-field {
		width: 100% !important;
		min-width: 0 !important;
		margin: 0 !important;
	}

		/* Prevent the multiline input wrapper from clipping text */
		.identity-multiline-field .mud-input-control,
		.identity-multiline-field .mud-input-root,
		.identity-multiline-field .mud-input-slot {
			width: 100% !important;
			height: auto !important;
			min-height: 64px !important;
			margin-top: 0 !important;
			margin-bottom: 0 !important;
			overflow: visible !important;
			box-sizing: border-box;
		}

		/* Make entered multiline text clearly visible */
		.identity-multiline-field textarea {
			width: 100% !important;
			min-height: 64px !important;
			height: auto !important;
			padding: 10px !important;
			box-sizing: border-box;
			color: #212121 !important;
			font-size: 0.82rem !important;
			font-weight: 500 !important;
			line-height: 1.5 !important;
			opacity: 1 !important;
			resize: vertical;
			overflow-y: auto !important;
		}

			/* Placeholder should be visible but lighter */
			.identity-multiline-field textarea::placeholder,
			.identity-singleline-field input::placeholder {
				color: #757575 !important;
				font-size: 0.76rem !important;
				font-weight: 400 !important;
				opacity: 1 !important;
			}
</style>

<MudDialog DisableSidePadding="true" ContentStyle="overflow: hidden;">
	<DialogContent>
		@* 1. Outer wrapper with fixed height, flexbox, and NO overflow *@
		<div style="height: 75vh; display: flex; flex-direction: column; overflow: hidden;">

			@* 2. MudForm stretches to fill the wrapper perfectly *@
			<MudForm @ref="_form" @bind-IsValid="@_formIsValid" Style="display: flex; flex-direction: column; height: 100%;">

				@* 3. MudTabs uses flex-grow and applies scrolling ONLY to the inner PanelClass *@
				<MudTabs @bind-ActivePanelIndex="_activeIndex"
						 Elevation="0"
						 CenterTabs="true"
						 ReadOnly="true"
						 Style="flex-grow: 1; display: flex; flex-direction: column;"
						 PanelClass="fixed-dialog-panel pa-2">


					@* --- TAB 1: GENERAL & OWNERSHIP (ULTRA-COMPACT ENTRY & GRID) --- *@
					<MudTabPanel Text="Basic Details" Icon="@Icons.Material.Filled.Info">
						<div class="fixed-panel-scroll">
							<MudGrid Spacing="1">

								@*  --- BUDGET ALLOCATION (created together with the project) --- 
								<MudItem xs="12">
									<MudPaper Elevation="1" Class="pa-3 mb-2" Style="background-color:#fff8e1; border-left:4px solid #ffa000;">
										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
											<MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Warning" />
											<MudText Typo="Typo.subtitle2"><b>BUDGET ALLOCATION — @BudgetType</b></MudText>
											@if (_budgetSaved)
											{
												<MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Saved</MudChip>
											}
										</MudStack>

																				@if (BudgetType == "REVENUE")
										{
											<MudGrid Spacing="2" Class="mb-1">
												<MudItem xs="12" md="4">
													@if (IsEdit)
													{
													<MudTextField T="string" Label="Department" Disabled="true" 
														Value="@Depttext(_budgetDeptId)" 
														Variant="Variant.Outlined" Margin="Margin.Dense" />
													}
													else
													{
														<MudSelect T="long?" Label="Department *" Value="_budgetDeptId" ValueChanged="OnBudgetDeptChanged"
															ToStringFunc="@Depttext"
															Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
													
														@foreach (var d in _budgetDepts)
														{
															<MudSelectItem T="long?" Value="@((long?)d.DeptId)">@d.DeptName</MudSelectItem>
														}
													</MudSelect>
													}
												</MudItem>
												<MudItem xs="12" md="4">
													@if (IsEdit)
													{
														<MudTextField T="string" Label="Section" Disabled="true"
															Value="@SecText(_budgetSectionId)"
															Variant="Variant.Outlined" Margin="Margin.Dense" />
													}
													else
													{
													<MudSelect T="long?" Label="Section *" Value="_budgetSectionId" ValueChanged="OnBudgetSectionChanged"
															ToStringFunc="@SecText" Disabled="@(_budgetDeptId == null)"
															   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
														@foreach (var s in _budgetSections)
														{
																var taken = TakenBy(s.SectionId);
																<MudSelectItem T="long?" Value="@((long?)s.SectionId)" Disabled="@(taken != null)">
																	@s.SectionName
																	@if (taken != null)
																	{
																		<span style="opacity:.65;">&nbsp;- already has @taken.Code @taken.Name</span>
																	}
																</MudSelectItem>
														}
													</MudSelect>
													}
												</MudItem>
												<MudItem xs="12" md="4">
													<MudTextField T="string" Label="Item Name *" @bind-Value="Projects.ProjectName"
																  Variant="Variant.Outlined" Margin="Margin.Dense" />
												</MudItem>
											</MudGrid>
										}

										<MudGrid Spacing="2">
											<MudItem xs="12" md="3">
												<MudSelect T="int" Label="Financial Year" @bind-Value="_budgetFyId"
														Disabled="@BudgetLocked" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
													@foreach (var fy in _budgetFys)
													{
														<MudSelectItem T="int" Value="@fy.FyId">@fy.FyLabel</MudSelectItem>
													}
												</MudSelect>
											</MudItem>
											<MudItem xs="12" md="3">
												<MudNumericField T="decimal" Label="Spillover Allotted (Cr)" @bind-Value="_allotSpillover"
															ReadOnly="@BudgetLocked"  Min="0" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
											<MudItem xs="12" md="3">
												<MudNumericField T="decimal" Label="Fresh Allotted (Cr)" @bind-Value="_allotFresh"
															ReadOnly="@BudgetLocked"  Min="0" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
											<MudItem xs="12" md="3">
												<MudTextField T="string" Label="Total Allotted (Cr)" ReadOnly="true"
															  Value="@AllotTotal.ToString("N2")" Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
										</MudGrid>
										@if (_budgetSaved)
										{
											<MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
												@if (IsEdit)
											{
												<text>
											This @(BudgetType == "REVENUE" ? "Section" : "project") already has
											<b>@AllotTotal.ToString("N2") Cr</b> Allotted for <b>@FyLabelText</b>
										Tick below to revise it.
									</text>
											}
											else
											{

											<text>
													This @(BudgetType == "REVENUE" ? "Section" : "project") already has
												<b>@AllotTotal.ToString("N2") Cr</b> Allotted for <b>@FyLabelText</b>
												Enter the Item Name to record it - the budget will not change.
												</text>
											}
									</MudAlert>
									@if (IsEdit)
									{
											<MudCheckBox T="bool" @bind-Value="_reviseBudget" Color="Color.Warning" Dense="true" Class="mt-1"
											Label="Revise this section's budget" />
										}
										}

										<MudText Typo="Typo.caption" Class="mt-2">
											@(BudgetType == "CAPITAL"
												? "Capital budget is allotted per project. Utilisation above this amount will be blocked."
												: "Revenue budget is allotted per section. Utilisation above this amount will show a warning but still save.")
											It is saved automatically when you press Save &amp; Next on this tab.
										</MudText>
									</MudPaper>
								</MudItem>

								

																@if (BudgetType != "REVENUE")
								{ *@


								@* --- PROJECT IDENTITY SECTIONS (Part A & B side-by-side) --- *@
								<MudItem xs="12" md="6">
									<MudPaper Elevation="1" Class="pa-2" Style="background-color: #f9f9f9; border-left: 3px solid #594ae2; height: 100%;">
										<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.65rem;"><b>IDENTITY - PART A</b></MudText>
										@* Project Code: Single-line field *@
										@* Project Code: Single-line field *@
										@* <div class="identity-field-row">
											<MudText Class="ultra-compact-label">
												Project Code *
											</MudText>

											<MudTextField T="string"
														  @bind-Value="Projects.ProjectCode"
														  Variant="Variant.Outlined"
														  Required="true"
														  RequiredError="Project Code is required."
														  Margin="Margin.Dense"
														  Class="ultra-compact-input identity-singleline-field"
														  FullWidth="true" />
										</div> *@

										<div class="identity-field-row">
	<MudText Class="ultra-compact-label">
		Project Code
	</MudText>

	<MudTextField T="string"
				  Value="@Projects.ProjectCode"
				  Placeholder="Generated automatically when you save"
				  ReadOnly="true"
				  Variant="Variant.Filled"
				  Margin="Margin.Dense"
				  Class="identity-singleline-field"
				  FullWidth="true" />
</div>

										@* Project Name: Single-line field *@
										<div class="identity-field-row">
											<MudText Class="ultra-compact-label">
												Project Name *
											</MudText>

											<MudTextField T="string"
														  @bind-Value="Projects.ProjectName"
														  Variant="Variant.Outlined"
														  Required="true"
														  RequiredError="Project Name is required."
														  Margin="Margin.Dense"
														  Class="ultra-compact-input identity-singleline-field"
														  FullWidth="true" />
										</div>

										@* Project Brief: Multiline field *@
										<div class="identity-field-row">
											<MudText Class="ultra-compact-label">
												Project Brief
											</MudText>

											<MudTextField T="string"
														  @bind-Value="Projects.ProjectBrief"
														  Variant="Variant.Outlined"
														  Margin="Margin.Dense"
														  Class="identity-multiline-field"
														  Lines="3"
														  AutoGrow="true"
														  MaxLines="6"
														  FullWidth="true"
														  Placeholder="Enter a brief summary of the project" />
										</div>

										@* Description: Multiline field *@
										<div class="identity-field-row">
											<MudText Class="ultra-compact-label">
												Description
											</MudText>

											<MudTextField T="string"
														  @bind-Value="Projects.ProjectDesc"
														  Variant="Variant.Outlined"
														  Margin="Margin.Dense"
														  Class="identity-multiline-field"
														  Lines="3"
														  AutoGrow="true"
														  MaxLines="6"
														  FullWidth="true"
														  Placeholder="Enter detailed project description" />
										</div>

										@* Needs: Multiline field *@
										<div class="identity-field-row">
											<MudText Class="ultra-compact-label">
												Needs
											</MudText>

											<MudTextField T="string"
														  @bind-Value="Projects.ProjectNeed"
														  Variant="Variant.Outlined"
														  Margin="Margin.Dense"
														  Class="identity-multiline-field"
														  Lines="3"
														  AutoGrow="true"
														  MaxLines="6"
														  FullWidth="true"
														  Placeholder="Enter the business or technical need" />
										</div>
									</MudPaper>
								</MudItem>

								<MudItem xs="12" md="6">
									<MudPaper Elevation="1" Class="pa-2" Style="background-color: #f9f9f9; border-left: 3px solid #594ae2; height: 100%;">
										<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.65rem;"><b>IDENTITY - PART B</b></MudText>
										<div class="identity-field-row">
											<MudText Class="ultra-compact-label">
												Benefits to Bank *
											</MudText>

											<MudTextField T="string"
														  @bind-Value="Projects.ProjectBenefitsBank"
														  Variant="Variant.Outlined"
														  Required="true"
														  RequiredError="Benefits to Bank is required."
														  Margin="Margin.Dense"
														  Class="identity-multiline-field"
														  Lines="3"
														  AutoGrow="true"
														  MaxLines="6"
														  FullWidth="true"
														  Placeholder="Enter the expected benefits to the Bank" />
										</div>

										<div class="identity-field-row">
	<MudText Class="ultra-compact-label">
		Type
	</MudText>

	<MudSelect T="string"
			   @bind-Value="Projects.ProjectType"
			   Variant="Variant.Outlined"
			   Margin="Margin.Dense"
			   Dense="true"
			   Class="identity-singleline-field"
			   FullWidth="true">

		<MudSelectItem Value="@("")"></MudSelectItem>
		<MudSelectItem Value="@("Y")">TECH PROJECT</MudSelectItem>
		<MudSelectItem Value="@("N")">BIZ PROJECT</MudSelectItem>
	</MudSelect>
</div>
										<div class="identity-field-row">
	<MudText Class="ultra-compact-label">
		Category
	</MudText>

	<MudSelect T="string"
			   @bind-Value="Projects.ProjectCategory"
			   Variant="Variant.Outlined"
			   Margin="Margin.Dense"
			   Dense="true"
			   Class="identity-singleline-field"
			   FullWidth="true">

		<MudSelectItem Value="@("")"></MudSelectItem>
		<MudSelectItem Value="@("Y")">Non-IT PROJECT</MudSelectItem>
		<MudSelectItem Value="@("N")">IT PROJECT</MudSelectItem>
	</MudSelect>
</div>
										<div class="identity-field-row">
	<MudText Class="ultra-compact-label">
		Nature
	</MudText>

	<MudTextField T="string"
				  @bind-Value="Projects.ProjectNature"
				  Variant="Variant.Outlined"
				  Margin="Margin.Dense"
				  Class="identity-multiline-field"
				  Lines="3"
				  AutoGrow="true"
				  MaxLines="6"
				  FullWidth="true"
				  Placeholder="Enter the nature of the project" />
</div>


									</MudPaper>
								</MudItem>

								@* --- OWNERSHIP SECTIONS (3 Parts Side-by-Side) --- *@

								<MudItem xs="12" md="4">
									<MudPaper Elevation="1" Class="pa-2" Style="background-color: #f0f4ff; border-left: 3px solid #2196f3; height: 100%;">
										@* <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;"><b>BUSINESS OWNERSHIP</b></MudText> *@
										<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;"><b>BUSINESS OWNERSHIP</b></MudText>
										<div class="ultra-compact-row">
											<MudText Class="ultra-compact-label">Office Type</MudText>
											<MudSelect T="string" Value="@_bizOfficeType" ValueChanged="OnBizOfficeTypeChanged"
													   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input"
													   AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
													   Disabled="@(Projects.IS_IT_BUSINESS_SAME == "Y")">
												<MudSelectItem T="string" Value="@("")">-- Select Office Type --</MudSelectItem>
												@foreach (var t in _officeTypes)
												{
													<MudSelectItem T="string" Value="@t">@t</MudSelectItem>
												}
											</MudSelect>
										</div>
																				<div class="ultra-compact-row"><MudText Class="ultra-compact-label">Department *</MudText>
											<MudSelect T="string" Value="Projects.BUSINESS_OWNER_DEPT_NAME" ValueChanged="OnBizDeptChanged" Required="true"
													   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input"
													   AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Disabled="@(Projects.IS_IT_BUSINESS_SAME == "Y")">
												@* @foreach (var d in _mapDepartments) { <MudSelectItem Value="@d.DEPT_NAME">@d.DEPT_NAME</MudSelectItem> } *@
												@foreach (var d in _bizDepartments)
												{
													<MudSelectItem Value="@d.DEPT_NAME">@d.DEPT_NAME</MudSelectItem>
												}
											</MudSelect>
										</div>
										<div class="ultra-compact-row"><MudText Class="ultra-compact-label">Section</MudText>
											<MudSelect T="string" Value="Projects.BUSINESS_OWNER_SEC_NAME" ValueChanged="OnBizSecChanged"
													   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input"
													   AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Disabled="@(Projects.IS_IT_BUSINESS_SAME == "Y")">
												@foreach (var s in _bizSections) { <MudSelectItem Value="@s.NAME">@s.NAME</MudSelectItem> }
											</MudSelect>
										</div>
										<div class="ultra-compact-row"><MudText Class="ultra-compact-label">Owner Name *</MudText><MudTextField @bind-Value="Projects.BUSINESS_OWNER_NAME" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" Class="ultra-compact-input" /></div>
										<div class="ultra-compact-row"><MudText Class="ultra-compact-label">Designation</MudText><MudTextField @bind-Value="Projects.BUSINESS_OWNER_DESIG" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" /></div>
										<div class="ultra-compact-row"><MudText Class="ultra-compact-label">IP Number</MudText><MudTextField @bind-Value="Projects.BUSINESS_OWNER_IP_NO" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" /></div>
										<div class="ultra-compact-row"><MudText Class="ultra-compact-label">Mobile</MudText><MudTextField @bind-Value="Projects.BUSINESS_OWNER_MOBILE" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" /></div>
										<div class="ultra-compact-row"><MudText Class="ultra-compact-label">Email</MudText><MudTextField @bind-Value="Projects.BUSINESS_OWNER_EMAIL" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" /></div>
										@* --- SIMPLE TOGGLE PLACED HERE --- *@
										<div class="mt-2 pt-1 d-flex align-center" style="border-top: 1px dotted #ccc;">
											<MudText Class="ultra-compact-label" Style="width: 50%;">Is Business and IT Same?</MudText>
											<MudRadioGroup T="string" Value="@Projects.IS_IT_BUSINESS_SAME" ValueChanged="OnItAndBusinessSameChanged" Class="d-flex align-center mt-0">
												<MudRadio T="string" Value="@("Y")" Size="Size.Small" Dense="true" Color="Color.Primary"><span style="font-size: 0.7rem;">Yes</span></MudRadio>
												<MudRadio T="string" Value="@("N")" Size="Size.Small" Dense="true" Color="Color.Primary"><span style="font-size: 0.7rem;">No</span></MudRadio>
											</MudRadioGroup>
										</div>

									</MudPaper>
								</MudItem>


								<MudItem xs="12" md="4">
									<MudPaper Elevation="1" Class="pa-2" Style="background-color: #f0f4ff; border-left: 3px solid #2196f3; height: 100%;">
										@* <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;"><b>IT OWNERSHIP</b></MudText> *@
										<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;"><b>IT OWNERSHIP</b></MudText>
										@if (Projects.IS_IT_BUSINESS_SAME == "Y" && Projects.DEPT_ID == null)
										{
											<MudText Typo="Typo.caption" Style="font-size:0.65rem;color:#c62828;" Class="d-block mb-1">
												That business department is not one of your DIT departments — please choose the IT Department and Section here.
											</MudText>
										}
																				@* <div class="ultra-compact-row"><MudText Class="ultra-compact-label">Department *</MudText>
											 <MudSelect T="string" Value="Projects.BUSINESS_OWNER_DEPT_NAME" ValueChanged="OnBizDeptChanged" Required="true"
													   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input"
													   AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Disabled="@(Projects.IS_IT_BUSINESS_SAME == "Y")">
