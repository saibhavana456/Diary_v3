												@(_editingIssue == null ? "Add to List" : "Update Item")
											</MudButton>
										</MudItem>
									</MudGrid>
								</MudPaper>
							</MudItem>

							@* --- ISSUE LIST GRID --- *@
							<MudItem xs="12" Class="mt-2">
								<MudText Typo="Typo.caption" Color="Color.Primary"><b>ISSUES TO BE SAVED (@IssueList.Count)</b></MudText>
								<MudTable Items="@IssueList" Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-1" HorizontalScrollbar="true">
									<HeaderContent>
										<MudTh Class="grid-header">Code</MudTh>
										<MudTh Class="grid-header">Owner</MudTh>
										<MudTh Class="grid-header">Status</MudTh>
										<MudTh Class="grid-header">Description</MudTh>
										<MudTh Class="grid-header">Impact</MudTh>
										<MudTh Class="grid-header">Root Cause</MudTh>
										<MudTh Class="grid-header">Resolution Summary</MudTh>
										<MudTh Class="grid-header">Raised</MudTh>
										<MudTh Class="grid-header">Target</MudTh>
										<MudTh Class="grid-header">Actual</MudTh>
										<MudTh Class="grid-header" Style="width:80px">Action</MudTh>
									</HeaderContent>
									<RowTemplate>
										<MudTd Class="grid-data"><b>@context.IssueCode</b></MudTd>
										<MudTd Class="grid-data">@(context.OwnerName ?? "-")</MudTd>
										<MudTd Class="grid-data">
											<MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Style="font-size:0.65rem; height:18px;">
												@(context.Status ?? "Open")
											</MudChip>
										</MudTd>
										<MudTd Class="grid-data" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@context.IssueDescription</MudTd>
										<MudTd Class="grid-data">@context.Impact</MudTd>
										<MudTd Class="grid-data">@context.RootCause</MudTd>
										<MudTd Class="grid-data" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@context.ResolutionSummary</MudTd>
										<MudTd Class="grid-data">@context.DateRaised?.ToString("dd-MMM-yyyy")</MudTd>
										<MudTd Class="grid-data">@context.TargetResolutionDate?.ToString("dd-MMM-yyyy")</MudTd>
										<MudTd Class="grid-data">@(context.ActualResolutionDate?.ToString("dd-MMM-yyyy") ?? "-")</MudTd>
										<MudTd>
											<div class="d-flex">
												<MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadIssueForEdit(context))" Class="pa-1" />
												<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveIssueFromList(context))" Class="pa-1" />
											</div>
										</MudTd>
									</RowTemplate>
								</MudTable>
							</MudItem>
						</MudGrid>
					</MudTabPanel>


					@* --- TAB 6: RESOURCES (ULTRA-COMPACT ENTRY WITH SMART VALIDATION & RESET) --- *@
					<MudTabPanel Text="Resources" Icon="@Icons.Material.Filled.People" Disabled="@(!BasicSaved)">
						<MudGrid Spacing="1" Class="mt-2">

							@* --- ENTRY FORM SECTION --- *@
							<MudItem xs="12">
								<MudPaper Elevation="1" Class="pa-2" Style="border-left: 6px solid #2196f3; background-color: #f0f4ff;">
									<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;" Class="mb-1 d-block">
										<b>NEW RESOURCE ENTRY</b> (All fields mandatory only when adding to list)
									</MudText>

									<MudGrid Spacing="1">
										@* ROW 1: Name, Designation & Role *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Resource Name</MudText>
											<MudTextField @bind-Value="ProjectResource.ResourceName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Designation</MudText>
											<MudTextField @bind-Value="ProjectResource.ResourceDesig" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Resource Role</MudText>
											<MudTextField @bind-Value="ProjectResource.ResourceRole" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* ROW 2: Skillset, Type & Remark (As Requested) *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Skillset</MudText>
											<MudTextField @bind-Value="ProjectResource.ResourceSkillset" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Type</MudText>
											<MudSelect T="string" @bind-Value="ProjectResource.ResourceType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												<MudSelectItem Value="@("")" Disabled="true">Select</MudSelectItem>
												<MudSelectItem Value="@("INTERNAL")">INTERNAL</MudSelectItem>
												<MudSelectItem Value="@("VENDOR")">VENDOR</MudSelectItem>
											</MudSelect>
										</MudItem>
										<MudItem xs="5">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Resource Remark</MudText>
											<MudTextField @bind-Value="ProjectResource.ResourceRemark" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* ROW 3: Timelines (Moved here to make room for Row 2) *@
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Start Date</MudText>
											<MudDatePicker @bind-Date="ProjectResource.ResourceStartDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">End Date</MudText>
											<MudDatePicker @bind-Date="ProjectResource.ResourceEndDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>

										@* Action Buttons *@
										<MudItem xs="6" Class="d-flex justify-end align-end gap-2 pb-1">
											<MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="ResetResourceForm" StartIcon="@Icons.Material.Filled.Refresh">
												Reset
											</MudButton>
											<MudButton Variant="Variant.Filled" Color="@(_editingResource == null ? Color.Info : Color.Warning)" Size="Size.Small" OnClick="AddResourceToList" StartIcon="@Icons.Material.Filled.Add">
												@(_editingResource == null ? "Add to List" : "Update Item")
											</MudButton>
										</MudItem>
									</MudGrid>
								</MudPaper>
							</MudItem>

							@* --- RESOURCE LIST GRID --- *@
							<MudItem xs="12" Class="mt-2">
								<MudText Typo="Typo.caption" Color="Color.Primary"><b>RESOURCES TO BE SAVED (@ResourceList.Count)</b></MudText>
								<MudTable Items="@ResourceList" Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-1" HorizontalScrollbar="true">
									<HeaderContent>
										<MudTh Class="grid-header">Code</MudTh>
										<MudTh Class="grid-header">Name</MudTh>
										<MudTh Class="grid-header">Designation</MudTh>
										<MudTh Class="grid-header">Role</MudTh>
										<MudTh Class="grid-header">Skillset</MudTh>
										<MudTh Class="grid-header">Type</MudTh>
										<MudTh Class="grid-header">Start Date</MudTh>
										<MudTh Class="grid-header">End Date</MudTh>
										<MudTh Class="grid-header">Remarks</MudTh>
										<MudTh Class="grid-header" Style="width:80px">Action</MudTh>
									</HeaderContent>
									<RowTemplate>
										<MudTd Class="grid-data">@context.ResourceCode</MudTd>
										<MudTd Class="grid-data"><b>@context.ResourceName</b></MudTd>
										<MudTd Class="grid-data">@context.ResourceDesig</MudTd>
										<MudTd Class="grid-data">@context.ResourceRole</MudTd>
										<MudTd Class="grid-data">@context.ResourceSkillset</MudTd>
										<MudTd Class="grid-data">
											<MudChip T="string" Size="Size.Small" Color="@(context.ResourceType == "INTERNAL" ? Color.Success : Color.Info)" Style="font-size:0.65rem; height:18px;">
												@(context.ResourceType ?? "NA")
											</MudChip>
										</MudTd>
										<MudTd Class="grid-data">@context.ResourceStartDate?.ToString("dd-MMM-yyyy")</MudTd>
										<MudTd Class="grid-data">@context.ResourceEndDate?.ToString("dd-MMM-yyyy")</MudTd>
										<MudTd Class="grid-data" Style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@context.ResourceRemark</MudTd>
										<MudTd>
											<div class="d-flex">
												<MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadResourceForEdit(context))" Class="pa-1" />
												<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveResourceFromList(context))" Class="pa-1" />
											</div>
										</MudTd>
									</RowTemplate>
								</MudTable>
							</MudItem>
						</MudGrid>
					</MudTabPanel>
					


					@* --- TAB 7: DOCUMENTS (FIXED CONTEXT CONFLICT) --- *@
					<MudTabPanel Text="Documents" Icon="@Icons.Material.Filled.AttachFile" Disabled="@(!BasicSaved)">
						<MudGrid Spacing="1" Class="mt-2">

							<MudItem xs="12">
								<MudPaper Elevation="1" Class="pa-2" Style="border-left: 6px solid #ff9800; background-color: #fff9f0;">
									<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;" Class="mb-1 d-block">
										<b>NEW DOCUMENT REFERENCE</b>
									</MudText>

									<MudGrid Spacing="1">
										@* --- Document Name (Left Side) --- *@
										<MudItem xs="7">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Document Name *</MudText>
											<MudTextField @bind-Value="Document.DocName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* --- Attachment Upload (Right Side) --- *@
										<MudItem xs="5">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Attachment *</MudText>
											<MudFileUpload T="IBrowserFile" OnFilesChanged="HandleFileSelection" Accept=".xlsx">
												<ActivatorContent>
													<div class="d-flex align-center border rounded pa-1" style="height: 30px; background: white; border-color: #bdbdbd !important; cursor: pointer;">
														@* Area showing the filename *@
														<MudText Typo="Typo.caption" Class="flex-grow-1 px-2 text-truncate" Style="font-size: 0.7rem; color: #616161;">
															@(string.IsNullOrEmpty(selectedFileName) ? "No file chosen" : selectedFileName)
														</MudText>

														@* "Choose File" Button label *@
														<MudButton Variant="Variant.Filled"
																   Color="Color.Default"
																   Size="Size.Small"
																   Style="height: 22px; font-size: 0.65rem; text-transform: none; margin-left: 4px; pointer-events: none;">
															Choose File
														</MudButton>
													</div>
												</ActivatorContent>
											</MudFileUpload>
										</MudItem>

										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Type *</MudText>
											<MudSelect T="string" @bind-Value="Document.DocType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												<MudSelectItem Value="@("")" Disabled="true">Select Type</MudSelectItem>
												<MudSelectItem Value="@("RFP")">RFP</MudSelectItem>
												<MudSelectItem Value="@("SLA")">SLA</MudSelectItem>
												<MudSelectItem Value="@("Approval Note")">Approval Note</MudSelectItem>
											</MudSelect>
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Reference *</MudText>
											<MudTextField @bind-Value="Document.Field1" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="6">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Remarks *</MudText>
											<MudTextField @bind-Value="Document.Remark" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										<MudItem xs="12" Class="d-flex justify-end mt-1 gap-2">
											<MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetDocumentForm" StartIcon="@Icons.Material.Filled.Refresh">Reset</MudButton>
											<MudButton Variant="Variant.Filled" Color="@(_editingDocument == null ? Color.Warning : Color.Info)" Size="Size.Small" OnClick="AddDocumentToList" StartIcon="@Icons.Material.Filled.Add">
												@(_editingDocument == null ? "Add to List" : "Update Item")
											</MudButton>
										</MudItem>
									</MudGrid>
								</MudPaper>
							</MudItem>

							<MudItem xs="12" Class="mt-2">
								@* Added HorizontalScrollbar to handle the extra columns safely *@
								<MudTable Items="@DocumentList" Context="doc" Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-1" HorizontalScrollbar="true">
									<HeaderContent>
										@* --- ADDED ALL REQUESTED COLUMNS TO HEADER --- *@
										<MudTh Class="grid-header">ID</MudTh>
										<MudTh Class="grid-header">Project</MudTh>
										<MudTh Class="grid-header">Code</MudTh>
										<MudTh Class="grid-header">Name</MudTh>
										<MudTh Class="grid-header">Type</MudTh>
										<MudTh Class="grid-header">Reference (Field1)</MudTh>
										<MudTh Class="grid-header">Remark</MudTh>
										<MudTh Class="grid-header">File</MudTh>
										<MudTh Class="grid-header" Style="width:100px">Action</MudTh>
									</HeaderContent>
									<RowTemplate>
										@* --- MAPPING DATA TO ROWS --- *@
										<MudTd Class="grid-data">@doc.DocId</MudTd>
										<MudTd Class="grid-data">@doc.ProjectCode</MudTd>
										<MudTd Class="grid-data"><b>@doc.DocCode</b></MudTd>
										<MudTd Class="grid-data">@doc.DocName</MudTd>
										<MudTd Class="grid-data">
											<MudChip T="string" Size="Size.Small" Color="Color.Info" Style="font-size:0.65rem; height:18px;">
												@(doc.DocType ?? "NA")
											</MudChip>
										</MudTd>
										@* Field1 and Remark often contain long text, so we add a max-width and ellipsis *@
										<MudTd Class="grid-data" Style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
											@doc.Field1
										</MudTd>
										<MudTd Class="grid-data" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
											@doc.Remark
										</MudTd>
										<MudTd Class="grid-data">
											@if (doc.FileContent != null)
											{
												<MudLink OnClick="@(() => DownloadFile(doc))" Style="cursor:pointer; font-size:0.7rem; display: flex; align-items: center;">
													<MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="mr-1" /> Download
												</MudLink>
											}
											else
											{
												<MudText Style="font-size:0.7rem; color:gray;">No File</MudText>
											}
										</MudTd>
										<MudTd>
											<div class="d-flex">
												<MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadDocumentForEdit(doc))" Class="pa-1" />
												<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DocumentList.Remove(doc))" Class="pa-1" />
											</div>
										</MudTd>
									</RowTemplate>
								</MudTable>
							</MudItem>
						</MudGrid>
					</MudTabPanel>

					@* --- TAB 8: BUDGET MANAGEMENT --- *@
					<MudTabPanel Text="Budget Management" Icon="@Icons.Material.Filled.Savings" Disabled="@(!BasicSaved)">
						<div class="fixed-panel-scroll">
							<MudGrid Spacing="2" Class="mt-2">

								@* ---------------- CAPITAL ---------------- *@
								<MudItem xs="12">
									<MudPaper Elevation="2" Class="pa-4" Style="background:#f4f2ff; border-left:6px solid #594ae2;">
										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
											<MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" />
											<MudText Typo="Typo.subtitle1"><b>CAPITAL BUDGET</b></MudText>
											@if (_capSaved)
											{
												<MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Saved</MudChip>
											}
										</MudStack>

										<MudGrid Spacing="2">
											<MudItem xs="12" md="3">
												<MudSelect T="int" Label="Financial Year" Value="_capFyId" ValueChanged="OnCapFyChanged"
														   Disabled="@CapLocked" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
													@foreach (var fy in _budgetFys)
													{
														<MudSelectItem T="int" Value="@fy.FyId">@fy.FyLabel</MudSelectItem>
													}
												</MudSelect>
											</MudItem>
											<MudItem xs="12" md="3">
												<MudNumericField T="decimal" Label="Spillover Allotted (Cr)" @bind-Value="_capSpill"
																 ReadOnly="@CapLocked" Min="0" HideSpinButtons="true"
																 Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
											<MudItem xs="12" md="3">
												<MudNumericField T="decimal" Label="Fresh Allotted (Cr)" @bind-Value="_capFresh"
																 ReadOnly="@CapLocked" Min="0" HideSpinButtons="true"
																 Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
											<MudItem xs="12" md="3">
												<MudTextField T="string" Label="Total Allotted (Cr)" ReadOnly="true"
															  Value="@CapTotal.ToString("N2")" Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
										</MudGrid>

										<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3">
											<div>
												@if (_capSaved)
												{
													<MudCheckBox T="bool" @bind-Value="_capRevise" Color="Color.Warning" Dense="true"
																 Label="Revise the capital budget." />
												}
											</div>
											<MudButton Variant="Variant.Filled" Color="Color.Primary"
													   StartIcon="@Icons.Material.Filled.Save"
													   Disabled="@(CapLocked || _isProcessing)"
													   OnClick="SaveCapitalBudget"
													   Style="text-transform:none; min-width:160px;">
												SAVE CAPITAL
											</MudButton>
										</MudStack>
									</MudPaper>
								</MudItem>

								@* ---------------- REVENUE ---------------- *@
								<MudItem xs="12">
									<MudPaper Elevation="2" Class="pa-4" Style="background:#eef8f6; border-left:6px solid #00897b;">
										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
											<MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Tertiary" />
											<MudText Typo="Typo.subtitle1"><b>REVENUE BUDGET</b></MudText>
											@if (_revSaved)
											{
												<MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Saved</MudChip>
											}
										</MudStack>

										<MudGrid Spacing="2">
											<MudItem xs="12" md="3">
												<MudSelect T="int" Label="Financial Year" Value="_revFyId" ValueChanged="OnRevFyChanged"
														   Disabled="@RevLocked" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
													@foreach (var fy in _budgetFys)
													{
														<MudSelectItem T="int" Value="@fy.FyId">@fy.FyLabel</MudSelectItem>
													}
												</MudSelect>
											</MudItem>
											<MudItem xs="12" md="3">
												<MudNumericField T="decimal" Label="Spillover Allotted (Cr)" @bind-Value="_revSpill"
																 ReadOnly="@RevLocked" Min="0" HideSpinButtons="true"
																 Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
											<MudItem xs="12" md="3">
												<MudNumericField T="decimal" Label="Fresh Allotted (Cr)" @bind-Value="_revFresh"
																 ReadOnly="@RevLocked" Min="0" HideSpinButtons="true"
																 Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
											<MudItem xs="12" md="3">
												<MudTextField T="string" Label="Total Allotted (Cr)" ReadOnly="true"
															  Value="@RevTotal.ToString("N2")" Variant="Variant.Outlined" Margin="Margin.Dense" />
											</MudItem>
										</MudGrid>

										<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3">
											<div>
												@if (_revSaved)
												{
													<MudCheckBox T="bool" @bind-Value="_revRevise" Color="Color.Warning" Dense="true"
																 Label="Revise the revenue budget." />
												}
											</div>
											<MudButton Variant="Variant.Filled" Color="Color.Tertiary"
													   StartIcon="@Icons.Material.Filled.Save"
													   Disabled="@(RevLocked || _isProcessing)"
													   OnClick="SaveRevenueBudget"
													   Style="text-transform:none; min-width:160px;">
												SAVE REVENUE
											</MudButton>
										</MudStack>
									</MudPaper>
								</MudItem>

								<MudItem xs="12">
									<MudText Typo="Typo.caption" Style="color:#666;">
										A project may have a capital budget, a revenue budget, or both.
										Leave a box at zero if it does not apply. Each box is saved on its own.
									</MudText>
								</MudItem>
							</MudGrid>
						</div>
					</MudTabPanel>

				</MudTabs>
			</MudForm>
		</div>

	</DialogContent>

	<DialogActions>
		<div class="d-flex justify-space-between mud-width-full px-6 py-4 static-footer">
			<MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Error" Disabled="_isProcessing">Cancel</MudButton>
			<div class="d-flex gap-3">
				<MudButton Disabled="@(_activeIndex == 0 || _isProcessing)" OnClick="PrevTab" Variant="Variant.Outlined">Back</MudButton>

				<MudButton OnClick="HandleSaveAndNext" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isProcessing">
					@if (_isProcessing)
					{
						<MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
					}
					@(!IsLastTab ? "Save & Next" : "Save & Finish")
				</MudButton>
			</div>
		</div>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

	// Parameters passed from ProjectDetails.razor
	[Parameter] public ProjectsMaster Projects { get; set; } = new();
