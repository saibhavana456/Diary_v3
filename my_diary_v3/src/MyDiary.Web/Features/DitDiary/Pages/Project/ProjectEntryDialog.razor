	//DOCUMENTS
	private void AddDocumentToList()
	{
		// 1. Mandatory Validation
		if (string.IsNullOrWhiteSpace(Document.DocName) ||
			string.IsNullOrWhiteSpace(Document.DocType) ||
			(tempFileContent == null && _editingDocument?.FileContent == null))
		{
			Snackbar.Add("Name, Type, and File Upload are mandatory!", Severity.Error);
			return;
		}

		if (_editingDocument != null)
		{
			// 2. UPDATE MODE
			_editingDocument.DocName = Document.DocName;
			_editingDocument.DocType = Document.DocType;
			_editingDocument.Field1 = Document.Field1;
			_editingDocument.Remark = Document.Remark;

			// Update file only if a new one was picked
			if (tempFileContent != null)
			{
				_editingDocument.FileContent = tempFileContent;
				_editingDocument.ContentType = tempContentType;
				_editingDocument.FileName = selectedFileName;
			}

			_editingDocument = null;
			Snackbar.Add("Document updated.", Severity.Success);
		}
		else
		{
			// 3. ADD MODE
			DocumentList.Add(new Document
			{
				DocName = Document.DocName,
				DocType = Document.DocType,
				Field1 = Document.Field1,
				Remark = Document.Remark,
				FileContent = tempFileContent,
				ContentType = tempContentType,
				FileName = selectedFileName,
				ProjectCode = Projects.ProjectCode
			});
			Snackbar.Add("Document added to list.", Severity.Success);
		}

		ResetDocumentForm();
	}

	private void LoadDocumentForEdit(Document item)
	{
		if (item == null) return;

		_editingDocument = item;
		selectedFileName = item.FileName;

		// Create a new instance for the form to avoid direct mutation of the list item
		// until "Update" is clicked. Ensure all strings default to "" instead of null.
		Document = new Document
		{
			DocId = item.DocId,
			DocCode = item.DocCode,
			ProjectCode = item.ProjectCode,
			DocName = item.DocName ?? "",
			DocType = item.DocType ?? "",
			Field1 = item.Field1 ?? "",
			Remark = item.Remark ?? "",
			FileContent = item.FileContent, // Maintain the binary reference
			FileName = item.FileName,
			ContentType = item.ContentType
		};

		StateHasChanged();
	}

	private void ResetDocumentForm()
	{
		_editingDocument = null;
		selectedFileName = null;
		tempFileContent = null;
		tempContentType = null;
		Document = new Document { DocType = "" };
		StateHasChanged();
	}

	private void RemoveDocumentFromList(Document item)
	{
		DocumentList.Remove(item);
	}

	private async Task HandleFileSelection(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file != null)
		{
			selectedFileName = file.Name;
			tempContentType = file.ContentType;

			// Read file into byte array (Max 10MB limit)
			using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
			using var ms = new MemoryStream();
			await stream.CopyToAsync(ms);
			tempFileContent = ms.ToArray();

			Snackbar.Add($"File '{selectedFileName}' attached.", Severity.Info);
		}
	}

	private async Task DownloadFile(Document doc)
	{
		if (doc.FileContent == null || doc.FileContent.Length == 0)
		{
			Snackbar.Add("No file data available for download.", Severity.Warning);
			return;
		}

		try
		{
			var base64 = Convert.ToBase64String(doc.FileContent);
			await JS.InvokeVoidAsync("downloadFileFromBase64",
				doc.FileName ?? "document_download",
				base64,
				doc.ContentType ?? "application/octet-stream");
		}
		catch (Exception ex)
		{
			Snackbar.Add("Download failed: " + ex.Message, Severity.Error);
		}
	}
	private IEnumerable<Section> _bizSections => string.IsNullOrEmpty(Projects.BUSINESS_OWNER_DEPT_NAME)
	? new List<Section>()
	: _mapCapitalSections.Where(s => _mapDepartments.FirstOrDefault(d => d.DEPT_NAME == Projects.BUSINESS_OWNER_DEPT_NAME)?.DEPT_ID == s.DEPT_ID);

	private void OnBizDeptChanged(string v)
	{
		Projects.BUSINESS_OWNER_DEPT_NAME = v;
		Projects.BUSINESS_OWNER_SEC_NAME = null;
		if (Projects.IS_IT_BUSINESS_SAME == "Y") CopyBusinessToIt();
	}

	private void OnBizSecChanged(string v)
	{
		Projects.BUSINESS_OWNER_SEC_NAME = v;
		if (Projects.IS_IT_BUSINESS_SAME == "Y") CopyBusinessToIt();
	}

	private void CopyBusinessToIt()
	{
		Projects.IT_OWNER_NAME = Projects.BUSINESS_OWNER_NAME;
		Projects.IT_OWNER_DESIG = Projects.BUSINESS_OWNER_DESIG;
		Projects.IT_OWNER_IP_NO = Projects.BUSINESS_OWNER_IP_NO;
		Projects.IT_OWNER_MOBILE = Projects.BUSINESS_OWNER_MOBILE;
		Projects.IT_OWNER_EMAIL = Projects.BUSINESS_OWNER_EMAIL;

		// A scoped user is locked to their own department and section — copying the
		// business side must not move the project out of it.
		if (_deptLocked || _sectionLocked) return;

	// 	Projects.IT_OWNER_DEPT_NAME = Projects.BUSINESS_OWNER_DEPT_NAME;
	// 	Projects.IT_OWNER_SEC_NAME = Projects.BUSINESS_OWNER_SEC_NAME;
	// 	Projects.DEPT_ID = _mapDepartments.FirstOrDefault(d => d.DEPT_NAME == Projects.BUSINESS_OWNER_DEPT_NAME)?.DEPT_ID;
	// 	Projects.SECTION_ID = _mapCapitalSections.FirstOrDefault(s => s.NAME == Projects.BUSINESS_OWNER_SEC_NAME)?.SECTION_ID;
	// }

	// Business Ownership can be any department in the bank, but IT Ownership drives
		// DEPT_ID / SECTION_ID, so it may only be filled from a DIT department in scope.
		var bizDept = _itDepartments.FirstOrDefault(x =>
			string.Equals((x.DEPT_NAME ?? "").Trim(), (Projects.BUSINESS_OWNER_DEPT_NAME ?? "").Trim(),
						  StringComparison.OrdinalIgnoreCase));

		if (bizDept == null) return;   // not a DIT department - leave IT Ownership for the user

		Projects.DEPT_ID = bizDept.DEPT_ID;
		Projects.IT_OWNER_DEPT_NAME = bizDept.DEPT_NAME;

		var bizSec = _itSections.FirstOrDefault(x =>
			x.DEPT_ID == bizDept.DEPT_ID &&
			string.Equals((x.NAME ?? "").Trim(), (Projects.BUSINESS_OWNER_SEC_NAME ?? "").Trim(),
						  StringComparison.OrdinalIgnoreCase));

		Projects.SECTION_ID = bizSec?.SECTION_ID;
		Projects.IT_OWNER_SEC_NAME = bizSec?.NAME;
	}



