	[Parameter] public int BudgetFyId { get; set; }

	// --- Budget Management tab: one box for Capital, one for Revenue ---
	private List<FyItem> _budgetFys = new();
	private List<DeptItem> _pmAllDepts =  new();
	private List<SecItem> _pmAllSections = new();

	private int _capFyId, _revFyId;
	private decimal _capSpill, _capFresh, _revSpill, _revFresh;
	private bool _capSaved, _revSaved, _capRevise, _revRevise;

	private decimal CapTotal => _capSpill + _capFresh;
	private decimal RevTotal => _revSpill + _revFresh;
	private bool CapLocked => _capSaved && !_capRevise;
	private bool RevLocked => _revSaved && !_revRevise;

	// Dropdown values come from APP_LOOKUP - adding an option is one INSERT, no rebuild.
	private List<string> _phaseOptions = new();
	private List<string> _statusOptions = new();

	private bool IsEdit => Projects.ProjectId > 0;

	// Every tab except Basic Details stays disabled until the project actually exists.
	private bool BasicSaved => Projects.ProjectId > 0;

	// Save logic switches on the tab NAME, never the index.
	private List<string> VisibleTabs => new()
		{ "Basic", "Procurement", "Vendor", "Milestones", "Risk", "Resources", "Documents", "Budget" };

	private string CurrentTab =>
		(_activeIndex >= 0 && _activeIndex < VisibleTabs.Count) ? VisibleTabs[_activeIndex] : "Basic";

	private bool IsLastTab => _activeIndex >= VisibleTabs.Count - 1;

	private List<ProjectMilestone> MilestoneList = new();
	private List<ProjectIssue> IssueList = new();
	private List<ProjectResource> ResourceList = new();
	private List<Document> DocumentList = new();

	private ProjectMilestone? _editingMilestone = null;
	private ProjectIssue? _editingIssue = null;
	private ProjectResource? _editingResource = null;
	private Document? _editingDocument = null;
	private string? selectedFileName;
	private byte[]? tempFileContent;
	private string? tempContentType;


	private MudForm? _form;
	private bool _formIsValid, _isProcessing = false;
	private int _activeIndex = 0;
	private readonly string[] _tabTitles = { "Basic Info", "Procurement", "Milestones", "Issues", "Resources", "Provider", "Documents" };


	private void OnItAndBusinessSameChanged(string selectedValue)
	{
		// 1. Update the property in the model
		Projects.IS_IT_BUSINESS_SAME = selectedValue;

		// 2. If 'Yes' is selected, copy Business details into IT details
		if (selectedValue == "Y")
		{
			Projects.IT_OWNER_DEPT_NAME = Projects.BUSINESS_OWNER_DEPT_NAME;
			Projects.IT_OWNER_SEC_NAME = Projects.BUSINESS_OWNER_SEC_NAME;
			Projects.IT_OWNER_NAME = Projects.BUSINESS_OWNER_NAME;
			Projects.IT_OWNER_DESIG = Projects.BUSINESS_OWNER_DESIG;
			Projects.IT_OWNER_IP_NO = Projects.BUSINESS_OWNER_IP_NO;
			Projects.IT_OWNER_MOBILE = Projects.BUSINESS_OWNER_MOBILE;
			Projects.IT_OWNER_EMAIL = Projects.BUSINESS_OWNER_EMAIL;
		}

	}
	// ---- Project ↔ Department/Section mapping (Capital) ----
	private List<Department> _mapDepartments = new();
	private List<Section> _mapCapitalSections = new();

	// IT Ownership lists — the same data, narrowed to the signed-in user's own
	// department and section when they are not an administrator.
	private List<Department> _itDepartments = new();
	private List<Section> _itSections = new();
	// Office Type narrows the Business Ownership department list. It is a filter only -
	// nothing is stored, the chosen department already carries its office type.
	private string? _bizOfficeType;

	private List<string> _officeTypes =>
		_mapDepartments
			.Select(d => (d.OFFICE_TYPE ?? "").Trim())
			.Where(t => t.Length > 0)
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.OrderBy(t => t)
			.ToList();

	private IEnumerable<Department> _bizDepartments =>
		string.IsNullOrWhiteSpace(_bizOfficeType)
			? new List<Department>()
			: _mapDepartments.Where(d =>
				string.Equals((d.OFFICE_TYPE ?? "").Trim(), _bizOfficeType, StringComparison.OrdinalIgnoreCase));

	private void OnBizOfficeTypeChanged(string v)
	{
		_bizOfficeType = v;
		Projects.BUSINESS_OWNER_DEPT_NAME = null;
		Projects.BUSINESS_OWNER_SEC_NAME = null;
		if (Projects.IS_IT_BUSINESS_SAME == "Y") CopyBusinessToIt();
