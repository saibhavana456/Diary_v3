										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">PM Name</MudText>
											<MudTextField @bind-Value="Projects.SpPmName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">PM Designation</MudText>
											<MudTextField @bind-Value="Projects.SpPmDesig" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">PM Mobile</MudText>
											<MudTextField @bind-Value="Projects.SpPmMobile" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">PM Email</MudText>
											<MudTextField @bind-Value="Projects.SpPmEmail" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* Row 2: SPOC Details (4 in a row) *@
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">SPOC Name</MudText>
											<MudTextField @bind-Value="Projects.SpSpocName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">SPOC Designation</MudText>
											<MudTextField @bind-Value="Projects.SpSpocDesig" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">SPOC Mobile</MudText>
											<MudTextField @bind-Value="Projects.SpSpocMobile" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">SPOC Email</MudText>
											<MudTextField @bind-Value="Projects.SpSpocEmail" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
									</MudGrid>
								</MudPaper>
							</MudItem>

							@* --- SECTION 3: SLA & COMPLIANCE --- *@
							<MudItem xs="12" Class="mb-2">
								<MudPaper Elevation="1" Class="pa-2" Style="border-left: 6px solid #ff9800; background-color: #fff9f0;">
									<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;" Class="mb-1 d-block"><b>SLA & COMPLIANCE</b></MudText>

									<MudGrid Spacing="1">
										@* Row 1: SLA Execution, Effective From, Upto (3 in a row) *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">SLA Execution Date</MudText>
											<MudDatePicker @bind-Date="Projects.SlaExecutionDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Effective From</MudText>
											<MudDatePicker @bind-Date="Projects.SlaEffectiveFrom" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Effective Upto</MudText>
											<MudDatePicker @bind-Date="Projects.SlaEffectiveUpto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>

										@* Row 2: Renewal, Onboarding, Agreement (3 in a row) *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Renewal Date</MudText>
											<MudDatePicker @bind-Date="Projects.SlaRenewalDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Onboarding Date</MudText>
											<MudDatePicker @bind-Date="Projects.SpOnboardingDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Agreement Date</MudText>
											<MudDatePicker @bind-Date="Projects.SpAgreementDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>

										@* Row 3: Legal Vetting *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Legal Vetting</MudText>
											<MudSelect T="string" @bind-Value="Projects.SlaLegalVetting" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												<MudSelectItem Value="@("")"></MudSelectItem>
												<MudSelectItem Value="@("Y")">Yes</MudSelectItem>
												<MudSelectItem Value="@("N")">No</MudSelectItem>
											</MudSelect>
										</MudItem>
									</MudGrid>
								</MudPaper>
							</MudItem>

						</MudGrid>
					</MudTabPanel>

					@* --- TAB 4: MILESTONES (ULTRA-COMPACT ENTRY WITH SMART VALIDATION) --- *@
					<MudTabPanel Text="Milestones" Icon="@Icons.Material.Filled.Flag" Disabled="@(!BasicSaved)">
						<MudGrid Spacing="1" Class="mt-2">

							@* --- ENTRY FORM SECTION --- *@
							<MudItem xs="12">
								<MudPaper Elevation="1" Class="pa-2" Style="border-left: 6px solid #594ae2; background-color: #f9f9f9;">
									<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size: 0.75rem;" Class="mb-1 d-block">
										<b>NEW MILESTONE ENTRY</b> (Fill all fields ONLY if you wish to add a new milestone)
									</MudText>

									<MudGrid Spacing="1">
										@* ROW 1: Identity & Owner *@
										<MudItem xs="5">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Milestone Name</MudText>
											<MudTextField @bind-Value="Milestone.MilestoneName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Owner Name</MudText>
											<MudTextField @bind-Value="Milestone.OwnerName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Status</MudText>
											<MudSelect T="string" @bind-Value="Milestone.Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												@* --- THE DISABLED DEFAULT OPTION --- *@
												<MudSelectItem Value="@("")" Disabled="true">-- Select --</MudSelectItem>
												<MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
												<MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
												<MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
											</MudSelect>
										</MudItem>

										@* ROW 2: Timelines *@
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Planned Date</MudText>
											<MudDatePicker @bind-Date="Milestone.PlannedDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Baseline Date</MudText>
											<MudDatePicker @bind-Date="Milestone.BaselineDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Revised Date</MudText>
											<MudDatePicker @bind-Date="Milestone.RevisedDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="3">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Actual Date</MudText>
											<MudDatePicker @bind-Date="Milestone.ActualDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>

										@* ROW 3: Status & Compliance *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">SLA Met?</MudText>
											<MudSelect T="string" @bind-Value="Milestone.IsSlaMet" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												<MudSelectItem Value="@("")" Disabled="true">-- Select --</MudSelectItem>
												<MudSelectItem Value="@("Y")">Yes</MudSelectItem>
												<MudSelectItem Value="@("N")">No</MudSelectItem>
											</MudSelect>
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Penalty Applicable?</MudText>
											<MudSelect T="string" @bind-Value="Milestone.IsPenaltyApplicable" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												<MudSelectItem Value="@("")" Disabled="true">-- Select --</MudSelectItem>
												<MudSelectItem Value="@("Y")">Yes</MudSelectItem>
												<MudSelectItem Value="@("N")">No</MudSelectItem>
											</MudSelect>
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Description</MudText>
											<MudTextField @bind-Value="Milestone.MilestoneDescription" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* Action Buttons *@
										<MudItem xs="12" Class="d-flex justify-end mt-1 gap-2">
											<MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="ResetMilestoneForm" StartIcon="@Icons.Material.Filled.Refresh">
												Reset
											</MudButton>
											<MudButton Variant="Variant.Filled" Color="@(_editingMilestone == null ? Color.Primary : Color.Info)" Size="Size.Small" OnClick="AddMilestoneToList" StartIcon="@Icons.Material.Filled.Add">
												@(_editingMilestone == null ? "Add to List" : "Update Item")
											</MudButton>
										</MudItem>
									</MudGrid>
								</MudPaper>
							</MudItem>

							@* --- MILESTONE LIST GRID --- *@
							<MudItem xs="12" Class="mt-2">
								<MudText Typo="Typo.caption" Color="Color.Primary"><b>MILESTONES TO BE SAVED (@MilestoneList.Count)</b></MudText>
								<MudTable Items="@MilestoneList" Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-1" HorizontalScrollbar="true">
									<HeaderContent>
										<MudTh Class="grid-header">Name</MudTh>
										<MudTh Class="grid-header">Owner</MudTh>
										<MudTh Class="grid-header">Planned</MudTh>
										<MudTh Class="grid-header">Baseline</MudTh>
										<MudTh Class="grid-header">Revised</MudTh>
										<MudTh Class="grid-header">Actual</MudTh>
										<MudTh Class="grid-header">SLA</MudTh>
										<MudTh Class="grid-header">Penalty</MudTh>
										<MudTh Class="grid-header">Status</MudTh>
										<MudTh Class="grid-header">Description</MudTh>
										<MudTh Class="grid-header" Style="width:80px">Action</MudTh>
									</HeaderContent>
									<RowTemplate>
										<MudTd Class="grid-data">@context.MilestoneName</MudTd>
										<MudTd Class="grid-data">@(context.OwnerName ?? "-")</MudTd>
										<MudTd Class="grid-data">@context.PlannedDate?.ToString("dd-MMM-yyyy")</MudTd>
										<MudTd Class="grid-data">@context.BaselineDate?.ToString("dd-MMM-yyyy")</MudTd>
										<MudTd Class="grid-data">@(context.RevisedDate?.ToString("dd-MMM-yyyy") ?? "-")</MudTd>
										<MudTd Class="grid-data">@(context.ActualDate?.ToString("dd-MMM-yyyy") ?? "-")</MudTd>
										<MudTd Class="grid-data">
											<MudText Color="@(context.IsSlaMet == "Y" ? Color.Success : Color.Error)" Style="font-size:0.7rem; font-weight:bold;">
												@(context.IsSlaMet == "Y" ? "YES" : "NO")
											</MudText>
										</MudTd>
										<MudTd Class="grid-data">
											<MudText Color="@(context.IsPenaltyApplicable == "Y" ? Color.Error : Color.Default)" Style="font-size:0.7rem;">
												@(context.IsPenaltyApplicable == "Y" ? "YES" : "NO")
											</MudText>
										</MudTd>
										<MudTd Class="grid-data">
											<MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Style="font-size:0.65rem; height:18px;">
												@(context.Status ?? "Pending")
											</MudChip>
										</MudTd>
										<MudTd Class="grid-data">@context.MilestoneDescription</MudTd>
										<MudTd>
											<div class="d-flex">
												<MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadMilestoneForEdit(context))" Class="pa-1" />
												<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMilestoneFromList(context))" Class="pa-1" />
											</div>
										</MudTd>
									</RowTemplate>
								</MudTable>
							</MudItem>
						</MudGrid>
					</MudTabPanel>


					@* --- TAB 5: ISSUES (ULTRA-COMPACT ENTRY WITH SMART VALIDATION & RESET) --- *@
					<MudTabPanel Text="Risk" Icon="@Icons.Material.Filled.ReportProblem" Disabled="@(!BasicSaved)">
						<MudGrid Spacing="1" Class="mt-2">

							@* --- ISSUE ENTRY FORM --- *@
							<MudItem xs="12">
								<MudPaper Elevation="1" Class="pa-2" Style="border-left: 6px solid #f44336; background-color: #fffafa;">
									<MudText Typo="Typo.caption" Color="Color.Error" Style="font-size: 0.75rem;" Class="mb-1 d-block">
										<b>NEW ISSUE ENTRY</b> (All fields required only when adding to list)
									</MudText>

									<MudGrid Spacing="1">
										@* Row 1: Owner, Status & Impact *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Owner Name</MudText>
											<MudTextField @bind-Value="ProjectIssue.OwnerName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Status</MudText>
											<MudSelect T="string" @bind-Value="ProjectIssue.Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ultra-compact-input">
												<MudSelectItem Value="@("")" Disabled="true">Select</MudSelectItem>
												<MudSelectItem Value="@("Open")">Open</MudSelectItem>
												<MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
												<MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
												<MudSelectItem Value="@("Closed")">Closed</MudSelectItem>
											</MudSelect>
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Impact</MudText>
											<MudTextField @bind-Value="ProjectIssue.Impact" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* Row 2: Full-Width Description *@
										<MudItem xs="12">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Issue Description</MudText>
											<MudTextField @bind-Value="ProjectIssue.IssueDescription" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* Row 3: Root Cause & Resolution *@
										<MudItem xs="6">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Root Cause</MudText>
											<MudTextField @bind-Value="ProjectIssue.RootCause" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>
										<MudItem xs="6">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Resolution Summary</MudText>
											<MudTextField @bind-Value="ProjectIssue.ResolutionSummary" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" />
										</MudItem>

										@* Row 4: Dates *@
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Date Raised</MudText>
											<MudDatePicker @bind-Date="ProjectIssue.DateRaised" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Target Resolution</MudText>
											<MudDatePicker @bind-Date="ProjectIssue.TargetResolutionDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>
										<MudItem xs="4">
											<MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: gray;">Actual Resolution</MudText>
											<MudDatePicker @bind-Date="ProjectIssue.ActualResolutionDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ultra-compact-input" DateFormat="dd-MMM-yyyy" />
										</MudItem>

										@* Action Buttons *@
										<MudItem xs="12" Class="d-flex justify-end mt-1 gap-2">
											<MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="ResetIssueForm" StartIcon="@Icons.Material.Filled.Refresh">
												Reset
											</MudButton>
