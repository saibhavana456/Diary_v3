	private bool _deptLocked, _sectionLocked;

	private IEnumerable<Section> _itSectionsForDept =>
		Projects.DEPT_ID == null ? new List<Section>()
			: _itSections.Where(s => s.DEPT_ID == Projects.DEPT_ID);
	private IEnumerable<Section> _mapSectionsForDept =>
		Projects.DEPT_ID == null ? new List<Section>()
			: _mapCapitalSections.Where(s => s.DEPT_ID == Projects.DEPT_ID);

	private void OnItDepartmentChanged(long? deptId)
	{
		Projects.DEPT_ID = deptId;
		var d = _mapDepartments.FirstOrDefault(x => x.DEPT_ID == deptId);
		Projects.IT_OWNER_DEPT_NAME = d?.DEPT_NAME;   // keep the text in sync
		Projects.SECTION_ID = null;                    // reset section when department changes
		Projects.IT_OWNER_SEC_NAME = null;
	}

	private void OnItSectionChanged(long? sectionId)
	{
		Projects.SECTION_ID = sectionId;
		var s = _mapCapitalSections.FirstOrDefault(x => x.SECTION_ID == sectionId);
		Projects.IT_OWNER_SEC_NAME = s?.NAME;          // keep the text in sync
	}

	protected override async Task OnInitializedAsync()
	{
		// If we are editing an existing project, load its associated data
		// Mapping dropdowns: active departments + active CAPITAL sections
		// Budget: load financial years, default to the current one
		// Budget: load financial years, default to the current one
		_budgetFys = await BudgetSvc.GetFinancialYearsAsync();
		var currentFy = BudgetFyId > 0 ? BudgetFyId : await BudgetSvc.GetCurrentFyIdAsync();
		if (currentFy == 0 && _budgetFys.Count > 0) currentFy = _budgetFys[0].FyId;
		_capFyId = _revFyId = currentFy;

		await LoadBudgetsAsync();

		_mapDepartments = await AdminService.GetDepartmentsAsync(false);
		_mapCapitalSections = (await AdminService.GetSectionsAsync(false)).ToList();

		// _phaseOptions = await BudgetSvc.GetLookupValuesAsync("PROJECT_PHASE");
		// On Edit, show the office type of the department already stored on the project.
		_bizOfficeType = _mapDepartments
			.FirstOrDefault(d => d.DEPT_NAME == Projects.BUSINESS_OWNER_DEPT_NAME)?.OFFICE_TYPE?.Trim();

		_phaseOptions = await BudgetSvc.GetLookupValuesAsync("PROJECT_PHASE");
		_statusOptions = await BudgetSvc.GetLookupValuesAsync("OVERALL_STATUS");

		// IT Ownership starts from the same lists, then narrows to the user's scope.
		_itDepartments = _mapDepartments.ToList();
		_itSections = _mapCapitalSections.ToList();

		await Session.LoadAsync();
		var me = Session.User;
		if (me is not null && !me.IsAdmin)
		{
			if (me.DeptIds.Count > 0)
				_itDepartments = _itDepartments.Where(d => me.DeptIds.Contains(d.DEPT_ID)).ToList();

			// if (me.SectionIds.Count > 0)
			// 	_itSections = _itSections.Where(s => me.SectionIds.Contains(s.SECTION_ID)).ToList();
			// 	_mapDepartments = _itDepartments.ToList();
			// 	_mapCapitalSections = _itSections.ToList();

			if (Projects.ProjectId == 0)   // new project only — never re-point an existing one
			{
				if (_itDepartments.Count == 1)
				{
					Projects.DEPT_ID = _itDepartments[0].DEPT_ID;
					Projects.IT_OWNER_DEPT_NAME = _itDepartments[0].DEPT_NAME;
					_deptLocked = true;
				}
				if (_itSections.Count == 1)
				{
					Projects.SECTION_ID = _itSections[0].SECTION_ID;
					Projects.IT_OWNER_SEC_NAME = _itSections[0].NAME;
					_sectionLocked = true;
				}
			}
		}


		// Back-fill IDs for older projects that only stored the section NAME
		if (Projects.SECTION_ID == null && !string.IsNullOrWhiteSpace(Projects.IT_OWNER_SEC_NAME))
		{
			var match = _mapCapitalSections.FirstOrDefault(s => s.NAME == Projects.IT_OWNER_SEC_NAME);
			if (match != null) { Projects.SECTION_ID = match.SECTION_ID; Projects.DEPT_ID = match.DEPT_ID; }
		}
		else if (Projects.DEPT_ID == null && !string.IsNullOrWhiteSpace(Projects.IT_OWNER_DEPT_NAME))
		{
			var dep = _mapDepartments.FirstOrDefault(d => d.DEPT_NAME == Projects.IT_OWNER_DEPT_NAME);
			if (dep != null) Projects.DEPT_ID = dep.DEPT_ID;
		}

		if (string.IsNullOrEmpty(Milestone.Status))
		{
			Milestone.Status = "";
			Milestone.IsSlaMet = "";
			Milestone.IsPenaltyApplicable = "";
		}

		if (!string.IsNullOrEmpty(Projects.ProjectCode))
		{
			MilestoneList = await ProjectService.GetMilestonesByProjectAsync(Projects.ProjectCode);
			IssueList = await ProjectService.GetIssuesByProjectAsync(Projects.ProjectCode);
			ResourceList = await ProjectService.GetResourcesByProjectAsync(Projects.ProjectCode);
			DocumentList = await ProjectService.GetDocumentsByProjectAsync(Projects.ProjectCode);
		}
	}

	// Re-reads the allotment whenever the key changes, so a second Revenue item
	// under the same section never overwrites the first one's budget with zero.
	// Both budgets are keyed on the project. Re-read whenever the year changes.
	private async Task LoadBudgetsAsync()
	{
		try
		{
			await LoadBudgetCoreAsync();
		}
		catch (Exception ex)
		{
			Snackbar.Add("could not load budget deatils: " + ex.Message, Severity.Error);
		}
	}

	private async Task LoadBudgetCoreAsync()
	{
		if (Projects.ProjectId <= 0) return;

		var cap = await BudgetSvc.GetAllocationAsync("CAPITAL", Projects.ProjectId, _capFyId);
		_capSpill = cap?.Spillover ?? 0m;
		_capFresh = cap?.Fresh ?? 0m;
		_capSaved = cap != null;
		_capRevise = false;

		var rev = await BudgetSvc.GetAllocationAsync("REVENUE", Projects.ProjectId, _revFyId);
		_revSpill = rev?.Spillover ?? 0m;
		_revFresh = rev?.Fresh ?? 0m;
		_revSaved = rev != null;
		_revRevise = false;
	}

	private async Task OnCapFyChanged(int id) { _capFyId = id; await LoadBudgetsAsync(); }
	private async Task OnRevFyChanged(int id) { _revFyId = id; await LoadBudgetsAsync(); }

	private async Task SaveCapitalBudget() => await SaveBudgetBox("CAPITAL");
	private async Task SaveRevenueBudget() => await SaveBudgetBox("REVENUE");

	private async Task SaveBudgetBox(string type)
	{
		try
		{
			await SaveBudgetBoxCore(type);
		}
		catch (Exception ex)
		{
			Snackbar.Add("could not save the budget: " + ex.Message, Severity.Error);
			StateHasChanged();
		}
	}

	private async Task SaveBudgetBoxCore(string type)
	{
		bool isCapital = type == "CAPITAL";
		int fy = isCapital ? _capFyId : _revFyId;
		decimal spill = isCapital ? _capSpill : _revSpill;
		decimal fresh = isCapital ? _capFresh : _revFresh;

		if (!await ConfirmBudget(type, fy, spill, fresh)) return;

		_isProcessing = true;
		try
		{
			// SaveAllocationAsync also refuses a budget below what is already utilised.
			var err = await BudgetSvc.SaveAllocationAsync(type, Projects.ProjectId, fy, spill, fresh,
															Projects.IT_OWNER_NAME ?? "SYSTEM");
			if (err != null) { Snackbar.Add(err, Severity.Error); return; }

			if (isCapital) { _capSaved = true; _capRevise = false; }
			else { _revSaved = true; _revRevise = false; }

			Snackbar.Add($"{type} budget saved: {(spill + fresh):N2} Cr", Severity.Success);
		}
		finally { _isProcessing = false; }
	}



	private async Task HandleSaveAndNext()
	{
		if (_form == null) return;
		await _form.Validate();
		if (!_formIsValid) return;

		_isProcessing = true;
		bool stepSuccess = false;
		var tab = CurrentTab;

		try
		{
			// Basic / Procurement / Vendor all write to PROJECTS_MASTER
			// Basic / Procurement / Vendor all write to PROJECTS_MASTER
			if (tab is "Basic" or "Procurement" or "Vendor")
			{
				if (tab == "Basic")
				{
					// The IT Ownership dropdowns now write DEPT_ID / SECTION_ID directly,
					// so here we validate them and keep the text columns in step with the ids.
					if (Projects.DEPT_ID == null || Projects.SECTION_ID == null)
					{
						Snackbar.Add("Please select the IT Ownership Department and Section before saving.", Severity.Warning);
						_isProcessing = false;
						return;
					}

					Projects.IT_OWNER_DEPT_NAME =
						_mapDepartments.FirstOrDefault(d => d.DEPT_ID == Projects.DEPT_ID)?.DEPT_NAME
						?? Projects.IT_OWNER_DEPT_NAME;

					Projects.IT_OWNER_SEC_NAME =
						_mapCapitalSections.FirstOrDefault(s => s.SECTION_ID == Projects.SECTION_ID)?.NAME
						?? Projects.IT_OWNER_SEC_NAME;

					// A team leader / member may only create or edit inside their own section.
					var scoped = Session.User;
					if (scoped is not null && !scoped.IsAdmin && scoped.SectionIds.Count > 0
						&& !scoped.SectionIds.Contains(Projects.SECTION_ID.Value))
					{
						Snackbar.Add("You can only create or edit projects inside your own section.", Severity.Warning);
						_isProcessing = false;
						return;
					}

					var dupCode = await BudgetSvc.FindDuplicateNameAsync(Projects.ProjectName ?? "", Projects.ProjectId);
					if (dupCode != null)
					{
						Snackbar.Add($"A project named \"{Projects.ProjectName}\" already exists ({dupCode}). Please use a different name.",
									 Severity.Error);
						_isProcessing = false;
						return;
					}
				}

				var result = await ProjectService.SaveProjectGeneralAsync(Projects);
				if (result != null)
				{
					Projects = result; // Captures Oracle-generated ProjectCode/ID
					stepSuccess = true;

					// The project now has an Id, so the Budget Management tab can read its allocations.
					if (tab == "Basic") await LoadBudgetsAsync();
				}
			}
			else if (tab == "Milestones")
			{
				stepSuccess = true;

				if (!string.IsNullOrWhiteSpace(Milestone.MilestoneName))
				{
					Milestone.ProjectCode = Projects.ProjectCode;
					var currentRes = await ProjectService.SaveMilestoneAsync(Milestone);
					if (!currentRes) stepSuccess = false;
				}

				foreach (var m in MilestoneList)
				{
					m.ProjectCode = Projects.ProjectCode;
					var res = await ProjectService.SaveMilestoneAsync(m);
					if (!res) stepSuccess = false;
				}

				if (stepSuccess)
					MilestoneList = await ProjectService.GetMilestoneListByProjectAsync(Projects.ProjectCode);
			}
			else if (tab == "Risk")
			{
				if (!string.IsNullOrWhiteSpace(ProjectIssue.IssueDescription))
				{
					ProjectIssue.ProjectCode = Projects.ProjectCode;
					await ProjectService.SaveIssueAsync(ProjectIssue);
				}

				stepSuccess = true;
				foreach (var i in IssueList)
				{
					i.ProjectCode = Projects.ProjectCode;
					var res = await ProjectService.SaveIssueAsync(i);
					if (!res) stepSuccess = false;
				}

				if (stepSuccess)
					IssueList = await ProjectService.GetIssueListByProjectAsync(Projects.ProjectCode);
			}
			else if (tab == "Resources")
			{
				if (!string.IsNullOrWhiteSpace(ProjectResource.ResourceName))
				{
					ProjectResource.ProjectCode = Projects.ProjectCode;
					ProjectResource.ProjectId = Projects.ProjectId;
					await ProjectService.SaveResourceAsync(ProjectResource);
				}

				stepSuccess = true;
				foreach (var r in ResourceList)
				{
					r.ProjectCode = Projects.ProjectCode;
					r.ProjectId = Projects.ProjectId;
					if (!string.IsNullOrEmpty(r.ResourceType)) r.ResourceType = r.ResourceType.ToUpper();
					var res = await ProjectService.SaveResourceAsync(r);
					if (!res) stepSuccess = false;
				}

				if (stepSuccess)
					ResourceList = await ProjectService.GetResourceListByProjectAsync(Projects.ProjectCode);
			}
			else if (tab == "Documents")
			{
				if (!string.IsNullOrWhiteSpace(Document.DocName))
				{
					Document.ProjectCode = Projects.ProjectCode;
					await ProjectService.SaveDocumentAsync(Document);
				}

				stepSuccess = true;
				foreach (var d in DocumentList)
				{
					d.ProjectCode = Projects.ProjectCode;
					var res = await ProjectService.SaveDocumentAsync(d);
					if (!res) stepSuccess = false;
				}

			}
			else if (tab == "Budget")
			{
				// The two boxes save themselves. This button only finishes.
				stepSuccess = true;
				MudDialog.Close(DialogResult.Ok(true));
			}

			// Move to the next VISIBLE tab if the save succeeded

			// Move to the next VISIBLE tab if the save succeeded
			if (stepSuccess && !IsLastTab)
			{
				_activeIndex++;
				Milestone = new ProjectMilestone { Status = "Pending" };
				ProjectIssue = new ProjectIssue { Status = "Open", DateRaised = DateTime.Now };
				ProjectResource = new ProjectResource();
				Document = new Document();

				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Error during save: {ex.Message}", Severity.Error);
		}
		finally
		{
			_isProcessing = false;
		}
	}

	private async Task<bool> ConfirmBudget(string type, int fyId, decimal spill, decimal fresh)
	{
		var fyLabel = _budgetFys.FirstOrDefault(f => f.FyId == fyId)?.FyLabel ?? "-";

		var parameters = new DialogParameters
			{
				["BudgetType"] = type,
				["ProjectName"] = string.IsNullOrWhiteSpace(Projects.ProjectName) ? "-" : Projects.ProjectName,
				["FyLabel"] = fyLabel,
				["Spillover"] = spill,
				["Fresh"] = fresh
			};

		var options = new DialogOptions
			{
				MaxWidth = MaxWidth.ExtraSmall,
				FullWidth = true,
				CloseButton = true,
				BackdropClick = false
			};

		var dlg = await DialogService.ShowAsync<BudgetConfirmDialog>("", parameters, options);
		var result = await dlg.Result;
		return result is not null && !result.Canceled;
	}




	// MILESTONE LIST
	private void AddMilestoneToList()
	{
		// Check if the form is empty. If it's completely empty, we do nothing.
		if (string.IsNullOrWhiteSpace(Milestone.MilestoneName) &&
			string.IsNullOrWhiteSpace(Milestone.OwnerName) &&
			Milestone.PlannedDate == null)
		{
			Snackbar.Add("Please enter milestone details before adding.", Severity.Warning);
			return;
		}

		// SMART VALIDATION: If the user started filling it, ALL fields must be present.
		if (string.IsNullOrWhiteSpace(Milestone.MilestoneName) ||
			string.IsNullOrWhiteSpace(Milestone.OwnerName) ||
			string.IsNullOrWhiteSpace(Milestone.Status) ||
			string.IsNullOrWhiteSpace(Milestone.IsSlaMet) ||
			string.IsNullOrWhiteSpace(Milestone.IsPenaltyApplicable) ||
			string.IsNullOrWhiteSpace(Milestone.MilestoneDescription) ||
			Milestone.PlannedDate == null ||
			Milestone.BaselineDate == null ||
			Milestone.RevisedDate == null ||
			Milestone.ActualDate == null)
		{
			Snackbar.Add("To add/update a milestone, all fields are mandatory.", Severity.Error);
			return;
		}

		if (_editingMilestone != null)
		{
			// UPDATE MODE: Update the existing reference in the list
			_editingMilestone.MilestoneName = Milestone.MilestoneName;
			_editingMilestone.OwnerName = Milestone.OwnerName;
			_editingMilestone.PlannedDate = Milestone.PlannedDate;
			_editingMilestone.BaselineDate = Milestone.BaselineDate;
			_editingMilestone.RevisedDate = Milestone.RevisedDate;
			_editingMilestone.ActualDate = Milestone.ActualDate;
			_editingMilestone.Status = Milestone.Status;
			_editingMilestone.IsSlaMet = Milestone.IsSlaMet;
			_editingMilestone.IsPenaltyApplicable = Milestone.IsPenaltyApplicable;
			_editingMilestone.MilestoneDescription = Milestone.MilestoneDescription;

			_editingMilestone = null;
			Snackbar.Add("Milestone updated successfully.", Severity.Success);
		}
		else
		{
			// ADD MODE: Add a new one
			MilestoneList.Add(new ProjectMilestone
			{
				MilestoneName = Milestone.MilestoneName,
				OwnerName = Milestone.OwnerName,
				PlannedDate = Milestone.PlannedDate,
				BaselineDate = Milestone.BaselineDate,
				RevisedDate = Milestone.RevisedDate,
				ActualDate = Milestone.ActualDate,
				Status = Milestone.Status,
				IsSlaMet = Milestone.IsSlaMet,
				IsPenaltyApplicable = Milestone.IsPenaltyApplicable,
				MilestoneDescription = Milestone.MilestoneDescription,
				ProjectCode = Projects.ProjectCode
			});
			Snackbar.Add("Milestone added to list.", Severity.Success);
		}

		ResetMilestoneForm();
	}

	// Ensure there is ONLY ONE version of this method
	private void LoadMilestoneForEdit(ProjectMilestone item)
	{
		_editingMilestone = item; // Store the reference

		// Copy data to form
		Milestone = new ProjectMilestone
		{
			MilestoneName = item.MilestoneName,
			OwnerName = item.OwnerName,
			PlannedDate = item.PlannedDate,
			BaselineDate = item.BaselineDate,
			RevisedDate = item.RevisedDate,
			ActualDate = item.ActualDate,
			Status = item.Status,
			IsSlaMet = item.IsSlaMet,
			IsPenaltyApplicable = item.IsPenaltyApplicable,
			MilestoneDescription = item.MilestoneDescription
		};
		StateHasChanged();
	}

	private void ResetMilestoneForm()
	{
		_editingMilestone = null;

		Milestone = new ProjectMilestone
		{
			Status = "",
			IsSlaMet = "",
			IsPenaltyApplicable = ""
		};
		StateHasChanged();
	}

	private void RemoveMilestoneFromList(ProjectMilestone item)
	{
		MilestoneList.Remove(item);
	}



	//ISSUE LIST
	private void AddIssueToList()
	{
		// 1. Check if form is totally empty
		if (string.IsNullOrWhiteSpace(ProjectIssue.IssueDescription) &&
			string.IsNullOrWhiteSpace(ProjectIssue.OwnerName) &&
			ProjectIssue.DateRaised == null)
		{
			Snackbar.Add("Please enter issue details before adding.", Severity.Warning);
			return;
		}

		// 2. STRICT VALIDATION: If user started filling, all fields are mandatory
		if (string.IsNullOrWhiteSpace(ProjectIssue.IssueDescription) ||
			string.IsNullOrWhiteSpace(ProjectIssue.OwnerName) ||
			string.IsNullOrWhiteSpace(ProjectIssue.Status) ||
			string.IsNullOrWhiteSpace(ProjectIssue.Impact) ||
			string.IsNullOrWhiteSpace(ProjectIssue.RootCause) ||
			string.IsNullOrWhiteSpace(ProjectIssue.ResolutionSummary) ||
			ProjectIssue.DateRaised == null ||
			ProjectIssue.TargetResolutionDate == null ||
			ProjectIssue.ActualResolutionDate == null)
		{
			Snackbar.Add("All fields are mandatory to add an issue to the list.", Severity.Error);
			return;
		}

		if (_editingIssue != null)
		{
			// UPDATE MODE: Update reference in list
