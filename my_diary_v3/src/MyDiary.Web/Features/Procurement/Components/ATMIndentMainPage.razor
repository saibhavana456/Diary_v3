@page "/ATMIndent"
@using System.Net.Http.Json
@using System.Text.Json
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@inject HttpClient Http
@inject NavigationManager Nav
@using System.Text.Json.Serialization;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components.Web
@using MyDiary.Web.Features.Procurement.Models.VIEWS
@using Procurement.Interfaces
@using Procurement.Models.TABLES
@using static Procurement.Components.ATMIndentEditPage
@using static Procurement.Models.DTO.MiscClasses

@using Microsoft.AspNetCore.Components.Authorization
@inject ProtectedSessionStorage SessionStore
@inject IATMIndentService _ATMIndentService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage ProtectedSessionStorage
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

<PageTitle>Indent Requests</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Indent Management</h2>
            <p class="text-muted small mb-0">Track procurement requests and approval workflows</p>
        </div>

        @if (isMaker)
        {
            <button class="btn btn-primary px-4 shadow-sm d-flex align-items-center gap-2" @onclick="OpenAdd">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Create New Indent</span>
            </button>
        }
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="bi bi-filter-left fs-5"></i>
                        </span>
                        <input class="form-control border-start-0 ps-0"
                        placeholder="Filter by Request ID or Justification..."
                        @bind="filterText" @bind:event="oninput" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-@statusKind alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi @(statusKind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3 text-muted small uppercase">S.No</th>
                        <th class="py-3 text-muted small uppercase">Request Details</th>
                        <th class="py-3 text-muted small uppercase">Justification</th>
                        <th class="py-3 text-muted small uppercase">Current Status</th>
                        <th class="py-3 text-muted small uppercase">Active Approver</th>
                        <th class="text-end pe-4 py-3 text-muted small uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-grow text-primary spinner-grow-sm me-2"></div>
                                <span class="text-muted">Loading indents...</span>
                            </td>
                        </tr>
                    }
                    else if (!PagedItems.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-2 d-block mb-2"></i>
                                No matching requests found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = (currentPage - 1) * pageSize + 1;
                        @foreach (var it in PagedItems)
                        {
                            <tr>
                                <td class="ps-4 text-muted font-monospace">@index</td>
                                <td>
                                    <div class="fw-bold text-primary">@it.RequestCode</div>
                                    <div class="text-muted extra-small">Created: @it.RaisedOn?.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;" title="@it.Justification">
                                        @it.Justification
                                    </div>
                                </td>
                                <td>
                                    @GetStatusBadge(it)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm-text me-2">@GetApproverInitial(it)</div>
                                        <div>
                                            <div class="fw-bold small">@GetActiveApproverName(it)</div>
                                            <div class="text-muted extra-small">@GetLatestRemarks(it)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <button class="btn btn-success btn-sm px-3" @onclick="() => OpenEdit(it.RequestCode!)">
                                            <i class="bi bi-check-square-fill"></i> @(isMaker ? "View" : "Action")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3 border-top">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <span class="text-muted small">
                    Showing <b>@((currentPage - 1) * pageSize + 1)</b> to <b>@Math.Min(currentPage * pageSize, filtered.Count)</b> of @filtered.Count indents
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => MovePage(-1)"><i class="bi bi-chevron-left"></i></button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var p = i;
                            <li class="page-item @(currentPage == p ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => MovePage(1)"><i class="bi bi-chevron-right"></i></button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-trash3 text-danger display-4 mb-3"></i>
                    <h5 class="fw-bold">Delete Indent?</h5>
                    <p class="text-muted small">Are you sure you want to remove request <b>@deleteTarget?.RequestCode</b>?</p>
                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-danger" @onclick="DeleteAsync">Delete Now</button>
                        <button class="btn btn-light" @onclick="CloseDeleteModal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

