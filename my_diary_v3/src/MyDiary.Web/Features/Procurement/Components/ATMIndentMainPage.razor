    private string GetActiveApproverName(ATMRequestMaster it) =>
        !string.IsNullOrWhiteSpace(it.CoApproverName) ? it.CoApproverName :
        !string.IsNullOrWhiteSpace(it.CoCheckerName) ? it.CoCheckerName :
        // !string.IsNullOrWhiteSpace(it.ZoneApproverName) ? it.ZoneApproverName :
        !string.IsNullOrWhiteSpace(it.RegionApproverName) ? it.RegionApproverName :
        !string.IsNullOrWhiteSpace(it.RegionCheckerName) ? it.RegionCheckerName :
        !string.IsNullOrWhiteSpace(it.CheckerApproverName) ? it.CheckerApproverName : "N/A";

    private string GetApproverInitial(ATMRequestMaster it)
    {
        var name = GetActiveApproverName(it);
        return name == "N/A" ? "?" : name[0].ToString().ToUpper();
    }

    private string GetLatestRemarks(ATMRequestMaster it) =>
     !string.IsNullOrWhiteSpace(it.CoCheckerRemarks) ? it.CoCheckerRemarks :
        !string.IsNullOrWhiteSpace(it.CoRemarks) ? it.CoRemarks :
    !string.IsNullOrWhiteSpace(it.RegionApproverRemarks) ? it.RegionApproverRemarks :
        !string.IsNullOrWhiteSpace(it.RegionRemarks) ? it.RegionRemarks :
        !string.IsNullOrWhiteSpace(it.BranchRemarks) ? it.BranchRemarks : "No remarks";

    private void OpenAdd() => Nav.NavigateTo("ATMIndent/new");
    private void OpenEdit(string id) => Nav.NavigateTo($"ATMIndent/{Uri.EscapeDataString(id)}");
    private void OpenDelete(ATMRequestMaster it) { deleteTarget = it; showDeleteModal = true; }
    private void CloseDeleteModal() => showDeleteModal = false;

    private async Task DeleteAsync()
    {
        if (deleteTarget is null) return;
        try
        {
            var pfResult = await SessionStore.GetAsync<string>("UserId");
            var deletedBy = pfResult.Success ? pfResult.Value : null;

            if (string.IsNullOrWhiteSpace(deleteTarget.RequestCode) || string.IsNullOrWhiteSpace(deletedBy)) return;

            var dto = new DeleteRequestDto { RequestCode = deleteTarget.RequestCode, DeletedBy = deletedBy };
            var resultMessage = await _ATMIndentService.DeleteATMIndentMaster(dto);

            if (resultMessage.Contains("Successfully", StringComparison.OrdinalIgnoreCase))
            {
                ShowStatus(resultMessage, "success");
                showDeleteModal = false;
                var sessionResult = await ProtectedSessionStorage.GetAsync<string>("ROLE");
                if (sessionResult.Success)
                {
                    userRole = sessionResult.Value ?? "";
                }
                await LoadAsync(userRole);
            }
            else ShowStatus(resultMessage, "danger");
        }
        catch (Exception ex) { AppLogger.LogError(ex, "ATMIndentMainPage: submit failed"); ShowStatus(UserFacingError.Generic, "danger"); }

    }

    private async Task PersistUserToSessionAsync(UserMasterView user, string? userId)
    {

        try
        {
            await SessionStore.SetAsync("UserId", userId);
            await SessionStore.SetAsync("NAME", user.NAME);
            await SessionStore.SetAsync("JOB_CODE", user.JOB_CODE);
            await SessionStore.SetAsync("JOB_DESC", user.JOB_DESC);
            await SessionStore.SetAsync("LOCATION", user.LOCATION);
            await SessionStore.SetAsync("LOCATION_DESC", user.LOCATION_DESC);
            await SessionStore.SetAsync("REGION_CODE", user.REGION_CODE);
            await SessionStore.SetAsync("REGION_NAME", user.REGION_NAME);
            await SessionStore.SetAsync("FINACLE_ID", user.FINACLE_ID);
            await SessionStore.SetAsync("ZONE_CODE", user.ZONE_CODE);
            await SessionStore.SetAsync("ZONE_NAME", user.ZONE_NAME);
            await SessionStore.SetAsync("DEPT_ID", user.DEPT_ID);
            await SessionStore.SetAsync("DEPT_DESC", user.DEPT_DESC);
            await SessionStore.SetAsync("CONTACT_NO", user.CONTACT_NO);
            await SessionStore.SetAsync("EMAIL_ID", user.EMAIL_ID);
            await SessionStore.SetAsync("OFFICE_TYPE", user.OFFICE_TYPE);
            await SessionStore.SetAsync("ROLE", user.ROLE);
            await SessionStore.SetAsync("ACCESS_LEVEL", user.ACCESS_LEVEL);
            await SessionStore.SetAsync("BRANCH_NAME", user.BRANCH_NAME);
            await SessionStore.SetAsync("REMARKS", user.REMARKS);
            await SessionStore.SetAsync("REPORTING_OFFICER_PF_NO", user.REPORTING_OFFICER_PF_NO);
            await SessionStore.SetAsync("REPORTING_OFFICER_NAME", user.REPORTING_OFFICER_NAME);

            var eff = user.EFFECTIVE_DATE?.ToString("O");
            await SessionStore.SetAsync("EFFECTIVE_DATE", eff);

        }
        catch
        {
            // Ignore session write failures
        }
    }

    private void ShowStatus(string message, string kind) { statusMessage = message; statusKind = kind; }
}