    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // ✅ Get EMPLID
        string empId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        // string empId = "766997";

        item = await _ATMIndentService.GetUserDetailsViewByUserId(empId);

        if (item != null)
        {
            await PersistUserToSessionAsync(item, empId);
        }

        var sessionResult = await ProtectedSessionStorage.GetAsync<string>("ROLE");
        if (sessionResult.Success)
        {
            userRole = sessionResult.Value ?? "";
            isMaker = userRole == "MAKER";
        }

        await LoadAsync(userRole);
        isLoading = false;
    }

    private async Task LoadAsync(string userRole)
    {
        
        loadError = null;
        string code = null;
        try
        {
            if(!string.IsNullOrWhiteSpace(userRole))
            {

                if (userRole.Contains("ROMAKER") || userRole.Contains("ROAPPROVER"))
                {
                    var jobRes = await ProtectedSessionStorage.GetAsync<string>("REGION_CODE");
                    code = jobRes.Success ? jobRes.Value : null;
                }
                else if (userRole.Contains("ZOMAKER") || userRole.Contains("ZOAPPROVER"))
                {
                    var jobRes = await ProtectedSessionStorage.GetAsync<string>("ZONE_CODE");
                    code = jobRes.Success ? jobRes.Value : null;
                }
                // else if (userRole.Contains("COMAKER") || userRole.Contains("COAPPROVER"))
                // {
                //     code = "100000";
                // }
                else if (userRole.Contains("MAKER") || userRole.Contains("CHECKER"))
                {
                    var jobRes = await ProtectedSessionStorage.GetAsync<string>("LOCATION");
                    code = jobRes.Success ? jobRes.Value : null;
                }
                if (!string.IsNullOrWhiteSpace(code))
                {
                    var data = await _ATMIndentService.GetAllATMIndentData(code, userRole);
                    items = data ?? new();
                }

            }
            else
            {

                items = new();
            }

        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "ATMIndentMainPage: failed to load data");
            loadError = UserFacingError.Generic;
        }
    }


    private void MovePage(int step) => currentPage = Math.Clamp(currentPage + step, 1, TotalPages);
    private void GoToPage(int p) => currentPage = p;
    private string GetItemStatusString(ATMRequestMaster it)
    {

        if (!string.IsNullOrWhiteSpace(it.CoRecommendation))
            return it.CoRecommendation == "Reject" ? ZO_APP_REJ : it.CoRecommendation == "Return to Requestor" ? ZO_APP_RET : ZO_APP_APP;

        if (!string.IsNullOrWhiteSpace(it.CoCheckerRecommendation))
            return it.CoCheckerRecommendation == "Reject" ? ZO_MAKER_REJ : it.CoCheckerRecommendation == "Return to Requestor" ? ZO_MAKER_RET : ZO_MAKER_APP;

        if (!string.IsNullOrWhiteSpace(it.RegionApproverRecommendation))
            return it.RegionApproverRecommendation == "Reject" ? RO_APP_REJ : it.RegionApproverRecommendation == "Return to Requestor" ? RO_APP_RET : RO_APP_APP;

        if (!string.IsNullOrWhiteSpace(it.RegionRecommendation))
            return it.RegionRecommendation == "Reject" ? RO_MAKER_REJ : it.RegionRecommendation == "Return to Requestor" ? RO_MAKER_RET : RO_MAKER_APP;

        if (!string.IsNullOrWhiteSpace(it.BranchRecommendation))
            return it.BranchRecommendation == "Reject" ? BRANCH_REJ : it.BranchRecommendation == "Return to Requestor" ? BRANCH_RET : BRANCH_APP;

        return BRANCH_SUB;
    }
    private List<ATMRequestMaster> filtered => items
    .Where(it =>
    {
        // 1. Get current status and cost check
        string status = GetItemStatusString(it);
        bool isHighValue = it.TotalProcurementCost >= RO_AUTHORITY_LIMIT;
        if (!isHighValue)
        {
            isHighValue = false;
        }

        // 2. Role Based Filtering with Value Logic
        bool isVisible = userRole switch
        {
            "MAKER" => true, // Sees everything

            "CHECKER" => status == BRANCH_SUB || status.Contains("Branch"),

            "ROMAKER" => status == BRANCH_APP || status.Contains("Region Maker"),

            "ROAPPROVER" => !isHighValue && (status == RO_MAKER_APP || status.Contains("Region Approved") || status.Contains("Region Rejected") || status.Contains("Region Returned")),

            "ZOMAKER" => (isHighValue && status == RO_MAKER_APP) || status.Contains("ZO Maker"),

            "ZOAPPROVER" => status == ZO_MAKER_APP || status.Contains("ZO Approved") || status.Contains("ZO Rejected") || status.Contains("ZO Returned"),

            // "COMAKER" => (isHighValue && status == RO_MAKER_APP) || status.Contains("CO Maker"),

            // "COAPPROVER" => status == ZO_MAKER_APP || status.Contains("CO Approved") || status.Contains("CO Rejected") || status.Contains("CO Returned"),

            _ => false
        };
        
        

        if (!isVisible)
        { 
            return false;
        }

        // 3. Search Text Filtering
        return string.IsNullOrWhiteSpace(filterText) ||
               (it.RequestCode ?? "").Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
               (it.Justification ?? "").Contains(filterText, StringComparison.OrdinalIgnoreCase);
    })
    .ToList();
