	private void UpdateCostBeforeTax(int? newQuantity, ProcurementRow row)
	{
		// Update the specific field that was changed
		row.Quantity = newQuantity;

		// Recalculate based on the hierarchy:
		// If Approved exists, use it; otherwise fallback to Maker Quantity.
		RecalculateRowCost(row);
	}

	private void RecalculateRowCost(ProcurementRow row)
	{
		decimal? effectiveQuantity;

		// If the Maker is currently editing (New or Returned), use their Quantity.
		// Otherwise, fallback to the Approved Quantity for read-only/approval views.
		if (CanEditMakerFields)
		{
			effectiveQuantity = (decimal?)row.Quantity;
		}
		else
		{
			effectiveQuantity = row.QuantityApproved.HasValue
								? (decimal)row.QuantityApproved.Value
								: (decimal?)row.Quantity;
		}

		if (effectiveQuantity.HasValue && row.ItemCost.HasValue)
		{
			row.CostBeforeTax = (int)effectiveQuantity.Value * row.ItemCost.Value;
		}
		else
		{
			row.CostBeforeTax = 0;
		}
	}

