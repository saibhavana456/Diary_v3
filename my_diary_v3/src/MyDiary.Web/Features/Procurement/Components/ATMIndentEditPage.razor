									 : selectedRow.PoGeneratedDocName,

				// PO Acceptance Fields
				IsPoAccepted = selectedRow.IsPoAccepted,
				PoAcceptedBy = selectedRow.PoAcceptedBy,
				PoAcceptedOn = selectedRow.PoAcceptedOn,
				PoAcceptedDoc = selectedRow.PoAcceptedDoc,
				PoAcceptedDocName = !string.IsNullOrEmpty(selectedRow.TempPoAcceptedDocName)
									 ? selectedRow.TempPoAcceptedDocName
									 : selectedRow.PoAcceptedDocName,

				// Order & Receipt Fields
				OrderedBy = selectedRow.OrderedBy,
				OrderedOn = selectedRow.OrderedOn,
				PreBookedAmt = selectedRow.PreBookedAmt,
				PreBookedDoc = selectedRow.PreBookedDoc,
				PreBookedDocName = !string.IsNullOrEmpty(selectedRow.TempPreBookedDocName)
									? selectedRow.TempPreBookedDocName
									: selectedRow.PreBookedDocName,

				ReceivedBy = selectedRow.ReceivedBy,
				DeliveredOn = selectedRow.DeliveredOn,
				PostDeliveredAmt = selectedRow.PostDeliveredAmt,
				OrderRecivedDoc = selectedRow.OrderRecivedDoc,
				OrderRecivedDocName = !string.IsNullOrEmpty(selectedRow.TempOrderRecivedDocName)
									   ? selectedRow.TempOrderRecivedDocName
									   : selectedRow.OrderRecivedDocName,


				// Installation Fields
				InstalledOn = selectedRow.InstalledOn,
				PostInstalledAmt = selectedRow.PostInstalledAmt,
				PostInstallationDoc = selectedRow.PostInstallationDoc,
				PostInstallationDocName = !string.IsNullOrEmpty(selectedRow.TempPostInstallationDocName)
										   ? selectedRow.TempPostInstallationDocName
										   : selectedRow.PostInstallationDocName,


										   PaymentDate = selectedRow.PaymentDate,
				InvoiceNumber = selectedRow.InvoiceNumber,
				PaymentBy = selectedRow.PaymentBy,
				InvoiceDoc = selectedRow.InvoiceDoc,
				InvoiceDocName = !string.IsNullOrEmpty(selectedRow.TempInvoiceDocName)
										   ? selectedRow.TempInvoiceDocName
										   : selectedRow.InvoiceDocName
			};

			// 2. Call the service
			var result = await _ATMIndentService.UpdateRequestATM(payload);

			// 3. Provide Feedback
			if (result == "Success")
			{
				await JS.InvokeVoidAsync("alert", "Execution Details Updated Successfully!");
				if (!string.IsNullOrEmpty(selectedRow.TempPoGeneratedDocName))
					selectedRow.PoGeneratedDocName = selectedRow.TempPoGeneratedDocName;

				if (!string.IsNullOrEmpty(selectedRow.TempPoAcceptedDocName))
					selectedRow.PoAcceptedDocName = selectedRow.TempPoAcceptedDocName;

				if (!string.IsNullOrEmpty(selectedRow.TempPreBookedDocName))
					selectedRow.PreBookedDocName = selectedRow.TempPreBookedDocName;

				if (!string.IsNullOrEmpty(selectedRow.TempOrderRecivedDocName))
					selectedRow.OrderRecivedDocName = selectedRow.TempOrderRecivedDocName;

				if (!string.IsNullOrEmpty(selectedRow.TempPostInstallationDocName))
					selectedRow.PostInstallationDocName = selectedRow.TempPostInstallationDocName;

				if (!string.IsNullOrEmpty(selectedRow.TempInvoiceDocName))
					selectedRow.InvoiceDocName = selectedRow.TempInvoiceDocName;

				// CLEAR: Reset temporary staging names
				selectedRow.TempPoGeneratedDocName = null;
				selectedRow.TempPoAcceptedDocName = null;
				selectedRow.TempPreBookedDocName = null;
				selectedRow.TempOrderRecivedDocName = null;
				selectedRow.TempPostInstallationDocName = null;
				selectedRow.TempInvoiceDocName = null;
				// 4. Close the Modal
				selectedRow = null;

				// Optional: Refresh state to reflect changes in the main table
				StateHasChanged();
			}
			else
			{
				loadError = "Failed to update status in database: " + result;
			}
		}
