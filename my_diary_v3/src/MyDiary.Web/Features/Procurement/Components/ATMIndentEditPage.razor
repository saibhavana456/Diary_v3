	private async Task OnInputFileChange(InputFileChangeEventArgs e, string section)
	{
		var file = e.File;
		if (file == null) return;

		using var ms = new MemoryStream();
		await file.OpenReadStream(1024 * 1024 * 5).CopyToAsync(ms); // 5MB Limit
		byte[] fileBytes = ms.ToArray();

		switch (section)
		{
			case "PO":
				selectedRow.PoGeneratedDoc = fileBytes;
				selectedRow.TempPoGeneratedDocName = file.Name;
				break;
			case "Accept":
				selectedRow.PoAcceptedDoc = fileBytes;
				selectedRow.TempPoAcceptedDocName = file.Name;
				break;
			case "Order":
				selectedRow.PreBookedDoc = fileBytes;
				selectedRow.TempPreBookedDocName = file.Name;
				break;
			case "Receive":
				selectedRow.OrderRecivedDoc = fileBytes;
				selectedRow.TempOrderRecivedDocName = file.Name;
				break;
			case "Install":
				selectedRow.PostInstallationDoc = fileBytes;
				selectedRow.TempPostInstallationDocName = file.Name;
				break;
			case "Invoice":
				selectedRow.InvoiceDoc = fileBytes;
				selectedRow.TempInvoiceDocName = file.Name;
				break;

		}
		StateHasChanged();
	}

	private async Task GeneratePO(ProcurementRow row)
	{
		try
		{
			if (vm.Rows == null || !vm.Rows.Any()) return;
			IsPOGeneratedSelected = true;
			StateHasChanged();
			await Task.Delay(1000);
			// Give Blazor a moment to render the HTML into the DOM
			//

			// await JS.InvokeVoidAsync("eval", $@"
			//         window.onafterprint = function() {{
			//             DotNet.invokeMethodAsync('{System.Reflection.Assembly.GetExecutingAssembly().GetName().Name}', 'OnPrintDialogClosed');
			//         }};
			//         window.print();
			//     ");

			// if (IsPoFilePrinted == true)
			// {
			var pdfBytes =await PdfService.GeneratePoPdf(vm,sessionUserId);

			var payload = new ATMRequestMaster
			{
				RequestCode = vm.RequestCode,
				IsPoIssued = true,
				PoIssuedBy = sessionUserId,
