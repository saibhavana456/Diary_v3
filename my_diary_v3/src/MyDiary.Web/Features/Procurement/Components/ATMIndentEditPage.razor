@code {



	[Parameter] public string? id { get; set; }
	private bool IsEdit => !string.IsNullOrWhiteSpace(id);
	private ProcurementRow selectedRow;
	private string? attachmentFileName;
	private long attachmentSizeKb;
	private string? attachmentInfo;

	private string? displayAttachmentName;

	private bool isLoading;
	private string? loadError;

	public string status;
	// Role plumbing
	private string? sessionRoleRaw;
	public bool? IsPOGeneratedSelected = false;
	public bool? IsPoFilePrinted = true;
	public bool IsSelectSelected = false;
	private bool CanSubmitFeedback = false;
	private bool IsFeedbackSaved = false;


	private DotNetObjectReference<ATMIndentEditPage>? objRef;


	//private enum UserRole { Maker, Checker, ROApprover, ROMAKER, ZOMAKER, ZOAPPROVER, COMaker, COApprover }
	private enum UserRole { Maker, Checker, ROApprover, ROMAKER, ZOMAKER, ZOAPPROVER }
	private UserRole currentRole = UserRole.Maker; // default fallback

	private bool IsROMaker => currentRole == UserRole.ROMAKER;
	private bool IsROApprover => currentRole == UserRole.ROApprover;
	private bool IsRO => IsROMaker || IsROApprover;

	private bool IsMaker => currentRole == UserRole.Maker;
	private bool IsChecker => currentRole == UserRole.Checker;
	//private bool IsRO => currentRole == UserRole.RO;
	// private bool IsZO => currentRole == UserRole.ZO;
	private bool IsZOMaker => currentRole == UserRole.ZOMAKER;
	private bool IsZOApprover => currentRole == UserRole.ZOAPPROVER;
	// private bool IsCOMaker => currentRole == UserRole.COMaker;
	// private bool IsCOApprover => currentRole == UserRole.COApprover;
	private bool IsZO => IsZOMaker || IsZOApprover;

	// Maker (header + items + attachment) editable only by Maker
	private bool CanEditMakerFields => (IsMaker && !IsEdit) || (IsMaker && status.Contains("Returned"));

	// Which approval section is editable (only its owner)
	private bool CanEditCheckerSection => IsChecker && status == "Branch Submitted";



	// RO Maker can only edit if they are a Maker AND the status isn't already 'Region Maker Approved' or higher
	private bool CanEditROMakerFields => IsROMaker && status == "Branch Recommended";

	// RO Approver can only edit if they are an Approver AND the status isn't already 'Region Approved'
	private bool CanEditROApproverFields => IsROApprover && (status == "Branch Recommended" || status == "Region Maker Recommended");

	// The overall RO Section visible logic (optional helper)
	private bool CanEditROSection => CanEditROMakerFields || CanEditROApproverFields;



	private bool CanEditZOMakerFields => IsZOMaker && status == "Region Maker Recommended";

	private bool CanEditZOApproverFields => IsZOApprover && status == "ZO Maker Recommended";


	// Checker is always shown to everyone downstream
	private bool ShowCheckerSection => IsChecker || IsRO || IsZO || status == "ZO Approved" || status == "Region Approved";



	// RO is always shown to everyone downstream
	private bool ShowROSection => IsRO || IsZO || status == "ZO Approved" || status == "Region Approved";

	// ZO and CO only show if the cost exceeds the limit
	private bool ShowZOSection => RequiresHigherApproval && (IsZO || status == "ZO Approved");
	//private bool ShowCOSection => RequiresHigherApproval && (IsZO || status == "ZO Approved");
	private bool ROCanEdit => IsRO;
	private bool isChangingFile = false;

	private bool CanDeleteRows => IsMaker &&
	string.IsNullOrWhiteSpace(vm.CheckerRecommendation) &&
	string.IsNullOrWhiteSpace(vm.CoRecommendation);
	private Dictionary<string, bool> uploadedFiles = new();
	private IJSObjectReference? _jsModule;

	private bool showFeedbackModal = false;

	private string searchAtmId;

	private bool IsPoGenerated;

	// Show the "Action" column if we are in draft mode OR if the CO has approved
	private bool ShowActionColumn => CanDeleteRows || status == "ZO Approved";

	// Define your limit here (e.g., 50,000)
	private const decimal RO_AUTHORITY_LIMIT = 100000;

	// Calculate the total cost across all items
	private decimal TotalProcurementCost => vm.Rows.Sum(i => i.CostBeforeTax ?? 0m);



	// Determine if this request requires Higher Authority (ZO/CO)
	private bool RequiresHigherApproval => TotalProcurementCost >= RO_AUTHORITY_LIMIT;


	private bool showPOModal = false;

	private void OpenPOModal() => showPOModal = true;
	private void ClosePOModal() => showPOModal = false;
	private async Task HandleSignedDocUpload(InputFileChangeEventArgs e)
	{
		// Your logic to handle the signed document upload
		var file = e.File;
		if (file != null)
		{
			// Process file...
		}
	}
	// Special flag for the PO button

	//private bool CanGeneratePO => IsMaker && status == "CO Approved";
	private bool IsZOOrROApproved => !IsMaker && (status == "Region Approved" || status == "ZO Approved");

	private void ToggleChangeFile()
	{
		isChangingFile = true;
	}

	private bool isAtmLookupOpen = false;
	private bool isAtmLookupLoading = false;
	private string atmLookupSearch = "";
	private int currentLookupRowIndex = -1;
	private List<AtmMaster> AtmMasterList = new();

	private IEnumerable<AtmMaster> AtmLookupFiltered =>
	string.IsNullOrWhiteSpace(atmLookupSearch)
	? AtmMasterList
	: AtmMasterList.Where(x =>
		(x.AtmId?.Contains(atmLookupSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
		(x.SolId?.Contains(atmLookupSearch, StringComparison.OrdinalIgnoreCase) ?? false) || 
		(x.Project?.Contains(atmLookupSearch, StringComparison.OrdinalIgnoreCase) ?? false));

	private async Task OpenAtmLookup(int rowIndex)
	{
		currentLookupRowIndex = rowIndex;
		isAtmLookupOpen = true;
		isAtmLookupLoading = true;

		// 1. Retrieve the BranchCode from Session Storage
		var jobRes = await ProtectedSessionStorage.GetAsync<string>("LOCATION");
		string? sessionBranchCode = jobRes.Success ? jobRes.Value : null;


		// 2. Fetch all data from the service
		var allAtms = await _ATMIndentService.GetAllATMMasterData();
		var firstRecord = allAtms.FirstOrDefault();

		// 3. Filter based on the sessionBranchCode
		// We filter by 'BRANCH_CODE' or 'SOL_ID' depending on your schema
		if (!string.IsNullOrEmpty(sessionBranchCode))
		{
			// Use Trim() to remove accidental spaces and ensure a clean comparison
			AtmMasterList = allAtms
			.Where(x => x.BranchCode == sessionBranchCode)
			.ToList();
		}
		// else
		// {
		// 	// Optional: Show empty or all data if no branch is found in session
		// 	AtmMasterList = allAtms.ToList();
		// }

		isAtmLookupLoading = false;
	}

	private void CloseAtmLookup() => isAtmLookupOpen = false;

	private void SelectAtmFromLookup(AtmMaster atm)
	{
		if (currentLookupRowIndex != -1 && currentLookupRowIndex < vm.AtmMasterRow.Count)
		{
			var row = vm.AtmMasterRow[currentLookupRowIndex];

			// Populate all fields from the selected ATM master data
			row.ATMId = atm.AtmId;
			row.Project = atm.Project;
			row.AtmMake = atm.AtmMake;
			row.InstallationDate = atm.InstallationDate;
			row.AtmCrm = atm.AtmCrm;
			row.CapexOpex = atm.CapexOpex;

			// Optional: Trigger any additional sync logic
