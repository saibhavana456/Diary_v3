	// Filtered view for the item lookup modal
	private List<ATMVendorMaster> ItemLookupFiltered
	{
		get
		{
			IEnumerable<ATMVendorMaster> q = itemLookup;
			if (!string.IsNullOrWhiteSpace(lookupSearch))
			{
				var s = lookupSearch.Trim();
				q = q.Where(x =>
					(!string.IsNullOrEmpty(x.ItemCode) && x.ItemCode.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
					(!string.IsNullOrEmpty(x.ItemName) && x.ItemName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
					(!string.IsNullOrEmpty(x.ItemCategory) && x.ItemCategory.Contains(s, StringComparison.OrdinalIgnoreCase))
				);
			}
			return q.OrderBy(x => x.ItemName, StringComparer.OrdinalIgnoreCase).ToList();
		}
	}



