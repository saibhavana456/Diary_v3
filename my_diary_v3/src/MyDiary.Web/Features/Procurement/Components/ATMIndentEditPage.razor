	private static bool TryParseRole(string? s, out UserRole role)
	{
		role = UserRole.Maker;
		if (string.IsNullOrWhiteSpace(s)) return false;

		switch (s.Trim().ToUpperInvariant())
		{
			case "MAKER": role = UserRole.Maker; return true;
			case "CHECKER": role = UserRole.Checker; return true;
			case "ROAPPROVER": role = UserRole.ROApprover; return true;
			case "ROMAKER": role = UserRole.ROMAKER; return true;
			case "ZOMAKER": role = UserRole.ZOMAKER; return true;
			case "ZOAPPROVER": role = UserRole.ZOAPPROVER; return true;
			// case "COAPPROVER": role = UserRole.COApprover; return true;
			// case "COMAKER": role = UserRole.COMaker; return true;
			default: return false;
		}
	}

