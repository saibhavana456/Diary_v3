	private static DateTime GetNowInIndia()
	{
		try
		{
			var ist = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
			return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);
		}
		catch (TimeZoneNotFoundException)
		{
			var ist = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
			return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);
		}
	}

	private static string GetIndianFinancialYear(DateTime dt)
	{
		var startYear = dt.Month >= 4 ? dt.Year : dt.Year - 1;
		var endYearShort = (startYear + 1) % 100;
		return $"{startYear}-{endYearShort:00}";
	}

	private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
	{
		try
		{
			if (!CanEditMakerFields)
				return;

			var file = e.File;
			if (file is null)
			{
				vm.Attachment = null;
				vm.AttachmentName = null;
				displayAttachmentName = null;
				attachmentSizeKb = 0;
				return;
			}

			// Safety limit e.g., 10 MB
			const long maxAllowed = 10 * 1024 * 1024;

			await using var stream = file.OpenReadStream(maxAllowed);
			using var ms = new MemoryStream();
			await stream.CopyToAsync(ms);

			// Store the raw byte array directly into the View Model
			vm.Attachment = ms.ToArray();

			vm.AttachmentName = file.Name;
			displayAttachmentName = file.Name;

			// Calculate size from the byte array length
			attachmentSizeKb = (int)(vm.Attachment.Length / 1024);
			isChangingFile = false;
		}
		catch (Exception ex)
		{
			AppLogger.LogError(ex, "ATMIndentEditPage: failed to read attachment");
			loadError = UserFacingError.Generic;
			vm.Attachment = null;
			vm.AttachmentName = null;
			displayAttachmentName = null;
			attachmentSizeKb = 0;
		}
	}

