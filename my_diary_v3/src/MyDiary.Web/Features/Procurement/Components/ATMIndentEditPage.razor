	private bool IsSubmitDisabled
	{
		get
		{
			// Ensure we don't crash on null status
			string safeStatus = status ?? "";

			if (IsMaker)
			{
				// If creating NEW, button is active
				if (!IsEdit) return false;



				// If EDITING, button is active ONLY for Draft or Returned
				return !(safeStatus.Contains("Returned"));
			}

			if (IsChecker)
			{
				// Checker only submits when status is Draft
				return safeStatus != "Branch Submitted";
			}

			if (IsROMaker)
			{
				// RO Maker only submits when status is Branch Approved
				return safeStatus != "Branch Recommended";
			}
			if (IsROApprover)
			{
				return safeStatus != "Region Maker Recommended";
			}

			if (IsZOMaker)
			{
				return safeStatus != "Region Maker Recommended";
			}

			// 6. CO Approver: Enable if CO Maker has recommended
			if (IsZOApprover)
			{
				return safeStatus != "ZO Maker Recommended";
			}

			// Default: Disable for safety if no conditions are met
			return true;
		}
	}

