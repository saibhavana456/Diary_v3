@page "/ATMIndent/new"
@page "/ATMIndent/{id}"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.ComponentModel.DataAnnotations
@using System.Linq
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@using Procurement.Interfaces
@using Procurement.Models
@using Procurement.Models.TABLES
@using Procurement.Services
@using static Procurement.Models.DTO.MiscClasses
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage ProtectedSessionStorage
@inject IPdfService PdfService 
@inject IATMIndentService _ATMIndentService

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <MudPaper Class="pa-4 mb-3 d-flex justify-space-between align-center" Elevation="1">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">
                @(IsEdit ? "Edit Indent Request" : "Create New Indent")
            </MudText>


			<MudBreadcrumbs Items="@(
    new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Indent List", href: "/Indent"),
        new BreadcrumbItem(IsEdit ? "Edit" : "New", href: null, disabled: true)
    })" />


        </div>

        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
            Role: <b>@currentRole</b>
        </MudChip>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@loadError</MudAlert>
    }
    else if (isLoading)
    {
        <div class="d-flex justify-center mt-4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        <EditForm Model="@vm" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <MudCard Class="mb-3" Elevation="1">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">General Information</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        @if (IsEdit)
                        {
                            <MudItem xs="12" sm="3">
                                <MudText><b>Request Code:</b> @vm.RequestCode</MudText>
                            </MudItem>
                        }
                        <MudItem xs="12" sm="3">
                            <MudText><b>FY / Month:</b> @displayFinYear / @displayMonth</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText><b>Branch:</b> @sessionLocationName (@sessionBranchCode)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText><b>Region:</b> @sessionRegionName</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText><b>Zone:</b> @sessionZoneName</MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <MudCard Class="mb-3" Elevation="1">
                <MudCardContent>
                    <MudGrid AlignItems="AlignItems.Center">
                        <MudItem xs="12" md="3">
                            <MudSelect T="string"
                                       Label="Urgency Level"
                                       @bind-Value="vm.UrgencyLevel"
                                       Disabled="@(!CanEditMakerFields)"
                                       Variant="Variant.Outlined">
                                <MudSelectItem Value="@("")">-- Select --</MudSelectItem>
                                <MudSelectItem Value="@("Normal")">Normal</MudSelectItem>
                                <MudSelectItem Value="@("Urgent")">Urgent</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField Label="Reason For Replacement"
                                          Lines="2"
                                          @bind-Value="vm.Justification"
                                          Disabled="@(!CanEditMakerFields)"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.body2" Class="mb-1">Attachment</MudText>
                            <InputFile id="fileInput" OnChange="OnAttachmentSelected" hidden />
                            <MudButton HtmlTag="label"
                                       Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       for="fileInput"
                                       Disabled="@(!CanEditMakerFields)">
                                Upload File
                            </MudButton>
                            @if (!string.IsNullOrEmpty(displayAttachmentName))
                            {
                                <MudText Typo="Typo.caption" Class="d-block mt-1 text-truncate">
                                    @displayAttachmentName (@attachmentSizeKb KB)
                                </MudText>
                            }
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

			@if (status == "ZO Approved" && RequiresHigherApproval)
			{
				<MudGrid Class="mt-4">
					<MudItem xs="12" Class="d-flex justify-end">

						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
								   Class="px-4 shadow-sm"
								   OnClick="OpenPOModal">

							Manage Purchase Orders

						</MudButton>

					</MudItem>
				</MudGrid>
			}

			@if (status == "Region Approved" && !RequiresHigherApproval)
			{
				<MudGrid Class="mt-4">
					<MudItem xs="12" Class="d-flex justify-end">

						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
								   Class="px-4 shadow-sm"
								   OnClick="OpenPOModal">

							Manage Purchase Orders

						</MudButton>

					</MudItem>
				</MudGrid>
			}


            <MudCard Class="mb-4" Elevation="1">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.h6">ATM Technical Details</MudText>
                            @if (CanEditMakerFields)
                            {
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Success" 
                                           StartIcon="@Icons.Material.Filled.Search"
                                           OnClick="@(() => OpenAtmLookup(0))">
                                    Search ATM
                                </MudButton>
                            }
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudTable Items="vm.AtmMasterRow" Dense="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>ATM ID</MudTh>
                        <MudTh>Project</MudTh>
                        <MudTh>Make</MudTh>
                        <MudTh>Install Date</MudTh>
                        <MudTh>CRM</MudTh>
                        <MudTh>CAPEX/OPEX</MudTh>
                    </HeaderContent>
					<RowTemplate Context="row">

						<MudTd DataLabel="ATM ID">
							<MudTextField Value="@row.ATMId"
										  ReadOnly="true"
										  Margin="Margin.Dense"
										  Variant="Variant.Text" />
						</MudTd>

						<MudTd DataLabel="Project">@row.Project</MudTd>

						<MudTd DataLabel="Make">@row.AtmMake</MudTd>

						<MudTd DataLabel="Install Date">
							@row.InstallationDate?.ToString("dd-MM-yyyy")
						</MudTd>

						<MudTd DataLabel="CRM">@row.AtmCrm</MudTd>

						<MudTd DataLabel="CAPEX/OPEX">@row.CapexOpex</MudTd>

					</RowTemplate>

                </MudTable>
            </MudCard>

            <MudTable Items="vm.Rows" Dense="true" Hover="true" Bordered="true" Elevation="1" Class="mb-4">
                <HeaderContent>
                    <MudTh Style="width: 50px;">#</MudTh>
                    <MudTh>Item</MudTh>
                    <MudTh>Qty</MudTh>
                    <MudTh>Cost</MudTh>
                    <MudTh>Approved</MudTh>
                    <MudTh Style="width: 120px;">Action</MudTh>
                </HeaderContent>
				<RowTemplate Context="row">

					<MudTd DataLabel="#">@(vm.Rows.IndexOf(row) + 1)</MudTd>

					<MudTd DataLabel="Item">
						<div class="d-flex align-center gap-2">

							<MudTextField Value="@(string.IsNullOrEmpty(row.ItemName) ? row.AtmCode : row.ItemName)"
										  ReadOnly="true"
										  Margin="Margin.Dense"
										  Variant="Variant.Outlined" />

							@if (CanEditMakerFields)
							{
								<MudIconButton Icon="@Icons.Material.Filled.Search"
											   Color="Color.Primary"
											   Size="Size.Small"
											   OnClick="@(() => OpenItemLookup(vm.Rows.IndexOf(row)))" />
							}

						</div>
					</MudTd>

					<MudTd DataLabel="Qty">
						<MudNumericField T="int?"
										 Value="row.Quantity"
										 ValueChanged="@((int? val) => UpdateCostBeforeTax(val, row))"
										 Disabled="@(!CanEditMakerFields)"
										 Margin="Margin.Dense"
										 Variant="Variant.Outlined" />
					</MudTd>

					<MudTd DataLabel="Cost">
						<MudNumericField T="decimal?"
										 @bind-Value="row.CostBeforeTax"
										 ReadOnly="true"
										 Margin="Margin.Dense"
										 Variant="Variant.Outlined" />
					</MudTd>

					<MudTd DataLabel="Approved">
						<MudNumericField T="int?"
										 Value="row.QuantityApproved"
										 ValueChanged="@((int? val) =>
                         {
                             row.QuantityApproved = val;
                             RecalculateRowCost(row);
                         })"
										 Disabled="@(!CanEditROSection)"
										 Margin="Margin.Dense"
										 Variant="Variant.Outlined" />
					</MudTd>

					@if (ShowActionColumn)
					{
						@if (CanDeleteRows)
						{
							<MudTd Align="Align.Center">

								<MudStack Direction="Row"
										  Justify="Justify.Center"
										  AlignItems="AlignItems.Center"
										  Spacing="1">

									@* SHOW ADD BUTTON ONLY ON LAST ROW *@
									<MudIconButton Icon="@Icons.Material.Filled.Add"
												   Color="Color.Primary"
												   Size="Size.Small"
												   OnClick="AddRow"
												   Disabled="@(!CanEditMakerFields)" />

									<MudIconButton Icon="@Icons.Material.Filled.Delete"
												   Color="Color.Error"
												   Size="Size.Small"
												   OnClick="@(() => RemoveRow(vm.Rows.IndexOf(row)))"
												   Disabled="@(!CanEditMakerFields)" />

								</MudStack>

							</MudTd>
						}
					}

					@* SELECT BUTTON AFTER APPROVAL *@
					@if (!IsEdit || IsPoGenerated || status == "ZO Approved" || status == "Region Approved")
					{
						@if (IsPoGenerated)
						{
							<MudTd Align="Align.Center">

								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   OnClick="@(() => HandleSelect(row))">

									Select

								</MudButton>

							</MudTd>
						}
					}

				</RowTemplate>

            </MudTable>
			<MudGrid Class="mt-2">

				<MudItem xs="12" md="2">
					<!-- empty space like col-md-2 -->
				</MudItem>

				<MudItem xs="12" md="10">

					<MudAlert Severity="Severity.Info"
							  Variant="Variant.Text"
							  Dense="true">

						

						<b>Note:</b>
						The rates are inclusive of all charges including installation andgrouting charges, but exclusive of GST.

					</MudAlert>

				</MudItem>

			</MudGrid>

			@if (ShowCheckerSection || ShowROSection || ShowZOSection || status == "ZO Approved")
			{
				<MudText Typo="Typo.h6"
						 Class="mt-5 mb-3 text-secondary"
						 Style="border-left:4px solid #1976d2;padding-left:10px;">
					Approval Workflow
				</MudText>

				<MudGrid Class="mb-5" Spacing="3">

					<!-- ✅ Branch Checker -->
					@if (ShowCheckerSection)
					{
						<MudItem xs="12" md="6">
							<MudCard Elevation="1">

								<MudCardHeader>
									<CardHeaderContent>
										<MudText Typo="Typo.subtitle1">
											Branch Checker
										</MudText>
									</CardHeaderContent>
								</MudCardHeader>

								<MudCardContent>

									<MudSelect T="string"
											   Label="Recommendation"
											   @bind-Value="vm.CheckerRecommendation"
											   Disabled="@(!CanEditCheckerSection)">

										@foreach (var opt in RecommendationOptions)
										{
											<MudSelectItem Value="@opt">@opt</MudSelectItem>
										}
									</MudSelect>

									<MudTextField Label="Remarks"
												  Lines="2"
												  Class="mt-2"
												  @bind-Value="vm.CheckerRemarks"
												  Disabled="@(!CanEditCheckerSection)" />

								</MudCardContent>
							</MudCard>
						</MudItem>
					}

					<!-- ✅ RO Section -->
					@if (ShowROSection)
					{
						<MudItem xs="12">
							<MudCard Elevation="1">

								<MudCardHeader>
									<MudText Typo="Typo.subtitle1" Color="Color.Info">
										Regional Office (RO)
									</MudText>
								</MudCardHeader>

								<MudCardContent>

									<MudGrid>

										<!-- RO Maker -->
										<MudItem xs="12" md="6">
											<MudText Typo="Typo.subtitle2" Class="mb-2">RO Maker</MudText>

											<MudSelect T="string"
													   Label="Recommendation"
													   @bind-Value="vm.RegionRecommendation"
													   Disabled="@(!CanEditROMakerFields)">
												@foreach (var opt in RecommendationOptions)
												{
													<MudSelectItem Value="@opt">@opt</MudSelectItem>
												}
											</MudSelect>

											@if (RequiresHigherApproval)
											{

												<MudSelect T="string"
														   Label="Forward To"
														   Class="mt-2"
														   @bind-Value="vm.RegionForwardTo"
														   Disabled="@(!CanEditROMakerFields)">

													<MudSelectItem Value="@("ZO")">ZO</MudSelectItem>

												</MudSelect>

											}

											<MudTextField Label="Maker Remarks"
														  Lines="2"
														  Class="mt-2"
														  @bind-Value="vm.RegionRemarks"
														  Disabled="@(!CanEditROMakerFields)" />
										</MudItem>


										<!-- RO Checker -->
										@if (!RequiresHigherApproval)
										{
											<MudItem xs="12" md="6">

												<MudText Typo="Typo.subtitle2" Class="mb-2">
													RO Checker
												</MudText>

												<MudSelect T="string"
														   Label="Action"
														   @bind-Value="vm.RegionApproverRecommendation"
														   Disabled="@(!CanEditROApproverFields)">
													@foreach (var opt in RecommendationOptions)
													{
														<MudSelectItem Value="@opt">@opt</MudSelectItem>
													}
												</MudSelect>

												<MudTextField Label="Approver Remarks"
															  Lines="2"
															  Class="mt-2"
															  @bind-Value="vm.RegionApproverRemarks"
															  Disabled="@(!CanEditROApproverFields)" />

											</MudItem>
										}

									</MudGrid>

								</MudCardContent>
							</MudCard>
						</MudItem>
					}

					<!-- ✅ ZO Section -->
					@if (ShowZOSection)
					{
						<MudItem xs="12">
							<MudCard Elevation="1">

								<MudCardHeader>
									<MudText Typo="Typo.subtitle1" Color="Color.Success">
										Zonal Office (ZO) Workflow
									</MudText>
								</MudCardHeader>

								<MudCardContent>

									<MudGrid>

										<!-- ZO Maker -->
										<MudItem xs="12" md="6">
											<MudText Typo="Typo.subtitle2">Zonal Maker</MudText>

											<MudSelect T="string"
													   Label="Recommendation"
													   @bind-Value="vm.CoCheckerRecommendation"
													   Disabled="@(!CanEditZOMakerFields)">
												@foreach (var opt in RecommendationOptions)
												{
													<MudSelectItem Value="@opt">@opt</MudSelectItem>
												}
											</MudSelect>

											<MudTextField Label="Maker Remarks"
														  Lines="2"
														  Class="mt-2"
														  @bind-Value="vm.CoCheckerRemarks"
														  Disabled="@(!CanEditZOMakerFields)" />
										</MudItem>

										<!-- ZO Checker -->
										<MudItem xs="12" md="6">
											<MudText Typo="Typo.subtitle2">Zonal Checker</MudText>

											<MudSelect T="string"
													   Label="Final Decision"
													   @bind-Value="vm.CoRecommendation"
													   Disabled="@(!CanEditZOApproverFields)">
												@foreach (var opt in RecommendationOptions)
												{
													<MudSelectItem Value="@opt">@opt</MudSelectItem>
												}
											</MudSelect>

											<MudTextField Label="Approver Remarks"
														  Lines="2"
														  Class="mt-2"
														  @bind-Value="vm.CoRemarks"
														  Disabled="@(!CanEditZOApproverFields)" />
										</MudItem>

									</MudGrid>

								</MudCardContent>
							</MudCard>
						</MudItem>
					}

				</MudGrid>
			}

            <MudPaper Class="pa-3 mt-4 d-flex justify-end gap-2" Elevation="1">
                <MudButton Variant="Variant.Outlined" OnClick="Cancel">
                    Cancel
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Disabled="@IsSubmitDisabled">
                    Submit Indent
                </MudButton>

                @if (CanSubmitFeedback)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               OnClick="@(() => showFeedbackModal = true)">
                        Add Feedback
                    </MudButton>
                }
            </MudPaper>
        </EditForm>
    }
</MudContainer>

@if (showPOModal)
{
    var itemRow = vm.Rows.FirstOrDefault(r => !string.IsNullOrEmpty(r.VendorName));

    <MudOverlay Visible="true" DarkBackground="true">

        <MudCard Style="width: min(900px, 95vw);" Class="mx-auto mt-10">

            <!-- HEADER -->
            <MudCardHeader Style="background: linear-gradient(90deg, #1a237e, #283593); color:white;">
                <CardHeaderContent>
					<MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2">

                        <MudIcon Icon="@Icons.Material.Filled.Description"
                                 Color="Color.Warning"
                                 Size="Size.Large" />

                        <MudText Typo="Typo.h6">
                            Purchase Order Issuance
                        </MudText>

                    </MudStack>
                </CardHeaderContent>

                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Inherit"
                                   OnClick="ClosePOModal" />
                </CardHeaderActions>
            </MudCardHeader>

            <!-- BODY -->
            <MudCardContent Class="pa-4">

                <!-- PHASE -->
				<MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">

					<MudChip T="string" Color="Color.Primary">
						Phase 1
					</MudChip>

                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                        Document Generation
                    </MudText>
                </MudStack>

                <!-- FORM -->
                <MudPaper Class="pa-4 mb-4">

                    <MudGrid Spacing="3">

                        <MudItem xs="12" md="6">
                            <MudDatePicker Label="Issue Date"
                                           @bind-Date="vm.PoIssuedOn"
                                           Disabled="true"
                                           Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField Label="PO Reference Number"
                                          @bind-Value="vm.PoRefno"
                                          Placeholder="e.g. DBD:HHP:ATM:001"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                </MudPaper>

                <!-- ACTION BUTTONS -->
                <MudGrid AlignItems="Center" Spacing="2">

                    <MudItem xs="12" md="4">

                        @if (vm.PoAcceptedDoc != null && vm.PoAcceptedDoc.Length > 0)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       FullWidth="true"
                                       OnClick="@(() => GeneratePO(itemRow))"
                                       Disabled="@(!IsZOOrROApproved)"
                                       StartIcon="@Icons.Material.Filled.Refresh">

                                Regenerate PO

                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="@(() => GeneratePO(itemRow))"
                                       Disabled="@(!IsZOOrROApproved)"
                                       StartIcon="@Icons.Material.Filled.Settings">

                                Generate PO

                            </MudButton>
                        }

                    </MudItem>

                    <MudItem xs="12" md="8">

                        <MudStack Direction="Row" Spacing="2">

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Disabled="@(vm.PoAcceptedDoc == null)"
                                       OnClick="@(() => JS.InvokeVoidAsync("previewFileFromBase64",
                                                    vm.PoAcceptedDocName,
                                                    Convert.ToBase64String(vm.PoAcceptedDoc)))"
                                       StartIcon="@Icons.Material.Filled.PictureAsPdf">

                                Preview PDF

                            </MudButton>


                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Disabled="@(vm.PoAcceptedDoc == null || string.IsNullOrEmpty(vm.PoAcceptedDocName))"
                                       OnClick="SendPOEmail"
                                       StartIcon="@Icons.Material.Filled.Send">

                                Send via Email

                            </MudButton>

                        </MudStack>

                    </MudItem>

                </MudGrid>

            </MudCardContent>

            <!-- FOOTER -->
            <MudCardActions Class="d-flex justify-end">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="ClosePOModal">
                    Close
                </MudButton>
            </MudCardActions>

        </MudCard>

    </MudOverlay>
}


@if (IsPOGeneratedSelected == true && vm.Rows != null)
{
    <div id="po-print-zone">
        <MudPaper Class="pa-6 mx-auto my-4" Style="max-width: 900px; font-family: 'Times New Roman', serif; color: black; line-height: 1.6;" Elevation="2">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #003366; padding-bottom: 15px; margin-bottom: 25px;">
                <div style="flex: 1; text-align: left;">
                    <MudImage Src="Images/union_ease.png" Height="75" Alt="VYOM Logo" />
                </div>
                <div style="flex: 2; text-align: center;">
                    <MudImage Src="Images/logubi.png" Height="85" Alt="Union Bank Logo" />
                </div>
                <div style="flex: 1; text-align: right;">
                    <MudImage Src="Images/75_year_India.png" Height="75" Alt="Azadi Logo" />
                </div>
            </div>

            <div class="d-flex justify-space-between mb-6" style="font-weight: bold; font-size: 18px;">
                <MudText>Ref: CPP/GEN/@(vm.RequestCode)</MudText>
                <MudText>Date: @AppTime.Now.ToString("dd-MM-yyyy")</MudText>
            </div>

            <div class="mb-6" style="font-size: 17px;">
                <MudText>To,</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@(vm.Rows.FirstOrDefault()?.VendorName)</MudText>
            </div>

            <MudText Class="mb-4">Dear Sir,</MudText>

            <MudText Class="fw-bold mb-4" Style="font-size: 17px; text-transform: uppercase;">
                Sub: - Purchase order for Procurement of IT Assets to @sessionLocationName
            </MudText>

            <MudText Align="Align.Justify" Class="mb-4">
                We refer to the rate contract dated <strong>@AppTime.Now.ToString("dd-MM-yyyy")</strong>.
                We are pleased to confirm the indent for the below mentioned items.
                Kindly arrange for the delivery of the items at the earliest.
            </MudText>

            <MudText Typo="Typo.h6" Class="fw-bold mb-2" Style="font-size: 18px;">Price Details:</MudText>

            <MudTable Items="vm.Rows" Dense="true" Bordered="true" Elevation="0" Class="mb-4" Style="border: 1.5px solid black !important;">
                <HeaderContent>
                    <MudTh Style="background-color: #f2f2f2; border: 1px solid black; font-weight: bold; color: black;">Sl.</MudTh>
                    <MudTh Style="background-color: #f2f2f2; border: 1px solid black; font-weight: bold; color: black;">Description</MudTh>
                    <MudTh Style="background-color: #f2f2f2; border: 1px solid black; font-weight: bold; color: black;" TValue="string" Align="Align.Center">Quantity</MudTh>
                    <MudTh Style="background-color: #f2f2f2; border: 1px solid black; font-weight: bold; color: black;" TValue="string" Align="Align.Right">Unit Price</MudTh>
                    <MudTh Style="background-color: #f2f2f2; border: 1px solid black; font-weight: bold; color: black;" TValue="string" Align="Align.Right">Total Price</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="border: 1px solid black; text-align: center;">@(vm.Rows.IndexOf(context) + 1)</MudTd>
                    <MudTd Style="border: 1px solid black;"><b>@context.ItemName</b></MudTd>
                    <MudTd Style="border: 1px solid black;" Align="Align.Center">@context.QuantityApproved</MudTd>
                    <MudTd Style="border: 1px solid black;" Align="Align.Right">@context.ItemCost?.ToString("N2")</MudTd>
                    <MudTd Style="border: 1px solid black;" Align="Align.Right">@context.CostBeforeTax?.ToString("N2")</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTr Style="background-color: #f9f9f9;">
                        <MudTd SafeText="Grand Total (Excl. Tax)" CoSpan="4" Style="border: 1px solid black; text-align: right; font-weight: bold;" />
                        <MudTd Style="border: 1px solid black; text-align: right; font-weight: bold;">
                            @vm.Rows.Sum(x => x.CostBeforeTax ?? 0).ToString("N2")
                        </MudTd>
                    </MudTr>
                </FooterContent>
            </MudTable>

            <MudPaper Class="pa-3 mb-4 text-capitalize" Style="border: 1px solid #eee; background-color: #fcfcfc;" Elevation="0">
                <strong>Amount in Words:</strong> @ConvertAmountToWords(vm.Rows.Sum(x => x.CostBeforeTax ?? 0))
            </MudPaper>

            <MudText Style="font-size: 13px; font-style: italic;" Class="mb-6">*GST will be applicable as per the terms.</MudText>

            <div style="font-size: 15px; line-height: 1.7;">
                <MudText Style="font-weight: bold; text-decoration: underline;" Class="mb-1">Payment terms:</MudText>
                <ul style="margin: 0 0 20px 25px; padding: 0;">
                    <li>No advance payment shall be made.</li>
                    <li>The payment will be made only after the delivery and installation of the items.</li>
                    <li>Vendor must show the bifurcation/details of GST (CGST/SGST/IGST) in the invoice.</li>
                </ul>

                <MudText Style="font-weight: bold; text-decoration: underline;" Class="mb-1">Delivery Location:</MudText>
                <div style="margin: 0 0 20px 25px;">
                    @sessionUserId (Branch Maker)<br />
                    @sessionLocationName<br />
                    @(sessionRegionName ?? "Zonal Office")
                </div>
            </div>

            <div class="mt-8 d-flex justify-space-between align-end">
                <div style="font-size: 13px; color: #666;">
                    <strong>Classification:</strong> Internal
                </div>
                <MudPaper Class="pa-4 text-center" Style="min-width: 350px; border: 1px dashed #ccc; background-color: #fdfdfd;" Elevation="0">
                    <MudText Style="font-size: 14px; color: #333;">Digitally Authorized By</MudText>
                    <MudText Style="font-size: 16px; font-weight: bold; text-transform: uppercase;">SYSTEM GENERATED AUTHORIZATION</MudText>
                    <MudDivider Class="my-2" Style="background-color:#000;" />
                    <MudText Style="font-size: 12px; font-style: italic; color: #555;">
                        This is a computer-generated document and does not require a physical signature.
                    </MudText>
                </MudPaper>
            </div>
        </MudPaper>
    </div>
}


