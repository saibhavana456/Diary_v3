	private async Task SelectItemFromLookup(ATMVendorMaster picked)
	{
		if (selectingRowIndex.HasValue &&
			selectingRowIndex.Value >= 0 &&
			selectingRowIndex.Value < vm.Rows.Count)
		{
			var target = vm.Rows[selectingRowIndex.Value];

			// Map Item Data
			target.AtmCode = picked.ItemCode;
			target.ItemName = picked.ItemName;
			target.ItemCategory = picked.ItemCategory;
			target.ItemCost = picked.ItemCost;


			// Auto-load Vendor
			target.VendorName = picked.VendorName;

			// Set default quantity if it's currently empty
			if (!target.Quantity.HasValue || target.Quantity <= 0)
			{
				target.Quantity = 1;
			}

			// TRIGGER CALCULATION IMMEDIATELY
			UpdateCostBeforeTax(target.Quantity, target);
		}

		// Close modal and refresh UI
		isItemLookupOpen = false;
		selectingRowIndex = null;
		await InvokeAsync(StateHasChanged);
	}

