	private async Task HandlePoAcceptanceChange(ChangeEventArgs e)
	{
		// Get the checkbox state from the event arguments
		bool isChecked = (bool)(e.Value ?? false);
		selectedRow.IsPoAccepted = isChecked;

		if (isChecked)
		{
			// 1. Set current system timestamp
			selectedRow.PoAcceptedOn = AppTime.Now;

			// 2. Fetch UserID from Session Storage
			try
			{
				var result = await ProtectedSessionStorage.GetAsync<string>("UserId");
				if (result.Success)
				{
					selectedRow.PoAcceptedBy = result.Value;
				}
				else
				{
					selectedRow.PoAcceptedBy = "Unknown User";
				}
			}
			catch (Exception ex)
			{
				selectedRow.PoAcceptedBy = "System Error";
				AppLogger.LogError(ex, "[AccountsClosedData] Error fetching session: " + ex.Message);
			}
		}
		else
		{
			// Optional: Clear fields if the user unchecks the box
			selectedRow.PoAcceptedOn = null;
			selectedRow.PoAcceptedBy = string.Empty;
		}
	}

