								}
							</MudItem>

						</MudGrid>

					</MudPaper>

				</MudCardContent>

				<!-- ✅ FOOTER -->
				<MudCardActions Class="d-flex justify-space-between pa-3">

					<MudButton Variant="Variant.Text"
