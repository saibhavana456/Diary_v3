@page "/reports/TopDepositors"
@using Microsoft.JSInterop
@using MudBlazor
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject MyDiary.Core.Abstractions.ICurrentUser ReportScopeUser


<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<style>
    .fixed-table {
        table-layout: fixed !important;
        width: 100% !important;
    }

    .mud-table-container {
        overflow-x: auto;
    }

    .mud-table-head {
        background-color: #2a2f5b;
    }
</style>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudPaper Elevation="0" Style="background-color: #ffffff;">


                <!-- Filters + Export -->
                <MudGrid Spacing="2" Class="pa-4 align-center">
                    <!-- Zone -->
                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="Zone"
                                   Value="SelectedZone"
                                   ValueChanged="HandleZoneChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   Disabled="@(!ScopeIsCo)">
                            <MudSelectItem Value="@("All")">All</MudSelectItem>
                            @foreach (var z in _zones)
                        {
                            <MudSelectItem Value="@z["zone_solid"].ToString()">
                                @z["zone_name_eng"].ToString()
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Region -->
                <MudItem xs="12" sm="3">
                    <MudSelect T="string"
                               Label="Region"
                               Value="SelectedRegion"
                               ValueChanged="HandleRegionChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Disabled="@(!ScopeAllowsRegionPick)">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        @foreach (var r in _regions)
                        {
                            <MudSelectItem Value="@r["region_solid"].ToString()">
                                @r["region_name"].ToString()
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Branch -->
                <MudItem xs="12" sm="3">
                    <MudSelect T="string"
                               Label="Branch"
                               Value="SelectedBranch"
                               ValueChanged="HandleBranchChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Disabled="@(!ScopeAllowsBranchPick)">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        @foreach (var b in _branches)
                        {
                            <MudSelectItem Value="@b["sol_id"].ToString()">
                                @b["branch_name"].ToString()
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudSpacer />

                <MudItem xs="12" sm="3" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@MudBlazor.Icons.Material.Filled.Download"
                               Style="background-color: #000066; color: white; font-size: 11px;"
                               OnClick="OnExportInternal">
                        Export To Excel
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- As On Label -->
            <div class="px-4 d-flex justify-end">
                <MudText Typo="Typo.caption" Style="font-weight:bold; font-style:italic; color: #666;">
                    @_asOnDateLabel
                </MudText>
            </div>

            <!-- Data Table -->
            <MudItem xs="12" Class="pa-4">
                <MudTable Items="_data"
                          Loading="_loading"
                          Dense="true"
                          Striped="true"
                          Bordered="true"
                          FixedHeader="true"
                          Height="700px"
                          Elevation="2"
                          Class="fixed-table"
                          RowsPerPage="50">
                    <HeaderContent>
                        <MudTh Style="background-color:#2a2f5b; color:white; width: 60px; text-align: center;">S.No</MudTh>
                        @foreach (var col in _cols)
                        {
                            <MudTh Style="@($"background-color:#2a2f5b; color:white; width: {col.Width}; text-align: center;")">
                                <MudTableSortLabel SortBy="new Func<Dictionary<string, object>, object>(x => x.ContainsKey(col.PropertyName) ? x[col.PropertyName] : string.Empty)">
                                    @col.Header
                                </MudTableSortLabel>
                            </MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="text-align: center;">@(_data.IndexOf(context) + 1)</MudTd>
                        @foreach (var col in _cols)
                        {
                            <MudTd Style="@(col.IsNumeric ? "text-align: right;" : "text-align: left;")">
                                @FormatValue(context, col)
                            </MudTd>
                        }
                    </RowTemplate>
                    <NoRecordsContent>
                        <td colspan="@(_cols.Count + 1)" style="text-align:center; padding: 40px;">
                            <MudText Typo="Typo.subtitle1" Color="Color.Error">No Data Found!</MudText>
                        </td>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                    </PagerContent>
                </MudTable>
            </MudItem>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // ---- UI / State ----
    [SupplyParameterFromQuery][Parameter] public string? Title { get; set; }

    private string _title => string.IsNullOrWhiteSpace(Title) ? "Top Depositors" : Title!;
    private string _asOnDateLabel = "";
    private bool _loading = true;

    private string SelectedZone { get; set; } = "All";
    private string SelectedRegion { get; set; } = "All";
    private string SelectedBranch { get; set; } = "All";

    // RBAC scope of the logged-in user (resolved in OnInitializedAsync). Used to disable the
    // filter dropdowns above the user's own level so the UI matches the enforced data scope.
    private MyDiary.Web.Features.Reports.Services.ReportUserScope? _scope;
    private bool ScopeIsCo => _scope?.IsCo ?? true;
    private bool ScopeAllowsRegionPick => _scope is null || _scope.IsCo || _scope.IsZone;
    private bool ScopeAllowsBranchPick => _scope is null || _scope.IsCo || _scope.IsZone || _scope.IsRegion;

    private List<Dictionary<string, object>> _zones = new();
    private List<Dictionary<string, object>> _regions = new();
    private List<Dictionary<string, object>> _branches = new();
    private List<Dictionary<string, object>> _data = new();

    // ---- Columns (match SELECT aliases) ----
    private readonly List<ColumnConfig> _cols = new()
    {
        new ColumnConfig { Header = "Zone",           PropertyName = "zone",         Width = "12%" },
        new ColumnConfig { Header = "Region",         PropertyName = "region",       Width = "12%" },
        new ColumnConfig { Header = "Branch",         PropertyName = "branch",       Width = "16%" },
        new ColumnConfig { Header = "Customer ID",    PropertyName = "custid",       Width = "10%" },
        new ColumnConfig { Header = "Customer Name",  PropertyName = "custname",     Width = "18%" },
        new ColumnConfig { Header = "Contact No.",    PropertyName = "phone",        Width = "14%" },
        new ColumnConfig { Header = "Address",        PropertyName = "address1",     Width = "18%" },
        new ColumnConfig { Header = "Total Balance",  PropertyName = "totalbalance", Width = "12%", IsNumeric = true, Format = "N2" }
    };

    protected override async Task OnInitializedAsync()
    {
        // RBAC: resolve the user's scope and pre-select their own zone/region/branch so the
        // (disabled) dropdowns show the locked-in value. LoadData re-clamps regardless.
        _scope = MyDiary.Web.Features.Reports.Services.ReportUserScope.Resolve(ReportScopeUser);
        if (_scope.IsZone) { SelectedZone = _scope.ZoneSolid; }
        else if (_scope.IsRegion) { SelectedZone = _scope.ZoneSolid; SelectedRegion = _scope.RegionSolid; }
        else if (_scope.IsBranch) { SelectedZone = _scope.ZoneSolid; SelectedRegion = _scope.RegionSolid; SelectedBranch = _scope.BranchSolid; }

        // Zone, Region, Branch lookups are independent — load in parallel with data
        var zonesTask = ReportService.GetLookupDataAsync(
            "zone_master",
            "zone_name_eng, zone_solid",
            "status='A'",
            "zone_name_eng"
        );

        var regionsTask = ReportService.GetLookupDataAsync(
            "region_master",
            "region_name, region_solid",
            "1=1",
            "region_name"
        );

        var branchesTask = ReportService.GetLookupDataAsync(
            "branch_master",
            "CONCAT(UPPER(branch_name),'  (',branch_code,')') as branch_name, sol_id",
            "1=1",
            "branch_name"
        );

        var dataTask = LoadData();

        await Task.WhenAll(zonesTask, regionsTask, branchesTask, dataTask);
        _zones = zonesTask.Result;
        _regions = regionsTask.Result;
        _branches = branchesTask.Result;
    }

    private async Task HandleZoneChanged(string value)
    {
        SelectedZone = value ?? "All";
        SelectedRegion = "All";
        SelectedBranch = "All";

        var regionWhere = SelectedZone.Equals("All", StringComparison.OrdinalIgnoreCase)
            ? "1=1"
            : $"zone_solid = '{SelectedZone}'";
        _regions = await ReportService.GetLookupDataAsync(
            "region_master",
            "region_name, region_solid",
            regionWhere,
            "region_name"
        );

        // Reset branches for All region
        _branches = await ReportService.GetLookupDataAsync(
            "branch_master",
            "CONCAT(UPPER(branch_name),'  (',branch_code,')') as branch_name, sol_id",
            "1=1",
            "branch_name"
        );

        await LoadData();
    }

    private async Task HandleRegionChanged(string value)
    {
        SelectedRegion = value ?? "All";
        SelectedBranch = "All";

        var branchWhere = SelectedRegion.Equals("All", StringComparison.OrdinalIgnoreCase)
            ? "1=1"
            : $"region_solid = '{SelectedRegion}'";
        _branches = await ReportService.GetLookupDataAsync(
            "branch_master",
            "CONCAT(UPPER(branch_name),'  (',branch_code,')') as branch_name, sol_id",
            branchWhere,
            "branch_name"
        );

        await LoadData();
    }

    private async Task HandleBranchChanged(string value)
    {
        SelectedBranch = value ?? "All";
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        // Build SELECT (aliases match _cols PropertyName)
        string selectColumns =
            "b.zone_name_eng as zone," +
            "b.region_name as region," +
            "b.branch_name as branch," +
            "a.custid as custid," +
            "a.custname as custname," +
            "(ISNULL(add1.PhoneNo,'') + '  ' + ISNULL(add1.HomePhNo,'') + '  ' + ISNULL(add1.MobilePhNo,'')) as phone," +
            "(ISNULL(add1.address1,'') + '  ' + ISNULL(add1.address2,'')) as address1," +
            "CAST(a.TotalBalance as decimal(18,2))/100000 as totalbalance";

        string fromJoin =
            "TopDepositors a  " +
            "JOIN Branch_Master b ON a.SolID = b.SOL_ID " +
            "LEFT JOIN CustomerAddress add1 ON a.CustID = add1.cifid";

        string where = "1=1";
        if (!string.Equals(SelectedZone, "All", StringComparison.OrdinalIgnoreCase))
            where += $" AND b.zone_solid = '{SelectedZone}'";
        if (!string.Equals(SelectedRegion, "All", StringComparison.OrdinalIgnoreCase))
            where += $" AND b.region_solid = '{SelectedRegion}'";
        if (!string.Equals(SelectedBranch, "All", StringComparison.OrdinalIgnoreCase))
            where += $" AND b.sol_id = '{SelectedBranch}'";

        // RBAC: clamp to the logged-in user's own scope for non-CO users, regardless of dropdowns
        // (fail-closed to BRANCH for unknown privilege).
        {
            var __scope = MyDiary.Web.Features.Reports.Services.ReportUserScope.Resolve(ReportScopeUser);
            if (__scope.IsZone) where += $" AND b.zone_solid = '{__scope.ZoneSolid}'";
            else if (__scope.IsRegion) where += $" AND b.region_solid = '{__scope.RegionSolid}'";
            else if (__scope.IsBranch) where += $" AND b.sol_id = '{__scope.BranchSolid}'";
        }

        string finalQuery = $"SELECT TOP 25 {selectColumns} FROM {fromJoin} WHERE {where} ORDER BY a.TotalBalance DESC";
        // Data query and as-on-date are independent - run in parallel
        var dataTask = ReportService.ExecuteRawQueryAsync(finalQuery);
        var dateTask = ReportService.GetAsOnDateAsync("TopDepositors");
        await Task.WhenAll(dataTask, dateTask);
        _data = dataTask.Result;
        string date = dateTask.Result;
        _asOnDateLabel = _data.Count > 0 ? $"Data As On -  {date} (Rs. in Lacs)" : "";

        _loading = false;
        StateHasChanged();
    }

    private async Task OnExportInternal()
    {
        var bytes = ReportService.ExportToExcel(_data, _cols, "TopDepositors");
        await JS.InvokeVoidAsync("BlazorDownloadFile",
            "TopDepositors.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private string FormatValue(Dictionary<string, object> row, ColumnConfig col)
    {
        if (!row.TryGetValue(col.PropertyName, out var val) || val == DBNull.Value || val == null) return "-";
        if (col.IsNumeric && decimal.TryParse(val.ToString(), out var d)) return d.ToString(col.Format);
        return val.ToString();
    }
}