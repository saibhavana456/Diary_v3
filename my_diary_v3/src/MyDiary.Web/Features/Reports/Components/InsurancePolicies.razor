            var policyStartDate =
    _policyStartDate.HasValue
        ? $"'{_policyStartDate.Value:yyyy-MM-dd}'"
        : "NULL";

            var policyEndDate =
                _policyEndDate.HasValue
                    ? $"'{_policyEndDate.Value:yyyy-MM-dd}'"
                    : "NULL";
            var renewalStatus = (_renewalStatus ?? "").Replace("'", "''");
