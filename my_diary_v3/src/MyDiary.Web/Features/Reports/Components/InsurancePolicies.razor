    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        string query = "SELECT * FROM InsurancePolicies WHERE IsDeleted = 'N' ORDER BY SortOrder";
        _data = await ReportService.ExecuteRawQueryAsync(query);

        _data = GetSortedDataForDisplay().ToList();

        _loading = false;
        StateHasChanged();
    }

    private async Task DownloadDocument(Dictionary<string, object> row)
    {
        if (row["PolicyDocument"] == DBNull.Value)
            return;

        var fileBytes = (byte[])row["PolicyDocument"];

        if (fileBytes == null || fileBytes.Length == 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "No document available for this policy.");

            return;
        }

        var fileName =
            row["PolicyDocumentName"]?.ToString()
            ?? "PolicyDocument.pdf";

        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            fileName,
            "application/octet-stream",
            Convert.ToBase64String(fileBytes));
    }

    private object GetAdvancedSortKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return (int.MaxValue, int.MaxValue, "");

        value = value.Trim();

        // 1021.1
        var decimalMatch = Regex.Match(
            value,
            @"^(\d+)\.(\d+)$");

        if (decimalMatch.Success)
        {
            return (
                int.Parse(decimalMatch.Groups[1].Value),
                int.Parse(decimalMatch.Groups[2].Value),
                ""
            );
        }

        // 1A, 1B
        var alphaMatch = Regex.Match(
            value,
            @"^(\d+)([A-Za-z]+)$");

        if (alphaMatch.Success)
        {
            return (
                int.Parse(alphaMatch.Groups[1].Value),
                0,
                alphaMatch.Groups[2].Value.ToUpper()
            );
        }

        // Pure number
        if (int.TryParse(value, out var num))
        {
            return (num, 0, "");
        }

        return (int.MaxValue, int.MaxValue, value);
    }

    private IEnumerable<Dictionary<string, object>> GetSortedDataForDisplay()
{
    var activePolicies = _data
        .Where(x =>
            !string.Equals(
                x["RenewalStatus"]?.ToString(),
                "Expired",
                StringComparison.OrdinalIgnoreCase))
        .OrderBy(x =>
            GetAdvancedSortKey(
                x["SNo"]?.ToString() ?? ""));

    var expiredPolicies = _data
        .Where(x =>
            string.Equals(
                x["RenewalStatus"]?.ToString(),
                "Expired",
                StringComparison.OrdinalIgnoreCase))
        .OrderBy(x =>
            GetAdvancedSortKey(
                x["SNo"]?.ToString() ?? ""));

    return activePolicies.Concat(expiredPolicies);
}



