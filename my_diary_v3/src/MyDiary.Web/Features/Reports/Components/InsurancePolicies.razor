    private (int Number, string Suffix) GetNaturalSortKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return (int.MaxValue, "");

        var match = System.Text.RegularExpressions.Regex.Match(
            value.Trim(),
            @"^(\d+)([A-Za-z]*)$");

        if (match.Success)
        {
            return (
                int.Parse(match.Groups[1].Value),
                match.Groups[2].Value.ToUpper()
            );
        }

        return (int.MaxValue, value);
    }

    private string FormatValue(Dictionary<string, object> row, ColumnConfig col)
    {
        if (!row.TryGetValue(col.PropertyName, out var val) || val == DBNull.Value)
            return "-";

        if (col.IsNumeric && decimal.TryParse(val.ToString(), out var d))
            return d.ToString(col.Format);

        return val.ToString();
    }
