@page "/reports/InsurancePolicies"
@using Microsoft.JSInterop
@using MudBlazor
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using Microsoft.AspNetCore.Components.Web
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Security.Claims
@using System.Text.RegularExpressions

@inject AuthenticationStateProvider AuthStateProvider

<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>Insurance Policies — My Diary</PageTitle>

<style>
    .fixed-table {
        table-layout: fixed !important;
        width: 100% !important;
    }

    .mud-table-container {
        overflow-x: auto;
    }

    .mud-table-head {
        background-color: #2a2f5b;
    }
</style>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudPaper Elevation="0" Style="background-color:#ffffff;">

            <MudGrid Spacing="2" Class="pa-4 align-center">

                <MudItem xs="12" sm="4">
                    <MudTextField T="string"
                                  Label="Search Policy Name / Insurer / Policy Number"
                                  @bind-Value="_searchText"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Dense="true"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>

                <MudSpacer />

                <MudItem xs="12" sm="4" Class="d-flex justify-end">

                    @if (_canAdd)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Style="background-color:green;color:white;font-size:11px;margin-right:10px;"
                                   OnClick="ShowAdd">
                            Add New
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Filled"
                               Style="background-color:#000066;color:white;font-size:11px;"
                               OnClick="OnExportInternal">
                        Export To Excel
                    </MudButton>

                </MudItem>

            </MudGrid>

            @if (_showAdd)
            {
                <MudPaper Class="pa-4 mx-4 mt-2 mb-2">

                    <MudGrid Spacing="2">

                        <!-- Row 1 -->
                        <MudItem xs="12" sm="3">
                            <MudTextField Label="S.No"
                                          @bind-Value="_sNo"
                                          Variant="Variant.Outlined"
                                          Validation="ValidateSNo"
                                          Required="true"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="3">

                            <MudTextField Label="Policy Name"
                                          @bind-Value="_policyName"
                                          Variant="Variant.Outlined"
                                          Validation="ValidatePolicyName"
                                          Required="true"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="User Vertical"
                                          @bind-Value="_userVertical"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Premium Paid By"
                                          @bind-Value="_premiumPaidBy"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Policy Number"
                                          @bind-Value="_policyNumber"
                                          Validation="ValidatePolicyNumber"
                                            Required="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <!-- Row 2 -->

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Inception Taxable Amount"
                                             Value="_inceptionTaxable"
                                             ValueChanged="InceptionTaxableChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Inception GST"
                                             Value="_inceptionGST"
                                             ValueChanged="InceptionGSTChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Inception Total Amount"
                                             Value="_inceptionTotal"
                                             ReadOnly="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Endorsement Invoice Upto Month"
                                          @bind-Value="_endorsementInvoiceUptoMonth"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <!-- Row 3 -->

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Endorsement Taxable Amount"
                                             Value="_endorsementTaxable"
                                             ValueChanged="EndorsementTaxableChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Endorsement GST"
                                             Value="_endorsementGST"
                                             ValueChanged="EndorsementGSTChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Endorsement Total Amount"
                                             Value="_endorsementTotal"
                                             ReadOnly="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Insurer Name"
                                          @bind-Value="_insurerName"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <!-- Row 4 -->

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Total Premium Taxable Amount"
                                             Value="_totalPremiumTaxable"
                                             ReadOnly="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Total Premium GST"
                                             Value="_totalPremiumGST"
                                             ReadOnly="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             Label="Total Premium Amount"
                                             Value="_totalPremiumTotal"
                                             ReadOnly="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudDatePicker Label="Policy Start Date"
                                           @bind-Date="_policyStartDate"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true" />

                            
                        </MudItem>
                        <MudItem xs="12" sm="3">
                        <MudDatePicker Label="Policy End Date"
                                       @bind-Date="_policyEndDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true" />
                        </MudItem>
                        <!-- Row 5 -->

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Renewal Status"
                                          @bind-Value="_renewalStatus"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">

                            <InputFile @key="_fileInputKey" OnChange="UploadDocument" accept=".pdf,application/pdf" />

                            @if (!string.IsNullOrWhiteSpace(_policyDocumentName))
                            {
                                <MudText Color="Color.Success">
                                    @_policyDocumentName
                                </MudText>
                            }

                        </MudItem>
                        

                        <!-- Buttons -->

                        <MudItem xs="12">

                            <MudButton Color="Color.Success"
                                       Variant="Variant.Filled"
                                       OnClick="SaveRow">
                                @(_isEdit ? "Update" : "Save")
                            </MudButton>

                            <MudButton Color="Color.Error"
                                       Variant="Variant.Filled"
                                       Class="ml-2"
                                       OnClick="CancelAdd">
                                Cancel
                            </MudButton>

                        </MudItem>

                    </MudGrid>

                </MudPaper>
            }
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudGrid Spacing="2">

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="Policy Name"
                                   @bind-Value="_filterPolicyName"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Clearable="true">

                            @foreach (var item in GetFilterValues("PolicyName"))
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="User Vertical"
                                   @bind-Value="_filterUserVertical"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Clearable="true">

                            @foreach (var item in GetFilterValues("UserVertical"))
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="Premium Paid By"
                                   @bind-Value="_filterPremiumPaidBy"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Clearable="true">

                            @foreach (var item in GetFilterValues("PremiumPaidBy"))
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="Policy Number"
                                   @bind-Value="_filterPolicyNumber"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Clearable="true">

                            @foreach (var item in GetFilterValues("PolicyNumber"))
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="Insurer Name"
                                   @bind-Value="_filterInsurerName"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Clearable="true">

                            @foreach (var item in GetFilterValues("InsurerName"))
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string"
                                   Label="Renewal Status"
                                   @bind-Value="_filterRenewalStatus"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Clearable="true">

                            @foreach (var item in GetFilterValues("RenewalStatus"))
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudDatePicker Label="Policy Start Date"
                                       @bind-Date="_filterPolicyStartDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Editable="true" />
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudDatePicker Label="Policy End Date"
                                       @bind-Date="_filterPolicyEndDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Editable="true" />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end mt-2">
                        <MudButton StartIcon="@Icons.Material.Filled.ClearAll"
                                   Variant="Variant.Filled"
                                   Color="Color.Error"
                                   OnClick="ClearFilters">
                            Clear Filters
                        </MudButton>
                    </MudItem>

                </MudGrid>
            </MudPaper>
            <!-- ✅ Data Table -->
            <MudItem xs="12" Class="pa-4">

                <MudTable Items="FilteredData"
                          Loading="_loading"
                          Dense="true"
                          Striped="true"
                          Bordered="true"
                          FixedHeader="true"
                          Height="700px"
                          Elevation="2"
                          Class="fixed-table"
                          RowsPerPage="50"
                          SortLabel="Sort By">

                    <!-- ✅ HEADER -->
                    <HeaderContent>

                        <MudTh Style="background-color:#2a2f5b; color:white; width:80px; text-align:center;">

                            <MudTableSortLabel T="Dictionary<string, object>"
                                               SortBy="@(x => GetNaturalSortKey(
                           x.ContainsKey("SNo")
                           ? x["SNo"]?.ToString() ?? ""
                           : ""))">
                                S.No
                            </MudTableSortLabel>

                        </MudTh>

                        @foreach (var col in VisibleColumns)
                        {
                            <MudTh Style="@($"background-color:#2a2f5b; color:white; width:{col.Width}; text-align:center;")">

                                @if (col.IsNumeric)
                                {
                                    <MudTableSortLabel T="Dictionary<string, object>"
                                                       SortBy="@(x =>
                           x.ContainsKey(col.PropertyName)
                               ? decimal.TryParse(
                                    x[col.PropertyName]?.ToString(),
                                    out var d)
                                    ? d
                                    : 0m
                               : 0m)">
                                        @col.Header
                                    </MudTableSortLabel>
                                }
                                else
                                {
                                    if (col.PropertyName == "PolicyEndDate")
                                    {
                                        <MudTableSortLabel T="Dictionary<string, object>"
                                                           SortBy="@(x =>
                            x.ContainsKey("PolicyEndDate")
                                ? Convert.ToDateTime(x["PolicyEndDate"])
                                : DateTime.MinValue)">
                                            @col.Header
                                        </MudTableSortLabel>
                                    }
                                    else
                                    {
                                        <MudTableSortLabel T="Dictionary<string, object>"
                                                           SortBy="@(x =>
                           x.ContainsKey(col.PropertyName)
                               ? x[col.PropertyName]?.ToString() ?? ""
                               : "")">
                                            @col.Header
                                        </MudTableSortLabel>
                                    }
                                }



                            </MudTh>
                        }
                        <MudTh Style="background-color:#2a2f5b;color:white;">
                            Policy Document
                        </MudTh>
                        
                        @if (_canAdd)
                        {
                            <MudTh Style="background:#2a2f5b;color:white;">
                                Action
                            </MudTh>
                        }

                    </HeaderContent>

                    <!-- ✅ ROW -->
                    <RowTemplate>
                        <MudTd Style="text-align:center;">
                            @(context.ContainsKey("SNo") ? context["SNo"] : "-")
                        </MudTd>
                        

                        @foreach (var col in VisibleColumns)
                        {
                            <MudTd Style="@(col.IsNumeric ? "text-align:right;" : "text-align:left;")">
                                @FormatValue(context, col)
                            </MudTd>
                        }

                        <MudTd>

                            @if (context["PolicyDocument"] != DBNull.Value
                            && context["PolicyDocument"] is byte[] bytes
                            && bytes.Length > 0)
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => DownloadDocument(context))">
                                    Download
                                </MudButton>
                            }

                        </MudTd>
                        @if (_canAdd)
                        {
                            <MudTd>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Style="margin-right:5px;"
                                           OnClick="@(() => EditRow(context))">
                                    Edit
                                </MudButton>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteRow(context))">
                                    Delete
                                </MudButton>

                            </MudTd>
                        }
                    </RowTemplate>

                    <!-- ✅ NO DATA -->
                    <NoRecordsContent>
                        <td colspan="@(VisibleColumns.Count + 2)" style="text-align:center; padding:40px;">
                            <MudText Typo="Typo.subtitle1" Color="Color.Error">
                                No Data Found!
                            </MudText>
                        </td>
                    </NoRecordsContent>

                    <!-- ✅ PAGER -->
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
                    </PagerContent>

                </MudTable>

            </MudItem>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _loading = true;
    private List<Dictionary<string, object>> _data = new();
    private bool _canAdd = false;
    private bool _showAdd = false;
    private bool _isEdit = false;
    private int _editId;
    private string _sNo = "";
    private string _policyName = "";
    private string _userVertical = "";
    private string _premiumPaidBy = "";
    private string _policyNumber = "";
    private string? _policyValidityError;
    private string _fileInputKey = Guid.NewGuid().ToString();
    private decimal? _inceptionTaxable;
    private decimal? _inceptionGST;
    private decimal? _inceptionTotal;
    private string _filterPolicyName = "";
    private string _filterUserVertical = "";
    private string _filterPremiumPaidBy = "";
    private string _filterPolicyNumber = "";
    private string _filterEndorseMonth = "";
    private string _filterInsurerName = "";
    private string _filterRenewalStatus = "";
    private DateTime? _filterPolicyStartDate;
private DateTime? _filterPolicyEndDate;
    private string _endorsementInvoiceUptoMonth = "";

    private decimal? _endorsementTaxable;
    private decimal? _endorsementGST;
    private decimal? _endorsementTotal;

    private decimal? _totalPremiumTaxable;
    private decimal? _totalPremiumGST;
    private decimal? _totalPremiumTotal;
    private string _searchText = "";

    private string _insurerName = "";
    private DateTime? _policyStartDate;
    private DateTime? _policyEndDate;
    private string _renewalStatus = "";

    private byte[]? _policyDocumentBytes;
    private string _policyDocumentName = "";

 
    private IEnumerable<string> GetFilterValues(string columnName)
    {
        return FilterDataForDropdowns
            .Where(x =>
                x.ContainsKey(columnName) &&
                x[columnName] != DBNull.Value)
            .Select(x => x[columnName]?.ToString() ?? "")
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x);
    }

    private IEnumerable<Dictionary<string, object>> FilterDataForDropdowns =>
    _data.Where(x =>

        (string.IsNullOrEmpty(_filterPolicyName)
            || x["PolicyName"]?.ToString() == _filterPolicyName)

        &&

        (string.IsNullOrEmpty(_filterUserVertical)
            || x["UserVertical"]?.ToString() == _filterUserVertical)


        &&
    (
    !_filterPolicyStartDate.HasValue
    ||
    (
        x["PolicyStartDate"] != DBNull.Value &&
        Convert.ToDateTime(x["PolicyStartDate"]).Date
        >= _filterPolicyStartDate.Value.Date
    )
    )

    &&
    (
    !_filterPolicyEndDate.HasValue
    ||
    (
        x["PolicyEndDate"] != DBNull.Value &&
        Convert.ToDateTime(x["PolicyEndDate"]).Date
        <= _filterPolicyEndDate.Value.Date
    )
    ) 
        &&

        (string.IsNullOrEmpty(_filterPremiumPaidBy)
            || x["PremiumPaidBy"]?.ToString() == _filterPremiumPaidBy)

        &&

        (string.IsNullOrEmpty(_filterPolicyNumber)
            || x["PolicyNumber"]?.ToString() == _filterPolicyNumber)

        &&

        (string.IsNullOrEmpty(_filterEndorseMonth)
            || x["Endorsement_InvoiceUptoMonth"]?.ToString() == _filterEndorseMonth)

        &&

        (string.IsNullOrEmpty(_filterInsurerName)
            || x["InsurerName"]?.ToString() == _filterInsurerName)

        &&

        (string.IsNullOrEmpty(_filterRenewalStatus)
            || x["RenewalStatus"]?.ToString() == _filterRenewalStatus)
    );

    private IEnumerable<Dictionary<string, object>> FilteredData =>
    _data.Where(x =>

        (string.IsNullOrWhiteSpace(_searchText) ||
         (x.ContainsKey("PolicyName") &&
          x["PolicyName"]?.ToString()?.Contains(_searchText,
            StringComparison.OrdinalIgnoreCase) == true) ||

         (x.ContainsKey("InsurerName") &&
          x["InsurerName"]?.ToString()?.Contains(_searchText,
            StringComparison.OrdinalIgnoreCase) == true) ||

         (x.ContainsKey("PolicyNumber") &&
          x["PolicyNumber"]?.ToString()?.Contains(_searchText,
            StringComparison.OrdinalIgnoreCase) == true))

        &&

        (string.IsNullOrWhiteSpace(_filterPolicyName) ||
         (x["PolicyName"]?.ToString() ?? "")
         .Contains(_filterPolicyName, StringComparison.OrdinalIgnoreCase))

        &&

        (string.IsNullOrWhiteSpace(_filterUserVertical) ||
         (x["UserVertical"]?.ToString() ?? "")
         .Contains(_filterUserVertical, StringComparison.OrdinalIgnoreCase))

        &&

        (string.IsNullOrWhiteSpace(_filterPremiumPaidBy) ||
         (x["PremiumPaidBy"]?.ToString() ?? "")
         .Contains(_filterPremiumPaidBy, StringComparison.OrdinalIgnoreCase))

        &&

        (string.IsNullOrWhiteSpace(_filterPolicyNumber) ||
         (x["PolicyNumber"]?.ToString() ?? "")
         .Contains(_filterPolicyNumber, StringComparison.OrdinalIgnoreCase))

        &&

        (string.IsNullOrWhiteSpace(_filterEndorseMonth) ||
         (x["Endorsement_InvoiceUptoMonth"]?.ToString() ?? "")
         .Contains(_filterEndorseMonth, StringComparison.OrdinalIgnoreCase))

        &&

        (string.IsNullOrWhiteSpace(_filterInsurerName) ||
         (x["InsurerName"]?.ToString() ?? "")
         .Contains(_filterInsurerName, StringComparison.OrdinalIgnoreCase))

        &&

        (string.IsNullOrWhiteSpace(_filterRenewalStatus) ||
         (x["RenewalStatus"]?.ToString() ?? "")
         .Contains(_filterRenewalStatus, StringComparison.OrdinalIgnoreCase))

        &&

        (
            !_filterPolicyStartDate.HasValue ||
            (x["PolicyStartDate"] != DBNull.Value &&
             Convert.ToDateTime(x["PolicyStartDate"]).Date
                >= _filterPolicyStartDate.Value.Date)
        )

        &&

        (
            !_filterPolicyEndDate.HasValue ||
            (x["PolicyEndDate"] != DBNull.Value &&
             Convert.ToDateTime(x["PolicyEndDate"]).Date
                <= _filterPolicyEndDate.Value.Date)
        )
    );

    private void ClearFilters()
    {
        _filterPolicyName = null;
        _filterUserVertical = null;
        _filterPremiumPaidBy = null;
        _filterPolicyNumber = null;
        _filterInsurerName = null;
        _filterRenewalStatus = null;

        _filterPolicyStartDate = null;
        _filterPolicyEndDate = null;
    }

    private object GetSortValue(
    Dictionary<string, object> row,
    ColumnConfig col)
    {
        if (!row.ContainsKey(col.PropertyName) ||
            row[col.PropertyName] == null ||
            row[col.PropertyName] == DBNull.Value)
            return "";

        if (col.IsNumeric)
        {
            return Convert.ToDecimal(row[col.PropertyName]);
        }

        return row[col.PropertyName]?.ToString() ?? "";
    }

    private string ValidateSNo(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "S.No is required";

        return null;
    }

    private string ValidatePolicyName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Policy Name is required";

        return null;
    }

    private string ValidatePolicyNumber(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Policy Number is required";

        return null;
    }

    private string ValidatePolicyDates()
    {
        if (!_policyStartDate.HasValue)
            return "Policy Start Date is required";

        if (!_policyEndDate.HasValue)
            return "Policy End Date is required";

        if (_policyEndDate < _policyStartDate)
            return "End Date cannot be earlier than Start Date";

        return null;
    }

    private async Task UploadDocument(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        // PDF validation
        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Only PDF files are allowed.");

            _policyDocumentBytes = null;
            _policyDocumentName = "";

            return;
        }

        // 20 MB validation
        const long maxSize = 20 * 1024 * 1024;

        if (file.Size > maxSize)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "File size cannot exceed 20 MB.");

            _policyDocumentBytes = null;
            _policyDocumentName = "";
            _fileInputKey = Guid.NewGuid().ToString();
            StateHasChanged();
            return;
        }

        _policyDocumentName = file.Name;

        using var ms = new MemoryStream();

        await file.OpenReadStream(maxSize)
                  .CopyToAsync(ms);

        _policyDocumentBytes = ms.ToArray();
    }

