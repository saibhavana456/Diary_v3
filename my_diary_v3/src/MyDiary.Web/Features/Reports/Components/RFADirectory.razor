    //  UPLOAD
    // ═══════════════════════════════════════════════════

    private void OpenUploadDialog()
    {
        uploadMode = "AddNew";
        uploadDate = null;
        uploadModifyDate = null;
        uploadFile = null;
        uploadFileSelected = false;
        uploadFileName = "";
        isUploading = false;
        showUploadDialog = true;
    }

    private void OnUploadFileSelected(InputFileChangeEventArgs e)
    {
        uploadFile = e.File;
        uploadFileSelected = true;
        uploadFileName = e.File.Name;
        Snackbar.Add($"{uploadFileName} selected.", Severity.Info);
    }

    private async Task ExecuteUpload()
    {
        if (uploadFile == null)
        {
            Snackbar.Add("Please select a file.", Severity.Warning);
            return;
        }

        DateTime targetDate;

        if (uploadMode == "AddNew")
        {
            if (!uploadDate.HasValue)
            {
                Snackbar.Add("Please select a Position as of Date.", Severity.Warning);
                return;
            }
            targetDate = uploadDate.Value;
        }
        else
        {
            if (!uploadModifyDate.HasValue)
            {
                Snackbar.Add("Please select an existing date.", Severity.Warning);
                return;
            }
            targetDate = uploadModifyDate.Value;
        }

        isUploading = true;

        try
        {
            using var ms = new MemoryStream();
            await uploadFile.OpenReadStream(50 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            RFAImportResult result;

            if (uploadMode == "AddNew")
            {
                result = await RFAService.ImportAddNewAsync(ms, targetDate, currentUser);
            }
            else
            {
                result = await RFAService.ImportModifyExistingAsync(ms, targetDate, currentUser);
            }

            if (result.Success)
            {
                showUploadDialog = false;

                // Refresh dates and data
                uploadDates = await RFAService.GetUploadDatesAsync();

                await OnDateChanged(targetDate);

                // selectedDate = targetDate;
                // currentPage = 1;
                // await LoadFilters();
                // await LoadData();

                await JS.InvokeVoidAsync("resetFileInput", "rfaExcelFile");

                await DialogService.ShowMessageBox("Success", result.Message);
                uploadHistory = await RFAService.GetUploadHistoryAsync(targetDate);
            }
            else
            {
                await DialogService.ShowMessageBox("Upload Failed", result.Message);
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "RFADirectory: upload failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        finally
        {
            isUploading = false;
        }
    }

