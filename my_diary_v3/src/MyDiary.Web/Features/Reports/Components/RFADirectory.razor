    private async Task ExportExcel()
    {
        if (!selectedDate.HasValue) return;

        try
        {
            var fileBytes = await RFAService.ExportExcelAsync(selectedDate.Value, selectedZone, selectedRegion, searchString);
            var fileName = $"RFA_Records_{selectedDate.Value:yyyyMMdd}.xlsx";

            await JS.InvokeVoidAsync(
                "BlazorDownloadFile",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(fileBytes));
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "RFADirectory: Excel export failed");
            await DialogService.ShowMessageBox("Export Failed", UserFacingError.Generic);
        }
    }

