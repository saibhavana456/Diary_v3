    private async Task DeleteEntry(RFARecordModel item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Delete Entry",
            $"Are you sure you want to delete the record for {item.NameOfBorrower} (PAN: {item.PAN})?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm != true) return;

        var success = await RFAService.DeleteRecordAsync(item.SNo, currentUser);

        if (success)
        {
            Snackbar.Add("Record deleted successfully.", Severity.Success);
            await LoadData();
        }
        else
        {
            Snackbar.Add("Failed to delete record.", Severity.Error);
        }
    }

    private async Task DeleteAllForSelectedDate()
    {
        if (!selectedDate.HasValue) return;

        var dateLabel = selectedDate.Value.ToString("dd-MM-yyyy");

        bool? confirm = await DialogService.ShowMessageBox(
            "Delete ALL Records",
            $"This will permanently delete ALL {totalRecords} record(s) for position date {dateLabel}. " +
            "This action cannot be undone. Are you sure you want to proceed?",
            yesText: "Delete All",
            cancelText: "Cancel");

        if (confirm != true) return;

        var success = await RFAService.DeleteAllForDateAsync(selectedDate.Value, currentUser);

        if (success)
        {
            Snackbar.Add($"All records for {dateLabel} have been deleted.", Severity.Success);

            uploadDates = await RFAService.GetUploadDatesAsync();
            selectedDate = null;
            selectedZone = null;
            selectedRegion = null;
            zonalOffices.Clear();
            regionalOffices.Clear();
            entries.Clear();
            totalRecords = 0;
            totalPages = 1;
            currentPage = 1;

            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Snackbar.Add($"Failed to delete records for {dateLabel}.", Severity.Error);
        }
    }

