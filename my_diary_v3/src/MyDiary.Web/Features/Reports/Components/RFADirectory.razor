    private async Task ConfirmAndExportPdf()
    {
        if (!selectedDate.HasValue) return;

        // BRD requirement: show alert before download
        bool? confirm = await DialogService.ShowMessageBox(
            "Download Confirmation",
            "This file is confidential and traceable. " +
            "User details will be embedded as watermark.\n\n" +
            "Do you want to proceed with the download?",
            yesText: "Download",
            cancelText: "Cancel");

        if (confirm != true) return;

        try
        {
            var fileBytes = await RFAService.ExportPdfAsync(selectedDate.Value, selectedZone, selectedRegion, searchString, currentUser);
            var fileName = $"RFA_Records_{selectedDate.Value:yyyyMMdd}.pdf";

            await RFAService.LogDownloadAsync(selectedDate.Value,"PDF",currentUser,selectedZone,selectedRegion,searchString);

            await JS.InvokeVoidAsync("BlazorDownloadFile",fileName,"application/pdf",Convert.ToBase64String(fileBytes));
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "RFADirectory: PDF export failed");
            await DialogService.ShowMessageBox("Export Failed", UserFacingError.Generic);
        }
    }


