    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        // CO CCM users can upload/edit/delete; everyone else can view & download
        // canManage = !string.IsNullOrEmpty(currentUser)
        //             && CcmAuthorizedUsers.Contains(currentUser);

        canManage = await RFAService.HasManageAccessAsync(currentUser);

        uploadDates = await RFAService.GetUploadDatesAsync();

        await InvokeAsync(StateHasChanged);
    }

    // ═══════════════════════════════════════════════════
    //  AVL DATE SEARCHING FOR Position as of Date Field
    // ═══════════════════════════════════════════════════
    private Task<IEnumerable<DateTime?>> SearchDates(string value, CancellationToken token)
    {
        IEnumerable<DateTime?> dates = uploadDates
            .Select(x => (DateTime?)x.PositionAsOfDate.Date).Distinct().OrderByDescending(x => x);

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(dates);

        IEnumerable<DateTime?> filteredDates = dates.Where(d =>
            d.HasValue &&
            d.Value.ToString("dd-MM-yyyy")
                .Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filteredDates);
    }

