    private async Task OnDateChanged(DateTime? value)
    {
        try
        {
            selectedDate = value;

            selectedZone = null;
            selectedRegion = null;
            currentPage = 1;

            if (!selectedDate.HasValue)
            {
                entries.Clear();
                uploadHistory.Clear();
                zonalOffices.Clear();
                regionalOffices.Clear();

                totalRecords = 0;
                totalPages = 1;
                await InvokeAsync(StateHasChanged);
                return;
            }
            await LoadFilters();
            await LoadData();

            uploadHistory = await RFAService.GetUploadHistoryAsync(selectedDate.Value);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "RFADirectory: failed to load data/filters");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
    }

    private async Task OnZoneChanged(string value)
    {
        selectedZone = value;
        selectedRegion = null;
        currentPage = 1;

        if (selectedDate.HasValue)
        {
            regionalOffices = await RFAService.GetRegionalOfficesAsync(
                selectedDate.Value, selectedZone);
        }

        await LoadData();
    }

    private async Task OnRegionChanged(string value)
    {
        selectedRegion = value;
        currentPage = 1;
        await LoadData();
    }

    private void OnSearchDebounced(string value)
    {
        searchString = value;
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();

        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.Elapsed += async (s, e) =>
        {
            _debounceTimer.Stop();
            currentPage = 1;
            await InvokeAsync(LoadData);
        };
        _debounceTimer.Start();
    }

    private async Task PageChanged(int i)
    {
        currentPage = i;
        await LoadData();
    }

