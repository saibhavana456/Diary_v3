    private void OpenEditDialog(RFARecordModel item)
    {
        editModel = new RFAEditModel
            {
                SNo = item.SNo,
                UploadId = item.UploadId,
                PositionAsOfDate = item.PositionAsOfDate,
                ZonalOffice = item.ZonalOffice ?? "",
                RegionalOffice = item.RegionalOffice ?? "",
                BranchName = item.BranchName ?? "",
                BranchSOL = item.BranchSOL ?? "",
                NameOfBorrower = item.NameOfBorrower ?? "",
                CIFID = item.CIFID ?? "",
                PAN = item.PAN ?? "",
                NameOfBank = item.NameOfBank ?? "",
                DateOfRFAClassification = item.DateOfRFAClassification,
                Remarks = item.Remarks ?? ""
            };
        showEditDialog = true;
    }

    private async Task SaveEditRecord()
    {
        if (string.IsNullOrWhiteSpace(editModel.PAN))
        {
            Snackbar.Add("PAN is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(editModel.NameOfBorrower))
        {
            Snackbar.Add("Name of Borrower is required.", Severity.Error);
            return;
        }

        var success = await RFAService.UpdateRecordAsync(editModel, currentUser);

        if (success)
        {
            Snackbar.Add("Record updated successfully.", Severity.Success);
            showEditDialog = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add("Failed to update record.", Severity.Error);
        }
    }

