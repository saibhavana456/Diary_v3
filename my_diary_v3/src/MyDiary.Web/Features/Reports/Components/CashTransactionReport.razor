        new ColumnConfig { Header = "Region", PropertyName = "region_name",   Width = "12%" },
        new ColumnConfig { Header = "Branch", PropertyName = "Branch_Name",   Width = "18%" },
        new ColumnConfig { Header = "SolID",  PropertyName = "SolId",         Width = "8%"  },

        // Receipts - With Debit Card
        new ColumnConfig { Header = "R WDC <=10K",   PropertyName = "OTC_R_WDCARD_10K",   IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "R WDC 10-25K",    PropertyName = "OTC_R_WDCARD_1025K", IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "R WDC >25K",    PropertyName = "OTC_R_WDCARD_25K",   IsNumeric = true, Width="6%" },

        // Receipts - Without Debit Card
        new ColumnConfig { Header = "R WODC <=10K",  PropertyName = "OTC_R_WODCARD_10K",  IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "R WODC 10-25K",   PropertyName = "OTC_R_WODCARD_1025K",IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "R WODC >25K",   PropertyName = "OTC_R_WODCARD_25K",  IsNumeric = true, Width="6%" },

        // Payments - With Debit Card
        new ColumnConfig { Header = "P WDC <=10K",   PropertyName = "OTC_P_WDCARD_10K",   IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "P WDC 10-25K",    PropertyName = "OTC_P_WDCARD_1025K", IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "P WDC >25K",    PropertyName = "OTC_P_WDCARD_25K",   IsNumeric = true, Width="6%" },

        // Payments - Without Debit Card
        new ColumnConfig { Header = "P WODC <=10K",  PropertyName = "OTC_P_WODCARD_10K",  IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "P WODC 10-25K",   PropertyName = "OTC_P_WODCARD_1025K",IsNumeric = true, Width="6%" },
        new ColumnConfig { Header = "P WODC >25K",   PropertyName = "OTC_P_WODCARD_25K",  IsNumeric = true, Width="6%" },
    };

    private readonly List<ColumnConfig> _colsFY = new()
    {
