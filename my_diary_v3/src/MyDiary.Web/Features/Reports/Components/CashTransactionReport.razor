@page "/reports/cash-transaction-report"
@using Microsoft.JSInterop
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using MyDiary.Web.Features.Shared.Components
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject MyDiary.Core.Abstractions.ICurrentUser ReportScopeUser



<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>Cash Transactions — My Diary</PageTitle>

<!-- ===================== OTC (Monthly) � existing ===================== -->
<DynamicDashboard Config="_configMonthly"
                  Data="_dataMonthly"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabelMonthly"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExportMonthly" />

<!-- ===================== OTC (FY) � existing ===================== -->

<DynamicDashboard Config="_configFY"
                  Data="_dataFY"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabelFY"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExportFY" />

<!-- ===================== Digital (Monthly) � NEW ===================== -->
<DynamicDashboard Config="_configDigiMonthly"
                  Data="_dataDigiMonthly"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabelDigiMonthly"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExportDigiMonthly" />

<!-- ===================== Digital (FY) � NEW ===================== -->
<DynamicDashboard Config="_configDigiFY"
                  Data="_dataDigiFY"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabelDigiFY"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExportDigiFY" />

@code {
    // Optional page title
    [SupplyParameterFromQuery][Parameter] public string? Title { get; set; }

    // Shared Filters ("1"=All(Summary), "all"=All(Levelwise))
    private string _selectedZone = "1", _selectedRegion = "1", _selectedBranch = "1";

    // Shared state
    private bool _loading = true;

    // OTC datasets (Monthly & FY) � existing
    private List<Dictionary<string, object>> _dataMonthly = new();
    private List<Dictionary<string, object>> _dataFY = new();

    // Digital datasets (Monthly & FY) � NEW
    private List<Dictionary<string, object>> _dataDigiMonthly = new();
    private List<Dictionary<string, object>> _dataDigiFY = new();

    // Labels
    private string _asOnDateLabelMonthly = "";
    private string _asOnDateLabelFY = "";
    private string _asOnDateLabelDigiMonthly = ""; // NEW
    private string _asOnDateLabelDigiFY = "";      // NEW

    // Dashboard configs
    private ReportConfig _configMonthly = new();
    private ReportConfig _configFY = new();
    private ReportConfig _configDigiMonthly = new(); // NEW
    private ReportConfig _configDigiFY = new();      // NEW

    // User context (wire to claims/session)
    // CO | ZONE | REGION | BRANCH
    private string _userPrivilege = "CO";
    private string _userZoneSolid = "00000", _userRegionSolid = "00000", _userBranchSolid = "00000";

    // ---------------- Columns (OTC Monthly: OTC_*, FY: FY_OTC_*) � existing ----------------
    private readonly List<ColumnConfig> _colsMonthly = new()
    {
