            cols.Add(new ColumnConfig { Header = "Re-KYC", PropertyName = "REKYC", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "Debit Cards Issued", PropertyName = "DEBIT_CARD_ISSUED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "PPF ACs Opened", PropertyName = "PPF_ACCS_OPENED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "SSA ACs Opened", PropertyName = "SSA_ACCS_OPENED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "SCSS ACs Opened", PropertyName = "SCSS_ACCS_OPENED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "KVP ACs Opened", PropertyName = "KVP_ACCS_OPENED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "MSSC ACs Opened", PropertyName = "MSSC_ACCS_OPENED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "Form 15G/H", PropertyName = "FORM_15G_15H", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "Locker Operated", PropertyName = "LOCKER_OPERATED", IsNumeric = true, Format = "N0" });
            cols.Add(new ColumnConfig { Header = "Nomination Updated", PropertyName = "NOMINATION_UPDATED", IsNumeric = true, Format = "N0" });
        }

        cols.Add(new ColumnConfig { Header = "Total Transactions", PropertyName = "TOTAL_TRANSACTIONS", IsNumeric = true, Format = "N0" });
        cols.Add(new ColumnConfig { Header = "Avg. Footfall", PropertyName = "AVG_FOOTFALL", IsNumeric = true, Format = "N0" });

        return cols;
    }

    // Helper methods
    private string GetValue(Dictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var v) && v != null && v != DBNull.Value)
            return v.ToString()!;
        return "-";
    }

    private string FormatNumber(Dictionary<string, object> row, string key)
    {
        if (!row.TryGetValue(key, out var v) || v == null || v == DBNull.Value)
            return "-";

        if (decimal.TryParse(v.ToString(), out var d))
            return d.ToString("N0");

        return v.ToString()!;
    }
