@page "/reports/DailyApprovedRates"
@using Microsoft.JSInterop
@using MudBlazor
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject IStaticAssetPathResolver Assets
@inject IOptions<GapReportSettings> ReportConfig
@using Microsoft.Extensions.Options
@using MyDiary.Web.Features.Focus360.Components
@using MyDiary.Web.Features.Focus360.Models
@using MyDiary.Web.Features.Focus360.Services
@using MyDiary.Web.Features.Assurance.Services
@using MyDiary.Web.Features.Assurance.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyDiary.Web.Features.Landing_Dashboard_V2.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Services
@using MyDiary.Web.Features.OperationDashboard.Services
@using MyDiary.Web.Features.Shared.Components
@using global::RequestPortal.Web.Shared
@using Microsoft.AspNetCore.Components.Web
@using System.Data
@using MyDiary.Web.Core.Extensions
@inject IGapService GapSvc
@inject MyDiary.Core.Abstractions.ICurrentUser ReportScopeUser

<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>Daily Approved Rates Report — My Diary</PageTitle>

<style>
    .fixed-table {
        table-layout: fixed !important;
        width: 100% !important;
    }

    .mud-table-container {
        overflow-x: auto;
    }

    .mud-table-head {
        background-color: #2a2f5b !important;
    }
</style>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudPaper Elevation="0" Style="background-color:#ffffff;">

            <!-- ✅ Filters -->
            <MudGrid Spacing="2" Class="pa-4 align-center">

                <MudItem xs="15" sm="2">
                    <MudSelect T="string" Label="Zone"
                               Value="SelectedZone"
                               ValueChanged="HandleZoneChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        @foreach (var z in _zones)
                        {
                            <MudSelectItem Value="@z["zone_solid"].ToString()">
                                @z["zone_name_eng"]
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="15" sm="2">
                    <MudSelect T="string" Label="Region"
                               Value="SelectedRegion"
                               ValueChanged="HandleRegionChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        @foreach (var r in _regions)
                        {
                            <MudSelectItem Value="@r["region_solid"].ToString()">
                                @r["region_name"]
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="15" sm="2">
                    <MudSelect T="string" Label="Branch"
                               Value="SelectedBranch"
                               ValueChanged="HandleBranchChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        @foreach (var b in _branches)
                        {
                            <MudSelectItem Value="@b["sol_id"].ToString()">
                                @b["branch_name"]
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- From Date -->

                <MudItem xs="12" sm="2">
                    <MudSelect T="string"
                               Label="Month"
                               Value="SelectedMonth"
                               ValueChanged="HandleMonthChanged"
                               Disabled="DisableMonth"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">

                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        <MudSelectItem Value="@("1")">January</MudSelectItem>
                        <MudSelectItem Value="@("2")">February</MudSelectItem>
                        <MudSelectItem Value="@("3")">March</MudSelectItem>
                        <MudSelectItem Value="@("4")">April</MudSelectItem>
                        <MudSelectItem Value="@("5")">May</MudSelectItem>
                        <MudSelectItem Value="@("6")">June</MudSelectItem>
                        <MudSelectItem Value="@("7")">July</MudSelectItem>
                        <MudSelectItem Value="@("8")">August</MudSelectItem>
                        <MudSelectItem Value="@("9")">September</MudSelectItem>
                        <MudSelectItem Value="@("10")">October</MudSelectItem>
                        <MudSelectItem Value="@("11")">November</MudSelectItem>
                        <MudSelectItem Value="@("12")">December</MudSelectItem>

                    </MudSelect>
                </MudItem>
                <MudItem xs="15" sm="2">
                    <MudDatePicker Label="From Date"
                                   Date="FromDate"
                                   DateChanged="HandleFromDateChanged"
                                   Disabled="DisableDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true" />
                </MudItem>

                <MudItem xs="15" sm="2">
                    <MudDatePicker Label="To Date"
                                   Date="ToDate"
                                   DateChanged="HandleToDateChanged"
                                   Disabled="DisableDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true" />
                </MudItem>
                <MudItem xs="15" sm="2"> </MudItem>
                <MudItem xs="15" sm="2"> </MudItem>
                <MudItem xs="15" sm="2"> </MudItem>
                <MudItem xs="15" sm="2"> </MudItem>

                <MudItem xs="15" sm="4" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Style="font-size:11px;margin-left:10px;"
                               OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                    @if (_canAdd)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Style="background-color: green; color:white; font-size:11px; margin-right:10px;"
                                   OnClick="ShowAdd">
                            Add New
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Filled"
                               Style="background-color:#000066; color:white; font-size:11px;"
                               OnClick="OnExportInternal">
                        Export
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Style="background-color:#0078D7; color:white; font-size:11px; margin-left:10px;"
                               OnClick="OnExportToWord">
                        Export Word
                    </MudButton>
                </MudItem>

            </MudGrid>

            <!-- ✅ ADD FORM -->
            @if (_showAdd)
            {
                <MudPaper Class="pa-4 mx-4 mt-2 mb-2">

                    <MudGrid Spacing="2">

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Name of the Borrower"
                                          @bind-Value="_borrower"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="SOL ID"
                                          Value="_solid"
                                          ValueChanged="@(async (string value) => await OnSolChanged(value))"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>



                        <MudItem xs="12" md="3">
                            <MudTextField Label="Nature Of Limit"
                                          @bind-Value="_natureOfLimit"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Limit Sanctioned"
                                          @bind-Value="_limitSanctioned"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Limit O/S"
                                          @bind-Value="_limitOutstanding"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Branch"
                                          @bind-Value="_branch"
                                          ReadOnly
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Region"
                                          @bind-Value="_region"
                                          ReadOnly
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Zone"
                                          @bind-Value="_zone"
                                          ReadOnly
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <!-- Row 3 -->

                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="Date Of Sanction"
                                           @bind-Date="_dateOfSanction"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Sanction Authority"
                                          @bind-Value="_sanctionAuthority"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="External Rating"
                                          @bind-Value="_externalRating"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Internal Rating"
                                          @bind-Value="_internalRating"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <!-- Row 4 -->

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Amount Proposed"
                                          @bind-Value="_amountProposed"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Months T-Bill Rate / MCLR"
                                          @bind-Value="_months"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        @* <MudItem xs="12" md="3">
                    <MudSelect T="string"
                    Label="T-Bill / MCLR"
                    @bind-Value="_interestTable"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Dense="true">

                    <MudSelectItem Value="@("MCLR")">MCLR</MudSelectItem>
                    <MudSelectItem Value="@("T-BILL")">T-BILL</MudSelectItem>

                    </MudSelect>
                    </MudItem> *@

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Rate of Interest Previous Transaction"
                                          @bind-Value="_previousROI"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <!-- Row 5 -->

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Effective ROI at the time of availment"
                                          @bind-Value="_effectiveROI"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField Label="Tenor"
                                          @bind-Value="_tenor"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="Likely Date Of Availment"
                                           @bind-Date="_likelyAvailmentDate"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true" />
                        </MudItem>

                        <MudItem xs="12" md="3" Class="d-flex align-center">
                            <MudCheckBox T="bool"
                                         @bind-Value="_isRollover"
                                         Label="Rollover" />
                        </MudItem>

                        <!-- Row 6 -->

                        <MudItem xs="12" md="3" Class="d-flex align-center">
                            <MudCheckBox T="bool"
                                         @bind-Value="_bulkDepositAccepted"
                                         Label="Whether Bulk Deposit Accepted from the customer and subsiding as on date" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       Class="mr-2"
                                       OnClick="SaveRow">
                                Save
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="CancelAdd">
                                Cancel
                            </MudButton>
                        </MudItem>

                    </MudGrid>

                </MudPaper>
            }

            <!-- ✅ TABLE -->
            <MudItem xs="12" Class="pa-4">
                <MudTable Items="_data"
                          Loading="_loading"
                          Dense="true"
                          Striped="true"
                          Bordered="true"
                          FixedHeader="true"
                          Height="700px"
                          Elevation="2"
                          Class="fixed-table"
                          RowsPerPage="50">

                    <HeaderContent>

                        <MudTh Style="background-color:#2a2f5b; color:white; width:60px; text-align:center;">
                            S.No
                        </MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Branch</MudTh>


                        <MudTh Style="background-color:#2a2f5b; color:white;">Name of the Borrower</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Nature Of Limit</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Limit Sanctioned</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Limit O/S</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Date Of Sanction</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Sanction Authority</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">External Rating</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Internal Rating</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Amount Proposed</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Months T-Bill Rate (Present)/MCLR</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">T-Bill / MCLR</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Rate of Interest Previous Transaction</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Effective ROI at the time of availment</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Tenor</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Likely Date Of Availment</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">Rollover</MudTh>

                        <MudTh Style="background-color:#2a2f5b; color:white;">
                            Whether Bulk Deposit Accepted from the customer and subsiding as on date
                        </MudTh>

                    </HeaderContent>


                    <RowTemplate>

                        <MudTd>@(_data.IndexOf(context) + 1)</MudTd>

                        <MudTd>@context["Branch"]</MudTd>


                        <MudTd>@context["BorrowerName"]</MudTd>

                        <MudTd>@context["NatureOfLimit"]</MudTd>

                        <MudTd>@context["LimitSanctioned"]</MudTd>

                        <MudTd>@context["LimitOutstanding"]</MudTd>

                        <MudTd>
                            @Convert.ToDateTime(context["DateOfSanction"]).ToString("dd-MM-yyyy")
                        </MudTd>

                        <MudTd>@context["SanctionAuthority"]</MudTd>

                        <MudTd>@context["ExternalRating"]</MudTd>

                        <MudTd>@context["InternalRating"]</MudTd>

                        <MudTd>@context["AmountProposed"]</MudTd>

                        <MudTd>@context["Months"]</MudTd>

                        <MudTd>@context["InterestTable"]</MudTd>

                        <MudTd>@context["PreviousTransactionROI"]</MudTd>

                        <MudTd>@context["EffectiveROI"]</MudTd>

                        <MudTd>@context["Tenor"]</MudTd>

                        <MudTd>
                            @Convert.ToDateTime(context["LikelyDateOfAvailment"]).ToString("dd-MM-yyyy")
                        </MudTd>

                        <MudTd>
                            @(Convert.ToBoolean(context["IsRollover"]) ? "Yes" : "No")
                        </MudTd>

                        <MudTd>
                            @(Convert.ToBoolean(context["BulkDepositAccepted"]) ? "Yes" : "No")
                        </MudTd>

                    </RowTemplate>

                    <NoRecordsContent>
                        <td colspan="21" style="text-align:center; padding:40px;">
                            <MudText Typo="Typo.subtitle1" Color="Color.Error">
                                No Data Found!
                            </MudText>
                        </td>
                    </NoRecordsContent>

                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
                    </PagerContent>

                </MudTable>
            </MudItem>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    private bool _loading = true;
    private bool _showAdd = false;
    private DateTime? FromDate;
    private DateTime? ToDate;
    private string _solid = "";
    private string SelectedMonth = "All";
    private string SelectedZone = "All";
    private string SelectedRegion = "All";
    private string SelectedBranch = "All";
    private bool _canAdd = false;
    private List<Dictionary<string, object>> _zones = new();
    private List<Dictionary<string, object>> _regions = new();
    private List<Dictionary<string, object>> _branches = new();
    private List<Dictionary<string, object>> _data = new();
    private bool DisableMonth = false;
    private bool DisableDate = false;
    private string _borrower = "";

    private string _branch = "";
    private string _region = "";
    private string _zone = "";

    private string _natureOfLimit = "";

    private GapReportSettings _cfg = new();

    private DateTime? _dateOfSanction = AppTime.Today;

    private string _sanctionAuthority = "";

    private string _externalRating = "";
    private string _internalRating = "";

    private string _limitSanctioned = "";
    private string _limitOutstanding = "";
    private string _amountProposed = "";
    private string _months = "";
    private string _previousROI = "";
    private string _effectiveROI = "";
    private string _tenor = "";

    private string _interestTable = "MCLR";


    private DateTime? _likelyAvailmentDate = AppTime.Today;

    private bool _isRollover;
    private bool _bulkDepositAccepted;


    private async Task HandleMonthChanged(string value)
    {
        SelectedMonth = value;

        if (value != "All")
        {
            FromDate = null;
            ToDate = null;
            DisableDate = true;
        }
        else
        {
            DisableDate = false;
        }

        await LoadData();
    }

    private async Task HandleFromDateChanged(DateTime? value)
{
    FromDate = value;

    if (FromDate.HasValue || ToDate.HasValue)
    {
        SelectedMonth = "All";
        DisableMonth = true;
    }
    else
    {
        DisableMonth = false;
    }

    await LoadData();
}
    private async Task HandleToDateChanged(DateTime? value)
    {
        ToDate = value;

        if (FromDate.HasValue || ToDate.HasValue)
        {
            SelectedMonth = "All";
            DisableMonth = true;
        }
        else
        {
            DisableMonth = false;
        }

        await LoadData();
    }

    private async Task ClearFilters()
{
    SelectedZone = "All";
    SelectedRegion = "All";
    SelectedBranch = "All";

    SelectedMonth = "All";
        FromDate = null;
        ToDate = null;

    DisableMonth = false;
    DisableDate = false;

    _regions = await ReportService.GetLookupDataAsync(
        "region_master",
        "region_name, region_solid",
        "1=1",
        "region_name");

    _branches = await ReportService.GetLookupDataAsync(
        "branch_master",
        "branch_name, sol_id",
        "1=1",
        "branch_name");

    await LoadData();
}

    private async Task OnSolChanged(string value)
    {
        _solid = value;

        if (string.IsNullOrWhiteSpace(value))
            return;

        try
        {
            string query = $@"
            SELECT branch_name, region_name, zone_name_eng
            FROM branch_master
            WHERE sol_id = '{value}'";

            var result = await ReportService.ExecuteRawQueryAsync(query);

            if (result.Count > 0)
            {
                _branch = result[0]["branch_name"]?.ToString() ?? "";
                _region = result[0]["region_name"]?.ToString() ?? "";
                _zone = result[0]["zone_name_eng"]?.ToString() ?? "";
            }
            else
            {
                _branch = "";
                _region = "";
                _zone = "";
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[DailyApprovedRates] Unhandled error: " + ex.Message);
        }
    }


    private readonly List<ColumnConfig> _cols = new()
{
    new() { Header = "Branch", PropertyName = "Branch" },
    new() { Header = "Region", PropertyName = "RegionName" },
    new() { Header = "Zone", PropertyName = "ZoneName" },

    new() { Header = "Name of the Borrower", PropertyName = "BorrowerName" },

    new() { Header = "Nature Of Limit", PropertyName = "NatureOfLimit" },

    new() { Header = "Limit Sanctioned", PropertyName = "LimitSanctioned" },

    new() { Header = "Limit O/S", PropertyName = "LimitOutstanding" },

    new() { Header = "Date Of Sanction", PropertyName = "DateOfSanction" },

    new() { Header = "Sanction Authority", PropertyName = "SanctionAuthority" },

    new() { Header = "External Rating", PropertyName = "ExternalRating" },

    new() { Header = "Internal Rating", PropertyName = "InternalRating" },

    new() { Header = "Amount Proposed", PropertyName = "AmountProposed" },

    new() { Header = "Months", PropertyName = "Months" },

    new() { Header = "T-Bill / MCLR", PropertyName = "InterestTable" },

    new() { Header = "Previous ROI", PropertyName = "PreviousTransactionROI" },

    new() { Header = "Effective ROI", PropertyName = "EffectiveROI" },

    new() { Header = "Tenor", PropertyName = "Tenor" },

    new() { Header = "Likely Date Of Availment", PropertyName = "LikelyDateOfAvailment" },

    new() { Header = "Rollover", PropertyName = "IsRollover" },

    new() { Header = "Bulk Deposit", PropertyName = "BulkDepositAccepted" }
};

    private void ClearForm()
    {
        _solid = "";

        _borrower = "";

        _branch = "";
        _region = "";
        _zone = "";

        _natureOfLimit = "";



        _dateOfSanction = AppTime.Today;

        _sanctionAuthority = "";

        _externalRating = "";
        _internalRating = "";



        _interestTable = "MCLR";

        _limitSanctioned = "";
        _limitOutstanding = "";
        _amountProposed = "";
        _months = "";
        _previousROI = "";
        _effectiveROI = "";
        _tenor = "";

        _likelyAvailmentDate = AppTime.Today;

        _isRollover = false;
        _bulkDepositAccepted = false;
    }

    protected override async Task OnInitializedAsync()
    {
        // ✅ Get user info
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var department = authState.User.FindFirst("department_desc")?.Value?.ToUpper() ?? "";

        // ✅ Check condition
        if (department == "LARGE CORPORATE")
            _canAdd = true;

        // Existing code
        _zones = await ReportService.GetLookupDataAsync(
    "zone_master",
    "zone_name_eng, zone_solid",
    "1=1",
    "zone_name_eng");

        _regions = await ReportService.GetLookupDataAsync(
            "region_master",
            "region_name, region_solid",
            "1=1",
            "region_name");

        _branches = await ReportService.GetLookupDataAsync(
            "branch_master",
            "branch_name, sol_id",
            "1=1",
            "branch_name");

        await LoadData();
    }

    private void ShowAdd() => _showAdd = true;
    private void CancelAdd() => _showAdd = false;

    private async Task SaveRow()
    {
        // Prevent duplicate entry for same Branch and Date
        string duplicateCheck = $@"
    SELECT *
    FROM DailyApprovedRates
    WHERE Branch = '{_branch}'
    AND CAST(DateOfSanction AS DATE) =
        '{_dateOfSanction:yyyy-MM-dd}'";

        var existing = await ReportService.ExecuteRawQueryAsync(duplicateCheck);

        if (existing.Count > 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"An entry already exists for Branch {_branch} on {_dateOfSanction:dd-MM-yyyy}");

            return;
        }

        string query = $@"
    INSERT INTO DailyApprovedRates
    (
        Branch,
        RegionName,
        ZoneName,
        BorrowerName,
        NatureOfLimit,
        LimitSanctioned,
        LimitOutstanding,
        DateOfSanction,
        SanctionAuthority,
        ExternalRating,
        InternalRating,
        AmountProposed,
        Months,
        InterestTable,
        PreviousTransactionROI,
        EffectiveROI,
        Tenor,
        LikelyDateOfAvailment,
        IsRollover,
        BulkDepositAccepted
    )
    VALUES
    (
        '{_branch}',
        '{_region}',
        '{_zone}',
        '{_borrower}',
        '{_natureOfLimit}',
    '{_limitSanctioned}',
    '{_limitOutstanding}',
        '{_dateOfSanction:yyyy-MM-dd}',
        '{_sanctionAuthority}',
        '{_externalRating}',
        '{_internalRating}',
    '{_amountProposed}',
    '{_months}',
        '{_interestTable}',
    '{_previousROI}',
    '{_effectiveROI}',
    '{_tenor}',
        '{_likelyAvailmentDate:yyyy-MM-dd}',
    {(_isRollover ? 1 : 0)},
    {(_bulkDepositAccepted ? 1 : 0)}
    )";

        await ReportService.ExecuteRawQueryAsync(query);

        ClearForm();

        _showAdd = false;

        await LoadData();
    }
    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        string where = "1=1";

        // ✅ Zone
        if (SelectedZone != "All")
            where += $" AND bm.zone_solid='{SelectedZone}'";

        if (SelectedRegion != "All")
            where += $" AND bm.region_solid='{SelectedRegion}'";

        if (SelectedBranch != "All")
            where += $" AND bm.sol_id='{SelectedBranch}'";

        // RBAC: clamp to the logged-in user's own scope for non-CO users (fail-closed to BRANCH).
        {
            var __scope = MyDiary.Web.Features.Reports.Services.ReportUserScope.Resolve(ReportScopeUser);
            if (__scope.IsZone) where += $" AND bm.zone_solid = '{__scope.ZoneSolid}'";
            else if (__scope.IsRegion) where += $" AND bm.region_solid = '{__scope.RegionSolid}'";
            else if (__scope.IsBranch) where += $" AND bm.sol_id = '{__scope.BranchSolid}'";
        }

        // ✅ SINGLE DATE FILTER (Exact match 🔥)
        // Month Filter
        if (SelectedMonth != "All")
        {
            where += $" AND MONTH(DateOfSanction) = {SelectedMonth}";
        }

        // Date Filter
        if (FromDate.HasValue)
        {
            where +=
                $" AND CAST(DateOfSanction AS DATE) >= '{FromDate.Value:yyyy-MM-dd}'";
        }

        if (ToDate.HasValue)
        {
            where +=
                $" AND CAST(DateOfSanction AS DATE) <= '{ToDate.Value:yyyy-MM-dd}'";
        }

        string query = $@"
SELECT DISTINCT d.*
FROM DailyApprovedRates d
LEFT JOIN branch_master bm
    ON d.Branch = bm.branch_name
WHERE {where}
ORDER BY d.DateOfSanction DESC";

        _data = await ReportService.ExecuteRawQueryAsync(query);

        _loading = false;
        StateHasChanged();
    }


    private async Task HandleZoneChanged(string val)
    {
        SelectedZone = val;

        SelectedRegion = "All";
        SelectedBranch = "All";

        if (val == "All")
        {
            _regions = await ReportService.GetLookupDataAsync(
                "region_master",
                "region_name, region_solid",
                "1=1",
                "region_name");
        }
        else
        {
            _regions = await ReportService.GetLookupDataAsync(
                "region_master",
                "region_name, region_solid",
                $"zone_solid='{val}'",
                "region_name");
        }

        _branches.Clear();

        await LoadData();
    }


    private async Task HandleRegionChanged(string val)
    {
        SelectedRegion = val;

        SelectedBranch = "All";

        if (val == "All")
        {
            _branches = await ReportService.GetLookupDataAsync(
                "branch_master",
                "branch_name, sol_id",
                "1=1",
                "branch_name");
        }
        else
        {
            _branches = await ReportService.GetLookupDataAsync(
                "branch_master",
                "branch_name, sol_id",
                $"region_solid='{val}'",
                "branch_name");
        }

        await LoadData();
    }

    private async Task HandleBranchChanged(string val)
    {
        SelectedBranch = val;
        await LoadData();
    }

    private async Task OnExportInternal()
    {
        try
        {
            var exportData = _data
                .Select(x => new Dictionary<string, object>(x))
                .ToList();

            foreach (var row in exportData)
            {
                if (row.ContainsKey("DateOfSanction") &&
                    row["DateOfSanction"] != DBNull.Value)
                {
                    row["DateOfSanction"] =
                        Convert.ToDateTime(row["DateOfSanction"])
                            .ToString("dd-MM-yyyy");
                }

                if (row.ContainsKey("LikelyDateOfAvailment") &&
                    row["LikelyDateOfAvailment"] != DBNull.Value)
                {
                    row["LikelyDateOfAvailment"] =
                        Convert.ToDateTime(row["LikelyDateOfAvailment"])
                            .ToString("dd-MM-yyyy");
                }

                if (row.ContainsKey("IsRollover") &&
                    row["IsRollover"] != DBNull.Value)
                {
                    row["IsRollover"] =
                        Convert.ToBoolean(row["IsRollover"])
                            ? "Yes"
                            : "No";
                }

                if (row.ContainsKey("BulkDepositAccepted") &&
                    row["BulkDepositAccepted"] != DBNull.Value)
                {
                    row["BulkDepositAccepted"] =
                        Convert.ToBoolean(row["BulkDepositAccepted"])
                            ? "Yes"
                            : "No";
                }
            }

            var bytes = ReportService.ExportToExcel(
                exportData,
                _cols,
                "DailyApprovedRates");

            await JS.InvokeVoidAsync(
                "BlazorDownloadFile",
                "DailyApprovedRates.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            AppLogger.LogError(
                ex,
                "[DailyApprovedRates] Unhandled error: " + ex.Message);
        }
    }

