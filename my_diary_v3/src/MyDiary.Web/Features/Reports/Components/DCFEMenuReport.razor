@using MyDiary.Web.Core.Extensions
@page "/reports/dcfemenu"
@using Microsoft.JSInterop
@using MudBlazor
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using MyDiary.Web.Features.Reports.Services

@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@inject DCFEMenuReportService DataService
@inject DynamicReportService ReportService
@inject MyDiary.Core.Abstractions.ICurrentUser CurrentUser
@inject IJSRuntime JS

@* --- INJECTED MUDBLAZOR STYLES FROM DYNAMIC DASHBOARD --- *@

<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<style>
    .fixed-table {
        table-layout: fixed !important;
        width: 100% !important;
    }

    .mud-table-container {
        overflow-x: auto;
    }

    .mud-table-head {
        background-color: #2a2f5b;
    }
    /* Display Sort Icon by default */
    .mud-table-sort-label .mud-button-root .mud-icon-root {
        opacity: 1 !important;
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .mud-table-sort-label.mud-table-sort-label-active .mud-button-root .mud-icon-root {
        color: white !important;
    }
    /* Auto-assign S.No using CSS Counters so it stays sequential after sorting */
    .auto-index-table {
        counter-reset: rowNumber;
    }

        .auto-index-table tbody tr:has(td:nth-child(2)) {
            counter-increment: rowNumber;
        }

            .auto-index-table tbody tr:has(td:nth-child(2)) td:first-child::before {
                content: counter(rowNumber);
            }
</style>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <div id="report-page-root" class="mb-4">
            <MudPaper Elevation="0" Style="background-color: #ffffff;">



                @* --- LEVEL 2: Custom MudBlazor Filters --- *@
                <MudGrid Spacing="2" Class="pa-4 align-center">
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Zone" Value="@_selectedZone" ValueChanged="OnZoneChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(!IsCo)">
                            <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var z in _zones)
                            {
                                <MudSelectItem Value="@z.Value">@z.Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Region" Value="@_selectedRegion" ValueChanged="OnRegionChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(_userPrivilege == "REGION" || _userPrivilege == "BRANCH" || _selectedZone == "ALL")">
                            <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var r in _regions)
                            {
                                <MudSelectItem Value="@r.Value">@r.Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudSelect T="string" Label="Branch" Value="@_selectedBranch" ValueChanged="OnBranchChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(_userPrivilege == "BRANCH" || _selectedRegion == "ALL")">
                            <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var b in _branches)
                            {
                                <MudSelectItem Value="@b.Value">@b.Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Pendency" Value="@_selectedPendency" ValueChanged="OnPendencyChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                            <MudSelectItem Value="@("Upto 10 Days")">Upto 10 Days</MudSelectItem>
                            <MudSelectItem Value="@("Upto 15 Days")">Upto 15 Days</MudSelectItem>
                            <MudSelectItem Value="@("Above 15 Days")">Above 15 Days</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudSpacer />

                    <MudItem xs="12" sm="2" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" StartIcon="@MudBlazor.Icons.Material.Filled.Download"
                                   Style="background-color: #000066; color: white; font-size: 11px;"
                                   OnClick="HandleExport">Export To Excel</MudButton>
                    </MudItem>
                </MudGrid>

                @* --- LEVEL 3: Table Section --- *@
                <div class="px-4 d-flex justify-end">
                    <MudText Typo="Typo.caption" Style="font-weight:bold; font-style:italic; color: #666;">@_asOnDateLabel</MudText>
                </div>

                <MudItem xs="12" Class="pa-4">
                    <MudTable Items="_data" Loading="_loading" Dense="true" Striped="true" Bordered="true" FixedHeader="true"
                              Height="750px" Elevation="2" Class="fixed-table auto-index-table" Style="font-size:12px;" RowsPerPage="25">
                        <HeaderContent>
                            <MudTh Style="background-color:#2a2f5b; color:white; width: 60px; text-align: center;">S.No</MudTh>
                            @foreach (var col in _reportColumns)
                            {
                                <MudTh Style="@($"background-color:#2a2f5b; color:white; width: {col.Width ?? "10%"}; text-align: center;")">
                                    <MudTableSortLabel SortBy="new Func<Dictionary<string, object>, object>(x => x.ContainsKey(col.PropertyName) ? x[col.PropertyName] : string.Empty)">
                                        @col.Header
                                    </MudTableSortLabel>
                                </MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            @* S.No is auto-filled via CSS counter class *@
                            <MudTd Style="text-align: center;"></MudTd>

                            @foreach (var col in _reportColumns)
                            {
                                <MudTd Style="@(col.IsNumeric ? "text-align: right;" : "text-align: left;")">
                                    @FormatValue(context, col)
                                </MudTd>
                            }
                        </RowTemplate>
                        <NoRecordsContent>
                            <td colspan="@(_reportColumns.Count + 1)" style="text-align:center; padding: 40px;">
                                <MudText Typo="Typo.subtitle1" Color="Color.Error">No record found</MudText>
                            </td>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                        </PagerContent>
                    </MudTable>
                </MudItem>
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery][Parameter] public string? Title { get; set; }

    private string _title => string.IsNullOrWhiteSpace(Title) ? "Death Menu Dashboard" : Title!;

    // Data State
    private List<Dictionary<string, object>> _data = new();
    private bool _loading = true;
    private string _asOnDateLabel = "Loading...";

    // Dropdown Collections
    private List<DropdownItem> _zones = new();
    private List<DropdownItem> _regions = new();
    private List<DropdownItem> _branches = new();

    // Selected Values
    private string _selectedZone = "ALL";
    private string _selectedRegion = "ALL";
    private string _selectedBranch = "ALL";
    private string _selectedPendency = "ALL";

    // RBAC scope resolved from the logged-in user's claims. Non-CO users are clamped to their own
    // zone/region/branch in LoadReportData regardless of the dropdown selections.
    private string _userPrivilege = "BRANCH";
    private string _userZoneSolid = "", _userRegionSolid = "", _userBranchSolid = "";
    private bool IsCo => _userPrivilege == "CO";

    // Column Definitions
    private List<ColumnConfig> _reportColumns = new() {
        new ColumnConfig { Header = "Zone", PropertyName = "Zone", Width = "8%" },
        new ColumnConfig { Header = "Region", PropertyName = "Region", Width = "8%" },
        new ColumnConfig { Header = "Branch", PropertyName = "Branch", Width = "10%" },
        new ColumnConfig { Header = "Sol Id", PropertyName = "SolId", Width = "6%" },
        new ColumnConfig { Header = "Account Number", PropertyName = "AccountNumber", Width = "10%" },
        new ColumnConfig { Header = "CIF Id", PropertyName = "CifId", Width = "8%" },
        new ColumnConfig { Header = "Account Status", PropertyName = "AccountStatus", Width = "8%" },
        new ColumnConfig { Header = "Nomination Flag", PropertyName = "NominationFlag", Width = "6%" },
        new ColumnConfig { Header = "Nominee Name", PropertyName = "NomineeName", Width = "12%" },
        new ColumnConfig { Header = "Intimation Rcvd Date", PropertyName = "IntimationReceivedDate", Width = "10%" },
        new ColumnConfig { Header = "Entry In DCFE", PropertyName = "DateOfEntryInDCFEMenu", Width = "10%" },
        new ColumnConfig { Header = "Doc Received Flag", PropertyName = "DocumentReceivedFlag", Width = "8%" },
        new ColumnConfig { Header = "All Docs Rcvd Date", PropertyName = "DateOfReceivingAllClaimDocuments", Width = "10%" },
        new ColumnConfig { Header = "Pendency", PropertyName = "Pendency", IsNumeric = true, Width = "6%" },
        new ColumnConfig { Header = "Acct Closure Status", PropertyName = "AccountClosureStatus", Width = "8%" },
        new ColumnConfig { Header = "Acct Closure Date", PropertyName = "AccountClosureDate", Width = "10%" },
        new ColumnConfig { Header = "Claimant 1", PropertyName = "Claimant_1", Width = "10%" },
        new ColumnConfig { Header = "Claimant 2", PropertyName = "Claimant_2", Width = "10%" },
        new ColumnConfig { Header = "Claimant 3", PropertyName = "Claimant_3", Width = "10%" },
        new ColumnConfig { Header = "Claimant 4", PropertyName = "Claimant_4", Width = "10%" },
        new ColumnConfig { Header = "Claimant 5", PropertyName = "Claimant_5", Width = "10%" }
    };

    protected override async Task OnInitializedAsync()
    {
        // RBAC: resolve the user's scope. Default to BRANCH (most restrictive) for an
        // unknown/missing privilege so a bad claim can never widen access.
        _userPrivilege = (CurrentUser.Privilege ?? "").ToUpperInvariant() switch
        {
            "CO" => "CO",
            "ZONE" => "ZONE",
            "REGION" => "REGION",
            _ => "BRANCH"
        };
        _userZoneSolid = CurrentUser.ZoneSolid ?? "";
        _userRegionSolid = CurrentUser.RegionSolid ?? "";
        _userBranchSolid = CurrentUser.BranchSolid ?? "";

        // Zones dropdown and initial report data are independent — run in parallel
        var zonesTask = DataService.GetZonesAsync();
        var reportTask = LoadReportData();
        await Task.WhenAll(zonesTask, reportTask);
        _zones = zonesTask.Result;
    }

    // --- MUDBLAZOR DROPDOWN EVENT HANDLERS ---
    // MudBlazor uses EventCallbacks with the specific Value type instead of ChangeEventArgs

    private async Task OnZoneChanged(string value)
    {
        _selectedZone = value ?? "ALL";
        _selectedRegion = "ALL";
        _selectedBranch = "ALL";
        _branches.Clear();

        if (_selectedZone != "ALL")
        {
            _regions = await DataService.GetRegionsAsync(_selectedZone);
        }
        else
        {
            _regions.Clear();
        }

        await LoadReportData();
    }

    private async Task OnRegionChanged(string value)
    {
        _selectedRegion = value ?? "ALL";
        _selectedBranch = "ALL";

        if (_selectedRegion != "ALL")
        {
            _branches = await DataService.GetBranchesAsync(_selectedRegion);
        }
        else
        {
            _branches.Clear();
        }

        await LoadReportData();
    }

    private async Task OnBranchChanged(string value)
    {
        _selectedBranch = value ?? "ALL";
        await LoadReportData();
    }

    private async Task OnPendencyChanged(string value)
    {
        _selectedPendency = value ?? "ALL";
        await LoadReportData();
    }

    // --- DATA FETCHING & FORMATTING ---

    private async Task LoadReportData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // RBAC enforcement — The SP therefore never receives a filter outside the user's scope.
            var zoneArg = _selectedZone;
            var regionArg = _selectedRegion;
            var branchArg = _selectedBranch;
            if (_userPrivilege == "ZONE")
            {
                zoneArg = _userZoneSolid;
            }
            else if (_userPrivilege == "REGION")
            {
                zoneArg = _userZoneSolid;
                regionArg = _userRegionSolid;
            }
            else if (_userPrivilege == "BRANCH")
            {
                zoneArg = _userZoneSolid;
                regionArg = _userRegionSolid;
                branchArg = _userBranchSolid;
            }

            var result = await DataService.GetDCFEMenuDataAsync(zoneArg, regionArg, branchArg, _selectedPendency);
            _data = result.Data;
            _asOnDateLabel = string.IsNullOrEmpty(result.LastUpdatedDate)
    ? AppTime.Now.ToString("dd/MM/yyyy")
    : result.LastUpdatedDate;
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[DCFEMenuReport] Error: " + ex.Message);
            _asOnDateLabel = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Identical formatting function to the one in DynamicDashboard.razor
    private string FormatValue(Dictionary<string, object> row, ColumnConfig col)
    {
        if (!row.TryGetValue(col.PropertyName, out var val) || val == DBNull.Value || val == null) return "-";
        if (col.IsDate && DateTime.TryParse(val.ToString(), out var dt)) return dt.ToString("dd/MM/yyyy");
        if (col.IsNumeric && decimal.TryParse(val.ToString(), out var d)) return d.ToString(col.Format ?? "0");
        return val.ToString() ?? "";
    }

    private async Task HandleExport()
    {
        if (!_data.Any()) return;

        var bytes = ReportService.ExportToExcel(_data, _reportColumns, "DCFEMenuReport");
        await JS.InvokeVoidAsync("BlazorDownloadFile", $"DCFE_Menu_Report_{AppTime.Now:yyyyMMdd_HHmmss}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
}