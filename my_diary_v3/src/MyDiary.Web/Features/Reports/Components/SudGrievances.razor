@page "/reports/sudClaimsGrievances"
@using Microsoft.JSInterop
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using MyDiary.Web.Features.Shared.Components
@using Microsoft.AspNetCore.Components.Web
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject MyDiary.Core.Abstractions.ICurrentUser ReportScopeUser


<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>SUD Claims and Grievances — My Diary</PageTitle>

<DynamicDashboard Config="_activeConfig"
                  Data="_data"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabel"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExport" />

@code {
    [SupplyParameterFromQuery][Parameter] public string? Title { get; set; }

    private List<Dictionary<string, object>> _data = new();
    private string _selectedZone = "1", _selectedRegion = "1", _selectedBranch = "1", _asOnDateLabel = "";
    private bool _loading = true;
    private ReportConfig _activeConfig = new();

    // Map these from your auth/claims in your app:
    private string _userPrivilege = "CO";    // CO | ZONE | REGION | BRANCH
    private string _userZoneSolid = "00000";
    private string _userRegionSolid = "00000";
    private string _userBranchSolid = "00000";

    // ===== Grid column configurations =====
    private readonly List<ColumnConfig> _summaryCols = new() {
        new ColumnConfig { Header = "Zone",                         PropertyName = "zone_name_eng",   Width = "18%" },
        new ColumnConfig { Header = "Region",                       PropertyName = "region_name",     Width = "18%" },
        new ColumnConfig { Header = "Branch",                       PropertyName = "Branch_Name",     Width = "18%" },
        new ColumnConfig { Header = "Claims Settled - Number",      PropertyName = "ClaimsSettledNo", IsNumeric = true, Format = "N0", Width = "12%" },
        new ColumnConfig { Header = "Claims Settled - Amount (₹ Lacs)", PropertyName = "ClaimsSettledAmt", IsNumeric = true, Format = "N2", Width = "16%" },
        new ColumnConfig { Header = "Grievances Reported",          PropertyName = "GrievanceReported", IsNumeric = true, Format = "N0", Width = "9%" },
        new ColumnConfig { Header = "Grievances Settled",           PropertyName = "GrievanceResolved", IsNumeric = true, Format = "N0", Width = "9%" }
    };

    private readonly List<ColumnConfig> _detailedCols = new() {
        new ColumnConfig { Header = "Zone",                         PropertyName = "zone_name_eng",   Width = "14%" },
        new ColumnConfig { Header = "Region",                       PropertyName = "region_name",     Width = "14%" },
        new ColumnConfig { Header = "Branch",                       PropertyName = "Branch_Name",     Width = "18%" },
        new ColumnConfig { Header = "Sol ID",                       PropertyName = "SolId",           Width = "10%" },
        new ColumnConfig { Header = "Claims Settled - Number",      PropertyName = "ClaimsSettledNo", IsNumeric = true, Format = "N0", Width = "10%" },
        new ColumnConfig { Header = "Claims Settled - Amount (₹ Lacs)", PropertyName = "ClaimsSettledAmt", IsNumeric = true, Format = "N2", Width = "12%" },
        new ColumnConfig { Header = "Grievances Reported",          PropertyName = "GrievanceReported", IsNumeric = true, Format = "N0", Width = "11%" },
        new ColumnConfig { Header = "Grievances Settled",           PropertyName = "GrievanceResolved", IsNumeric = true, Format = "N0", Width = "11%" }
    };

    protected override async Task OnInitializedAsync()
    {
        // RBAC: scope this report to the logged-in user (fail-closed to BRANCH for unknown privilege).
        {
            var __scope = MyDiary.Web.Features.Reports.Services.ReportUserScope.Resolve(ReportScopeUser);
            _userPrivilege = __scope.Privilege;
            _userZoneSolid = __scope.ZoneSolid;
            _userRegionSolid = __scope.RegionSolid;
            _userBranchSolid = __scope.BranchSolid;
        }
        _activeConfig.Title = Title ?? "SUD Claims & Grievances";
        await LoadReport();
    }

    private async Task HandleFilterChanged((string zone, string region, string branch) f)
    {
        _selectedZone = f.zone;
        _selectedRegion = f.region;
        _selectedBranch = f.branch;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true; StateHasChanged();

        string columns = "";
        string where = "1=1";
        string groupBy = "";
        bool isSummary = true;

        // Toggle to diagnose joining issues (if needed)
        const bool UseLeftJoin = false;
        string joinType = UseLeftJoin ? "LEFT JOIN" : "JOIN";

        // --- Helpers to build SELECT fragments ---
        string DetailedColumns() =>
            // Dividing amount by 100000 for ₹ Lacs at source (easier for UI to format consistently)
            "zone_name_eng, b.region_name, b.BRANCH_NAME as Branch_Name, b.SOL_ID as SolId, " +
            "a.GrievanceReported, a.GrievanceResolved, a.ClaimsSettledNo, " +
            "CONVERT(decimal(18,2), (a.ClaimsSettledAmt / 100000.0)) as ClaimsSettledAmt";

        string SummaryAll() =>
            "SUM(a.GrievanceReported) as GrievanceReported, " +
            "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
            "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
            "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
            "'All' as Branch_Name, 'All' as region_name, 'All' as zone_name_eng, 'All' as SolId";

        // Apply base filter (matches your WebForms condition)
        where += " and B.region_solid <> '00000' and B.region_solid <> ' '";

        // ===================== PRIVILEGE: CO =====================
        if (_userPrivilege == "CO")
        {
            if (_selectedZone == "1") // All(Summary)
            {
                columns = SummaryAll();
            }
            else if (_selectedZone.Equals("all", StringComparison.OrdinalIgnoreCase))
            {
                if (_selectedRegion == "1") // Zonewise Summary (All zones)
                {
                    columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                              "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                              "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                              "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                              "'All' as Branch_Name, 'All' as region_name, zone_name_eng, B.Zone_SolId as SolId";
                    groupBy = " Group By B.Zone_SolId, zone_name_eng";
                }
                else if (_selectedRegion.Equals("all", StringComparison.OrdinalIgnoreCase))
                {
                    if (_selectedBranch == "1") // Regionwise Summary across all zones
                    {
                        columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                                  "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                                  "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                                  "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                                  "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                        groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
                    }
                    else // Detailed across all branches
                    {
                        isSummary = false;
                        if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                            where += $" and B.sol_id = '{_selectedBranch}'";
                        columns = DetailedColumns();
                    }
                }
                else // Specific Region across all zones
                {
                    where += $" and B.region_SolId = '{_selectedRegion}'";
                    if (_selectedBranch == "1") // Region summary (specific region)
                    {
                        columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                                  "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                                  "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                                  "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                                  "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                        groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
                    }
                    else // Detailed within specific region
                    {
                        isSummary = false;
                        if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                            where += $" and B.sol_id = '{_selectedBranch}'";
                        columns = DetailedColumns();
                    }
                }
            }
            else // Specific Zone selected
            {
                where += $" and B.Zone_SolId = '{_selectedZone}'";

                if (_selectedRegion == "1") // Zone summary
                {
                    columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                              "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                              "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                              "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                              "'All' as Branch_Name, 'All' as region_name, zone_name_eng, B.Zone_SolId as SolId";
                    groupBy = " Group By B.Zone_SolId, zone_name_eng";
                }
                else if (_selectedRegion.Equals("all", StringComparison.OrdinalIgnoreCase))
                {
                    if (_selectedBranch == "1") // Regionwise Summary within the zone
                    {
                        columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                                  "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                                  "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                                  "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                                  "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                        groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
                    }
                    else // Detailed within zone across branches
                    {
                        isSummary = false;
                        if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                            where += $" and B.sol_id = '{_selectedBranch}'";
                        columns = DetailedColumns();
                    }
                }
                else // Specific Region in specific Zone
                {
                    where += $" and B.region_SolId = '{_selectedRegion}'";
                    if (_selectedBranch == "1") // Region summary (within zone)
                    {
                        columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                                  "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                                  "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                                  "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                                  "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                        groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
                    }
                    else // Detailed for selected branch/region/zone
                    {
                        isSummary = false;
                        if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                            where += $" and B.sol_id = '{_selectedBranch}'";
                        columns = DetailedColumns();
                    }
                }
            }
        }
        // ===================== PRIVILEGE: ZONE =====================
        else if (_userPrivilege == "ZONE")
        {
            where += $" and B.Zone_SolId = '{_userZoneSolid}'";

            if (_selectedRegion == "1") // Summary of the zone
            {
                columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                          "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                          "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                          "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                          "'All' as Branch_Name, 'All' as region_name, zone_name_eng, B.Zone_SolId as SolId";
                groupBy = " Group By zone_name_eng, B.Zone_SolId";
            }
            else if (_selectedRegion.Equals("all", StringComparison.OrdinalIgnoreCase))
            {
                if (_selectedBranch == "1") // Regionwise summary within user's zone
                {
                    columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                              "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                              "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                              "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                              "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                    groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
                }
                else // Detailed within user's zone
                {
                    isSummary = false;
                    if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                        where += $" and B.sol_id = '{_selectedBranch}'";
                    columns = DetailedColumns();
                }
            }
            else // Specific region inside user's zone
            {
                where += $" and B.region_SolId = '{_selectedRegion}'";
                if (_selectedBranch == "1") // Region summary
                {
                    columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                              "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                              "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                              "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                              "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                    groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
                }
                else // Detailed for region/branch in user's zone
                {
                    isSummary = false;
                    if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                        where += $" and B.sol_id = '{_selectedBranch}'";
                    columns = DetailedColumns();
                }
            }
        }
        // ===================== PRIVILEGE: REGION =====================
        else if (_userPrivilege == "REGION")
        {
            where += $" and B.region_SolId = '{_userRegionSolid}'";

            if (_selectedBranch == "1") // Region summary
            {
                columns = "SUM(a.GrievanceReported) as GrievanceReported, " +
                          "SUM(a.GrievanceResolved)  as GrievanceResolved, " +
                          "SUM(a.ClaimsSettledNo)    as ClaimsSettledNo, " +
                          "CONVERT(decimal(18,2), (SUM(a.ClaimsSettledAmt) / 100000.0)) as ClaimsSettledAmt, " +
                          "'All' as Branch_Name, b.region_name, zone_name_eng, B.region_SolId as SolId";
                groupBy = " Group By b.region_name, B.region_SolId, zone_name_eng";
            }
            else // Detailed within region
            {
                isSummary = false;
                if (!_selectedBranch.Equals("all", StringComparison.OrdinalIgnoreCase))
                    where += $" and B.sol_id = '{_selectedBranch}'";
                columns = DetailedColumns();
            }
        }
        // ===================== PRIVILEGE: BRANCH =====================
        else if (_userPrivilege == "BRANCH")
        {
            isSummary = false;
            where += $" and B.sol_id = '{_userBranchSolid}'";
            columns = DetailedColumns();
        }

        string finalQuery =
            $"SELECT {columns} " +
            $"FROM SUDData A {joinType} Branch_Master B ON A.branchcode = B.Branch_Code " +
            $"WHERE {where}{groupBy}";

        // Uncomment during testing if you want to inspect SQL text
        // Console.WriteLine(finalQuery);

        // Data query and as-on-date are independent - run in parallel
        var dataTask = ReportService.ExecuteRawQueryAsync(finalQuery);
        var dateTask = ReportService.GetAsOnDateAsync("SUDData");
        await Task.WhenAll(dataTask, dateTask);
        _data = dataTask.Result;
        string date = dateTask.Result;

        // In this report, both views show ₹ in Lacs
        _activeConfig.Columns = isSummary ? _summaryCols : _detailedCols;
        _asOnDateLabel = $"(₹ in Lacs, Data As On - {date})";

        _loading = false; StateHasChanged();
    }

    private async Task HandleExport()
    {
        var bytes = ReportService.ExportToExcel(_data, _activeConfig.Columns, "SUD_Claims_Grievances");
        await JS.InvokeVoidAsync("BlazorDownloadFile", "SUD_Claims_Grievances.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }
}
``