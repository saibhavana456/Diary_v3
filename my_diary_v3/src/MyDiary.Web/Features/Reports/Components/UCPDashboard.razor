    protected override async Task OnInitializedAsync()
    {
        Config.Columns = _summaryCols;
        var today = AppTime.Today;
        var currentFyStart = today.Month >= 4 ? today.Year : today.Year - 1;
        FinancialYears = Enumerable.Range(currentFyStart - 5, 6).Reverse().ToList();
        Filter.FyStartYear = currentFyStart;

        await Task.WhenAll(LoadAuthorityList(), LoadAsync());
    }

    private Task OnAuthorityChanged(string v)
    {
        Filter.Authority = v;
        return LoadAsync();
    }

    private Task OnPendingBucketChanged(string v)
    {
        Filter.PendingBucket = v;
        return LoadAsync();
    }

    private Task OnSummaryFlagChanged(string value)
    {
        SummaryFlag = value;   // null or "D"
        Filter.Authority = "All";
        return LoadAsync();
    }

    public static (DateTime StartDate, DateTime EndDate) GetCurrentFinancialYear()
    {
        var today = AppTime.Today;

        int fyStartYear = today.Month >= 4   // April or later
            ? today.Year
            : today.Year - 1;

        return FyWindow(fyStartYear);
    }


    private static (DateTime from, DateTime to) FyWindow(int fyStartYear)
    {
        return (new DateTime(fyStartYear, 4, 1),
                new DateTime(fyStartYear + 1, 3, 31));
    }

    private async Task LoadAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            _showDetailPanel = false;
            // var (rows, retval) = await SummaryService.GetAsync(Filter);

            //         var (rows, retval) =
            // await SummaryService.GetSummaryAsync(Filter, SummaryFlag ?? "A");


            var (from, to) = GetCurrentFinancialYear();

            ExecSummary = await SummaryService.GetExecutiveSummaryAsync(from, to);


            var (rows, retval) =
            await SummaryService.GetSummaryAsync(
                Filter,
                SummaryFlag
            );

            var (depts, letters, adds) = await SummaryService.GetFiltersAsync(Filter);
            Data = rows;
            DeptNames = depts;
            LetterTypes = letters;
            AddressedTos = adds;
            BuildPieData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[UCPDashboard] Error: " + ex.Message);
            ErrorMessage = UserFacingError.Generic;
            Data = new List<Dictionary<string, object>>
            {
                MockRow("RBI", 12, 3, 15, 5, 2, 7, 4, 6, 10, 32),
                MockRow("SEBI", 8, 1, 9, 3, 1, 4, 2, 3, 5, 18),
                MockRow("IRDAI", 6, 2, 8, 2, 0, 2, 1, 2, 3, 13),
                MockRow("GOI", 10, 4, 14, 4, 3, 7, 3, 5, 8, 29),
            };
            BuildPieData();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Dictionary<string, object> MockRow(string auth, int si, int sd, int st, int ii, int id, int it, int pi, int pd, int pt, int gt)
    {
        return new Dictionary<string, object>
        {
            ["AUTHORITY"] = auth,
            ["CNT_SUBMITTED_INTIME"] = si, ["CNT_SUBMITTED_DELAYED"] = sd, ["CNT_TOTAL_SUBMITTED"] = st,
            ["CNT_INTERIM_INTIME"] = ii, ["CNT_INTERIM_DELAYED"] = id, ["CNT_TOTAL_INTERIM"] = it,
            ["CNT_PENDING_INPROGRESS"] = pi, ["CNT_PENDING_DELAYED"] = pd, ["CNT_TOTAL_PENDING"] = pt,
            ["CNT_TOTAL"] = gt
        };
    }

    private async Task OnCellClick(string authority, string statusKey, bool isDepartmentWise)
    {
        _detailAuthority = authority;
        _detailStatusKey = statusKey;
