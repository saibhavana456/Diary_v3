    private void BuildPieData()
    {
        if (Data == null || Data.Count == 0)
        {
            _pieData.Clear();
            PieChartRenderKey = Guid.NewGuid();
            return;
        }

        _pieData = Data
            .Where(r => r.ContainsKey("FLAG_TXT") && r.ContainsKey("CNT_TOTAL"))
            .Select(r => new AuthorityPieItem
                {
                    Authority = r["FLAG_TXT"]?.ToString() ?? "Unknown",
                    Count = decimal.TryParse(r["CNT_TOTAL"]?.ToString(), out var v) ? v : 0
                })
            .Where(p => p.Count > 0)
            .ToList();

        PieChartRenderKey = Guid.NewGuid();
    }

    private async Task LoadAuthorityList()
    {
        try
        {
            // Call SP with minimal filter (ALL)
            var tempFilter = new ComplianceFilters
                {
                    FyStartYear = Filter.FyStartYear,
                    DeptName = "All",
                    LetterType = "All",
                    AddressedTo = "All",
                    DashStatus = "All",
                    Timeliness = "All",
                    Authority = "All",
                    PendingBucket = "All"
                };

            var (rows, _) = await SummaryService.GetSummaryAsync(tempFilter, "A");

            AuthorityList = rows.Where(x => x.ContainsKey("FLAG_TXT"))
                                .Select(x => x["FLAG_TXT"]?.ToString() ?? "")
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();
        }
        catch
        {
            AuthorityList = new List<string>();
        }
    }

    // Filter change handlers
    private Task OnFiltersChanged() => LoadAsync();
    private Task OnFyStartYearChanged(int v) { Filter.FyStartYear = v; Filter.DeptName = "All"; Filter.LetterType = "All"; Filter.AddressedTo = "All"; Filter.DashStatus = "All"; Filter.Timeliness = "All"; Filter.StartDate = null; Filter.EndDate = null; return OnFiltersChanged(); }
    private Task OnDeptChanged(string v) { Filter.DeptName = v; Filter.LetterType = "All"; Filter.AddressedTo = "All"; Filter.DashStatus = "All"; Filter.Timeliness = "All"; return OnFiltersChanged(); }
    private Task OnLetterTypeChanged(string v) { Filter.LetterType = v; Filter.AddressedTo = "All"; Filter.DashStatus = "All"; Filter.Timeliness = "All"; return OnFiltersChanged(); }
    private Task OnAddressedToChanged(string v) { Filter.AddressedTo = v; Filter.DashStatus = "All"; Filter.Timeliness = "All"; return OnFiltersChanged(); }

    private Task OnDashStatusChanged(string v) { Filter.DashStatus = v; Filter.Timeliness = "All"; Filter.PendingBucket = "All";  return OnFiltersChanged(); }

    private Task OnTimelinessChanged(string v)
    {
        Filter.Timeliness = v;
        if (v != "Delayed")
        {
            Filter.PendingBucket = "All";
        }

        return OnFiltersChanged();
    }

    private Task OnStartDateChanged(DateTime? d) { Filter.StartDate = d; return OnFiltersChanged(); }
    private Task OnEndDateChanged(DateTime? d) { Filter.EndDate = d; return OnFiltersChanged(); }

    private async Task HandleExport()
    {
        var bytes = SummaryService.ExportToExcel(Data, Config.Columns, "UnionCompliance");
        await JS.InvokeVoidAsync(
           "BlazorDownloadFile",
           "UnionCompliance_Report.xlsx",
           "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
           Convert.ToBase64String(bytes)
       );
    }

    public class AuthorityPieItem
    {
        public string Authority { get; set; } = string.Empty;
        public decimal Count { get; set; }
    }

    private ApexChartOptions<AuthorityPieItem> _pieOptions = new()
    {
        Chart = new() { Type = ApexCharts.ChartType.Donut, Toolbar = new() { Show = true } },
        Legend = new() { Position = ApexCharts.LegendPosition.Right },
        DataLabels = new() { Enabled = true, Formatter = @"function(val){ return val.toFixed(1) + '%' }" }
