                            <!-- Completed Requests -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="3" Class="pa-4 kpi-card">
                                    <MudText Typo="Typo.subtitle2" Class="kpi-title">
                                        Completed Requests
                                    </MudText>
                                    <MudText Typo="Typo.h4" Class="kpi-value green">
                                        @ExecSummary.CompletedRequests
                                    </MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- TAT Compliance -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="3" Class="pa-4 kpi-card">
                                    <MudText Typo="Typo.subtitle2" Class="kpi-title">
                                        TAT Compliance
                                    </MudText>
                                    <MudText Typo="Typo.h4" Class="kpi-value green">
                                        @string.Format("{0:0.##}%", ExecSummary.TatCompliancePercent)
                                    </MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- Delayed Requests -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="3" Class="pa-4 kpi-card">
