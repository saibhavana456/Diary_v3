                @* --- Filters --- *@
                <MudGrid Spacing="2" Class="pa-4 align-center">
                    <MudItem xs="12" sm="2">
                        <MudSelect T="int" Label="Fin Year" Value="Filter.FyStartYear" ValueChanged="OnFyStartYearChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            @foreach (var fy in FinancialYears)
                            {
                                <MudSelectItem Value="@fy">@fy-@(fy + 1)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudDatePicker Label="Start Date" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                       Date="Filter.StartDate" DateChanged="OnStartDateChanged" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudDatePicker Label="To Date" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                       Date="Filter.EndDate" DateChanged="OnEndDateChanged" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Assigned Dept" Value="Filter.DeptName" ValueChanged="OnDeptChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("All")">All Departments</MudSelectItem>
                            @foreach (var d in DeptNames)
                            {
                                <MudSelectItem Value="@d">@d</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Letter Type" Value="Filter.LetterType" ValueChanged="OnLetterTypeChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("All")">All Letter Types</MudSelectItem>
                            @foreach (var lt in LetterTypes)
                            {
                                <MudSelectItem Value="@lt">@lt</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Addressed To" Value="Filter.AddressedTo" ValueChanged="OnAddressedToChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("All")">All</MudSelectItem>
                            @foreach (var a in AddressedTos)
                            {
                                <MudSelectItem Value="@a">@a</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Status" Value="Filter.DashStatus" ValueChanged="OnDashStatusChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("All")">All</MudSelectItem>
                            <MudSelectItem Value="@("Submitted")">Submitted</MudSelectItem>
                            <MudSelectItem Value="@("Interim")">Interim</MudSelectItem>
                            <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Timeliness" Value="Filter.Timeliness" ValueChanged="OnTimelinessChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("All")">All</MudSelectItem>
                            <MudSelectItem Value="@("Intime")">Intime</MudSelectItem>
                            <MudSelectItem Value="@("Delayed")">Delayed</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (Filter.DashStatus == "Pending" && Filter.Timeliness == "Delayed")
                    {
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" Label="Pending Bucket" Value="Filter.PendingBucket" ValueChanged="OnPendingBucketChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="@("All")">All</MudSelectItem>
                                <MudSelectItem Value="@("LT3")">Less than 3 Days</MudSelectItem>
                                <MudSelectItem Value="@("3TO5")">3 to 5 Days</MudSelectItem>
                                <MudSelectItem Value="@("5TO10")">5 to 10 Days</MudSelectItem>
                                <MudSelectItem Value="@("GT10")">More than 10 Days</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    }

                    @if (SummaryFlag == "A")
                    {
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" Label="Authority" Value="Filter.Authority" ValueChanged="OnAuthorityChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="@("All")">All Authorities</MudSelectItem>
                                @foreach (var a in AuthorityList)
                                {
                                    <MudSelectItem Value="@a">@a</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    <MudSpacer />
                    <MudItem xs="12" sm="2" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" StartIcon="@MudBlazor.Icons.Material.Filled.Download"
                                   Style="background-color: #000066; color: white; font-size: 11px;"
                                   OnClick="HandleExport">Export To Excel</MudButton>
                    </MudItem>
                </MudGrid>

                <MudPaper Class="mx-4 mb-2 pa-2">
                    <MudRadioGroup T="string"
                                   Value="SummaryFlag"
                                   ValueChanged="OnSummaryFlagChanged"
                                   Row="true">

                        <MudRadio T="string" Value="@("A")" Label="Authority wise" />
                        <MudRadio T="string" Value="@("D")" Label="Department wise" />

                    </MudRadioGroup>
                </MudPaper>           

                @* --- Pie Chart --- *@
                <MudPaper Elevation="1" Class="mx-4 mb-4 pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        @(SummaryFlag == "D"
                            ? "Department-wise Compliance Distribution"
                            : "Authority-wise Compliance Distribution")
                    </MudText>

                    @if (!_pieData.Any())
                    {
                        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                            No data available for selected filters.
                        </MudText>
                    }
                    else
                    {
                        <ApexCharts.ApexChart @key="PieChartRenderKey"
                                              TItem="AuthorityPieItem"
                                              Options="_pieOptions"
                                              Height="300">
                            <ApexCharts.ApexPointSeries TItem="AuthorityPieItem"
                                             Items="_pieData"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(x => x.Authority)"
                                             YValue="@(x => x.Count)"
                                             Name="Total" />
                        </ApexCharts.ApexChart>
                    }
                </MudPaper>

                @* --- Table with Grouped Headers --- *@
                <div class="px-4 d-flex justify-end">
                    <MudText Typo="Typo.caption" Style="font-weight:bold; font-style:italic; color: #666;">@AsOnDateLabel</MudText>
                </div>

                <MudItem xs="12" Class="pa-4">
                    <MudSimpleTable Dense="true" Bordered="true" Striped="true" FixedHeader="true"
                                    Elevation="2" Style="font-size:12px; overflow-x:auto; max-height:750px;">
                        <thead>
                            <tr class="grouped-header">
                                <th rowspan="2" style="width:50px; vertical-align:middle;">S.No</th>
                                @* <th rowspan="2" style="width:20%; vertical-align:middle;">Authority</th> *@
                                    <th rowspan="2">
                                        @(SummaryFlag == "D" ? "Department" : "Authority")
                                    </th>

                                <th colspan="3" style="border-bottom:2px solid #4caf50;">Submitted</th>
                                <th colspan="3" style="border-bottom:2px solid #ff9800;">Interim</th>
                                <th colspan="3" style="border-bottom:2px solid #f44336;">Pending</th>
                                <th rowspan="2" style="width:8%; vertical-align:middle;">Grand Total</th>
                            </tr>
                            <tr class="grouped-header">
                                <th style="width:8%;">In Time</th>
                                <th style="width:8%;">Delayed</th>
                                <th style="width:8%;">Total</th>
                                <th style="width:8%;">In Time</th>
                                <th style="width:8%;">Delayed</th>
                                <th style="width:8%;">Total</th>
                                <th style="width:8%;">In Progress</th>
                                <th style="width:8%;">Delayed</th>
                                <th style="width:8%;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoading)
                            {
                                <tr>
                                    <td colspan="12" style="text-align:center; padding:40px;">
                                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Small" />
                                        <span class="ml-2">Loading...</span>
                                    </td>
                                </tr>
                            }
                            else if (!Data.Any())
                            {
                                <tr>
                                    <td colspan="12" style="text-align:center; padding:40px;">
                                        <MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Error">No record found</MudText>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int sno = 1;
                                @foreach (var row in Data)
                                {
                                    @* var authority = row.ContainsKey("AUTHORITY") ? row["AUTHORITY"]?.ToString() ?? "" : ""; *@
                                    var labelValue = row.ContainsKey("FLAG_TXT")
                                    ? row["FLAG_TXT"]?.ToString() ?? ""
                                    : "";

                                    var currentAuthority = labelValue;
                                    @* var currentAuthority = authority; *@
                                    <tr>
                                        <td style="text-align:center;">@(sno++)</td>
                                       @*  <td>@authority</td> *@
                                        <td>@labelValue</td>
                                        @foreach (var col in _statusColumns)
                                        {
                                            var cellVal = GetCellValue(row, col.PropertyName);
                                            var isZero = cellVal == "0";
                                            var capturedStatusKey = col.StatusKey;
                                            var capturedAuthority = currentAuthority;
                                            <td class="status-cell" style="text-align:right;">
                                                @if (isZero)
                                                {
                                                    <span class="status-cell-zero">@cellVal</span>
                                                }
                                                else
                                                {
                                                    <MudButton Variant="Variant.Text"
                                                               Size="MudBlazor.Size.Small"
                                                               Color="MudBlazor.Color.Primary"
                                                               Style="text-decoration:underline; font-weight:600; min-width:auto; padding:0; font-size:inherit; text-transform:none;"
                                                               OnClick="@(() => OnCellClick(capturedAuthority, capturedStatusKey,SummaryFlag == "D"))">
                                                        @cellVal
                                                    </MudButton>
                                                }
                                            </td>
                                        }
                                        <td style="text-align:right; font-weight:700;">@GetCellValue(row, "CNT_TOTAL")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                @* --- Popup Detail Dialog (shown when a count is clicked) --- *@
                @* --- Popup Detail Dialog (Pure MudBlazor Version) --- *@
                <MudOverlay @bind-Visible="_showDetailPanel"
                            AutoClose="true"
                            DarkBackground="true"
                            ZIndex="10000">

                    @* The MudPaper replaces the custom-dialog-card div. AutoClose handles the backdrop logic automatically *@
                    <MudPaper Class="custom-dialog-card" Elevation="4">

                        @* HEADER *@
                        <div class="custom-dialog-header">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Color="MudBlazor.Color.Primary" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #1b4a98;">
                                    @_detailAuthority — @_detailStatusKey
                                </MudText>
                            </MudStack>
                            @* Use OnClick (Capital O) - this is a MudBlazor parameter, not an HTML attribute *@
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="MudBlazor.Color.Default"
                                           OnClick="CloseDetailPanel" />
                        </div>

                        @* BODY *@
                        <div class="custom-dialog-body">
                            @if (_detailLoading)
                            {
                                <MudStack AlignItems="AlignItems.Center" Class="pa-10">
                                    <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
                                    <MudText Typo="Typo.body2" Class="mt-2">Loading details...</MudText>
                                </MudStack>
                            }
                            else if (!_detailData.Any())
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No detail records found.</MudAlert>
                            }
                            else
                            {
                                <MudTable Items="@_detailData" Dense="true" Bordered="true"
                                          Hover="true" Elevation="0" RowsPerPage="10" T="ComplianceStatusDetail"
                                          Style="font-size:12px;">
                                    <HeaderContent>
                                        <MudTh Style="background:#2a2f5b; color:white;">S.No</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Letter Serial No</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Received From</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Subject</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Send Dept</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Target Date</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Letter Date</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Received On</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Action Taken</MudTh>
                                        <MudTh Style="background:#2a2f5b; color:white;">Action Date</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.SNo</MudTd>
                                            <MudTd>@context.LetterRefNo</MudTd>
                                            <MudTd>@context.Authority</MudTd>
                                            <MudTd>@context.Subject</MudTd>
                                            <MudTd>@context.DeptName</MudTd>
                                            <MudTd>@context.DueDate</MudTd>
                                            <MudTd>@context.LetterDate</MudTd>
                                            <MudTd>@context.ReceivedDate</MudTd>
                                            <MudTd>@context.ActionTaken</MudTd>
                                            <MudTd>@context.ActionDate</MudTd>
                                        </RowTemplate>
                                        <PagerContent>
                                            <MudTablePager PageSizeOptions="new int[] { 5, 10, 25 }" />
                                        </PagerContent>
                                    </MudTable>
                            }
                        </div>

                        @* FOOTER *@
                        <div class="custom-dialog-footer">
                            <MudButton OnClick="CloseDetailPanel"
                                       Color="MudBlazor.Color.Primary"
                                       Variant="Variant.Filled"
                                       Class="rounded-pill px-6">
                                Close
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudOverlay>
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

