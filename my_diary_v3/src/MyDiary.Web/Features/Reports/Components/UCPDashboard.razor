@using MyDiary.Web.Core.Extensions
@page "/reports/UCPDashboard"
@using Microsoft.JSInterop
@using MudBlazor
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using MyDiary.Web.Features.Shared.Components
@using Microsoft.AspNetCore.Components.Web
@using MyDiary.Web.Components.Dialogs
@inject MyDiary.Web.Features.Shared.Services.IComplianceSummaryService SummaryService
@inject IDialogService DialogService
@inject IJSRuntime JS
@using ApexCharts

<PageTitle>UCP Dashboard — My Diary</PageTitle>

<style>
    .grouped-header th {
        background-color: #2a2f5b !important;
        color: white !important;
        text-align: center !important;
        font-weight: 700;
        font-size: 12px;
        padding: 6px 8px;
        border: 1px solid #3d4480;
    }

    .status-cell {
        cursor: default;
        position: relative;
    }

    .status-cell-btn {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: #1565C0;
        text-decoration: underline;
        cursor: pointer;
        font-weight: 600;
        font-size: inherit;
        font-family: inherit;
        line-height: inherit;
    }

    .status-cell-btn:hover {
        color: #0d47a1;
    }

    .status-cell-zero {
        color: #9e9e9e;
    }

    .detail-panel {
        border: 2px solid #1b4a98;
        border-radius: 8px;
        background: #f8f9ff;
    }

    .custom-dialog-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .custom-dialog-card {
        width: 95vw;
        max-width: 1100px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        overflow: hidden; /* Prevents double scrollbars */
    }

    .custom-dialog-header {
        padding: 12px 20px;
        background: #fdfdfd;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
    }

    .custom-dialog-body {
        flex-grow: 1;
        padding: 16px;
        overflow-y: auto; /* Only the body scrolls if the table is long */
    }

    .custom-dialog-footer {
        padding: 12px 20px;
        border-top: 1px solid #e0e0e0;
        display: flex;
        justify-content: flex-end;
    }

    .kpi-card {
        border-radius: 16px;
        text-align: center;
        background: linear-gradient(180deg, #ffffff, #f5f7ff);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        }

    .kpi-title {
        font-weight: 600;
        color: #555;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-weight: 800;
    }

        .kpi-value.blue {
            color: #0d47a1;
        }

        .kpi-value.amber {
            color: #ffb300;
        }

        .kpi-value.green {
            color: #2e7d32;
        }

        .kpi-value.red {
            color: #c62828;
        }



</style>

