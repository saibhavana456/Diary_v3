    private void CloseDetailPanel()
    {
        _showDetailPanel = false;
    }

    private string GetCellValue(Dictionary<string, object> row, string key)
    {
        if (!row.TryGetValue(key, out var val) || val == DBNull.Value || val == null) return "0";
        if (int.TryParse(val.ToString(), out var n)) return n.ToString("N0");
        return val.ToString() ?? "0";
    }

