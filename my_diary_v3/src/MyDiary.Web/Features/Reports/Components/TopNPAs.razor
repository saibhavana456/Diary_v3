@using MyDiary.Web.Core.Extensions
@page "/reports/topNPAs"
@using Microsoft.JSInterop
@using System.Linq
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using MyDiary.Web.Features.Shared.Components
@using Microsoft.AspNetCore.Components.Web
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject MyDiary.Core.Abstractions.ICurrentUser ReportScopeUser


<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>Top NPAs — My Diary</PageTitle>

<DynamicDashboard Config="_activeConfig"
                  Data="_data"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabel"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExport" />

@code {
    [SupplyParameterFromQuery][Parameter] public string? Title { get; set; }

    private List<Dictionary<string, object>> _data = new();
    // WebForms page used "All" (value = "all") for each dropdown; mirror that here
    private string _selectedZone = "all", _selectedRegion = "all", _selectedBranch = "all";
    private string _asOnDateLabel = "";
    private bool _loading = true;
    private ReportConfig _activeConfig = new();

    // Privilege context (map from claims if available): CO | ZONE | REGION | BRANCH
    private string _userPrivilege = "CO";
    private string _userZoneSolid = "00000", _userRegionSolid = "00000", _userBranchSolid = "00000";

    // Columns (match SELECT aliases)
    private readonly List<ColumnConfig> _cols = new() {
        new ColumnConfig { Header = "Zone",              PropertyName = "zone_name_eng", Width = "12%" },
        new ColumnConfig { Header = "Region",            PropertyName = "region_name",   Width = "12%" },
        new ColumnConfig { Header = "Branch",            PropertyName = "branch_name",   Width = "14%" },
        new ColumnConfig { Header = "Sol ID",            PropertyName = "sol_id",        Width = "8%"  },
        new ColumnConfig { Header = "Customer ID",       PropertyName = "CIFID",         Width = "10%" },
        new ColumnConfig { Header = "Customer Name",     PropertyName = "CustomerName",  Width = "18%" },
        new ColumnConfig { Header = "No of Accounts",    PropertyName = "NoOfAc",        IsNumeric = true, Format = "N0", Width = "12%" },
        new ColumnConfig { Header = "Total Outstanding", PropertyName = "TotalBalance",  IsNumeric = true, Format = "N2", Width = "14%" }
    };

    protected override async Task OnInitializedAsync()
    {
        // RBAC: scope this report to the logged-in user (fail-closed to BRANCH for unknown privilege).
        {
            var __scope = MyDiary.Web.Features.Reports.Services.ReportUserScope.Resolve(ReportScopeUser);
            _userPrivilege = __scope.Privilege;
            _userZoneSolid = __scope.ZoneSolid;
            _userRegionSolid = __scope.RegionSolid;
            _userBranchSolid = __scope.BranchSolid;
        }
        _activeConfig.Title = Title ?? "Top NPAs";
        _activeConfig.Columns = _cols;
        await LoadReport();
    }

    private async Task HandleFilterChanged((string zone, string region, string branch) f)
    {
        _selectedZone = f.zone;
        _selectedRegion = f.region;
        _selectedBranch = f.branch;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Base FROM and SELECT (TOP 25; amounts in Lacs)
            string fromJoin =
                " FROM TopNPAs a " +
                " JOIN Branch_Master b ON a.SolID = b.SOL_ID " +
                " LEFT JOIN CustomerAddress add1 ON a.CIFID = add1.cifid ";

            // NOTE: Phone/Address columns are not shown in the grid per the WebForms markup (commented out there as well)
            string selectCols =
                " TOP 25 " +
                " a.CIFID, a.CustomerName, a.NoOfAc, " +
                " (a.OSBalance) / 100000.0 AS TotalBalance, " +  // Lacs (as in legacy)
                " b.BRANCH_NAME AS branch_name, b.Sol_ID AS sol_id, b.region_name, b.zone_name_eng ";

            string where = " WHERE 1=1 ";
            string orderBy = " ORDER BY TotalBalance ASC"; // Legacy sorts ascending

            // ---------- Privilege scope ----------
            switch (_userPrivilege)
            {
                case "ZONE":
                    where += $" AND b.Zone_solid = '{_userZoneSolid}'";
                    break;
                case "REGION":
                    where += $" AND b.region_solid = '{_userRegionSolid}'";
                    break;
                case "BRANCH":
                    where += $" AND b.sol_id = '{_userBranchSolid}'";
                    break;
            }

            // ---------- Selections (All = 'all') ----------
            if (!string.Equals(_selectedZone, "all", StringComparison.OrdinalIgnoreCase))
                where += $" AND b.zone_solid = '{_selectedZone}'";

            if (!string.Equals(_selectedRegion, "all", StringComparison.OrdinalIgnoreCase))
                where += $" AND b.region_solid = '{_selectedRegion}'";

            if (!string.Equals(_selectedBranch, "all", StringComparison.OrdinalIgnoreCase))
                where += $" AND b.sol_id = '{_selectedBranch}'";

            // Final query
            var finalQuery = $"SELECT {selectCols} {fromJoin}{where}{orderBy}";
            _data = await ReportService.ExecuteRawQueryAsync(finalQuery);

            // As-on date: this table uses DataAsOn (not LastUpdateDate), so fetch explicitly
            var asOnRow = (await ReportService.ExecuteRawQueryAsync(
                "SELECT CONVERT(varchar, MAX(DataAsOn), 103) AS DataAsOn FROM TopNPAs WHERE 1=1"))
                .FirstOrDefault() ?? new Dictionary<string, object>();
            var asOn = asOnRow.TryGetValue("DataAsOn", out var v) ? v?.ToString() ?? "" : "";

            _asOnDateLabel = _data.Count > 0
                ? $"Data As On - {asOn} (Rs. in Lacs)"
                : " ";
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[TopNPAs] Unhandled error: " + ex.Message);
            _data = new();
            _asOnDateLabel = " ";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleExport()
    {
        var bytes = ReportService.ExportToExcel(_data, _cols, "TopNPAs");
        await JS.InvokeVoidAsync("BlazorDownloadFile",
            "TopNPAs.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }
}