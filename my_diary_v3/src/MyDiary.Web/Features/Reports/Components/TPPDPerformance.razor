                        columns = "zone_name_eng,BM.Region_Name, BM.Branch_Name,BM.Sol_Id branchsol,SUDLife/100000 SUDLife,IFLIC/100000 IFLIC,LIC/100000 LIC,CreditLife/100000 CreditLife,Bajaj/100000 Bajaj,Chola/100000 Chola,United/100000 United,CareRetail/100000 CareRetail,ManipalRetail/100000 ManipalRetail,CareGMC/100000 CareGMC,ManipalGMC/100000 ManipalGMC,MFLumpsum/100000 MFLumpsum,MFSIP MFSIP";
