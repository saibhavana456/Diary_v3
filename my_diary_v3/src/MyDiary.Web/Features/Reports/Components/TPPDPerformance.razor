            if (_selectedBranch == "1")
            {
                columns = "Sum(SUDLife)/100000 TotalSUD,Sum(IFLIC)/100000 TotalIFLIC,Sum(LIC)/100000 TotalLIC,Sum(CreditLife)/100000 TotalCreditLife,Sum(Bajaj)/100000 TotalBajaj,Sum(Chola)/100000 TotalChola,Sum(United)/100000 TotalUnited,Sum(CareRetail)/100000 TotalCareRetail,Sum(ManipalRetail)/100000 TotalManipalRetail,Sum(CareGMC)/100000 TotalCareGMC,Sum(ManipalGMC)/100000 TotalManipalGMC,Sum(MFLumpsum)/100000 TotalMFLumpsum,Sum(MFSIP) TotalMFSIP, 'All' As Branch_Name,BM.Region_Name,zone_name_eng, region_solid As BranchSol";
                groupBy = " Group By BM.Region_Name, region_SolId, zone_name_eng";
            }
            else
            {
                isSummary = false;
                if (_selectedBranch != "all") where += $" and BM.sol_id = '{_selectedBranch}'";
                columns = "zone_name_eng,BM.Region_Name, BM.Branch_Name,BM.Sol_Id branchsol,SUDLife/100000 SUDLife,IFLIC/100000 IFLIC,LIC/100000 LIC,CreditLife/100000 CreditLife,Bajaj/100000 Bajaj,Chola/100000 Chola,United/100000 United,CareRetail/100000 CareRetail,ManipalRetail/100000 ManipalRetail,CareGMC/100000 CareGMC,ManipalGMC/100000 ManipalGMC,MFLumpsum/100000 MFLumpsum,MFSIP MFSIP";
            }
        }
        else if (_userPrivilege == "BRANCH")
        {
            isSummary = false;
            where += $" and b.sol_id = '{_userBranchSolid}'";
            columns = "zone_name_eng,BM.Region_Name, BM.Branch_Name,BM.Sol_Id branchsol,SUDLife/100000 SUDLife,IFLIC/100000 IFLIC,LIC/100000 LIC,CreditLife/100000 CreditLife,Bajaj/100000 Bajaj,Chola/100000 Chola,United/100000 United,CareRetail/100000 CareRetail,ManipalRetail/100000 ManipalRetail,CareGMC/100000 CareGMC,ManipalGMC/100000 ManipalGMC,MFLumpsum/100000 MFLumpsum,MFSIP MFSIP";
        }

        // Execute Query
        string finalQuery = $"SELECT {columns} FROM Branch_Master BM Left Join TPPD_Life A ON Bm.SOL_ID = A.SolID Left Join TPPD_NonLife B  on BM.SOL_ID = B.Solid Left Join TPPD_Health C On  BM.Sol_Id= C.Solid Left Join TPPD_MutualFund D on BM.Sol_ID = D.SolId WHERE {where} {groupBy} {orderBy}";
        // Data query and as-on-date are independent - run in parallel
        var dataTask = ReportService.ExecuteRawQueryAsync(finalQuery);
        var dateTask = ReportService.GetAsOnDateAsync("TPPD_Life");
        await Task.WhenAll(dataTask, dateTask);
        _data = dataTask.Result;
        string date = dateTask.Result;

        if (isSummary)
        {
            _activeConfig.Columns = _summaryCols;
        }
        else
        {
            _activeConfig.Columns = _detailedCols;
        }
        _asOnDateLabel = $"Data As On - {date} (Rs. in Lakhs)";

        _loading = false;
        StateHasChanged();
    }

    private async Task HandleExport()
    {
        var bytes = ReportService.ExportToExcel(_data, _activeConfig.Columns, "TPPD_Products_"+_selectedPdt);
        await JS.InvokeVoidAsync("BlazorDownloadFile", "TPPD_Products_" + _selectedPdt+".xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
}