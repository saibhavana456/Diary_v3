        StateHasChanged();

        string columns = "";
        string where = "region_solid <> '' and Zone_SolId <> '' ";
        string groupBy = "";
        string orderBy = " Order By Zone_Name_Eng,Region_Name,Branch_Name,Branchsol";
        bool isSummary = true;

        // EXACT Logic from ThirdPartyPerformance.aspx.cs
        if (_userPrivilege == "CO")
        {
            if (_selectedZone == "1") // All(Summary)
            {
                columns = "Sum(SUDLife)/100000 TotalSUD,Sum(IFLIC)/100000 TotalIFLIC,Sum(LIC)/100000 TotalLIC,Sum(CreditLife)/100000 TotalCreditLife,Sum(Bajaj)/100000 TotalBajaj,Sum(Chola)/100000 TotalChola,Sum(United)/100000 TotalUnited,Sum(CareRetail)/100000 TotalCareRetail,Sum(ManipalRetail)/100000 TotalManipalRetail,Sum(CareGMC)/100000 TotalCareGMC,Sum(ManipalGMC)/100000 TotalManipalGMC,Sum(MFLumpsum)/100000 TotalMFLumpsum,Sum(MFSIP) TotalMFSIP, 'All' As Branch_Name,'All' As Region_Name,'All' As zone_name_eng,'All' As BranchSol";
            }
            else if (_selectedZone == "all") // All(Zonewise)
            {
                if (_selectedRegion == "1")
                {
                    columns = "Sum(SUDLife)/100000 TotalSUD,Sum(IFLIC)/100000 TotalIFLIC,Sum(LIC)/100000 TotalLIC,Sum(CreditLife)/100000 TotalCreditLife,Sum(Bajaj)/100000 TotalBajaj,Sum(Chola)/100000 TotalChola,Sum(United)/100000 TotalUnited,Sum(CareRetail)/100000 TotalCareRetail,Sum(ManipalRetail)/100000 TotalManipalRetail,Sum(CareGMC)/100000 TotalCareGMC,Sum(ManipalGMC)/100000 TotalManipalGMC,Sum(MFLumpsum)/100000 TotalMFLumpsum,Sum(MFSIP) TotalMFSIP,  'All' As Branch_Name,'All' As Region_Name,zone_name_eng,Zone_SolId As BranchSol";
                    groupBy = " Group By Zone_SolId, zone_name_eng";
                }
                else if (_selectedRegion == "all")
                {
                    if (_selectedBranch == "1")
                    {
                        columns = "Sum(SUDLife)/100000 TotalSUD,Sum(IFLIC)/100000 TotalIFLIC,Sum(LIC)/100000 TotalLIC,Sum(CreditLife)/100000 TotalCreditLife,Sum(Bajaj)/100000 TotalBajaj,Sum(Chola)/100000 TotalChola,Sum(United)/100000 TotalUnited,Sum(CareRetail)/100000 TotalCareRetail,Sum(ManipalRetail)/100000 TotalManipalRetail,Sum(CareGMC)/100000 TotalCareGMC,Sum(ManipalGMC)/100000 TotalManipalGMC,Sum(MFLumpsum)/100000 TotalMFLumpsum,Sum(MFSIP) TotalMFSIP,  'All' As Branch_Name,BM.Region_Name,zone_name_eng,region_SolId As BranchSol";
