@using MyDiary.Web.Core.Extensions
@page "/reports/branchLibrary"
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using MudBlazor
@using MyDiary.Web.Features.Shared.Services
@inject DynamicReportService ReportService


<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>Branch Library — My Diary</PageTitle>

<MudPaper Elevation="0" Style="background-color:#ffffff; padding:1.5rem;">
    <h3 class="text-center mb-4">Branch Library</h3>

    <div class="container">
        <!-- Search Card / Block -->
        <div class="d-flex flex-column align-items-center">
            <!-- Input centered -->
            <div class="w-100" style="max-width: 600px;">
                <label class="control-label w-100 text-center mb-2">
                    Search Using Branch Name or SOL ID or IFSC
                </label>
                <input class="form-control text-center"
                       @bind="_searchText"
                       @bind:event="oninput"
                       placeholder="Enter Branch Name or SOL ID or IFSC"
                       @onkeydown="HandleEnter" />
            </div>

            <!-- Buttons centered under the textbox -->
            <div class="d-flex justify-content-center gap-2 mt-3">
                <button class="btn btn-success px-4" @onclick="OnSearch" disabled="@_loading">Search</button>
                <button class="btn btn-outline-secondary px-4" @onclick="OnClear" disabled="@_loading">Clear</button>
            </div>
        </div>

        <!-- Messages / Loading -->
        <div class="row mt-3">
            <div class="col-12 d-flex justify-content-center">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger mb-0" role="alert">@_error</div>
                }
                else if (_loading)
                {
                    <div class="text-muted">Loading...</div>
                }
                else if (_data.Count == 0 && _hasSearched)
                {
                    <div class="alert alert-warning mb-0">Requested Branch Not Found</div>
                }
            </div>
        </div>

        <!-- Results table -->
        @if (_data.Count > 0)
        {
            <div class="row mt-4">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th style="width:90px; text-align:center;">S.No</th>
                                    <th class="text-center">Branch Code</th>
                                    <th class="text-center">MICR Code</th>
                                    <th class="text-center">IFSC Code</th>
                                    <th class="text-center">Branch Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _data.Select((r, i) => new { r, i }))
                                {
                                    <tr>
                                        <td style="text-align:center;">@(row.i + 1)</td>
                                        <td class="text-center">@Get(row.r, "branch_code")</td>
                                        <td class="text-center">@Get(row.r, "MICR_CODE")</td>
                                        <td class="text-center">@Get(row.r, "IFSC_CODE")</td>
                                        <td>@Get(row.r, "branch_name")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</MudPaper>

@code {
    private string _searchText = "";
    private bool _loading = false;
    private bool _hasSearched = false;
    private string _error = "";
    private List<Dictionary<string, object>> _data = new();

    private async Task OnSearch()
    {
        _error = "";
        _hasSearched = true;
        _loading = true;
        StateHasChanged();

        try
        {
            var search = (_searchText ?? string.Empty).Trim();

            if (string.IsNullOrWhiteSpace(search))
            {
                _data = new();
                _error = "Please enter Branch Name, SOL ID, or IFSC.";
                return;
            }

            var where = BuildWhere(search);

            string sql = $@"
SELECT TOP 500
    branch_code,
    MICR_CODE,
    IFSC_CODE,
    branch_name
FROM branch_master
WHERE {where}
ORDER BY branch_name";

            _data = await ReportService.ExecuteRawQueryAsync(sql);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[BranchLibrary] Unhandled error: " + ex.Message);
            _error = "Error occurred. Please try again later.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string BuildWhere(string search)
    {
        bool isNumeric = search.All(char.IsDigit);
        bool looksLikeIfsc = search.Any(char.IsLetter);

        var clauses = new List<string>
        {
            $"branch_name like '%{EscapeLike(search)}%'"
        };

        if (isNumeric)
        {
            clauses.Add($"CAST(sol_id as varchar(10)) = '{search}'");
            clauses.Add($"CAST(branch_code as varchar(10)) = '{search}'");
        }

        if (looksLikeIfsc || search.Length >= 4)
        {
            clauses.Add($"IFSC_CODE like '%{EscapeLike(search)}%'");
        }

        return string.Join(" OR ", clauses);
    }

    private static string EscapeLike(string input)
        => input.Replace("[", "[[]").Replace("%", "[%]").Replace("_", "[_]");

    private void OnClear()
    {
        _searchText = "";
        _data = new();
        _error = "";
        _hasSearched = false;
    }

    private Task HandleEnter(KeyboardEventArgs e)
        => e.Key == "Enter" ? OnSearch() : Task.CompletedTask;

    private static string Get(Dictionary<string, object> row, string key)
        => row.TryGetValue(key, out var val) && val != null && val != DBNull.Value ? val.ToString()! : "—";
}