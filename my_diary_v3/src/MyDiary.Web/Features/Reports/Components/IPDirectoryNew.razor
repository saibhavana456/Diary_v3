@page "/reports/ipnewdirectory"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@using MudBlazor
@using MyDiary.Web.Features.IPDirectory.Models
@using MyDiary.Web.Features.IPDirectory.Services
@using MyDiary.Web.Services
@inject IIPDirectoryService DirectoryService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop;
@inject IJSRuntime JS

<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>IP DIrectory</PageTitle>

<style>
    .main-content-wrapper {
        padding: 20px;
        display: flex;
        flex-direction: column; /* stack: hero on top, row below */
        gap: 20px; /* space between hero and row (no white strip) */
        min-height: 85vh;
        background-size: cover;
        background-position: center;
    }

    /* Remove bottom margin to avoid white line between sections */
    .hero-section {
        background: var(--primary-gradient);
        color: white;
        padding: 2rem;
        border-radius: 16px;
        margin-bottom: 0; /* was 1.25rem — this caused the white gap */
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    /* New row to hold the two columns */
    .content-row {
        display: flex;
        gap: 20px;
    }

    .mud-dialog {
    border-radius: 18px !important;
    overflow: hidden;
}

.mud-dialog-title {
    background: linear-gradient(135deg,#1E3A8A 0%,#EF4444 100%);
    color: white;
    padding: 18px 24px;
}

.mud-dialog-content {
    padding-top: 24px !important;
}

.mud-dialog-actions {
    padding: 16px 24px !important;
    border-top: 1px solid #e5e7eb;
}

.mud-input-control {
    margin-bottom: 8px;
}

    /* Optional: responsive stacking */
    @@media (max-width: 900px) {
        .content-row {
            flex-direction: column;
        }

        .filter-panel {
            width: 100%;
        }
    }

    .filter-panel {
        width: 280px;
        background: white;
        border-radius: 12px;
        padding: 15px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    /* REPLICATING YOUR EXACT SELECTION STYLE [cite: 16, 32, 33] */
    .custom-chipset .mud-chip {
        width: 100%;
        justify-content: start;
        padding: 12px 16px;
        height: auto;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: 0.3s;
        font-size: 0.9rem;
        background-color: transparent;
        color: inherit;
    }

        .custom-chipset .mud-chip:hover {
            background-color: #f1f5f9;
        }

    /* EXACT GRADIENT FROM YOUR DESIGN  */
    .custom-chipset .mud-chip-selected {
        background: linear-gradient(135deg, #1E3A8A 0%, #EF4444 100%) !important;
        color: white !important;
        font-weight: 600;
    }

    .directory-container {
        flex: 1;
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    .table-container {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #f8fafc;
        padding: 15px;
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid #e5e7eb;
    }

    td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
    }

    :root {
        --primary-gradient: linear-gradient(135deg, #1E3A8A 0%, #EF4444 100%);
    }

    .breadcrumb-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .breadcrumb-link {
        color: white !important;
        text-decoration: none;
        transition: 0.3s;
    }

        .breadcrumb-link:hover {
            text-decoration: underline !important;
        }
</style>
<div class="main-content-wrapper">
    <!-- Breadcrumb + header now INSIDE the same background block -->


    <!-- New: row that holds LEFT (filter) + RIGHT (directory) -->
    <div class="content-row">
        <aside class="filter-panel">
            <MudText Typo="Typo.h6" Class="mb-4 px-2" Style="font-weight: 700;">IP Phone Directory</MudText>

            <MudChipSet T="string"
                        SelectedValue="@selectedDept"
                        SelectedValueChanged="OnDeptChanged"
                        Mandatory="true"
                        Class="custom-chipset d-flex flex-column">
                @foreach (var dept in departments)
                {
                    <MudChip Value="@dept"
                             Text="@GetDeptDisplay(dept)"
                             Variant="Variant.Text"
                             Ripple="false" />
                }
            </MudChipSet>
        </aside>

        <section class="directory-container">
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h5" Style="font-weight:700;color:#1E3A8A;">
                    @GetHeaderText()
                </MudText>

                <div class="d-flex align-center gap-2">
                    @if (canManage)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddDialog">
                            Add Entry
                        </MudButton>
                        <InputFile id="ipExcelFile"
                                   OnChange="OnFileSelected"
                                   accept=".xlsx" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Disabled="@(!fileSelected)"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   OnClick="UploadExcel">

                            Upload Full Data

                        </MudButton>

                    }
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ExportExcel">

                        Export Excel

                    </MudButton>

                    <MudTextField T="string"
                                  Value="@searchString"
                                  ValueChanged="@OnSearchDebounced"
                                  Placeholder="Search name or IP..."
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="width:300px;" />
                </div>
            </div>
            <MudDialog @bind-Visible="showDialog"
                       Options="new DialogOptions()
           {
               MaxWidth = MaxWidth.Small,
               FullWidth = true,
               CloseButton = true
           }">

                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">

                        <MudAvatar Color="Color.Primary"
                                   Size="Size.Medium">
                            <MudIcon Icon="@(isEdit
                                 ? Icons.Material.Filled.Edit
                                 : Icons.Material.Filled.PersonAdd)" />
                        </MudAvatar>

                        <MudText Typo="Typo.h6"
                                 Style="font-weight:700;">

                            @(isEdit
                                ? "Edit IP Directory Entry"
                                : "Add New IP Directory Entry")

                        </MudText>

                    </MudStack>
                </TitleContent>

                <DialogContent>

                    <MudPaper Class="pa-4"
                              Elevation="0">

                        <MudGrid Spacing="3">

                            <MudItem xs="12">

                                <MudTextField Label="IP Name"
                                              @bind-Value="editingEntry.Name"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Immediate="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Person" />

                            </MudItem>

                            <MudItem xs="12">

                                <MudSelect T="string"
                                           Label="Department"
                                           @bind-Value="editingEntry.DepartmentName"
                                           Variant="Variant.Outlined"
                                           Required="true">

                                    @foreach (var dept in departments.Where(x => !string.IsNullOrWhiteSpace(x)))
                                    {
                                        <MudSelectItem Value="@dept">
                                            @GetDeptDisplay(dept)
                                        </MudSelectItem>
                                    }

                                </MudSelect>

                            </MudItem>

                            <MudItem xs="12">

                                <MudTextField Label="IP Phone Number"
                                              @bind-Value="editingEntry.IPPhone"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Number"
                                              Required="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Call" />

                            </MudItem>

                        </MudGrid>

                    </MudPaper>

                </DialogContent>

                <DialogActions>

                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="(() => showDialog = false)">

                        Cancel

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(isEdit
                                ? Icons.Material.Filled.Save
                                : Icons.Material.Filled.Add)"
                               OnClick="SaveRecord">

                        @(isEdit ? "Update" : "Save")

                    </MudButton>

                </DialogActions>

            </MudDialog>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Department</th>
                            <th>IP Number</th>

                            @if (canManage)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>

                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="@(canManage ? 4 : 3)"
                                    style="text-align:center;padding:20px;">

                                    <MudProgressCircular Color="Color.Primary"
                                                         Indeterminate="true" />

                                    <div style="margin-top:10px;">
                                        Loading...
                                    </div>

                                </td>
                            </tr>
                        }
                        else if (entries != null && entries.Any())
                        {
                            @foreach (var item in entries)
                            {
                                <tr>

                                    <td>@item.Name</td>

                                    <td>
                                        @GetDeptDisplay(item.DepartmentName)
                                    </td>

                                    <td>@item.IPPhone</td>

                                    @if (canManage)
                                    {
                                        <td>

                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => OpenEditDialog(item))" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           OnClick="@(() => DeleteEntry(item))" />

                                        </td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="@(canManage ? 4 : 3)"
                                    style="text-align:center;padding:20px;color:#666;">

                                    No records found.

                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-center mt-6">
                <MudPagination Color="Color.Primary" Count="@totalPages" Selected="@currentPage" SelectedChanged="PageChanged" />
            </div>
        </section>
    </div>
</div>

@code {
    private List<IPDirectoryEntry> entries = new();
    private string searchString = "";
    private string selectedDept = "";
    private int currentPage = 1;
    private int totalPages = 1;
    private const int pageSize = 20;
    private bool isLoading = true;
    private System.Timers.Timer? _debounceTimer;
    private bool showDialog;
    private bool isEdit;
    private string currentUser = "";
    private bool canManage;
    private IPDirectoryEntry editingEntry = new();

    private IBrowserFile? selectedFile;
    private bool fileSelected;

    private async Task ExportExcel()
    {
        try
        {
            var fileBytes =
                await DirectoryService
                    .ExportIPDirectoryExcelAsync();

            var fileName =
                $"IPDirectory_{AppTime.Now:yyyyMMddHHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFile",
                fileName,
                Convert.ToBase64String(fileBytes));
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBox(
                "Export Failed",
                ex.Message);
        }
    }

    private void OnFileSelected(
    InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        fileSelected = true;

        Snackbar.Add(
            $"{selectedFile.Name} selected.",
            Severity.Info);
    }

    private async Task UploadExcel()
    {
        try
        {
            if (selectedFile == null)
            {
                Snackbar.Add(
                    "Please select a file.",
                    Severity.Warning);

                return;
            }

            using var ms = new MemoryStream();

            await selectedFile
                .OpenReadStream(50 * 1024 * 1024)
                .CopyToAsync(ms);

            ms.Position = 0;

            var result =
                await DirectoryService
                    .ImportIPDirectoryExcelAsync(
                        ms,
                        currentUser);

            if (result.Success)
            {
                selectedFile = null;
                fileSelected = false;

                await LoadData();

                await JS.InvokeVoidAsync(
                    "resetFileInput",
                    "ipExcelFile");

                await DialogService.ShowMessageBox(
                    "Success",
                    result.Message);

                return;
            }
            else
            {
                await DialogService.ShowMessageBox(
    "Upload Failed",
    result.Message);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.ToString(),
                Severity.Error);
        }
    }

    private async Task DeleteEntry(IPDirectoryEntry item)
    {
        bool? confirm =
            await DialogService.ShowMessageBox(
                "Delete Entry",
                $"Are you sure you want to delete {item.Name} ?",
                yesText: "Delete",
                cancelText: "Cancel");

        if (confirm != true)
            return;

        var success =
            await DirectoryService.DeleteDirectoryEntryAsync(
                item.Name,
                currentUser);

        if (success)
        {
            Snackbar.Add(
                "Record deleted successfully.",
                Severity.Success);

            await LoadData();
        }
    }

    private async Task SaveRecord()
    {
        if (string.IsNullOrWhiteSpace(editingEntry.Name))
        {
            Snackbar.Add("Name is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(editingEntry.DepartmentName))
        {
            Snackbar.Add("Department is required.", Severity.Error);
            return;
        }

        if (!long.TryParse(editingEntry.IPPhone, out _))
        {
            Snackbar.Add("IP Phone must contain numbers only.", Severity.Error);
            return;
        }

        bool success;

        if (isEdit)
        {
            success =

                       await DirectoryService.UpdateDirectoryEntryAsync(
                editingEntry,
                currentUser);

            if (success)
                Snackbar.Add("Record updated successfully.", Severity.Success);
        }
        else
        {
            success = await DirectoryService.AddDirectoryEntryAsync(
                    editingEntry,
                    currentUser);

            if (success)
                Snackbar.Add("Record added successfully.", Severity.Success);
        }

        if (!success)
        {
            Snackbar.Add("Failed to save record.", Severity.Error);
            return;
        }

        showDialog = false;

        await LoadData();
    }

    private void OpenAddDialog()
    {
        isEdit = false;

        editingEntry = new IPDirectoryEntry();

        showDialog = true;
    }

    private void OpenEditDialog(IPDirectoryEntry item)
    {
        isEdit = true;

        editingEntry = new IPDirectoryEntry
            {
                Name = item.Name,
                DepartmentName = item.DepartmentName,
                IPPhone = item.IPPhone
            };

        showDialog = true;
    }

    private readonly string[] departments =
    {
    "",
    "Branches",
    "CISO",
    "Central Office",
    "DR Site",
    "Information Technology",
    "Regional Office",
    "Training Centres",
    "Zonal Office"
};

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        currentUser =
            authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        canManage = currentUser == "921604" && currentUser != "";

        await LoadData();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadData()
    {
        isLoading = true;

        var result =
            await DirectoryService.GetDirectoryAsync(
                selectedDept,
                searchString,
                currentPage,
                pageSize);

        if (result != null)
        {
            entries = result.Entries;
            totalPages =
                (int)Math.Ceiling(
                    (double)result.TotalRecords / pageSize);
        }

        isLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDeptChanged(string value)
    {
        selectedDept = value;
        currentPage = 1;
        await LoadData();
    }

    private string GetHeaderText()
    {
        var deptLabel = string.IsNullOrEmpty(selectedDept) ? "All Departments" : selectedDept;
        return GetDeptDisplay(deptLabel);
    }

    private void OnSearchDebounced(string value)
    {
        searchString = value;
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();

        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.Elapsed += async (s, e) =>
        {
            _debounceTimer.Stop();
            currentPage = 1;
            await InvokeAsync(LoadData);
        };
        _debounceTimer.Start();
    }

    private async Task PageChanged(int i)
    {
        currentPage = i;
        await LoadData();
    }
    private static string GetDeptDisplay(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "All Departments";

        // Map only for display
        return value.Trim() switch
        {
            "Training Centres" => "Union Bank Knowledge Centre",
            _ => value.Trim()
        };
    }
}