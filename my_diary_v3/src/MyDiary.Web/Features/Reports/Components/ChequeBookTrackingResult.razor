@using MyDiary.Web.Core.Extensions
@page "/reports/chequebook-tracking-result"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization
@using MyDiary.Web.Features.Shared.Services
@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject NavigationManager Nav

<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>ChequeBook Tracking Details</PageTitle>

<div class="container mt-3">
    <div class="row">
        <div class="col-12">
            <div class="breadcrumb-line">
                <strong>You are here :</strong>
                <span style="color:#284e98; font-weight:600;"> ChequeBook Tracking Details</span>
            </div>
        </div>
    </div>

    <div class="row mt-3" style="text-align:center">
        <div class="col-12">

            @if (_loading)
            {
                <div class="py-5 text-muted">Loading�</div>
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger">@_error</div>
                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="BackToSearch">Back To Search Page</button>
                </div>
            }
            else if (_rows.Count == 0)
            {
                <div class="text-danger py-4">No Data Found!</div>
                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="BackToSearch">Back To Search Page</button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover mb-0">
                        <thead class="table-head">
                            <tr>
                                <th style="width:70px;">S No.</th>
                                <th>Account Number</th>
                                <th>Begin Cheque Number</th>
                                <th>Tracking Number</th>
                                <th>Courier Name</th>
                                <th>Dispatched Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _rows.Count; i++)
                            {
                                var r = _rows[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@Get(r, "ACCOUNTNO")</td>
                                    <td>@Get(r, "BEGINCHQNO")</td>
                                    <td>@Get(r, "TRACKERID")</td>
                                    <td>@Get(r, "extra2")</td>
                                    <td>@FormatDdMmYyyy(r, "POSTDATE")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-3 mb-2">
                    <div class="col-12 col-md-3"></div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0">
                        <button class="btn btn-primary w-100" @onclick="BackToSearch">Back To Search Page</button>
                    </div>
                    <div class="col-12 col-md-3"></div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Query binding from ?accountno=...
    [SupplyParameterFromQuery] public string? accountno { get; set; }

    private bool _loading = true;
    private string _error = "";
    private List<Dictionary<string, object>> _rows = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = "";
        _rows.Clear();

        try
        {
            if (string.IsNullOrWhiteSpace(accountno))
            {
                _error = "Account number is missing.";
                return;
            }

            var ac = SqlQuote(accountno!.Trim());

            // Match WebForms:  SELECT * FROM chequebooktracking WHERE accountno = '...' ORDER BY PostDate DESC
            // Make ORDER BY robust to DD-MM-YYYY inputs via CASE/ISDATE (compatible with older SQL Server)
            string sql =
                "SELECT ACCOUNTNO, BEGINCHQNO, TRACKERID, extra2, POSTDATE " +
                "FROM ChequeBookTracking " +
                $"WHERE ACCOUNTNO = '{ac}' " +
                "ORDER BY CASE WHEN ISDATE(POSTDATE) = 1 THEN CONVERT(date, POSTDATE, 105) ELSE NULL END DESC, POSTDATE DESC;";

            _rows = await ReportService.ExecuteRawQueryAsync(sql) ?? new();

            // Optional console peek to verify keys
            if (_rows.Count > 0)
            {
                var keys = string.Join(",", _rows[0].Keys);
                await JS.InvokeVoidAsync("console.log", $"[ChequeBookTrackingResult] rows={_rows.Count}, keys={keys}");
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[ChequeBookTrackingResult] Error: " + ex.Message);
            _error = "Unable to load data at the moment.";
            await JS.InvokeVoidAsync("console.error", $"[ChequeBookTrackingResult] {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void BackToSearch()
    {
        // Adjust to your actual search page route, if different
        Nav.NavigateTo("reports/chequebooktracking");
    }

    // Helpers
    private static string SqlQuote(string s) => s.Replace("'", "''");

    private static string Get(Dictionary<string, object> row, string key)
        => row.TryGetValue(key, out var v) && v != null && v != DBNull.Value
           ? v.ToString()!
           : string.Empty;

    // Render dd/MM/yyyy; input expected as dd-MM-yyyy or other; fallback to original
    private static string FormatDdMmYyyy(Dictionary<string, object> row, string key)
    {
        var raw = Get(row, key);
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;

        // Try dd-MM-yyyy first (style 105), then any parseable date
        if (DateTime.TryParseExact(raw, "dd-MM-yyyy", CultureInfo.InvariantCulture,
                                   DateTimeStyles.None, out var dt))
            return dt.ToString("dd/MM/yyyy");

        if (DateTime.TryParse(raw, out var any))
            return any.ToString("dd/MM/yyyy");

        // Not a valid date; return raw
        return raw;
    }
}

/* ---------- styles (optional light polish) ---------- */
<style>
    .breadcrumb-line {
        padding: 8px 0;
        border-bottom: 1px solid #e6e6e6;
        font-size: 14px;
    }
    .table-head th {
        background-color: #2a2f5b;
        color: #fff;
        vertical-align: middle;
        text-align: center;
        white-space: nowrap;
    }
    td, th {
        vertical-align: middle !important;
    }
</style>