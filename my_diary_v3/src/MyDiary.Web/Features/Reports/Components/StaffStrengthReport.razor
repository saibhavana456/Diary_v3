@using Microsoft.AspNetCore.Components.Web
@using MyDiary.Web.Core.Extensions
@page "/reports/staff-strength"
@using Microsoft.JSInterop
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using MyDiary.Web.Features.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())

@inject DynamicReportService ReportService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider


<MyDiary.Web.Features.Shared.Components.ReportBreadcrumb />

<PageTitle>Staff Strength — My Diary</PageTitle>

<DynamicDashboard Config="_activeConfig"
                  Data="_data"
                  IsLoading="_loading"
                  AsOnDateLabel="@_asOnDateLabel"
                  SelectedZone="@_selectedZone"
                  SelectedRegion="@_selectedRegion"
                  SelectedBranch="@_selectedBranch"
                  OnFilterChanged="HandleFilterChanged"
                  OnExportRequested="HandleExport" />

@code {

    [SupplyParameterFromQuery][Parameter] public string? Title { get; set; }
    private List<Dictionary<string, object>> _data = new();
    private bool _loading = true;
    private string _asOnDateLabel = "";
    private ReportConfig _activeConfig = new();
    private string _selectedZone = "1";
    private string _selectedRegion = "1";
    private string _selectedBranch = "1";
    private string _userPrivilege = "BRANCH"; 
    private string _userZoneSolid = "00000";
    private string _userRegionSolid = "00000";
    private string _userBranchSolid = "00000";

    private readonly List<ColumnConfig> _fixedColumns = new()
    {
        new ColumnConfig { Header = "Zone",         PropertyName = "Zone",         Width = "10%" },
        new ColumnConfig { Header = "Region",       PropertyName = "Region",       Width = "12%" },
        new ColumnConfig { Header = "Branch Name",  PropertyName = "BranchName",   Width = "16%" },
        new ColumnConfig { Header = "Scale 8",      PropertyName = "Scale8",        Width = "7%" },
        new ColumnConfig { Header = "Scale 7",      PropertyName = "Scale7",        Width = "7%" },
        new ColumnConfig { Header = "Scale 6",      PropertyName = "Scale6",        Width = "7%" },
        new ColumnConfig { Header = "Scale 5",      PropertyName = "Scale5",        Width = "7%" },
        new ColumnConfig { Header = "Scale 4",      PropertyName = "Scale4",        Width = "7%" },
        new ColumnConfig { Header = "Scale 3",      PropertyName = "Scale3",        Width = "7%" },
        new ColumnConfig { Header = "Scale 2",      PropertyName = "Scale2",        Width = "7%" },
        new ColumnConfig { Header = "Scale 1",      PropertyName = "Scale1",        Width = "7%" },
        new ColumnConfig { Header = "Clerk",        PropertyName = "Clerk",         Width = "7%" },
        new ColumnConfig { Header = "Substaff",     PropertyName = "Substaff",      Width = "7%" }
    };

    protected override async Task OnInitializedAsync()
    {
        _activeConfig.Title = Title ?? "Staff Strength";

        // Load user privilege from claims
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userPrivilege = user.FindFirst("privilege")?.Value?.ToUpper() ?? "BRANCH";
            _userZoneSolid = user.FindFirst("zone_solid")?.Value ?? "00000";
            _userRegionSolid = user.FindFirst("region_solid")?.Value ?? "00000";
            _userBranchSolid = user.FindFirst("branch_solid")?.Value ?? "00000";
        }

        await LoadReport();
    }

    private async Task HandleFilterChanged((string zone, string region, string branch) filters)
    {
        _selectedZone = filters.zone;
        _selectedRegion = filters.region;
        _selectedBranch = filters.branch;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        StateHasChanged();
        var (spType, spCode) = ComputeStoredProcInputs();
        string safeType = (spType ?? "").Replace("'", "''");
        string safeCode = (spCode ?? "").Replace("'", "''");
        string finalQuery = $"EXEC sp_get_staff_data @type = '{safeType}', @code = '{safeCode}'";
        // Data query and date lookup are independent - run in parallel
        var dataTask = ReportService.ExecuteRawQueryAsync(finalQuery);
        var dateTask = TryGetAsOnDateOrNowAsync();
        var raw = await dataTask;

        _data = ProjectRowsForDisplay(raw);
        _activeConfig.Columns = _fixedColumns;
        var date = await dateTask;
        _asOnDateLabel = $"Data As On - {date:dd/MM/yyyy}";
        _loading = false;
        StateHasChanged();
    }

    private async Task HandleExport()
    {
        var bytes = ReportService.ExportToExcel(_data, _fixedColumns, "StaffStrength");
        await JS.InvokeVoidAsync("BlazorDownloadFile",
            "StaffStrength.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private (string type, string code) ComputeStoredProcInputs()
    {
        string z = _selectedZone?.ToLowerInvariant() ?? "1";
        string r = _selectedRegion?.ToLowerInvariant() ?? "1";
        string b = _selectedBranch?.ToLowerInvariant() ?? "1";
        if (_userPrivilege == "CO")
        {
            if (z == "1") return ("ALL", "");
            if (z == "all")
            {
                if (r == "1") return ("ALLZONE", "");
                if (r == "all")
                {
                    if (b == "1") return ("ALLREGION", "");
                    return ("ALLBRANCH", "");
                }

                if (b == "1") return ("SREGION", r);
                if (b == "all") return ("SREGIONBALL", r);
                return ("SREGIONSB", b);
            }
            if (r == "1") return ("SZONE", z);
            if (r == "all")
            {
                if (b == "1") return ("SZONERALL", z);
                if (b == "all") return ("SZONEBALL", z);
                return ("SREGIONSB", b);
            }

            if (b == "1") return ("SREGION", r);
            if (b == "all") return ("SREGIONBALL", r);
            return ("SREGIONSB", b);
        }

        else if (_userPrivilege == "ZONE")
        {
            if (r == "1") return ("SZONE", _userZoneSolid);
            if (r == "all")

            {

                if (b == "1") return ("SZONERALL", _userZoneSolid);

                if (b == "all") return ("SZONEBALL", _userZoneSolid);

                return ("SREGIONSB", b);

            }



            if (b == "1") return ("SREGION", r);

            if (b == "all") return ("SREGIONBALL", r);

            return ("SREGIONSB", b);

        }

        else if (_userPrivilege == "REGION")

        {

            if (b == "1") return ("SREGION", _userRegionSolid);

            if (b == "all") return ("SREGIONBALL", _userRegionSolid);

            return ("SREGIONSB", b);

        }

        else // BRANCH

        {

            return ("SREGIONSB", _userBranchSolid);

        }

    }

    private List<Dictionary<string, object>> ProjectRowsForDisplay(List<Dictionary<string, object>> raw)

    {

        var result = new List<Dictionary<string, object>>();

        if (raw == null || raw.Count == 0) return result;



        int sNo = 0;



        foreach (var r in raw)

        {

            sNo++;



            string zone = GetString(r, "Zone", "zone_name_eng", "ZONE_NAME_ENG", "ZONE");

            string region = GetString(r, "Region", "region_name", "REGION_NAME", "REGION");

            string branchName = GetString(r, "BranchName", "BRANCH_NAME", "branch_name", "Branch_Name", "BRANCH");



            var row = new Dictionary<string, object>

                {

                    ["Zone"] = zone,

                    ["Region"] = region,

                    ["BranchName"] = branchName,



                    ["Scale8"] = GetNumber(r, "Scale8", "scale8", "Scale_8", "S8"),

                    ["Scale7"] = GetNumber(r, "Scale7", "scale7", "Scale_7", "S7"),

                    ["Scale6"] = GetNumber(r, "Scale6", "scale6", "Scale_6", "S6"),

                    ["Scale5"] = GetNumber(r, "Scale5", "scale5", "Scale_5", "S5"),

                    ["Scale4"] = GetNumber(r, "Scale4", "scale4", "Scale_4", "S4"),

                    ["Scale3"] = GetNumber(r, "Scale3", "scale3", "Scale_3", "S3"),

                    ["Scale2"] = GetNumber(r, "Scale2", "scale2", "Scale_2", "S2"),

                    ["Scale1"] = GetNumber(r, "Scale1", "scale1", "Scale_1", "S1"),



                    ["Clerk"] = GetNumber(r, "Clerk", "clerk", "CLERK"),

                    ["Substaff"] = GetNumber(r, "Substaff", "substaff", "SUBSTAFF", "Sub_Staff", "SUB_STAFF")

                };



            result.Add(row);

        }



        return result;

    }



    private static string GetString(Dictionary<string, object> r, params string[] keys)

    {

        foreach (var k in keys)

        {

            if (r.TryGetValue(k, out var v) && v != null)

                return v.ToString() ?? "";

        }

        return "";

    }



    private static int GetNumber(Dictionary<string, object> r, params string[] keys)

    {

        foreach (var k in keys)

        {

            if (r.TryGetValue(k, out var v) && v != null)

            {

                if (v is IConvertible)

                {

                    try { return Convert.ToInt32(v); } catch { /* ignore */ }

                }

                if (int.TryParse(v.ToString(), out var n))

                    return n;

            }

        }

        return 0;

    }



    private async Task<DateTime> TryGetAsOnDateOrNowAsync()

    {

        try

        {


            var text = await ReportService.GetAsOnDateAsync("sp_get_staff_data");

            if (DateTime.TryParse(text, out var dt)) return dt;

        }

        catch (Exception ex) {
            AppLogger.LogError(ex, "[StaffStrengthReport] Unhandled error: " + ex.Message);
        }

        return AppTime.Now;

    }
}