            ws.Cells[rowNo, 10].Value = row["Approved_Percentage"];
            ws.Cells[rowNo, 11].Value = row["Technical_Decline_Percentage"];
            ws.Cells[rowNo, 12].Value = row["Business_Decline_Percentage"];

            ws.Cells[rowNo, 13].Value = row["Union_Bank_Of_India_Rank"];

            for (int col = 1; col <= 13; col++)
            {
                ws.Cells[rowNo, col].Style.Border.BorderAround(
