    private void AddMissingPreviousMonthProducts()
    {
        if (!_data.Any())
            return;

        var latestMonth = _data
            .Max(x => Convert.ToDateTime(x["Month"]));

        var previousMonth = latestMonth.AddMonths(-1);

        var currentMonthProducts = _data
            .Where(x =>
                Convert.ToDateTime(x["Month"]).Month == latestMonth.Month &&
                Convert.ToDateTime(x["Month"]).Year == latestMonth.Year)
            .Select(x => x["Products"]?.ToString())
            .Distinct()
            .ToList();

        var previousMonthProducts = _data
            .Where(x =>
                Convert.ToDateTime(x["Month"]).Month == previousMonth.Month &&
                Convert.ToDateTime(x["Month"]).Year == previousMonth.Year)
            .Select(x => x["Products"]?.ToString())
            .ToHashSet();

        foreach (var product in currentMonthProducts)
        {
            if (!previousMonthProducts.Contains(product))
            {
                _data.Add(new Dictionary<string, object>
                    {
                        ["Products"] = product,
                        ["Month"] = previousMonth,
                        ["Remitter_Bank"] = "Union Bank of India",

                        ["Approved_Volume_Million"] = 0,
                        ["Technical_Decline_Volume_Million"] = 0,
                        ["Business_Decline_Volume_Million"] = 0,

                        ["Approved_Value_Crore"] = 0,
                        ["Technical_Decline_Value_Crore"] = 0,
                        ["Business_Decline_Value_Crore"] = 0,

                        ["Approved_Percentage"] = 0,
                        ["Technical_Decline_Percentage"] = 0,
                        ["Business_Decline_Percentage"] = 0,

                        ["Union_Bank_Of_India_Rank"] = "Nil"
                    });
            }
        }
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            _error = null;

            string query = @"
        SELECT *
        FROM npci_dashboard
        WHERE 1=1";

            if (_selectedYear != "ALL")
                query += $" AND YEAR([Month]) = {_selectedYear}";

            if (_selectedMonth != "ALL")
                query += $" AND MONTH([Month]) = {_selectedMonth}";

            if (_selectedProduct != "ALL")
                query += $" AND Products='{_selectedProduct}'";

            query += " ORDER BY Products, [Month] DESC";

            _data = await ReportService.ExecuteRawQueryAsync(query);

            if (_selectedMonth == "ALL")
            {
                AddMissingPreviousMonthProducts();
            }

            _data = _data
                .OrderBy(x => x["Products"]?.ToString())
                .ThenByDescending(x => Convert.ToDateTime(x["Month"]))
                .ToList();

            CalculateKpis();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "NPCIDashboard: failed to load data");
            _error = UserFacingError.Generic;
        }
        finally
        {
            _loading = false;
        }
    }
