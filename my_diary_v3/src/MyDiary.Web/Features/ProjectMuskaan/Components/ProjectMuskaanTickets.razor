@page "/reports/project-muskaan"
@attribute [AllowAnonymous]
@layout MyDiary.Web.Components.Layout.LandingLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using MyDiary.Web.Features.ProjectMuskaan.Models
@using MyDiary.Web.Features.ProjectMuskaan.Services
@inject IProjectMuskaanService ProjectMuskaanService
@inject ILogger<ProjectMuskaanTickets> Logger

<PageTitle>Project Muskaan Issues Resolved — My Diary | Union Bank of India</PageTitle>

<style>
    /* Same tokens/look as the rates-charges and Deployment Pulse pages. Scoped to .pm-wrapper. */
    .pm-wrapper {
        --pm-primary-gradient: linear-gradient(135deg, #1E3A8A 0%, #EF4444 100%);
        --pm-primary-color: #1E3A8A;

        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-height: 85vh;
        background-image: url("images/Login_right_bg.jpeg");
        background-size: cover;
        background-position: center;
    }

    .pm-wrapper > .pm-panel {
        width: 100%;
        max-width: 1600px;
        margin-left: auto;
        margin-right: auto;
    }

    .pm-panel {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        min-width: 0;
    }

    /* ---------- title ---------- */
    .pm-title {
        font-size: 1.9rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 0.35rem;
    }

    .pm-subtitle {
        font-size: 0.95rem;
        color: #6b7280;
        margin: 0;
    }

    /* ---------- filters ---------- */
    .pm-clear-btn {
        border-radius: 999px !important;
        font-weight: 600;
        border-color: var(--pm-primary-color) !important;
        color: var(--pm-primary-color) !important;
    }

    .pm-count {
        margin-top: 0.9rem;
        font-size: 0.85rem;
        color: #6b7280;
    }

    /* ---------- table ---------- */
    .pm-table-scroll {
        overflow-x: auto;
    }

    .pm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
    }

    .pm-table th {
        background: linear-gradient(135deg, #1E3A8A, #2563EB);
        color: white;
        font-weight: 600;
        text-align: left;
        padding: 0;
        border: 1px solid #1E3A8A;
        white-space: nowrap;
    }

    .pm-th-static {
        display: block;
        padding: 12px 16px;
    }

    .pm-sort {
        all: unset;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        width: 100%;
        padding: 12px 16px;
        cursor: pointer;
        font-weight: 600;
    }

    .pm-sort:hover,
    .pm-sort:focus-visible {
        background: rgba(255,255,255,0.14);
    }

    .pm-sort:focus-visible {
        outline: 2px solid #fff;
        outline-offset: -3px;
    }

    .pm-arrow {
        font-size: 0.75rem;
        opacity: 0.55;
    }

    .pm-arrow-on {
        opacity: 1;
    }

    .pm-table td {
        padding: 10px 16px;
        border: 1px solid #e5e7eb;
        color: #1f2937;
        vertical-align: top;
        /* descriptions can contain line breaks - keep them, and wrap long text */
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .pm-table td.pm-sr {
        width: 64px;
        white-space: nowrap;
        color: #6b7280;
    }

    .pm-table tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    .pm-table tbody tr:hover {
        background: #eff6ff;
    }

    /* ---------- states ---------- */
    .pm-message {
        padding: 3rem 1rem;
        text-align: center;
        color: #6b7280;
    }

    .pm-message p {
        margin: 0 0 0.75rem;
    }

    /* ---------- pager row ---------- */
    .pm-pager {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .pm-showing {
        font-size: 0.85rem;
        color: #6b7280;
    }

    @@media (max-width: 600px) {
        .pm-panel { padding: 16px; }
        .pm-title { font-size: 1.5rem; }
    }
</style>

<div class="pm-wrapper">

    <section class="pm-panel">
        <h1 class="pm-title">Project Muskaan Updates</h1>
        <p class="pm-subtitle">Issues raised by branches and the changes made to resolve them.</p>
    </section>

    <section class="pm-panel">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="5">
                <MudTextField T="string"
                              Value="_search"
                              ValueChanged="OnSearchChanged"
                              Immediate="true"
                              DebounceInterval="300"
                              Label="Search"
                              Placeholder="Search issues, actions, benefits, requester"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string"
                           Value="_requestedBy"
                           ValueChanged="OnRequestedByChanged"
                           Label="Requested by"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="@AllOption">All</MudSelectItem>
                    @foreach (var name in _requestedByOptions)
                    {
                        <MudSelectItem Value="@name">@name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" Class="pm-clear-btn" OnClick="ClearFilters">Clear</MudButton>
            </MudItem>
        </MudGrid>

        @if (!_loading && _error is null)
        {
            <div class="pm-count" aria-live="polite">
                @CountText()
            </div>
        }
    </section>

    <section class="pm-panel">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_error is not null)
        {
            <div class="pm-message">
                <p>@_error</p>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync">Try again</MudButton>
            </div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="pm-message">
                <p>No issues match these filters.</p>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters">Clear filters</MudButton>
            </div>
        }
        else
        {
            <div class="pm-table-scroll">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th scope="col"><span class="pm-th-static">Sr No</span></th>
                            <th scope="col" aria-sort="@AriaSort("ProblemDescription")">
                                <button type="button" class="pm-sort" @onclick='() => SortBy("ProblemDescription")'>
                                    Problem Description <span class="@ArrowClass("ProblemDescription")">@Arrow("ProblemDescription")</span>
                                </button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("ActionRequired")">
                                <button type="button" class="pm-sort" @onclick='() => SortBy("ActionRequired")'>
                                    Action Required <span class="@ArrowClass("ActionRequired")">@Arrow("ActionRequired")</span>
                                </button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("BenefitToBranches")">
                                <button type="button" class="pm-sort" @onclick='() => SortBy("BenefitToBranches")'>
                                    Benefit to Branches <span class="@ArrowClass("BenefitToBranches")">@Arrow("BenefitToBranches")</span>
                                </button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("RequestedBy")">
                                <button type="button" class="pm-sort" @onclick='() => SortBy("RequestedBy")'>
                                    Requested By <span class="@ArrowClass("RequestedBy")">@Arrow("RequestedBy")</span>
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int serial = (_page - 1) * PageSize; }
                        @foreach (var row in PageRows())
                        {
                            serial++;
                            <tr>
                                <td class="pm-sr">@serial</td>
                                <td>@row.ProblemDescription</td>
                                <td>@row.ActionRequired</td>
                                <td>@row.BenefitToBranches</td>
                                <td>@row.RequestedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pm-pager">
                <div class="pm-showing">Showing @FirstShown–@LastShown of @_filtered.Count</div>
                @if (PageCount > 1)
                {
                    <MudPagination Count="PageCount"
                                   Selected="_page"
                                   SelectedChanged="OnPageChanged"
                                   ShowFirstButton="true"
                                   ShowLastButton="true" />
                }
            </div>
        }
    </section>
</div>

@code {
    private const string AllOption = "ALL";
    private const int PageSize = 10;

    private List<ProjectMuskaanTicket> _all = new();
    private List<ProjectMuskaanTicket> _filtered = new();
    private List<string> _requestedByOptions = new();

    private string _search = string.Empty;
    private string _requestedBy = AllOption;

    // Default order matches the original page: by SNo, ascending.
    private string _sortColumn = "SNo";
    private bool _sortDescending;

    private int _page = 1;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _all = await ProjectMuskaanService.GetTicketsAsync();

            _requestedByOptions = _all
                .Select(t => t.RequestedBy)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();

            ApplyFilters(resetPage: true);
        }
        catch (Exception ex)
        {
            // Public page: log the detail server-side, show only a generic message.
            Logger.LogError(ex, "Project Muskaan page failed to load tickets");
            _error = "The list could not be loaded right now. Please try again in a moment.";
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- filtering / sorting / paging (all in memory) ----------

    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<ProjectMuskaanTicket> query = _all;

        var term = _search.Trim();
        if (term.Length > 0)
        {
            query = query.Where(t => t.SearchText.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (_requestedBy != AllOption)
        {
            query = query.Where(t => string.Equals(t.RequestedBy, _requestedBy, StringComparison.OrdinalIgnoreCase));
        }

        _filtered = Sort(query).ToList();

        if (resetPage)
        {
            _page = 1;
        }
        else if (_page > PageCount)
        {
            _page = Math.Max(1, PageCount);
        }
    }

    private IEnumerable<ProjectMuskaanTicket> Sort(IEnumerable<ProjectMuskaanTicket> source)
    {
        if (_sortColumn == "SNo")
        {
            return _sortDescending
                ? source.OrderByDescending(t => t.SNoNumber).ThenByDescending(t => t.SNo, StringComparer.OrdinalIgnoreCase)
                : source.OrderBy(t => t.SNoNumber).ThenBy(t => t.SNo, StringComparer.OrdinalIgnoreCase);
        }

        Func<ProjectMuskaanTicket, string> key = _sortColumn switch
        {
            "ProblemDescription" => t => t.ProblemDescription,
            "ActionRequired" => t => t.ActionRequired,
            "BenefitToBranches" => t => t.BenefitToBranches,
            "RequestedBy" => t => t.RequestedBy,
            _ => t => t.SNo
        };

        return _sortDescending
            ? source.OrderByDescending(key, StringComparer.CurrentCultureIgnoreCase)
            : source.OrderBy(key, StringComparer.CurrentCultureIgnoreCase);
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));

    private IEnumerable<ProjectMuskaanTicket> PageRows() =>
        _filtered.Skip((_page - 1) * PageSize).Take(PageSize);

    private int FirstShown => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int LastShown => Math.Min(_page * PageSize, _filtered.Count);

    private string CountText() =>
        HasActiveFilters()
            ? $"{_filtered.Count} record(s) (of {_all.Count})"
            : $"{_filtered.Count} record(s)";

    private bool HasActiveFilters() =>
        !string.IsNullOrWhiteSpace(_search) || _requestedBy != AllOption;

    // ---------- event handlers ----------

    private void OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        ApplyFilters(resetPage: true);
    }

    private void OnRequestedByChanged(string value)
    {
        _requestedBy = string.IsNullOrEmpty(value) ? AllOption : value;
        ApplyFilters(resetPage: true);
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _requestedBy = AllOption;
        _sortColumn = "SNo";
        _sortDescending = false;
        ApplyFilters(resetPage: true);
    }

    private void SortBy(string column)
    {
        if (string.Equals(_sortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }

        // Keep the current page, as the original page did when sorting.
        ApplyFilters(resetPage: false);
    }

    private void OnPageChanged(int page) => _page = page;

    // ---------- header helpers ----------

    private string AriaSort(string column) =>
        _sortColumn == column ? (_sortDescending ? "descending" : "ascending") : "none";

    private string Arrow(string column) =>
        _sortColumn == column ? (_sortDescending ? "▼" : "▲") : "↕";

    private string ArrowClass(string column) =>
        _sortColumn == column ? "pm-arrow pm-arrow-on" : "pm-arrow";
}
