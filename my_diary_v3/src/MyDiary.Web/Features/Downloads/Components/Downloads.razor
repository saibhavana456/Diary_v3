@page "/downloads"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Features.Downloads.Models
@using MyDiary.Web.Features.Downloads.Services
@layout MyDiary.Web.Components.Layout.LandingLayout
@inject IDownloadService DownloadService
@inject NavigationManager Nav
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Downloads — My Diary | Union Bank of India</PageTitle>

<style>
    :root {
        --card-min-width: 280px;
        --card-height: 160px;
        --primary-color: #1E3A8A;
        --secondary-color: #EF4444;
    }

    .main-content-container {
        padding: 25px;
        background: rgba(255,255,255,0.95);
        min-height: 85vh;
        background-image: url("images/Login_right_bg.jpeg");
        background-size: cover;
        background-position: center;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(var(--card-min-width), 1fr));
        gap: 20px;
    }

    .card-button-component {
        background-color: #F8FAFC !important;
        border-radius: 16px !important;
        padding: 20px !important;
        min-height: var(--card-height) !important;
        border: 1px solid #e2e8f0 !important;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        text-transform: none !important;
        width: 100%;
    }

        .card-button-component:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
            border-color: var(--primary-color) !important;
        }

        .card-button-component::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        }

    .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1F2937;
        margin-left: 14px;
        text-align: left;
    }
</style>

<div class="main-content-container">
    <div class="d-flex justify-space-between align-center mb-6">
        <div style="font-size: 1.5rem; font-weight: 600; color: white;">
            <span data-i18n="DOWNLOADS">Downloads</span>
        </div>

        <div class="d-flex align-center gap-3">
            <MudTextField T="string"
                          @bind-Value="searchQuery"
                          data-i18n-placeholder="SEARCH_DOWNLOADS"
                          Placeholder="Search downloads..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Style="width: 300px; border-radius: 50px; background: white;" />
            <MudToggleGroup T="string" Value="@_viewMode" ValueChanged="v => { _viewMode = v; StateHasChanged(); }"
                            Delimiter="false" Color="MudBlazor.Color.Info" Rounded="true"
                            aria-label="View mode">
                <MudToggleItem Value='@("List")' Icon="@Icons.Material.Filled.List" aria-label="List view" />
                <MudToggleItem Value='@("Grid")' Icon="@Icons.Material.Filled.GridView" aria-label="Grid view" />
            </MudToggleGroup>
        </div>
    </div>

    @if (_viewMode == "Grid")
    {
    <div class="cards-grid">
        @if (FilteredDownloads != null)
        {
            @foreach (var item in FilteredDownloads)
            {
                <MudButton OnClick="() => NavigateToDocuments(item.ActivityID)"
                           Class="card-button-component"
                           Ripple="false">
                    <div class="d-flex align-center w-100">
                        <div class="icon-container" style="background: #f1f5f9; border-radius: 12px; padding: 12px; display: flex; align-items: center; justify-content: center;">
                            <MudIcon Icon="@GetIconForDownload(item.IconClass)" Color="MudBlazor.Color.Inherit" Size="MudBlazor.Size.Large" Style="color: #1E3A8A; font-size: 2.5rem;" />
                        </div>
                            <div class="card-title">
                                @item.DisplayName(_currentLang)
                            </div>
                    </div>
                </MudButton>
            }
        }
    </div>
    }
    else
    {
        <MudTable Items="FilteredDownloads?.ToList() ?? new()" Dense="true" Hover="true" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh Style="background-color:#2a2f5b; color:white;">Name</MudTh>
                <MudTh Style="background-color:#2a2f5b; color:white; width:80px;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <b>@context.DisplayName(_currentLang)</b>
                </MudTd>
                
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Launch" Color="MudBlazor.Color.Primary"
                                   OnClick="() => NavigateToDocuments(context.ActivityID)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    private List<Download> allDownloads = new();
    private string searchQuery = "";
    private string _viewMode = "Grid";
    private string _currentLang = "en";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _currentLang = await JS.InvokeAsync<string>(
            "localStorage.getItem", "lang"
        ) ?? "en";
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        allDownloads = await DownloadService.GetDownloadsAsync();
    }

    private IEnumerable<Download> FilteredDownloads =>
        string.IsNullOrWhiteSpace(searchQuery)
        ? allDownloads
        : allDownloads.Where(d => d.ActivityName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void NavigateToDocuments(int activityId)
    {
        Nav.NavigateTo($"documents/{activityId}?source=downloads");
    }

    private string GetIconForDownload(string iconClass)
    {
        // Map icon class names to MudBlazor icons
        return iconClass?.ToLower() switch
        {
            var ic when ic.Contains("pdf") || ic.Contains("document") => Icons.Material.Filled.PictureAsPdf,
            var ic when ic.Contains("excel") || ic.Contains("xls") => Icons.Material.Filled.TableChart,
            var ic when ic.Contains("word") || ic.Contains("doc") => Icons.Material.Filled.Description,
            var ic when ic.Contains("form") => Icons.Material.Filled.Assignment,
            var ic when ic.Contains("report") => Icons.Material.Filled.Assessment,
            var ic when ic.Contains("circular") => Icons.Material.Filled.Announcement,
            var ic when ic.Contains("policy") => Icons.Material.Filled.Policy,
            var ic when ic.Contains("manual") => Icons.Material.Filled.MenuBook,
            var ic when ic.Contains("guide") => Icons.Material.Filled.Help,
            var ic when ic.Contains("template") => Icons.Material.Filled.FileCopy,
            var ic when ic.Contains("certificate") => Icons.Material.Filled.CardMembership,
            var ic when ic.Contains("image") || ic.Contains("photo") => Icons.Material.Filled.Image,
            var ic when ic.Contains("video") => Icons.Material.Filled.VideoLibrary,
            var ic when ic.Contains("archive") || ic.Contains("zip") => Icons.Material.Filled.FolderZip,
            _ => Icons.Material.Filled.Download
        };
    }
}