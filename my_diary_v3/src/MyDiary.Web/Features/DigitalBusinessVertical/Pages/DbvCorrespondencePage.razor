@page "/dbv/correspondence"
@using global::RequestPortal.Web.Shared
@using Microsoft.AspNetCore.Components.Forms
@using MyDiary.Web.Features.DigitalBusinessVertical.Models
@using MyDiary.Web.Features.DigitalBusinessVertical.Services
@inject IDbvService Svc
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>DBV Important Correspondence - My Diary</PageTitle>

<AuthenticatedOnly>
    <PageHeader PageKey="dbv-correspondence" Title="Important Correspondence"
                Subtitle="Notices and updates from the Digital Business Vertical." Crumbs="_crumbs" />

    @if (_isAdmin)

    {
        <div class="d-flex justify-space-between align-center mb-3">
            <MudSwitch T="bool" Value="_includeArchived" ValueChanged="OnArchivedChanged" Label="Show archived (department only)" Color="Color.Warning" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">New Correspondence</MudButton>
        </div>
    }

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No correspondence to show.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var item in _items)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Style="height:100%" Elevation="1">
                        <div class="d-flex justify-space-between align-start">
                            <MudText Typo="Typo.subtitle1"><b>@item.Title</b></MudText>
                            @if (item.IsArchived) { <MudChip T="string" Size="Size.Small">Archived</MudChip> }
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@item.CorrDate.ToString("dd-MMM-yyyy")</MudText>
                        @if (!string.IsNullOrWhiteSpace(item.Description)) { <MudText Typo="Typo.body2" Class="mb-2" Style="white-space:pre-wrap">@item.Description</MudText> }
                        @if (!string.IsNullOrWhiteSpace(item.AttachmentFilePath))
                        {
                            <MudLink Href="@(item.AttachmentFilePath)" Target="_blank" Class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />@item.AttachmentFileName</MudLink>
                        }
                        @if (_isAdmin)

                        {
                            <div class="d-flex justify-end gap-1 mt-2">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(item))" />
                                <MudIconButton Icon="@(item.IsArchived ? Icons.Material.Filled.Unarchive : Icons.Material.Filled.Archive)" Size="Size.Small" OnClick="@(() => ToggleArchiveAsync(item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(item))" />
                            </div>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    <MudDialog @bind-Visible="_editOpen" Options="_dlg">
        <TitleContent>@(_form.Id == 0 ? "New Correspondence" : "Edit Correspondence")</TitleContent>
        <DialogContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8"><MudTextField T="string" Label="Title" @bind-Value="_form.Title" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="200" /></MudItem>
                <MudItem xs="12" sm="4"><MudDatePicker Label="Date" @bind-Date="_corrDate" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd MMM yyyy" /></MudItem>
                <MudItem xs="12"><MudTextField T="string" Label="Description" @bind-Value="_form.Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" MaxLength="4000" /></MudItem>
                <MudItem xs="12">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnPicked" Accept=".png,.jpg,.jpeg,.gif,.pdf,.doc,.docx">
                        <ActivatorContent><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CloudUpload">@(_file is null ? "Attach file" : "Replace attachment")</MudButton></ActivatorContent>
                    </MudFileUpload>
                    @if (_file is not null) { <div class="mt-1">@_file.Name</div> }
                    else if (!string.IsNullOrWhiteSpace(_form.AttachmentFileName)) { <div class="mt-1">Current: @_form.AttachmentFileName</div> }
                </MudItem>
                @if (_form.Id == 0)
                {
                    <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="_notify" Label="Send an in-app push notification to all users" Color="Color.Primary" /></MudItem>
                }
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _editOpen = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">Save</MudButton>
        </DialogActions>
    </MudDialog>
</AuthenticatedOnly>

@code {
    private String department = "";

    private readonly List<PageHeader.Crumb> _crumbs = new() { new("Departments", "departmentsnew"), new("Digital Business Vertical", "activitiesnew?DeptID=59"), new("Important Correspondence") };



    private readonly DialogOptions _dlg = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
    private const long MaxFileBytes = 10 * 1024 * 1024;

    private bool _loading = true, _isAdmin, _saving, _includeArchived, _editOpen, _notify = true;
    private string _actor = "";
    private List<DbvCorrespondence> _items = new();
    private DbvCorrespondence _form = new();
    private DateTime? _corrDate;
    private IBrowserFile? _file;

    protected override async Task OnInitializedAsync()
    {

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();



        department = authState.User.FindFirst("department_desc")?.Value?.ToUpper() ?? "";

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _actor = state.User.FindFirst("emplid")?.Value ?? "";
        _isAdmin = await Svc.IsAdminAsync(state.User);
        await ReloadAsync();
    }

    private async Task ReloadAsync() { _loading = true; _items = await Svc.ListCorrespondenceAsync(_isAdmin && _includeArchived); _loading = false; }
    private async Task OnArchivedChanged(bool v) { _includeArchived = v; await ReloadAsync(); }

    private void OpenNew() { _form = new DbvCorrespondence(); _corrDate = DateTime.Today; _file = null; _notify = true; _editOpen = true; }
    private void OpenEdit(DbvCorrespondence c)
    {
        _form = new DbvCorrespondence { Id = c.Id, Title = c.Title, CorrDate = c.CorrDate, Description = c.Description, AttachmentFileName = c.AttachmentFileName, AttachmentFilePath = c.AttachmentFilePath, IsArchived = c.IsArchived };
        _corrDate = c.CorrDate; _file = null; _editOpen = true;
    }

    private void OnPicked(IBrowserFile f) { if (f.Size > MaxFileBytes) { Snackbar.Add("File exceeds the 10 MB limit.", Severity.Warning); return; } _file = f; }

    private async Task SaveAsync()
    {
        if (_corrDate is null) { Snackbar.Add("Date is required.", Severity.Warning); return; }
        _saving = true;
        try
        {
            _form.CorrDate = _corrDate.Value;
            if (_file is not null)
            {
                await using var s = _file.OpenReadStream(MaxFileBytes);
                var (path, name) = await Svc.SaveFileAsync("correspondence", s, _file.Name);
                _form.AttachmentFilePath = path; _form.AttachmentFileName = name;
            }
            var isNew = _form.Id == 0;
            await Svc.SaveCorrespondenceAsync(_form, _actor, _notify);
            Snackbar.Add(isNew ? "Correspondence added." + (_notify ? " Push notification queued." : "") : "Correspondence updated.", Severity.Success);
            _editOpen = false; await ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ToggleArchiveAsync(DbvCorrespondence c) { await Svc.SetCorrespondenceArchivedAsync(c.Id, !c.IsArchived, _actor); await ReloadAsync(); }
    private async Task DeleteAsync(DbvCorrespondence c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete '{c.Title}' permanently? Use Archive to keep it.")) return;
        await Svc.DeleteCorrespondenceAsync(c.Id); await ReloadAsync();
    }
}
