@page "/pmsby"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout PublicLayout
<PageTitle>PMSBY – Union Bank of India</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-8">

    <!-- Page Header -->
    <MudPaper Elevation="3" Class="pa-4 mb-4"
              Style="background: linear-gradient(135deg, #1565c0 0%, #0d47a1 100%);
                     color:white; border-radius:12px;
                     box-shadow: 0 4px 20px rgba(21,101,192,0.35) !important;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Security"
                     Style="font-size:2.8rem; color:#bbdefb;" />
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:700; color:white; letter-spacing:0.3px;">
                    Pradhan Mantri Suraksha Bima Yojana
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#bbdefb; margin-top:2px;">
                    PMSBY — Government Accident Insurance Scheme
                </MudText>
            </div>
        </MudStack>
    </MudPaper>

    <!-- Breadcrumb -->
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-5 pa-0" />

    <!-- Scheme Info Alert -->
    <MudAlert Severity="Severity.Info" Class="mb-5" Style="border-radius:10px; font-size:0.9rem;">
        <strong>PMSBY</strong> is a government-backed personal accident insurance scheme offering
        coverage of <strong>₹2 lakh</strong> for accidental death or full disability, and
        <strong>₹1 lakh</strong> for partial disability, at a premium of just <strong>₹20/year</strong>.
        Available to bank account holders aged 18–70 years.
    </MudAlert>

    <!-- Document Links -->
    <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius:12px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Style="color:#1565c0;" />
            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1a237e;">
                PMSBY Documents & Resources
            </MudText>
        </MudStack>
        <MudDivider Class="mb-3" />

        <MudList T="string" Dense="false" DisablePadding="true">
            @foreach (var item in _documents)
            {
                <MudListItem T="string" Class="px-0 py-1">
                    <MudPaper Elevation="1" Class="pa-3"
                              Style="border-radius:10px; border-left:4px solid #1565c0;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                                  Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@item.Icon"
                                         Style=@($"color:{item.IconColor}; font-size:1.5rem; flex-shrink:0;") />
                                <div>
                                    <MudText Typo="Typo.subtitle2"
                                             Style="font-weight:700; color:#1a237e; line-height:1.3;">
                                        @item.Title
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(item.SubText))
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#666;">
                                            @item.SubText
                                        </MudText>
                                    }
                                </div>
                            </MudStack>
                            @if (!string.IsNullOrEmpty(item.Url))
                            {
                                <MudButton Variant="Variant.Filled"
                                           Style="background:#1565c0; color:white; border-radius:8px;
                                                  font-size:0.78rem; font-weight:600; flex-shrink:0;"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Size="Size.Small"
                                           Href="@item.Url"
                                           Target="_blank">
                                    Open
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    <!-- External Claim Links -->
    <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px; background:#e3f2fd;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Link" Style="color:#1565c0;" />
            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1a237e;">
                Claim Intimation / Document Submission
            </MudText>
        </MudStack>
        <MudDivider Class="mb-3" />

        <MudText Typo="Typo.body2" Class="mb-3" Style="color:#555;">
            PMSBY claim intimation and document submission can be done online via the respective
            insurer's portal. Select your insurer below:
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudButton FullWidth="true"
                           Variant="Variant.Outlined"
                           Style="border-color:#1565c0; color:#1565c0; border-radius:8px;
                                  font-weight:600; padding:10px;"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="https://services.uiic.in/pmsby/"
                           Target="_blank">
                    United India Insurance
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudButton FullWidth="true"
                           Variant="Variant.Outlined"
                           Style="border-color:#0d47a1; color:#0d47a1; border-radius:8px;
                                  font-weight:600; padding:10px;"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="https://pmsby.newindia.co.in/account/frmlogin.aspx"
                           Target="_blank">
                    New India Assurance
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("PMSBY", href: null, disabled: true),
    };

    private record DocItem(string Title, string SubText, string Url, string Icon, string IconColor);

    private List<DocItem> _documents = new()
    {
        new("PMSBY – Features and Details",
            "Complete scheme overview, eligibility, premium & coverage",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/pmsby/1. PMSBY - Features and Details.docx",
            Icons.Material.Filled.Info, "#1565c0"),

        new("PMSBY – Enrolment Form",
            "Revised enrolment form (30.05.2022)",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/pmsby/2. PMSBY Revised Enrolment Form_30.05.2022.pdf",
            Icons.Material.Filled.DynamicForm, "#2e7d32"),

        new("PMSBY – Claim Form",
            "Revised claim form (30.05.2022)",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/pmsby/3. PMSBY Revised Claim Form_30.05.2022.pdf",
            Icons.Material.Filled.FileCopy, "#880e4f"),

        new("PMSBY – Claim Process",
            "Step-by-step claim settlement procedure",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/pmsby/4. PMSBY Claim Process.docx",
            Icons.Material.Filled.Assignment, "#e65100"),
    };
}
