@page "/pmjjby"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout PublicLayout
<PageTitle>PMJJBY – Union Bank of India</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-8">

    <!-- Page Header -->
    <MudPaper Elevation="3" Class="pa-4 mb-4"
              Style="background: linear-gradient(135deg, #e65100 0%, #bf360c 100%);
                     color:white; border-radius:12px;
                     box-shadow: 0 4px 20px rgba(230,81,0,0.35) !important;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety"
                     Style="font-size:2.8rem; color:#ffe0b2;" />
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:700; color:white; letter-spacing:0.3px;">
                    Pradhan Mantri Jeevan Jyoti Bima Yojana
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#ffe0b2; margin-top:2px;">
                    PMJJBY — Government Life Insurance Scheme
                </MudText>
            </div>
        </MudStack>
    </MudPaper>

    <!-- Breadcrumb -->
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-5 pa-0" />

    <!-- Scheme Info Alert -->
    <MudAlert Severity="Severity.Warning" Class="mb-5" Style="border-radius:10px; font-size:0.9rem;">
        <strong>PMJJBY</strong> is a government-backed life insurance scheme offering coverage of
        <strong>₹2 lakh</strong> for death due to any cause at a premium of just <strong>₹436/year</strong>.
        Available to bank account holders aged 18–50 years.
    </MudAlert>

    <!-- Document Links -->
    <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius:12px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Style="color:#e65100;" />
            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1a237e;">
                PMJJBY Documents & Resources
            </MudText>
        </MudStack>
        <MudDivider Class="mb-3" />

        <MudList T="string" Dense="false" DisablePadding="true">
            @foreach (var item in _documents)
            {
                <MudListItem T="string" Class="px-0 py-1">
                    <MudPaper Elevation="1" Class="pa-3"
                              Style="border-radius:10px; border-left:4px solid #e65100;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                                  Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@item.Icon" Style=@($"color:{item.IconColor}; font-size:1.5rem; flex-shrink:0;") />
                                <div>
                                    <MudText Typo="Typo.subtitle2"
                                             Style="font-weight:700; color:#1a237e; line-height:1.3;">
                                        @item.Title
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(item.SubText))
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#666;">
                                            @item.SubText
                                        </MudText>
                                    }
                                </div>
                            </MudStack>
                            @if (!string.IsNullOrEmpty(item.Url))
                            {
                                <MudButton Variant="Variant.Filled"
                                           Style="background:#e65100; color:white; border-radius:8px;
                                                  font-size:0.78rem; font-weight:600; flex-shrink:0;"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Size="Size.Small"
                                           Href="@item.Url"
                                           Target="_blank">
                                    Open
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    <!-- External Claim Link -->
    <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px; background:#fff8e1;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Link" Style="color:#f57c00;" />
            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1a237e;">
                Claim Intimation / Document Submission
            </MudText>
        </MudStack>
        <MudDivider Class="mb-3" />

        <MudText Typo="Typo.body2" Class="mb-3" Style="color:#555;">
            PMJJBY claim intimation and document submission can be done online via the insurer's portal:
        </MudText>

        <MudButton Variant="Variant.Outlined"
                   Style="border-color:#e65100; color:#e65100; border-radius:8px; font-weight:600;"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   Href="https://bimasampark.sudlife.in"
                   Target="_blank">
            SUD Life Insurance Co. Ltd — Online Portal
        </MudButton>
    </MudPaper>

</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("PMJJBY", href: null, disabled: true),
    };

    private record DocItem(string Title, string SubText, string Url, string Icon, string IconColor);

    private List<DocItem> _documents = new()
    {
        new("PMJJBY – Features and Details",
            "Complete scheme overview, eligibility, premium & coverage",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/PMJJBY_DETAILS1.pdf",
            Icons.Material.Filled.Info, "#1565c0"),

        new("PMJJBY – Claim Process",
            "Step-by-step claim settlement procedure",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/CLAIMSETTLEMENTPROCEDUREPMJJBYfinal1.pdf",
            Icons.Material.Filled.Assignment, "#2e7d32"),

        new("PMJJBY – FAQs",
            "Frequently asked questions about the scheme",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/FAQsPMJJBY.pdf",
            Icons.Material.Filled.QuestionAnswer, "#6a1b9a"),

        new("PMJJBY – Application Form",
            "Enrolment/consent-cum-declaration form",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/PMJJBY APPLICATION FORM1.pdf",
            Icons.Material.Filled.DynamicForm, "#e65100"),

        new("PMJJBY – Claim Form",
            "Claim submission form for nominees",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/ClaimForm_PMJJBY1.pdf",
            Icons.Material.Filled.FileCopy, "#880e4f"),

        new("PMJJBY – Amendment in Rules w.e.f. 01 June 2016",
            "Revised rules effective 1st June 2016",
            "https://ubinet.unionbankofindia.co.in/download/Manuals/AMENDMENT IN PMJJBY RULES WEF 01 JUNE 2016.pdf",
            Icons.Material.Filled.Gavel, "#37474f"),
    };
}
