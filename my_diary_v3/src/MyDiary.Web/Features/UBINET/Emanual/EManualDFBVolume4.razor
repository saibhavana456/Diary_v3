@page "/emanual/dfb-ibd/volume4"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using global::RequestPortal.Web.Shared
@inject NavigationManager Nav
@layout MyDiary.Web.Components.Layout.MainLayout
<PageTitle>DFB & IBD – Volume 4 Others</PageTitle>

<PageHeader Title="DFB & IBD – Volume 4 Others"
            Subtitle="Foreign Exchange, SWIFT, KYC/AML & More — Union Bank of India"
            PageKey="emanual-dfb-ibd-volume4"
            Crumbs="_crumbs" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">

    <!-- Search -->
    <MudPaper Elevation="1" Class="pa-3 mb-5" Style="border-radius:10px;">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Search documents..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Primary"
                      Variant="Variant.Outlined"
                      Clearable="true"
                      Immediate="true"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Style="font-size:0.9rem;" />
    </MudPaper>

    <!-- Grouped Sections -->
    @foreach (var sec in FilteredSections)
    {
        <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius:10px; border-left: 4px solid #0277bd;">
            <!-- Section Header -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@sec.Icon" Style="color:#0277bd;" />
                <MudText Typo="Typo.h6" Style="font-weight:700; color:#1a237e;">
                    @sec.Title
                </MudText>
                <MudChip T="string" Size="Size.Small"
                         Style="background:#0277bd; color:white; font-size:0.75rem; font-weight:600; height:22px; margin-left:auto;">
                    @sec.Documents.Count doc@(sec.Documents.Count != 1 ? "s" : "")
                </MudChip>
            </MudStack>
            <MudDivider Class="mb-3" />

            <MudGrid Spacing="3">
                @foreach (var doc in sec.Documents)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="1" Class="v4-doc-card"
                                 Style="border-radius:10px; overflow:hidden; height:100%; cursor:pointer;">
                            <div style="height:3px; background:#0277bd;"></div>
                            <div style="height:100px; background:linear-gradient(145deg,#e1f5fe,#b3e5fc);
                                        display:flex; align-items:center; justify-content:center;">
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                         Style="font-size:3rem; color:#e53935; opacity:0.85;" />
                            </div>
                            <MudCardContent Class="pa-2" Style="padding-bottom:2px !important;">
                                <MudTooltip Text="@doc.Label" Placement="Placement.Top" Arrow="true" Color="Color.Dark">
                                    <MudText Typo="Typo.body2"
                                             Style="font-weight:600; color:#333; font-size:0.8rem;
                                                    line-height:1.4; display:-webkit-box;
                                                    -webkit-line-clamp:3; -webkit-box-orient:vertical;
                                                    overflow:hidden; min-height:3.4em;">
                                        @doc.Label
                                    </MudText>
                                </MudTooltip>
                            </MudCardContent>
                            <MudCardActions Class="pa-2 pt-1">
                                <MudButton FullWidth="true" Variant="Variant.Filled"
                                           Style="background:#0277bd; color:white; font-size:0.75rem;
                                                  border-radius:6px; font-weight:600;"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Size="Size.Small"
                                           Href="@doc.Href" Target="_blank">
                                    Open PDF
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    @if (!FilteredSections.Any())
    {
        <MudAlert Severity="Severity.Info" Style="border-radius:10px;">
            No documents found matching "<strong>@_searchText</strong>".
        </MudAlert>
    }

</MudContainer>

<style>
    .v4-doc-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .v4-doc-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(2,119,189,0.2) !important;
    }
</style>

@code {
    private string _searchText = "";

    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("E-manual Content", "emanual"),
        new("DFB & IBD", "emanual/dfb-ibd"),
        new("Volume 4 – Others"),
    };

    private record DocItem(string Label, string Href);
    private record SectionItem(string Title, string Icon, List<DocItem> Documents);

    private IEnumerable<SectionItem> FilteredSections =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _sections
            : _sections
                .Select(s => new SectionItem(s.Title, s.Icon,
