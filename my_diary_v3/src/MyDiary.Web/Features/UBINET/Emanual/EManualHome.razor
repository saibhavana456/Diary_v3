@page "/emanual"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Components.Layout
@using global::RequestPortal.Web.Shared
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout MyDiary.Web.Components.Layout.MainLayout

<PageTitle>E-manual Content — My Diary | Union Bank of India</PageTitle>

<PageHeader Title="E-manual Content"
            Subtitle="Digital reference manuals and operating instructions, organised by department"
            PageKey="emanual"
            Crumbs="_crumbs" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">

    <!-- Department Cards Grid -->
    <MudGrid Spacing="3">
        @foreach (var dept in _departments)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="emanual-dept-card" Style="border-radius:12px; height:100%; cursor:pointer;"
                         @onclick="() => NavigateTo(dept.Route)">
                    <!-- Coloured top accent -->
                    <div style="height:5px; background:@dept.AccentColor; border-radius:12px 12px 0 0;"></div>
                    <MudCardContent Class="pa-4">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <!-- Icon circle -->
                            <div style="width:64px; height:64px; border-radius:50%;
                                        background:@dept.IconBg;
                                        display:flex; align-items:center; justify-content:center;
                                        box-shadow: 0 3px 12px @(dept.AccentColor + "55");">
                                <MudIcon Icon="@dept.Icon" Style=@($"font-size:2rem; color:{dept.AccentColor};") />
                            </div>
                            <MudText Typo="Typo.subtitle1"
                                     Style="font-weight:700; color:#1a237e; text-align:center; line-height:1.35;">
                                @dept.Label
                            </MudText>
                            @if (!string.IsNullOrEmpty(dept.SubLabel))
                            {
                                <MudText Typo="Typo.caption"
                                         Style="color:#666; text-align:center; margin-top:-6px;">
                                    @dept.SubLabel
                                </MudText>
                            }
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pa-3 pt-0" Style="justify-content:center;">
                        <MudButton Variant="Variant.Text"
                                   Style=@($"color:{dept.AccentColor}; font-size:0.8rem; font-weight:600;")
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Size="Size.Small">
                            View Manuals
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

<style>
    .emanual-dept-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .emanual-dept-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.15) !important;
    }
</style>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    private void NavigateTo(string route) => Nav.NavigateTo(route);

    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("Knowledge Hub", "circulars"),
        new("E-manual Content"),
