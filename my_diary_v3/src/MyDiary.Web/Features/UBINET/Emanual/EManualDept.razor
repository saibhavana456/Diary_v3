@page "/emanual/dept/{DeptName}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using global::RequestPortal.Web.Shared
@using MyDiary.Web.Core.Extensions
@inject IStaticAssetPathResolver Assets
@inject NavigationManager Nav
@layout MyDiary.Web.Components.Layout.MainLayout
<PageTitle>@_pageTitle – E-Manual</PageTitle>

<PageHeader Title="@_pageTitle"
            Subtitle="E-Manual Contents — Union Bank of India"
            PageKey="emanual-dept"
            Crumbs="_crumbs" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">

    <!-- Search bar (only shown when files exist) -->
    @if (_pdfFiles.Any())
    {
        <MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:10px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search manuals..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Default"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              Margin="Margin.Dense"
                              Style="flex:1; font-size:0.9rem;" />
                <MudChip T="string" Color="Color.Default" Size="Size.Small"
                         Style="font-size:0.8rem; font-weight:600;">
                    @FilteredFiles.Count() file@(FilteredFiles.Count() != 1 ? "s" : "")
                </MudChip>
            </MudStack>
        </MudPaper>
    }

    <!-- Content -->
    @if (_loading)
    {
        <MudGrid Spacing="3">
            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px"
                                 Style="border-radius:12px;" />
                    <MudSkeleton Class="mt-2" Width="80%" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (!_pdfFiles.Any())
    {
        <MudPaper Elevation="0" Class="pa-8 text-center" Style="border-radius:12px; border: 2px dashed #e0e0e0;">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff"
                     Style="font-size:4rem; color:#bdbdbd;" Class="mb-3" />
            <MudText Typo="Typo.h6" Style="color:#9e9e9e; font-weight:600;">No PDF files found</MudText>
            <MudText Typo="Typo.body2" Style="color:#bdbdbd; margin-top:4px;">
                No PDF files found in: <code>wwwroot/eManual/@DeptName</code>
            </MudText>
        </MudPaper>
    }
    else if (!FilteredFiles.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mt-2" Style="border-radius:10px;">
            No manuals found matching "<strong>@_searchText</strong>".
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var file in FilteredFiles)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2" Class="emanual-file-card"
                             Style="border-radius:12px; height:100%; cursor:pointer; overflow:hidden;">
                        <!-- Top accent stripe -->
                        <div style="height:4px; background:@_accentColor;"></div>

                        <!-- PDF preview placeholder -->
                        <div style="height:140px; background: linear-gradient(145deg, #f5f5f5, #eeeeee);
                                    display:flex; align-items:center; justify-content:center;
                                    position:relative; overflow:hidden;">
                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                     Style="font-size:4rem; color:#e53935; opacity:0.85;" />
                            <div style="position:absolute; bottom:0; left:0; right:0; height:30px;
                                        background: linear-gradient(transparent, rgba(0,0,0,0.04));"></div>
                        </div>

                        <MudCardContent Class="pa-3" Style="padding-bottom:4px !important;">
                            <MudTooltip Text="@file.DisplayName" Placement="Placement.Top"
                                        Arrow="true" Color="Color.Dark">
                                <MudText Typo="Typo.body2"
                                         Style="font-weight:600; color:#333; font-size:0.82rem;
                                                line-height:1.4; display:-webkit-box;
                                                -webkit-line-clamp:3; -webkit-box-orient:vertical;
                                                overflow:hidden; min-height:3.5em;">
                                    @file.DisplayName
                                </MudText>
                            </MudTooltip>
                        </MudCardContent>

                        <MudCardActions Class="pa-2 pt-0">
                            <MudButton FullWidth="true"
                                       Variant="Variant.Filled"
                                       Style=@($"background:{_accentColor}; color:white; font-size:0.78rem; border-radius:8px; font-weight:600;")
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Size="Size.Small"
                                       Href="@file.Url"
                                       Target="_blank">
                                Open PDF
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

<style>
    .emanual-file-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .emanual-file-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.14) !important;
    }
</style>

@code {
    [Parameter] public string DeptName { get; set; } = "";

    private string _searchText = "";
    private bool _loading = true;
    private string _pageTitle = "";
    private string _deptIcon = Icons.Material.Filled.MenuBook;
    private string _accentColor = "#b71c1c";
    private string _accentColorDark = "#7f0000";
    private List<PdfItem> _pdfFiles = new();
    private List<PageHeader.Crumb> _crumbs = new();

    private record PdfItem(string DisplayName, string Url);

    private IEnumerable<PdfItem> FilteredFiles =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _pdfFiles
            : _pdfFiles.Where(f => f.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        _loading = true;
        ConfigureDept();
        LoadFiles();
        SetBreadcrumbs();
        _loading = false;
    }

    private void ConfigureDept()
    {
        // Map DeptName to display label, icon, and accent colour
        var config = DeptName.ToLower() switch
        {
            "abd"                  => ("ABD – Agricultural Banking Division",   Icons.Material.Filled.Agriculture,          "#2e7d32", "#1b5e20"),
            "audit"                => ("Audit",                                 Icons.Material.Filled.FactCheck,             "#1565c0", "#0d47a1"),
            "ccm"                  => ("CCM – Credit Monitoring",               Icons.Material.Filled.MonitorHeart,          "#6a1b9a", "#4a148c"),
            "compliance"           => ("Compliance",                            Icons.Material.Filled.GppGood,               "#00695c", "#004d40"),
            "crd"                  => ("CRD – Credit Recovery",                 Icons.Material.Filled.AccountBalance,        "#e65100", "#bf360c"),
            "legal"                => ("Legal Services",                        Icons.Material.Filled.Gavel,                 "#4e342e", "#3e2723"),
            "msme"                 => ("MSME",                                  Icons.Material.Filled.Storefront,            "#f57f17", "#e65100"),
            "operations"           => ("Operations",                            Icons.Material.Filled.Settings,              "#455a64", "#263238"),
            "retailbanking_govt"   => ("Retail Banking & Govt. Business",       Icons.Material.Filled.AccountBalanceWallet,  "#b71c1c", "#7f0000"),
            "risk_management"      => ("Risk Management",                       Icons.Material.Filled.Shield,                "#bf360c", "#870000"),
            "strategy"             => ("Strategy",                              Icons.Material.Filled.TrendingUp,            "#1a237e", "#0d1b6e"),
            _                      => (DeptName,                                Icons.Material.Filled.MenuBook,              "#37474f", "#263238"),
        };

        _pageTitle       = config.Item1;
        _deptIcon        = config.Item2;
        _accentColor     = config.Item3;
        _accentColorDark = config.Item4;
    }

    private void LoadFiles()
    {
        _pdfFiles.Clear();

        // Physical folder resolved from the NFS-aware assets root
        // (wwwroot/MyDiary/UBINET/eManual/... under NFS, wwwroot/UBINET/... locally).
        var folderPath = Assets.Resolve("UBINET", "eManual", DeptName);

        if (!Directory.Exists(folderPath))
            return;

        var files = Directory.GetFiles(folderPath, "*.pdf", SearchOption.TopDirectoryOnly)
                             .OrderBy(f => Path.GetFileName(f), StringComparer.OrdinalIgnoreCase);

        foreach (var file in files)
        {
            var fileName    = Path.GetFileName(file);
            var displayName = Path.GetFileNameWithoutExtension(fileName)
                                  .Replace("_", " ")
                                  .Replace("-", " – ");
            var url = $"UBINET/eManual/{DeptName}/{fileName}";
            _pdfFiles.Add(new PdfItem(displayName, url));
        }
    }

    private void SetBreadcrumbs()
    {
        _crumbs = new()
        {
            new("E-manual Content", "emanual"),
            new(_pageTitle),
        };
    }
}
