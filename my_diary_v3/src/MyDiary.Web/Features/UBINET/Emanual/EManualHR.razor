@page "/emanual/hr"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using global::RequestPortal.Web.Shared
@inject NavigationManager Nav
@layout MyDiary.Web.Components.Layout.MainLayout
<PageTitle>HR E-Manual</PageTitle>

<PageHeader Title="HR E-Manual"
            Subtitle="Human Resources — Union Bank of India"
            PageKey="emanual-hr"
            Crumbs="_crumbs" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">

    <!-- Info alert -->
    <MudAlert Severity="Severity.Info" Class="mb-5" Style="border-radius:10px; font-size:0.9rem;">
        The HR E-Manual is updated periodically. The latest version is dated <strong>30 September 2025</strong>.
        Click the card below to open the full manual as a PDF.
    </MudAlert>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Class="emanual-file-card"
                     Style="border-radius:12px; overflow:hidden; cursor:pointer;">
                <div style="height:5px; background:#880e4f;"></div>

                <div style="height:160px; background: linear-gradient(145deg,#fce4ec,#f8bbd0);
                            display:flex; flex-direction:column;
                            align-items:center; justify-content:center; gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                             Style="font-size:4rem; color:#e53935; opacity:0.9;" />
                    <MudChip T="string" Size="Size.Small"
                             Style="background:#880e4f; color:white; font-weight:700; font-size:0.75rem;">
                        Updated 30.09.2025
                    </MudChip>
                </div>

                <MudCardContent Class="pa-3">
                    <MudText Typo="Typo.subtitle1"
                             Style="font-weight:700; color:#1a237e; font-size:0.95rem; line-height:1.4;">
                        HR E-Manual
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#666;">
                        HR E Manual Updated 30.09.2025.pdf
                    </MudText>
                </MudCardContent>

                <MudCardActions Class="pa-3 pt-0">
                    <MudButton FullWidth="true" Variant="Variant.Filled"
                               Style="background:#880e4f; color:white; font-size:0.82rem;
                                      border-radius:8px; font-weight:600;"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Size="Size.Small"
                               Href="https://ubinet.unionbankofindia.co.in/download/eManual/27-10-2025/HR E MANUAL UPDATED 30.09.2025.pdf"
                               Target="_blank">
                        Open PDF
                    </MudButton>
                   
                </MudCardActions>
            </MudCard>


            <MudCard Elevation="3" Class="emanual-file-card"
                     Style="border-radius:12px; overflow:hidden; cursor:pointer;">
                <div style="height:5px; background:#880e4f;"></div>

                <div style="height:160px; background: linear-gradient(145deg,#fce4ec,#f8bbd0);
                            display:flex; flex-direction:column;
                            align-items:center; justify-content:center; gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                             Style="font-size:4rem; color:#e53935; opacity:0.9;" />
                    <MudChip T="string" Size="Size.Small"
                             Style="background:#880e4f; color:white; font-weight:700; font-size:0.75rem;">
                        Updated 17.06.2026
                    </MudChip>
                </div>

                <MudCardContent Class="pa-3">
                    <MudText Typo="Typo.subtitle1"
                             Style="font-weight:700; color:#1a237e; font-size:0.95rem; line-height:1.4;">
                        HR E-Manual Gist
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#666;">
                        HR E Manual Updated 17.06.2026.pdf
                    </MudText>
                </MudCardContent>

                <MudCardActions Class="pa-3 pt-0">
                    <MudButton FullWidth="true" Variant="Variant.Filled"
                               Style="background:#880e4f; color:white; font-size:0.82rem;
                                      border-radius:8px; font-weight:600;"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Size="Size.Small"
                               Href="https://mydiary.unionbankofindia.co.in/mydiary/downloads/STAFF%20BENEFITS-BY%20HARI_compressed.pdf E MANUAL UPDATED 17.06.2026.pdf"
                               Target="_blank">
                        Open PDF
                    </MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>

<style>
    .emanual-file-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .emanual-file-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(136,14,79,0.2) !important;
    }
</style>

@code {
    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("E-manual Content", "emanual"),
        new("HR E-Manual"),
    };
}
