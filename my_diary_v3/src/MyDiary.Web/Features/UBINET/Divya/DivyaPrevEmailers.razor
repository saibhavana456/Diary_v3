    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Divya Portal", href: "/divya"),
        new BreadcrumbItem("Previous Emailers", href: null, disabled: true)
    };

    // ---- Data Model ----
    private record EmailerItem(string Date, string Subject, string Url, string Domain);
    private record MonthGroup(string MonthLabel, List<EmailerItem> Items);

    private void OnPanelExpandedChanged(string label, bool value)
    {
        _expandedStates[label] = value;
    }

    private void ExpandAll()
    {
        foreach (var g in _monthGroups)
            _expandedStates[g.MonthLabel] = true;
    }

    private void CollapseAll()
    {
        foreach (var g in _monthGroups)
            _expandedStates[g.MonthLabel] = false;
    }

    private List<MonthGroup> GetFiltered()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return _monthGroups;

        var q = _searchText.Trim().ToLowerInvariant();
        return _monthGroups
            .Select(g => new MonthGroup(g.MonthLabel,
                g.Items.Where(i =>
                    i.Subject.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    i.Domain.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    i.Date.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList()))
            .Where(g => g.Items.Any())
            .ToList();
    }

