@page "/divya-previous-emailers"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout PublicLayout
<PageTitle>Empower Through Access – Previous Month Emailers</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudPaper Elevation="3" Class="pa-4 mb-5"
              Style="background: linear-gradient(135deg, #1a237e 0%, #283593 60%, #3949ab 100%);
                     color:white; border-radius:12px;
                     box-shadow: 0 4px 20px rgba(26,35,126,0.35) !important;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Email" Style="font-size:2.5rem; color:#90caf9;" />
            <div>
                <MudText Typo="Typo.h4" Style="font-weight:700; color:white; letter-spacing:0.5px;">
                    Empower Through Access
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#bbdefb; margin-top:2px;">
                    Previous Month Emailers Archive
                </MudText>
            </div>
        </MudStack>
    </MudPaper>
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />
    <MudGrid Spacing="3" Class="mb-5">
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center" Style="border-radius:10px; border-top: 3px solid #1a237e;">
                <MudText Typo="Typo.h5" Style="font-weight:700; color:#1a237e;">@_monthGroups.Count</MudText>
                    <MudText Typo="Typo.caption" Style="color:#555;">Monthly Archives</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="1" Class="pa-3 text-center" Style="border-radius:10px; border-top: 3px solid #388e3c;">
                    <MudText Typo="Typo.h5" Style="font-weight:700; color:#388e3c;">@_monthGroups.Sum(g => g.Items.Count)</MudText>
                    <MudText Typo="Typo.caption" Style="color:#555;">Total Emailers</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="1" Class="pa-3 text-center" Style="border-radius:10px; border-top: 3px solid #f57c00;">
                    <MudText Typo="Typo.h5" Style="font-weight:700; color:#f57c00;">2024–2026</MudText>
                    <MudText Typo="Typo.caption" Style="color:#555;">Coverage Period</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="1" Class="pa-3 text-center" Style="border-radius:10px; border-top: 3px solid #7b1fa2;">
                    <MudText Typo="Typo.h5" Style="font-weight:700; color:#7b1fa2;">PDF</MudText>
                    <MudText Typo="Typo.caption" Style="color:#555;">All Formats</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Search / Filter -->
        <MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:10px;">
            <MudTextField @bind-Value="_searchText"
                          Placeholder="Search emailers by subject or domain..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          Variant="Variant.Outlined"
                          Clearable="true"
                          Immediate="true"
                          FullWidth="true"
                          Margin="Margin.Dense"
                          Style="font-size:0.9rem;" />
        </MudPaper>

        <!-- Expand / Collapse All -->
        <MudStack Row="true" Spacing="2" Class="mb-3" JustifyContent="JustifyContent.FlexEnd">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.UnfoldMore"
                       OnClick="ExpandAll">Expand All</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.UnfoldLess"
                       OnClick="CollapseAll">Collapse All</MudButton>
        </MudStack>
        @{
        var filtered = GetFiltered();
        if (!filtered.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-4" Style="border-radius:10px;">
                No emailers found matching "<strong>@_searchText</strong>". Try a different keyword.
            </MudAlert>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" @ref="_expansionPanels" Class="prevemail-panels">
                @foreach (var (group, idx) in filtered.Select((g, i) => (g, i)))
                {
                    var color = _monthColors[idx % _monthColors.Length];
                    var isExpanded = _expandedStates.TryGetValue(group.MonthLabel, out var exp) ? exp : false;

                    <MudExpansionPanel @key="group.MonthLabel"
                                       IsExpanded="isExpanded"
                                       IsExpandedChanged="(v) => OnPanelExpandedChanged(group.MonthLabel, v)"
                                       Class="mb-2 prevemail-panel"
                                       Style=@($"border-radius:10px !important; overflow:hidden; border-left: 4px solid {color};")>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%;">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style=@($"color:{color}; font-size:1.3rem;") />
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1a237e; flex:1;">
                                    @group.MonthLabel
                                </MudText>
                                <MudChip T="string" Size="Size.Small"
                                         Style=@($"background:{color}; color:white; font-size:0.75rem; font-weight:600; height:22px;")>
                                    @group.Items.Count emailer@(group.Items.Count != 1 ? "s" : "")
                                </MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudTable Items="@group.Items" Hover="true" Striped="true" Dense="true" Bordered="false"
                                      Breakpoint="Breakpoint.Sm"
                                      Style="font-size:0.855rem; margin-top:4px;">
                                <HeaderContent>
                                    <MudTh Style="width:110px; white-space:nowrap; font-weight:700; color:#1a237e; background:#f0f4ff;">Date</MudTh>
                                    <MudTh Style="font-weight:700; color:#1a237e; background:#f0f4ff;">Subject</MudTh>
                                    <MudTh Style="width:200px; font-weight:700; color:#1a237e; background:#f0f4ff;">Domain</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Date">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Style="font-size:0.78rem; height:24px; font-weight:600; color:#555; border-color:#ccc;">
                                            @context.Date
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Subject">
                                        @if (!string.IsNullOrWhiteSpace(context.Url) && context.Url != "https://ubinet.unionbankofindia.co.in/download/Divya/Empower files/Empower Through Access PDF files/")
                                        {
                                            <MudLink Href="@context.Url" Target="_blank" Color="Color.Primary"
                                                     Style="font-size:0.85rem; display:flex; align-items:flex-start; gap:5px; line-height:1.45;">
                                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                                         Size="Size.Small" Style="color:#e53935; flex-shrink:0; margin-top:1px;" />
                                                <span>@context.Subject</span>
                                            </MudLink>
                                        }
                                        else
                                        {
                                            <MudText Style="font-size:0.85rem; color:#666;">@context.Subject</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Domain">
                                        @if (!string.IsNullOrWhiteSpace(context.Domain))
                                        {
                                            <MudChip T="string" Size="Size.Small"
                                                     Style="background:#e8eaf6; color:#3949ab; font-size:0.75rem; height:auto; white-space:normal; padding:3px 8px; line-height:1.4;">
                                                @context.Domain
                                            </MudChip>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
    <MudStack Row="true" JustifyContent="JustifyContent.FlexStart" Class="mt-5">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="divya">
            Back to Divya Portal
        </MudButton>
    </MudStack>

</MudContainer>

<style>
    .prevemail-panels .mud-expand-panel {
        border-radius: 10px !important;
        margin-bottom: 8px !important;
    }

    .prevemail-panels .mud-expand-panel-header {
        background: #fafbff !important;
        border-radius: 10px !important;
        padding: 10px 16px !important;
        transition: background 0.2s;
    }

        .prevemail-panels .mud-expand-panel-header:hover {
            background: #eef1fb !important;
        }

    .prevemail-panels .mud-expand-panel-text {
        padding: 0 8px 12px 8px !important;
    }

    .prevemail-panels .mud-table-row:hover td {
        background-color: #e8eaf6 !important;
    }
</style>

@code {
