    private MudExpansionPanels? _expansionPanels;
    private Dictionary<string, bool> _expandedStates = new();

    private readonly string[] _monthColors =
    {
        "#1a237e", "#283593", "#1565c0", "#0277bd", "#00695c",
        "#2e7d32", "#558b2f", "#f57f17", "#e65100", "#6a1b9a",
        "#880e4f", "#b71c1c", "#37474f", "#4e342e", "#00838f",
        "#1b5e20", "#0d47a1", "#4a148c", "#bf360c", "#1a237e"
