@page "/divya"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout PublicLayout
<PageTitle>Divya Portal</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @* Page Header *@
    <MudPaper Elevation="0" Class="divya-header-banner mb-2 pa-3 rounded-lg">
        <MudText Typo="Typo.h4" Class="divya-title">
            <MudIcon Icon="@Icons.Material.Filled.Accessibility" Class="mr-2" Style="vertical-align:middle;" />
            Divya Portal
        </MudText>
        <MudText Typo="Typo.body2" Class="divya-subtitle mt-1">
            Divya Portal has been developed to provide one stop platform for information related to various circulars,
            publications and guidelines related to persons with disabilities. Bank endeavour is to make conducive
            environment of equality for all. In that direction this portal which is conceptualized by the training
            college is a humble beginning.
        </MudText>
    </MudPaper>

    <MudDivider Class="mb-4" />

    @* Section 1: Circulars - Customer Services *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Circulars related to Customer Services to PwDs
        </MudText>

        <MudTable Items="@customerCirculars" Hover="true" Striped="true" Dense="true"
                  Breakpoint="Breakpoint.Sm" Class="circular-table" Elevation="0">
            <HeaderContent>
                <MudTh Style="width:60px;">S.No.</MudTh>
                <MudTh>Circular Subject</MudTh>
                <MudTh>Download Link</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="S.No.">@context.SNo</MudTd>
                    <MudTd DataLabel="Circular Subject">@context.Subject</MudTd>
                    <MudTd DataLabel="Download Link">
                        <MudLink Href="@context.Url" Target="_blank" Class="circular-link">
                            <MudIcon Icon="@Icons.Material.Filled.Download" Size="MudBlazor.Size.Small" Class="mr-1" />
                            @context.LinkText
                    </MudLink>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* Section 2: Circulars - Staff *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Circulars related to Differently Abled Staff Members
        </MudText>

        <MudTable Items="@staffCirculars" Hover="true" Striped="true" Dense="true"
                  Breakpoint="Breakpoint.Sm" Class="circular-table" Elevation="0">
            <HeaderContent>
                <MudTh Style="width:60px;">S.No.</MudTh>
                <MudTh>Circular Subject</MudTh>
                <MudTh>Download Link</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="S.No.">@context.SNo</MudTd>
                    <MudTd DataLabel="Circular Subject">@context.Subject</MudTd>
                    <MudTd DataLabel="Download Link">
                        <MudLink Href="@context.Url" Target="_blank" Class="circular-link">
                            <MudIcon Icon="@Icons.Material.Filled.Download" Size="MudBlazor.Size.Small" Class="mr-1" />
                            @context.LinkText
                    </MudLink>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* Section 3: Empower Through Access *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-1">
            <MudIcon Icon="@Icons.Material.Filled.FlashOn" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Empower Through Access
        </MudText>
        <MudText Typo="Typo.caption" Class="mb-3 ml-7 d-block" Style="color:var(--mud-palette-text-secondary);">
            Current Month Publications
        </MudText>

        <MudList T="EmpowerItem" Dense="true" DisablePadding="true">
            @foreach (var item in empowerItems)
            {
                <MudListItem T="EmpowerItem" Dense="true" Class="empower-item">
                    <MudLink Href="@item.Url" Target="_blank" Class="circular-link d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                        @item.Title
                    </MudLink>
                </MudListItem>
            }
        </MudList>

        <MudDivider Class="my-2" />
        <MudLink Href="divya-previous-emailers" Target="_blank" Class="circular-link d-flex align-center mt-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="MudBlazor.Size.Small" Class="mr-2" />
            Previous Month Emailers
        </MudLink>
    </MudPaper>

    @* Section 4: Knowledge Centre *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Union Bank Knowledge Centre Publications
        </MudText>
        <MudList T="ResourceItem" Dense="true" DisablePadding="true">
            @foreach (var item in knowledgeItems)
            {
                <MudListItem T="ResourceItem" Dense="true" Class="empower-item">
                    <MudLink Href="@item.Url" Target="_blank" Class="circular-link d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                        @item.Title
                    </MudLink>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    @* Section 5: Grahak Seva Book *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            ग्राहक सेवा उत्कृष्टता के विविध आयाम (Grahak Seva Ke Vividh Aayam Book)
        </MudText>
        <MudList T="ResourceItem" Dense="true" DisablePadding="true">
            @foreach (var item in grahakItems)
            {
                <MudListItem T="ResourceItem" Dense="true" Class="empower-item">
                    <MudLink Href="@item.Url" Target="_blank" Class="circular-link d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                        @item.Title
                    </MudLink>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    @* Section 6: Instruction Manuals *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Summarize" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Instructions Manuals Prepared by Union Access Team
        </MudText>
        <MudList T="ResourceItem" Dense="true" DisablePadding="true">
            @foreach (var item in manualItems)
            {
                <MudListItem T="ResourceItem" Dense="true" Class="empower-item">
                    <MudLink Href="@item.Url" Target="_blank" Class="circular-link d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                        @item.Title
                    </MudLink>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    @* Section 7: JAWS SOP *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Hearing" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Standard Operating Procedure (SOP) for JAWS Screen Reader
        </MudText>
        <MudLink Href="https://dms.unionbankofindia.co.in/webdesktop/CustomJobs/eCircular/ViewDocument.jsp?value=06717-2024~37642519~Information%20Circulars"
                 Target="_blank" Class="circular-link d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
            Standard Operating Procedure (SOP) for JAWS screen reader
        </MudLink>
    </MudPaper>

    @* Section 8: Union Vidya *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Union Vidya Modules
        </MudText>
        <MudList T="string" Dense="true" DisablePadding="true">
            @foreach (var course in vidyaCourses)
            {
                <MudListItem T="string" Dense="true" Class="empower-item">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                    @course
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    @* Section 9: Union Radio *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Radio" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Links to Union Radio and Podcast
        </MudText>
        <MudLink Href="https://#/course/view.php?id=727" Target="_blank" Class="circular-link d-flex align-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
            Union Radio (Login Required)
        </MudLink>
        <MudLink Href="https://#/enrol/index.php?id=2835" Target="_blank" Class="circular-link d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
            Podcasts (Login Required)
        </MudLink>
    </MudPaper>

    @* Section 10: Videos *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Videos
        </MudText>
        <MudList T="ResourceItem" Dense="true" DisablePadding="true">
            @foreach (var item in videoItems)
            {
                <MudListItem T="ResourceItem" Dense="true" Class="empower-item">
                    <MudLink Href="@item.Url" Target="_blank" Class="circular-link d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                        @item.Title
                    </MudLink>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    @* Section 11: IDPD Panel *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            IDPD 2024 Panel Discussion
        </MudText>
        <MudLink Href="https://youtu.be/9y9beQYhNdM?si=tcSX6ffA3Jckg1gW" Target="_blank" Class="circular-link d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
            IDPD 2024 Panel Discussion (YouTube)
        </MudLink>
    </MudPaper>

    @* Section 12: Screen Reader Software *@
    <MudPaper Elevation="2" Class="section-card mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.ScreenSearchDesktop" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Screen Reader Softwares
        </MudText>
        <MudList T="ResourceItem" Dense="true" DisablePadding="true">
            @foreach (var item in screenReaderItems)
            {
                <MudListItem T="ResourceItem" Dense="true" Class="empower-item">
                    <MudLink Href="@item.Url" Target="_blank" Class="circular-link d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="MudBlazor.Size.Small" Class="mr-2 bullet-icon" />
                        @item.Title
                    </MudLink>
                </MudListItem>
            }
        </MudList>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" Variant="Variant.Text">
            NVDA screen reader software is supplementary to JAWS screen reader considering its feature of multi languages
            text-to-speech support for efficiently working in both English and Hindi languages simultaneously.
        </MudAlert>
    </MudPaper>

    @* Section 13: Contact Details *@
    <MudPaper Elevation="2" Class="section-card contact-section mb-5 pa-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="section-heading mb-3">
            <MudIcon Icon="@Icons.Material.Filled.ContactPhone" Class="mr-2 section-icon" Style="vertical-align:middle;" />
            Contact Details
        </MudText>

        <MudGrid>
            @* Inclusion Cell *@
            <MudItem xs="12" sm="12" md="4">
                <MudCard Elevation="0" Class="contact-card h-100">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color=MudBlazor.Color.Primary Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Inclusion Cell</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Bank has established an Inclusion Cell at HR vertical at Central Office as per Equal Opportunity Policy.
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="MudBlazor.Size.Small" Class="mr-1" />
                            <MudLink Href="mailto:inclusion.cell@unionbankofindia.bank.in" Class="circular-link">
                                inclusion.cell@unionbankofindia.bank.in
                            </MudLink>
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="MudBlazor.Size.Small" Class="mr-1" />
                            IP Phone: 116266
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Union Access *@
            <MudItem xs="12" sm="12" md="4">
                <MudCard Elevation="0" Class="contact-card h-100">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="MudBlazor.Color.Secondary" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Accessibility" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Union Access</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Union Access team is functional at Department of Information Technology for any digital accessibility related issues/feedback.
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="MudBlazor.Size.Small" Class="mr-1" />
                            <MudLink Href="mailto:unionaccess@unionbankofindia.bank.in" Class="circular-link">
                                unionaccess@unionbankofindia.bank.in
                            </MudLink>
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="MudBlazor.Size.Small" Class="mr-1" />
                            IP Phone: 530309, 220538
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Union Sampark *@
            <MudItem xs="12" sm="12" md="4">
                <MudCard Elevation="0" Class="contact-card h-100">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="MudBlazor.Color.Tertiary" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.HelpCenter" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Union Sampark – Ask Us</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            A unique facility by training college whereby staff members lodge their queries/practical issues faced by them.
                        </MudText>
                        <MudLink Href="https://app2.unionbankofindia.co.in/QueryCornerLive/" Target="_blank" Class="circular-link">
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="MudBlazor.Size.Small" Class="mr-1" />
                            Visit Link – Ask Us
                        </MudLink>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudPaper>

</MudContainer>

<style>
    .divya-header-banner {
        background: linear-gradient(135deg, #7b0000 0%, #c0392b 60%, #e74c3c 100%);
        color: white;
        border-left: 6px solid #FFD700;
    }

    .divya-title {
        color: white !important;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .divya-subtitle {
        color: rgba(255,255,255,0.88) !important;
        line-height: 1.6;
    }

    .section-card {
        border-left: 4px solid #c0392b;
        transition: box-shadow 0.2s ease;
    }

        .section-card:hover {
            box-shadow: 0 4px 20px rgba(192, 57, 43, 0.15) !important;
        }

    .section-heading {
        color: #7b0000 !important;
        font-weight: 700;
        border-bottom: 2px solid #f5e6e6;
        padding-bottom: 8px;
    }

    .section-icon {
        color: #c0392b !important;
    }

    .circular-table th {
        background-color: #7b0000 !important;
        color: white !important;
        font-weight: 600;
    }

    .circular-link {
        color: #c0392b !important;
        text-decoration: none;
        font-size: 0.82rem;
        line-height: 1.5;
    }

        .circular-link:hover {
            color: #7b0000 !important;
            text-decoration: underline;
        }

    .bullet-icon {
        color: #c0392b !important;
        font-size: 8px !important;
        flex-shrink: 0;
    }

    .empower-item {
        border-bottom: 1px dotted #f0d0d0;
        padding-top: 4px !important;
        padding-bottom: 4px !important;
    }

        .empower-item:last-child {
            border-bottom: none;
        }

    .contact-section {
        background-color: #fff8f8;
    }

    .contact-card {
        background-color: #ffffff;
        border: 1px solid #f5e6e6;
        border-radius: 8px;
    }
</style>

