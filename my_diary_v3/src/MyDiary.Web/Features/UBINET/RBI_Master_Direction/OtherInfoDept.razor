        new("gbd",        "Govt. Business"),
        new("creditcard", "Credit Card"),
        new("ciso",       "CISO"),
        new("midcorp",    "MID Corporate"),
        new("crld",       "SAMV"),
        new("cenAcc",     "Finance & Accounts"),
        new("strategy",   "Strategy"),
        new("retass",     "Retail Assets"),
        new("NPC",        "NPC"),
        new("digi",       "Digitization"),
        new("fi",         "RuSu & FI"),
    };

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(DeptId)) DeptId = "cmplc";
        _dept        = BuildConfig(DeptId);
        _searchText  = "";
        _breadcrumbs = new()
        {
            new BreadcrumbItem("Home",        href: "",             icon: Icons.Material.Filled.Home),
            new BreadcrumbItem("Departments", href: "departments"),
            new BreadcrumbItem(_dept.Label,   href: null, disabled: true),
