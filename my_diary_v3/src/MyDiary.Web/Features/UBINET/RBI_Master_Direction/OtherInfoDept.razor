    private record GroupItem(string Title, List<LinkItem> Items);
    private record DeptConfig(
        string Id = "cmplc",
        string Label = "Compliance",
        string SectionTitle = "RBI Master Direction",
        string Icon = "",
        string AccentColor = "#00695c",
        string AccentDark = "#004d40",
        List<LinkItem>? Items = null,
        List<GroupItem>? Groups = null)
