@page "/departments/other-info"
@page "/departments/other-info/{DeptId}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject NavigationManager Nav
@using MyDiary.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout PublicLayout
<PageTitle>@_dept.Label – Other Information</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">

    <!-- Page Header -->
    <MudPaper Elevation="3" Class="pa-4 mb-4"
              Style=@($"background: linear-gradient(135deg, {_dept.AccentColor} 0%, {_dept.AccentDark} 100%); color:white; border-radius:12px; box-shadow: 0 4px 20px rgba(0,0,0,0.25) !important;")>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@_dept.Icon" Style="font-size:2.5rem; color:rgba(255,255,255,0.85);" />
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight:700; color:white;">
                        @_dept.Label
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.75); margin-top:2px;">
                        @_dept.SectionTitle — Union Bank of India
                    </MudText>
                </div>
            </MudStack>
            <MudStack Row="true" Spacing="2" Class="mt-2 mt-sm-0">
                <MudButton Variant="Variant.Filled"
                           Style="background:rgba(255,255,255,0.15); color:white; border:1px solid rgba(255,255,255,0.4);"
                           StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo("departments"))">Departments</MudButton>
                <MudButton Variant="Variant.Filled"
                           Style="background:rgba(255,255,255,0.15); color:white; border:1px solid rgba(255,255,255,0.4);"
                           StartIcon="@Icons.Material.Filled.Home" Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo(""))">Home</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <!-- Breadcrumb -->
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

    <!-- Department selector chips -->
    <MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:10px;">
        <MudText Typo="Typo.caption" Class="mb-2" Style="color:#666; font-weight:600; display:block;">
            SWITCH DEPARTMENT
        </MudText>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
            @foreach (var d in _allDepts)
            {
                <MudChip T="string"
                         Color="@(d.Id == DeptId ? Color.Primary : Color.Default)"
                         Variant="@(d.Id == DeptId ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         Style="font-size:0.75rem; font-weight:600; cursor:pointer;"
                         OnClick="@(() => Nav.NavigateTo($"departments/other-info/{d.Id}"))">
                    @d.Label
                </MudChip>
            }
        </div>
    </MudPaper>

    <!-- Search (only if list has items) -->
    @if (_dept.Items.Any())
    {
        <MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:10px;">
            <MudTextField @bind-Value="_searchText"
                          Placeholder=@($"Search {_dept.SectionTitle}...")
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          Variant="Variant.Outlined"
                          Clearable="true"
                          Immediate="true"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          Style="font-size:0.9rem;" />
        </MudPaper>
    }

    <!-- Content -->
    @{
        var filtered = string.IsNullOrWhiteSpace(_searchText)
            ? _dept.Items
            : _dept.Items.Where(i => i.Label.Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    @if (!_dept.Items.Any())
    {
        <MudPaper Elevation="0" Class="pa-8 text-center"
                  Style="border-radius:12px; border:2px dashed #e0e0e0;">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff"
                     Style="font-size:4rem; color:#bdbdbd;" Class="mb-2" />
            <MudText Typo="Typo.h6" Style="color:#9e9e9e; font-weight:600;">
                No content available for this department.
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#bdbdbd;">
                Please select another department from the chips above.
            </MudText>
        </MudPaper>
    }
    else if (!filtered.Any())
    {
        <MudAlert Severity="Severity.Info" Style="border-radius:10px;">
            No items found matching "<strong>@_searchText</strong>".
        </MudAlert>
    }
    else
    {
        <!-- Grouped sections (Strategy has named groups) -->
        @if (_dept.Groups.Any())
        {
            @foreach (var grp in _dept.Groups)
            {
                <MudPaper Elevation="2" Class="pa-4 mb-4"
                          Style=@($"border-radius:10px; border-left:4px solid {_dept.AccentColor};")>
                    <MudText Typo="Typo.subtitle1" Class="mb-3"
                             Style="font-weight:700; color:#1a237e;">@grp.Title</MudText>
                    <MudDivider Class="mb-3" />
                    <MudGrid Spacing="2">
                        @foreach (var item in grp.Items)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                @ItemCard(item)
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            }
        }
        else
        {
            <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@_dept.Icon" Style=@($"color:{_dept.AccentColor};") />
                    <MudText Typo="Typo.h6" Style="font-weight:700; color:#1a237e;">
                        @_dept.SectionTitle
                    </MudText>
                    <MudChip T="string" Size="Size.Small"
                             Style=@($"background:{_dept.AccentColor}; color:white; font-size:0.75rem; font-weight:600; height:22px; margin-left:auto;")>
                        @filtered.Count item@(filtered.Count != 1 ? "s" : "")
                    </MudChip>
                </MudStack>
                <MudDivider Class="mb-3" />
                <MudList T="string" Dense="true" DisablePadding="true">
                    @foreach (var (item, idx) in filtered.Select((x, i) => (x, i)))
                    {
                        <MudListItem T="string" Class="px-0 py-1">
                            <MudPaper Elevation="0" Class="pa-2"
                                      Style="border-radius:8px; border:1px solid #e8eaf6;
                                             display:flex; align-items:center; gap:10px;
                                             justify-content:space-between;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex:1; min-width:0;">
                                    <MudText Typo="Typo.caption"
                                             Style=@($"background:{_dept.AccentColor}; color:white; border-radius:4px; padding:2px 7px; font-weight:700; flex-shrink:0; font-size:0.72rem;")>
                                        @(idx + 1)
                                    </MudText>
                                    <MudText Typo="Typo.body2"
                                             Style="font-size:0.85rem; color:#1a237e; font-weight:500;
                                                    line-height:1.4; word-break:break-word;">
                                        @item.Label
                                    </MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Size="Size.Small"
                                               Style=@($"color:{_dept.AccentColor}; flex-shrink:0;")
                                               Href="@item.Url" Target="_blank"
                                               Title="Open document" />
                            </MudPaper>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    }

</MudContainer>

