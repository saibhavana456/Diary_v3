@page "/rd-calculator"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout PublicLayout
<PageTitle>RD Installment Calculator – UBINET</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-5 mb-8">

    <!-- Page Header -->
    <MudPaper Elevation="3" Class="pa-4 mb-5"
              Style="background: linear-gradient(135deg, #00569b 0%, #003f7a 100%);
                     color:white; border-radius:14px;
                     box-shadow: 0 4px 20px rgba(0,86,155,0.35) !important;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Savings"
                     Style="font-size:2.8rem; color:#90caf9;" />
            <div>
                <MudText Typo="Typo.h4" Style="font-weight:700; color:white; letter-spacing:0.5px;">
                    RD Installment Calculator
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#bbdefb; margin-top:2px;">
                    Recurring Deposit — Union Bank of India
                </MudText>
            </div>
        </MudStack>
    </MudPaper>

    <!-- Breadcrumb -->
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

    <!-- Input Card -->
    <MudPaper Elevation="2" Class="pa-5 mb-4" Style="border-radius:14px;">
        <MudText Typo="Typo.subtitle1" Class="mb-4"
                 Style="font-weight:700; color:#1a237e; display:flex; align-items:center; gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Input" Style="color:#00569b;" />
            Enter RD Details
        </MudText>

        <MudGrid Spacing="3">

            <!-- Maturity Amount -->
            <MudItem xs="12">
                <MudNumericField @bind-Value="_maturityAmount"
                                 Label="Maturity Amount (₹)"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₹"
                                 AdornmentColor="Color.Primary"
                                 Min="500" Max="100000000"
                                 HideSpinButtons="true"
                                 Format="N0"
                                 FullWidth="true"
                                 Immediate="true"
                                 @oninput="ClearResults"
                                 HelperText="Must be a multiple of ₹500"
                                 Error="@_maturityError"
                                 ErrorText="@_maturityMsg" />
            </MudItem>

            <!-- Maturity Slider -->
            <MudItem xs="12" Class="mt-n2 mb-n1">
                <MudSlider @bind-Value="_maturityAmount"
                           Min="500" Max="1000000" Step="500"
                           Color="Color.Primary" Class="px-2"
                           @oninput="ClearResults" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Style="color:#888;">₹500</MudText>
                    <MudText Typo="Typo.caption" Style="color:#888;">₹10,00,000</MudText>
                </MudStack>
            </MudItem>

            <!-- Interest Rate -->
            <MudItem xs="12">
                <MudNumericField @bind-Value="_interestRate"
                                 Label="Interest Rate (% p.a.)"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.End"
                                 AdornmentText="%"
                                 AdornmentColor="Color.Secondary"
                                 Min="0.01m" Max="20.00m"
                                 HideSpinButtons="true"
                                 Format="N2"
                                 FullWidth="true"
                                 Immediate="true"
                                 @oninput="ClearResults"
                                 HelperText="Maximum interest rate is 20%"
                                 Error="@_rateError"
                                 ErrorText="@_rateMsg" />
            </MudItem>

            <!-- Rate Slider -->
            <MudItem xs="12" Class="mt-n2 mb-n1">
                <MudSlider @bind-Value="_interestRate"
                           Min="0.01m" Max="20.00m" Step="0.25m"
                           Color="Color.Secondary" Class="px-2"
                           @oninput="ClearResults" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Style="color:#888;">0.01%</MudText>
                    <MudText Typo="Typo.caption" Style="color:#888;">20%</MudText>
                </MudStack>
            </MudItem>

            <!-- Tenure -->
            <MudItem xs="12">
                <MudNumericField @bind-Value="_tenureMonths"
                                 Label="Time Period (Months)"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.End"
                                 AdornmentText="mo"
                                 AdornmentColor="Color.Tertiary"
                                 Min="6" Max="120"
                                 HideSpinButtons="true"
                                 FullWidth="true"
                                 Immediate="true"
                                 @oninput="ClearResults"
                                 HelperText="Between 6 and 120 months"
                                 Error="@_tenureError"
                                 ErrorText="@_tenureMsg" />
            </MudItem>

            <!-- Tenure Slider -->
            <MudItem xs="12" Class="mt-n2 mb-n1">
                <MudSlider @bind-Value="_tenureMonths"
                           Min="6" Max="120" Step="1"
                           Color="Color.Tertiary" Class="px-2"
                           @oninput="ClearResults" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Style="color:#888;">6 mo</MudText>
                    <MudText Typo="Typo.caption" Style="color:#888;">120 mo (10 yr)</MudText>
                </MudStack>
            </MudItem>

            <!-- Calculate Button -->
            <MudItem xs="12" Class="mt-2">
                <MudButton FullWidth="true"
                           Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Calculate"
                           OnClick="Calculate"
                           Style="border-radius:10px; font-size:1rem; font-weight:700;
                                  padding:14px; letter-spacing:0.5px;">
                    Calculate Installment
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudPaper>

    <!-- Results Card -->
    @if (_calculated)
    {
        <MudPaper Elevation="3" Class="pa-5 mb-4"
                  Style="border-radius:14px; border: 2px solid #00569b;">

            <MudText Typo="Typo.subtitle1" Class="mb-4"
                     Style="font-weight:700; color:#1a237e; display:flex; align-items:center; gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Style="color:#00569b;" />
                Results
            </MudText>

            <!-- 3 result tiles -->
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="1" Class="pa-3 text-center"
                              Style="border-radius:12px; background:#00569b; color:white;">
                        <MudIcon Icon="@Icons.Material.Filled.Repeat"
                                 Style="font-size:2rem; color:#90caf9;" Class="mb-1" />
                        <MudText Typo="Typo.caption" Style="color:#bbdefb; display:block;">
                            Monthly Installment
                        </MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800; color:white; margin-top:4px;">
                            ₹@_installment.ToString("N2")
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="1" Class="pa-3 text-center"
                              Style="border-radius:12px; background:#1565c0; color:white;">
                        <MudIcon Icon="@Icons.Material.Filled.Paid"
                                 Style="font-size:2rem; color:#b3e5fc;" Class="mb-1" />
                        <MudText Typo="Typo.caption" Style="color:#e1f5fe; display:block;">
                            Total Investment
                        </MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800; color:white; margin-top:4px;">
                            ₹@_totalInvestment.ToString("N2")
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="1" Class="pa-3 text-center"
                              Style="border-radius:12px; background:#2e7d32; color:white;">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                                 Style="font-size:2rem; color:#a5d6a7;" Class="mb-1" />
                        <MudText Typo="Typo.caption" Style="color:#c8e6c9; display:block;">
                            Interest Earned
                        </MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800; color:white; margin-top:4px;">
                            ₹@_interestEarned.ToString("N2")
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Summary Bar -->
            <MudPaper Elevation="0" Class="pa-3 mt-4"
                      Style="border-radius:10px; background:#f5f5f5;">
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2" Style="color:#555;">Maturity Amount</MudText>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#00569b;">
                            ₹@_maturityAmount.ToString("N0")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2" Style="color:#555;">Interest Rate</MudText>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#333;">
                            @_interestRate.ToString("N2")% p.a.
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2" Style="color:#555;">Tenure</MudText>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#333;">
                            @_tenureMonths months (@Math.Round(_tenureMonths / 12.0, 1) yrs)
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2" Style="color:#555;">Return on Investment</MudText>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#2e7d32;">
                            @(_totalInvestment > 0 ? ((_interestEarned / _totalInvestment) * 100).ToString("N2") : "0.00")%
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Investment vs Interest breakdown bar -->
            <MudText Typo="Typo.caption" Class="mt-3 mb-1" Style="color:#555; font-weight:600;">
                Investment vs Interest Earned Breakdown
            </MudText>
            @{
                var maturity       = (double)_maturityAmount;
                var investmentPct  = maturity > 0 ? (int)Math.Round(_totalInvestment / maturity * 100) : 0;
                var interestPct    = 100 - investmentPct;
            }
            <div style="display:flex; height:16px; border-radius:8px; overflow:hidden; width:100%;">
                <div style="width:@(investmentPct)%; background:#00569b; transition:width 0.6s ease;"
                     title="Investment @investmentPct%"></div>
                <div style="width:@(interestPct)%; background:#2e7d32; transition:width 0.6s ease;"
                     title="Interest @interestPct%"></div>
            </div>
            <MudStack Row="true" Spacing="3" Class="mt-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <div style="width:12px; height:12px; border-radius:3px; background:#00569b;"></div>
                    <MudText Typo="Typo.caption" Style="color:#555;">Investment (@investmentPct%)</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <div style="width:12px; height:12px; border-radius:3px; background:#2e7d32;"></div>
                    <MudText Typo="Typo.caption" Style="color:#555;">Interest Earned (@interestPct%)</MudText>
                </MudStack>
            </MudStack>

            <!-- Reset -->
            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="Reset" Class="mt-4"
                       Style="border-radius:10px; font-weight:600;">
                Reset Calculator
            </MudButton>

        </MudPaper>
    }

    <!-- Disclaimer -->
    <MudAlert Severity="Severity.Normal" Class="mt-2" Style="border-radius:10px; font-size:0.8rem;">
        <strong>Disclaimer:</strong> This calculator provides an indicative monthly installment figure.
        The RD maturity formula used is quarterly compounding. Actual amounts may vary based on bank terms.
        Please contact your branch for exact figures.
    </MudAlert>

</MudContainer>

@code {
    // ---- Inputs ----
    private double  _maturityAmount = 100000;
    private decimal _interestRate   = 7.00m;
    private int     _tenureMonths   = 12;

    // ---- Validation ----
    private bool   _maturityError;
    private bool   _rateError;
    private bool   _tenureError;
    private string _maturityMsg = "";
    private string _rateMsg     = "";
    private string _tenureMsg   = "";

    // ---- Results ----
    private bool   _calculated;
    private double _installment;
    private double _totalInvestment;
    private double _interestEarned;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home",              href: "", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("RD Calculator",     href: null, disabled: true),
    };

    private void ClearResults()
    {
        _calculated    = false;
        _maturityError = false;
        _rateError     = false;
        _tenureError   = false;
    }

    private bool Validate()
    {
        var ok = true;

        // Maturity amount
        if (_maturityAmount <= 0)
        {
            _maturityError = true;
            _maturityMsg   = "Please enter a valid maturity amount.";
            ok = false;
        }
        else if (_maturityAmount % 500 != 0)
        {
            // Auto-round down to nearest 500, mirror original JS behaviour
            _maturityAmount = Math.Floor(_maturityAmount / 500) * 500;
            if (_maturityAmount < 500) _maturityAmount = 500;
            _maturityError = true;
            _maturityMsg   = "Maturity amount must be a multiple of ₹500. Rounded down automatically.";
            ok = false;
        }
        else { _maturityError = false; _maturityMsg = ""; }

        // Interest rate
        if (_interestRate <= 0 || _interestRate > 20)
        {
            _rateError = true;
            _rateMsg   = "Rate must be between 0.01% and 20%.";
            if (_interestRate > 20) _interestRate = 20;
            ok = false;
        }
        else { _rateError = false; _rateMsg = ""; }

        // Tenure
        if (_tenureMonths < 6)
        {
            _tenureError  = true;
            _tenureMsg    = "Tenure cannot be less than 6 months.";
            _tenureMonths = 6;
            ok = false;
        }
        else if (_tenureMonths > 120)
        {
            _tenureError  = true;
            _tenureMsg    = "Tenure cannot be more than 120 months.";
            _tenureMonths = 120;
            ok = false;
        }
        else { _tenureError = false; _tenureMsg = ""; }

        return ok;
    }

    private void Calculate()
    {
        _calculated = false;
        if (!Validate()) return;

        // Formula (quarterly compounding — matches original JS):
        // n = tenure / 3   (number of quarters)
        // i = rate / 400   (quarterly rate as decimal)
        // installment = Maturity / [((1+i)^n - 1) / (1 - (1+i)^(-1/3))]
        double rate      = (double)_interestRate;
        double n         = _tenureMonths / 3.0;
        double i         = rate / 400.0;
        double numerator = Math.Pow(1 + i, n) - 1;
        double denom     = 1 - Math.Pow(1 + i, -1.0 / 3.0);

        _installment     = _maturityAmount / (numerator / denom);
        _totalInvestment = Math.Round(_installment, 2) * _tenureMonths;
        _interestEarned  = _maturityAmount - _totalInvestment;

        _calculated = true;
    }

    private void Reset()
    {
        _maturityAmount = 100000;
        _interestRate   = 7.00m;
        _tenureMonths   = 12;
        _calculated     = false;
        _maturityError  = _rateError = _tenureError = false;
    }
}
