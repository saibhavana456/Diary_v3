@page "/loginDashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using MudBlazor
@using System.Security.Claims

@using MyDiary.Web.Features.Dashboard_new.services
@using MyDiary.Web.Features.Dashboard_new.Models
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services

@inject IDashboardService DashboardService
@inject IOperationalAreasService OperationalAreasService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject DynamicReportService ReportService
@inject IJSRuntime JS

<style>
    .fixed-table {
        table-layout: fixed !important;
        width: 100% !important;
    }

    /* Popup Overlay (Blazor-only) */
    .popup-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, .7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        opacity: 1;
        visibility: visible;
        transition: all .25s ease;
    }

    .popup-content {
        background: #fff;
        width: 90%;
        max-width: 520px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }

    .popup-header {
        background: linear-gradient(135deg, #3498db, #2c3e50);
        color: #fff;
        padding: 24px 18px;
        text-align: center;
    }

    .popup-body {
        padding: 24px;
        text-align: center;
    }

    .survey-btn, .close-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 18px;
        border-radius: 8px;
        font-weight: 600;
        border: 0;
        cursor: pointer;
        transition: all .2s ease;
        width: 100%;
        max-width: 260px;
        text-decoration: none;
    }

    .survey-btn {
        background: #2ecc71;
        color: #fff;
    }

        .survey-btn:hover {
            background: #27ae60;
            transform: translateY(-1px);
        }

    .close-btn {
        background: #e74c3c;
        color: #fff;
    }

        .close-btn:hover {
            background: #c0392b;
            transform: translateY(-1px);
        }
</style>

<MudGrid Spacing="3">
    <MudItem xs="12" md="12">
        <div class="mb-4">
            <MudPaper Elevation="0" Style="background-color: #ffffff;">
                <MudCard Class="overflow-hidden h-100" Elevation="2"
                         Style="border-top-left-radius:10px; border-top-right-radius:10px; border-bottom-left-radius:0; border-bottom-right-radius:0;">
                    <MudCardHeader Class="d-flex align-center justify-center text-white"
                                   Style="height:50px; font-weight:800; letter-spacing:.3px;
                                          background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
                        <h5>Operational Critical Areas Dashboard</h5>
                    </MudCardHeader>
                </MudCard>

                <!-- Filters -->
                <MudGrid Spacing="2" Class="p-3 align-center">

                    @if (_showZone)
                    {
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string"
                                       Label="Zone"
                                       Value="_selectedZone"
                                       ValueChanged="@(async (string n) => await OnZoneChanged(n))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Immediate="true">
                                <MudSelectItem Value="@ALL">All</MudSelectItem>
                                @foreach (var z in _zones)
                                {
                                    <MudSelectItem Value="@z.ZoneSolid">@z.ZoneName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }

                    @if (_showRegion)
                    {
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string"
                                       Label="Region"
                                       Value="_selectedRegion"
                                       ValueChanged="@(async (string n) => await OnRegionChanged(n))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Disabled="@(_selectedZone == ALL && _userPrivilege == "CO")"
                                       Immediate="true">
                                <MudSelectItem Value="@ALL">All</MudSelectItem>
                                @foreach (var r in _regions)
                                {
                                    <MudSelectItem Value="@r.RegionSolid">@r.RegionName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }

                    @if (_showBranch)
                    {
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string"
                                       Label="Branch"
                                       Value="_selectedBranch"
                                       ValueChanged="@(async (string n) => await OnBranchChanged(n))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Disabled="@(_selectedRegion == ALL && _userPrivilege != "BRANCH")"
                                       Immediate="true">
                                <MudSelectItem Value="@ALL">All</MudSelectItem>
                                @foreach (var b in _branches)
                                {
                                    <MudSelectItem Value="@b.SolId">@b.BranchName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }

                    <MudSpacer />

                    @if (CanShowData)
                    {
                        <MudItem xs="12" sm="3" Class="d-flex align-end">
                            <MudButton Variant="Variant.Filled"
                                       StartIcon="@MudBlazor.Icons.Material.Filled.Download"
                                       Style="background-color:#000066; color:white; font-size:12px;"
                                       OnClick="HandleExport">
                                Export To Excel
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>

                @if (CanShowData)
                {
                    <div class="px-4 d-flex justify-end">
                        <MudText Typo="Typo.caption" Style="font-weight:bold; font-style:italic; color:#666;">
                            @_asOnDateLabel
                        </MudText>
                    </div>
                }

                <!-- Advisory (always visible) -->
                <div class="px-4">
                    <MudText Typo="Typo.subtitle2" Style="color:rgb(40,78,152); font-weight:600;">
                        Branch is advised to focus on the following operational critical areas and take the immediate remedial measures.
                    </MudText>
                </div>

                <!-- Data Table (visible only when CanShowData is true) -->
                @if (CanShowData)
                {
                    <MudItem xs="12" Class="pa-4">
                        <MudTable Items="@_opsData" Hover="true" Striped="true" Bordered="true" Dense="true" Elevation="2"
                                  Loading="@_isLoading" RowsPerPage="25" Class="fixed-table" Style="font-size:12px;">
                            <HeaderContent>
                                <MudTh Style="background-color:#2a2f5b; color:white; width:25px; text-align:center;">S.No.</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white; width:25%;">Parameter</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:20%;">Previous Day</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:20%;">Actuals</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:20%;">Progress/Variations</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd Style="width:25px; text-align:center;">@(_opsData.IndexOf(context) + 1)</MudTd>

                                <!-- Parameter -->
                                <MudTd class="fw-bold">@context.Parameter</MudTd>

                                    <!-- Previous Day: "value (dd/MM/yyyy)" -->
                                    <MudTd style="text-align:right;">
                                        @($"{FormatValue(context.PrevDay2No)} ({context.PrevDay2Date:dd/MM/yyyy})")
                                    </MudTd>

                                    <!-- Actuals: "value (dd/MM/yyyy)" -->
                                    <MudTd style="text-align:right;">
                                        @($"{FormatValue(context.PrevDayNo)} ({context.PrevDayDate:dd/MM/yyyy})")
                                    </MudTd>

                                    <!-- Progress/Variations: "Δ | %" -->
                                    @{
                                    var (diff, pct) = ComputeVariation(context);
                                }
                                <MudTd style="text-align:right;">
                                    @($"{FormatSigned(diff)} | {FormatSmartPercent(pct)}")
                                </MudTd>
                            </RowTemplate>

                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>

                        @if (!_opsData.Any() && !_isLoading)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2">
                                No Data Found for the selected criteria.
                            </MudAlert>
                        }
                    </MudItem>
                }
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

@* Survey Popup (Blazor-only) *@
@if (_showSurveyPopup)
{
    <div class="popup-overlay" @onclick="OnOverlayClick">
        <div class="popup-content" @onclick:stopPropagation="true">
            <div class="popup-header">
                <h2>We Value Your Feedback</h2>
                <p>Help us improve by taking a short survey</p>
            </div>
            <div class="popup-body">
                <p>Your feedback is important to us and helps improve our services. The survey will only take 2-3 minutes to complete.</p>
                <div class="d-flex flex-column align-center" style="gap:12px;">
                    <a href="Survey_Home.aspx" target="_blank" class="survey-btn">Take Survey Now</a>
                    <button class="close-btn" @onclick="ClosePopup">Close Popup</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string ALL = "ALL";

    // Show data only if user is not CO OR a zone is selected.
    private bool CanShowData =>
        _userPrivilege != "CO" || _selectedZone != ALL;

    // Filters
    private List<Zone> _zones = new();
    private List<Region> _regions = new();
    private List<Branch> _branches = new();

    private string _selectedZone = ALL, _selectedRegion = ALL, _selectedBranch = ALL;
    private string _userPrivilege = "CO", _userSolid = "00000";
    private bool _showZone = true, _showRegion = true, _showBranch = true, _isLoading = false;

    // Data
    private List<OperationalItem> _opsData = new();
    private string _asOnDateLabel = "";

    // Survey
    private bool _showSurveyPopup = false;
    private readonly DateTime _surveyStart = new(2025, 12, 15);
    private readonly DateTime _surveyEnd = new(2026, 01, 14);

    // ---------- INITIAL LOAD ----------
    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            await InitializeFilters();  // Fetch from master tables through DashboardService
            await LoadUserClaims();

            // Only load data if allowed now (ZONE/REGION/BRANCH users or CO after zone will load later)
            if (CanShowData)
            {
                await LoadOpsData();
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "LoginDashboard: initialization error");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        await MaybeShowSurveyPopup();
    }

    private async Task LoadUserClaims()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userPrivilege = user.FindFirst("privilege")?.Value?.ToUpper() ?? "CO";

            if (_userPrivilege == "ZONE")
                _userSolid = user.FindFirst("zone_solid")?.Value ?? "00000";
            else if (_userPrivilege == "REGION")
                _userSolid = user.FindFirst("region_solid")?.Value ?? "00000";
            else if (_userPrivilege == "BRANCH")
                _userSolid = user.FindFirst("branch_solid")?.Value ?? "00000";
        }
    }

    private async Task InitializeFilters()
    {
        try
        {
            if (_userPrivilege == "CO")
            {
                _zones = await DashboardService.GetZonesAsync();               // zone_master
                Snackbar.Add($"Zones loaded: {_zones.Count}", Severity.Info);
                // Region/Branch remain disabled until a Zone is chosen
            }
            else if (_userPrivilege == "ZONE")
            {
                _showZone = false;
                _selectedZone = _userSolid;
                _regions = await DashboardService.GetRegionsAsync(_userSolid); // region_master
                Snackbar.Add($"Regions loaded: {_regions.Count}", Severity.Info);
            }
            else if (_userPrivilege == "REGION")
            {
                _showZone = false; _showRegion = false;
                _selectedRegion = _userSolid;
                _branches = await DashboardService.GetBranchesAsync(_userSolid); // branch_master
                Snackbar.Add($"Branches loaded: {_branches.Count}", Severity.Info);
            }
            else if (_userPrivilege == "BRANCH")
            {
                _showZone = false; _showRegion = false; _showBranch = false;
                _selectedBranch = _userSolid;
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "LoginDashboard: initialize filters error");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        StateHasChanged();
    }

    // ---------- SELECT CHANGE HANDLERS ----------
    private async Task OnZoneChanged(string n)
    {
        try
        {
            _selectedZone = n;
            _selectedRegion = ALL;
            _selectedBranch = ALL;

            _regions.Clear();
            _branches.Clear();

            if (n != ALL)
            {
                _regions = await DashboardService.GetRegionsAsync(n);  // region_master
                Snackbar.Add($"Regions loaded: {_regions.Count}", Severity.Info);

                // Now that Zone is selected (CO case), show data
                await LoadOpsData();
            }
            else
            {
                // CO user cleared zone: clear table content
                _opsData.Clear();
                _asOnDateLabel = "";
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "LoginDashboard: zone change failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task OnRegionChanged(string n)
    {
        try
        {
            _selectedRegion = n;
            _selectedBranch = ALL;

            _branches.Clear();

            if (n != ALL)
            {
                _branches = await DashboardService.GetBranchesAsync(n); // branch_master
                Snackbar.Add($"Branches loaded: {_branches.Count}", Severity.Info);
            }

            if (CanShowData) await LoadOpsData();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "LoginDashboard: region change failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task OnBranchChanged(string n)
    {
        try
        {
            _selectedBranch = n;
            if (CanShowData) await LoadOpsData();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "LoginDashboard: branch change failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        StateHasChanged();
    }

    // ---------- DATA LOAD ----------
    private async Task LoadOpsData()
    {
        if (!CanShowData)
        {
            _opsData.Clear();
            _asOnDateLabel = "";
            StateHasChanged();
            return;
        }

        _isLoading = true;
        StateHasChanged();

        // SOL resolution: Branch -> Region -> Zone -> fallback
        var sol = _selectedBranch != ALL ? _selectedBranch
                : _selectedRegion != ALL ? _selectedRegion
                : _selectedZone != ALL ? _selectedZone
                : "00000";

        try
        {
            _opsData = await OperationalAreasService.GetOperationalItemsAsync(sol);

            if (_opsData.Any())
            {
                var maxDt = _opsData.Max(x => x.PrevDayDate);
                _asOnDateLabel = maxDt != DateTime.MinValue ? $"As on {maxDt:dd-MM-yyyy}" : "";
            }
            else
            {
                _asOnDateLabel = "";
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "LoginDashboard: load data failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ---------- FORMAT/VARIATION ----------
    private string FormatValue(decimal v)
        => (v == Math.Truncate(v)) ? v.ToString("0") : v.ToString("0.######");

    private string FormatSigned(decimal v)
    {
        var s = v.ToString("0.##");
        if (decimal.TryParse(s, out var n) && n == 0) s = "0";
        return s;
    }

    private string FormatSmartPercent(decimal pct)
    {
        var abs = Math.Abs(pct);
        var whole = abs == Math.Truncate(abs);
        var formatted = (abs >= 1m && whole) ? pct.ToString("0") : pct.ToString("0.##");
        if (decimal.TryParse(formatted, out var n) && n == 0) formatted = "0";
        return $"{formatted}%";
    }

    private (decimal diff, decimal pct) ComputeVariation(OperationalItem row)
    {
        // Default: PrevDay2 - PrevDay
        // ATM HITS: PrevDay - PrevDay2
        var isAtm = (row.Parameter ?? "").ToUpperInvariant() == "ATM HITS";
        var diff = isAtm ? (row.PrevDayNo - row.PrevDay2No) : (row.PrevDay2No - row.PrevDayNo);
        var pct = row.PrevDay2No != 0 ? Math.Round((diff * 100m) / row.PrevDay2No, 2) : 0m;

        if (Math.Abs(diff) < 0.0005m) diff = 0;
        if (Math.Abs(pct) < 0.0005m) pct = 0;
        return (diff, pct);
    }

    // ---------- EXPORT ----------
    private async Task HandleExport()
    {
        if (!_opsData.Any()) return;

        var columns = new List<ColumnConfig>
        {
            new ColumnConfig { Header = "Parameter",PropertyName = "Parameter" },
            new ColumnConfig { Header = "Previous Day (Value)",     PropertyName = "PrevDay2No",     IsNumeric = true },
            new ColumnConfig { Header = "Previous Day (Date)",      PropertyName = "PrevDay2DateStr" },
            new ColumnConfig { Header = "Actuals (Value)",          PropertyName = "PrevDayNo",      IsNumeric = true },
            new ColumnConfig { Header = "Actuals (Date)",           PropertyName = "PrevDayDateStr"  },
            new ColumnConfig { Header = "Progress/Variations (Δ)",  PropertyName = "Diff",           IsNumeric = true },
            new ColumnConfig { Header = "Progress/Variations (%)",  PropertyName = "Pct",            IsNumeric = true },
        };

        var data = _opsData.Select(i =>
        {
            var (d, p) = ComputeVariation(i);
            return new Dictionary<string, object>
                {
                { "Parameter",        i.Parameter },
                { "PrevDay2No",       i.PrevDay2No },
                { "PrevDay2DateStr",  i.PrevDay2Date == DateTime.MinValue ? "" : i.PrevDay2Date.ToString("dd/MM/yyyy") },
                { "PrevDayNo",        i.PrevDayNo },
                { "PrevDayDateStr",   i.PrevDayDate  == DateTime.MinValue ? "" : i.PrevDayDate.ToString("dd/MM/yyyy") },
                { "Diff",             d },
                { "Pct",              p }
                };
        }).ToList();

        var bytes = ReportService.ExportToExcel(data, columns, "LoginDashboard");
        await JS.InvokeVoidAsync("BlazorDownloadFile",
            $"LoginDashboard_{AppTime.Now:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    // ---------- SURVEY POPUP ----------
    private async Task MaybeShowSurveyPopup()
    {
        var today = AppTime.Today;
        if (today >= _surveyStart && today <= _surveyEnd)
        {
            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var pf = user.FindFirst("pfno")?.Value ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                var hasSubmitted = await OperationalAreasService.HasSubmittedSurveyAsync(pf);
                if (!hasSubmitted)
                {
                    await Task.Delay(1000);
                    _showSurveyPopup = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // ignore popup check failures
            }
        }
    }

    private void ClosePopup() => _showSurveyPopup = false;
    private void OnOverlayClick() => ClosePopup();
}