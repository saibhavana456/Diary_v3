@page "/dashboard_new_1"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MyDiary.Web.Features.Dashboard_new_1.Services
@using MyDiary.Web.Features.Dashboard_new_1.Models
@using MyDiary.Web.Features.Dashboard_new.Models
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@using System.Security.Claims
@using Microsoft.JSInterop
@inject IDashboard1Service Dashboard1Service
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject Extensions.NavState NavState
@inject DynamicReportService ReportService
@inject IJSRuntime JS

<PageTitle>KPI Dashboard — My Diary | Union Bank of India</PageTitle>

<style>
    .fixed-table { table-layout: fixed !important; width: 100% !important; }
</style>

<PageHeader PageKey="kpi-dashboard" Title="KPI Dashboard"
            Crumbs="_crumbs"
            Subtitle="Key Performance Indicators across your network" />

<MudGrid Spacing="3">
    <MudItem xs="12" md="12">
        <div id="business-page-root" class="mb-4">
            <MudPaper Elevation="0" Style="background-color:#ffffff;">

                <MudGrid Spacing="2" Class="p-2 align-center">

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Zone" Value="_selectedZone" ValueChanged="OnZoneChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Disabled="@_isZoneDisabled">
                            @if (CanViewAll)
                            {
                                   <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                             }
                            @foreach (var z in _zones)
                            {
                                <MudSelectItem Value="@z.ZoneSolid">@z.ZoneName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Region" Value="_selectedRegion" ValueChanged="OnRegionChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Disabled="@(_isRegionDisabled || _selectedZone == "ALL")">
                            <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var r in _regions)
                            {
                                <MudSelectItem Value="@r.RegionSolid">@r.RegionName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Branch" Value="_selectedBranch" ValueChanged="OnBranchChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Disabled="@(_isBranchDisabled || _selectedRegion == "ALL")">
                            <MudSelectItem Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var b in _branches)
                            {
                                <MudSelectItem Value="@b.SolId">@b.BranchName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudSpacer />

                    <MudItem xs="12" sm="2" Class="d-flex align-center gap-3">
                        <MudText Typo="Typo.caption" Style="font-weight:bold; font-style:italic; color:#666; white-space:nowrap;">
                            @_asOnDateLabel
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@MudBlazor.Icons.Material.Filled.Download"
                                   Style="background-color:#000066; color:white; font-size:11px;"
                                   OnClick="HandleExport">Export To Excel</MudButton>
                    </MudItem>

                </MudGrid>

                <div class="pa-2">
                    <MudTable Items="@_result.Items" Hover="true" Striped="true" Bordered="true" Dense="true"
                              Elevation="2" Loading="@_isLoading" RowsPerPage="25"
                              Class="fixed-table" Style="font-size:12px;">
                        <HeaderContent>
                            <MudTh Style="background-color:#2a2f5b; color:white; width:40px;">S.No.</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; width:15%;">Parameter</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderLastToLastFY</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderLastFY</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderLastQtr</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderAsOnDate</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderTargetQtr</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderTargetFY</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderGrowthOver</MudTh>
                            <MudTh Style="background-color:#2a2f5b; color:white; text-align:right; width:10%;">@_result.HeaderTargetFYGap</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@(_result.Items.IndexOf(context) + 1)</MudTd>
                            <MudTd Class="fw-bold">@context.ParameterName</MudTd>
                            <MudTd Style="text-align:right;">@FormatCrores(context.ActualLastToLastFY)</MudTd>
                            <MudTd Style="text-align:right;">@FormatCrores(context.ActualLastFY)</MudTd>
                            <MudTd Style="text-align:right;">@FormatCrores(context.ActualLastQtr)</MudTd>
                            <MudTd Style="text-align:right;" Class="fw-bold">@FormatCrores(context.ActualAsOnDate)</MudTd>
                            <MudTd Style="text-align:right;">@FormatCrores(context.TargetNextQtr)</MudTd>
                            <MudTd Style="text-align:right;">@FormatCrores(context.TargetNextMar)</MudTd>
                            @{
                                bool isNpa = context.ParameterName.Contains("NPA", StringComparison.OrdinalIgnoreCase);
                                // Gap to FY Target = FY Target − Actuals (as of current date)
                                var gapToFyTarget = context.TargetNextMar - context.ActualAsOnDate;
                                string growthStyle = (context.GrowthOver < 0 && !isNpa) || (isNpa && context.GrowthOver > 0)
                                    ? "text-align:right; color:red; font-weight:bold;"
                                    : "text-align:right;";
                                string gapStyle = gapToFyTarget < 0 && !isNpa
                                    ? "text-align:right; color:red; font-weight:bold;"
                                    : "text-align:right;";
                            }
                            <MudTd Style="@growthStyle">@FormatValue(context.GrowthOver)</MudTd>
                            <MudTd Style="@gapStyle">@FormatCrores(gapToFyTarget)</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>

                    @if (!_result.Items.Any() && !_isLoading)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">No Data Found for the selected criteria.</MudAlert>
                    }
                </div>

            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

@code {
    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("Business"),
        new("KPI Dashboard"),
    };

    // ── State ────────────────────────────────────────────────────────────────────
    private List<Zone>   _zones    = new();
    private List<Region> _regions  = new();
    private List<Branch> _branches = new();

    private KpiDashboard1Result _result = new();

    private string _selectedZone   = "ALL";
    private string _selectedRegion = "ALL";
    private string _selectedBranch = "ALL";

    private string _userPrivilege = "CO";
    private string _userBrSolid   = "00000";
    private string _userRegSolid  = "00000";
    private string _userZoneSolid = "00000";

    private bool _isZoneDisabled   = false;
    private bool _isRegionDisabled = false;
    private bool _isBranchDisabled = false;
    private bool _isLoading  = false;

    private int scaleCode = 0;
    private bool CanViewAll = false;
    private string _asOnDateLabel = "";

    // ── Lifecycle ────────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _zones.Clear(); _regions.Clear(); _branches.Clear();

        // LoadUserClaims and zones fetch are independent — run in parallel
        var claimsTask = LoadUserClaims();
        var zonesTask = Dashboard1Service.GetZonesAsync();
        await Task.WhenAll(claimsTask, zonesTask);
        _zones = zonesTask.Result;

        await InitializeFilters(skipZones: true);
        StateHasChanged();
        await LoadKpiData();
    }

    // ── Auth ─────────────────────────────────────────────────────────────────────

    private async Task LoadUserClaims()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true) return;

        _userPrivilege = user.FindFirst("privilege")?.Value?.ToUpper() ?? "CO";
        _userBrSolid   = user.FindFirst("branch_solid")?.Value  ?? "00000";
        _userRegSolid  = user.FindFirst("region_solid")?.Value  ?? "00000";
        _userZoneSolid = user.FindFirst("zone_solid")?.Value    ?? "00000";

        int.TryParse(user.FindFirst("employee_scale_code")?.Value, out scaleCode);
        CanViewAll = _userPrivilege.Equals("co", StringComparison.OrdinalIgnoreCase) && scaleCode < 6;
    }

    // ── Filter initialisation ────────────────────────────────────────────────────

    private async Task InitializeFilters(bool skipZones = false)
    {
        // Always load zones for display (even if disabled) — unless already loaded in parallel
        if (!skipZones)
            _zones = await Dashboard1Service.GetZonesAsync();

        switch (_userPrivilege)
        {
            case "CO":
                // CO with CanViewAll: nothing disabled, "ALL" is default
                // CO without CanViewAll: auto-select first zone → region → branch
                if (!CanViewAll && _zones.Count > 0)
                {
                    _selectedZone = _zones.First().ZoneSolid;
                    _selectedRegion = "ALL"; // Displays "All Regions"
                    _selectedBranch = "ALL"; // Displays "All Branches"
                    _regions = await Dashboard1Service.GetRegionsAsync(_selectedZone);
                    // if (_regions.Count > 0)
                    // {
                    //     _selectedRegion = _regions.First().RegionSolid;
                    //     _branches = await Dashboard1Service.GetBranchesAsync(_selectedRegion);
                    //     if (_branches.Count > 0)
                    //         _selectedBranch = _branches.First().SolId;
                    // }
                }
                break;

            case "ZONE":
                _isZoneDisabled = true;
                _selectedZone   = _userZoneSolid;
                _regions        = await Dashboard1Service.GetRegionsAsync(_userZoneSolid);
                break;

            case "REGION":
                _isZoneDisabled   = true;
                _isRegionDisabled = true;
                _selectedZone     = _userZoneSolid;
                _selectedRegion   = _userRegSolid;
                _regions          = await Dashboard1Service.GetRegionsAsync(_userZoneSolid);
                _branches         = await Dashboard1Service.GetBranchesAsync(_userRegSolid);
                break;

            default: // BRANCH
                _isZoneDisabled   = true;
                _isRegionDisabled = true;
                _isBranchDisabled = true;
                _selectedZone     = _userZoneSolid;
                _selectedRegion   = _userRegSolid;
                _selectedBranch   = _userBrSolid;
                _regions          = await Dashboard1Service.GetRegionsAsync(_userZoneSolid);
                _branches         = await Dashboard1Service.GetBranchesAsync(_userRegSolid);
                break;
        }
        StateHasChanged();
    }

    // ── Dropdown handlers ────────────────────────────────────────────────────────

    private async Task OnZoneChanged(string val)
    {
        _selectedZone = val; _selectedRegion = "ALL"; _selectedBranch = "ALL";
        _regions.Clear(); _branches.Clear();
        if (val != "ALL") _regions = await Dashboard1Service.GetRegionsAsync(val);
        await LoadKpiData();
    }

    private async Task OnRegionChanged(string val)
    {
        _selectedRegion = val; _selectedBranch = "ALL";
        _branches.Clear();
        if (val != "ALL") _branches = await Dashboard1Service.GetBranchesAsync(val);
        await LoadKpiData();
    }

    private async Task OnBranchChanged(string val)
    {
        _selectedBranch = val;
        await LoadKpiData();
    }

    // ── Data load ────────────────────────────────────────────────────────────────

    private async Task LoadKpiData()
    {
        _isLoading = true;
        StateHasChanged();

        // Resolve the override solid from the dropdowns (most specific wins)
        string? overrideSolId =
            _selectedBranch != "ALL" ? _selectedBranch :
            _selectedRegion != "ALL" ? _selectedRegion :
            _selectedZone   != "ALL" ? _selectedZone   : null;

        try
        {
            _result = await Dashboard1Service.GetKpiDataAsync(
                _userPrivilege, _userBrSolid, _userRegSolid, _userZoneSolid,
                overrideSolId);

            _asOnDateLabel = _result.Items.Any() ? "(Rs. in Crores)" : "";
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "Dashboard_new_1: failed to load data");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ── Formatting ───────────────────────────────────────────────────────────────

    // KPI values from SP are raw (not in crores) — divide by 10,000,000
    private static string FormatCrores(decimal v) =>
        v == 0 ? "—" : (v / 10_000_000m).ToString("N2");

    // Growth is already a percentage from the SP
    private static string FormatValue(decimal v) =>
        v == 0 ? "—" : v.ToString("N2") + "%";

    // ── Export ───────────────────────────────────────────────────────────────────

    private async Task HandleExport()
    {
        if (!_result.Items.Any()) return;

        var columns = new List<ColumnConfig>
        {
            new() { Header = "Parameter",                                          PropertyName = "P"   },
            new() { Header = _result.HeaderLastToLastFY,                           PropertyName = "L2L", IsNumeric = true },
            new() { Header = _result.HeaderLastFY,                                 PropertyName = "LFY", IsNumeric = true },
            new() { Header = _result.HeaderLastQtr,                                PropertyName = "LQ",  IsNumeric = true },
            new() { Header = _result.HeaderAsOnDate,                               PropertyName = "AOD", IsNumeric = true },
            new() { Header = _result.HeaderTargetQtr,                              PropertyName = "TQ",  IsNumeric = true },
            new() { Header = _result.HeaderTargetFY,                               PropertyName = "TFY", IsNumeric = true },
            new() { Header = _result.HeaderGrowthOver,                             PropertyName = "GRW", IsNumeric = true },
            new() { Header = _result.HeaderTargetFYGap,                            PropertyName = "GAP", IsNumeric = true }
        };

        var data = _result.Items.Select(i => new Dictionary<string, object>
        {
            { "P",   i.ParameterName },
            { "L2L", i.ActualLastToLastFY / 10_000_000m },
            { "LFY", i.ActualLastFY       / 10_000_000m },
            { "LQ",  i.ActualLastQtr      / 10_000_000m },
            { "AOD", i.ActualAsOnDate     / 10_000_000m },
            { "TQ",  i.TargetNextQtr      / 10_000_000m },
            { "TFY", i.TargetNextMar      / 10_000_000m },
            { "GRW", i.GrowthOver },
            // Gap to FY Target = FY Target − Actuals (as of current date)
            { "GAP", (i.TargetNextMar - i.ActualAsOnDate) / 10_000_000m }
        }).ToList();

        var bytes = ReportService.ExportToExcel(data, columns, "KPIDashboard");
        await JS.InvokeVoidAsync("BlazorDownloadFile",
            $"KPI_Dashboard_{AppTime.Now:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }
}
