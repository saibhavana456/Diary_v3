@page "/svc/vendor/{CategoryCode}"
@using global::RequestPortal.Web.Shared
@using MyDiary.Web.Features.StaffVendorConnect.Services
@using MyDiary.Web.Features.StaffVendorConnect.Models.DTO
@using MyDiary.Web.Features.StaffVendorConnect.Components
@inject IStaffVendorConnectService SvcService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_category?.CategoryName ?? "Vendor Records") - Staff and Vendor Connect</PageTitle>

<AuthenticatedOnly>

<PageHeader Title="@(_category?.CategoryName ?? "Vendor Records")" Subtitle="Outsourced vendor records for this category." Crumbs="_crumbs" PageKey="svc-vendor-list" />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="d-flex flex-wrap align-center mb-3">
        <MudTextField @bind-Value="_search" Label="Search" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Style="max-width:280px" />
        <MudSpacer />
        @if (_canManage)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Send" Class="mr-2" OnClick="OpenSendDialog">
                Send Communication
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Class="mr-2" OnClick="OpenBulkUploadDialog">
                Bulk Upload
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo($"svc/vendor/{CategoryCode}/edit/new"))">
                Add New
            </MudButton>
        }
    </div>

    <MudTable Items="@Filtered" Hover="true" Dense="true" Bordered="true" RowsPerPage="20">
        <HeaderContent>
            <MudTh>Name / Title</MudTh>
            <MudTh>Branch</MudTh>
            <MudTh>Region</MudTh>
            <MudTh>Zone</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.DisplayTitle</MudTd>
            <MudTd>@context.BranchName</MudTd>
            <MudTd>@context.RegionName</MudTd>
            <MudTd>@context.ZoneName</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == "ACTIVE" ? Color.Success : Color.Default)">@context.Status</MudChip></MudTd>
            <MudTd>@context.CreatedDate.ToString("dd-MMM-yyyy")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo($"svc/vendor/{CategoryCode}/edit/{context.RecordId}"))">@(_canManage ? "Edit" : "View")</MudButton>
                @if (_canManage && context.Status == "ACTIVE")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Deactivate" OnClick="@(() => DeactivateAsync(context.RecordId))" />
                }
            </MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" /></PagerContent>
    </MudTable>
}

</AuthenticatedOnly>

@code {
    [Parameter] public string CategoryCode { get; set; } = "";

    private List<PageHeader.Crumb> _crumbs = new();
    private bool _loading = true;
    private SvcCategory? _category;
    private List<SvcVendorRecord> _records = new();
    private string _search = "";
    private string _pfNo = "";
    private bool _canManage;

    private IEnumerable<SvcVendorRecord> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _records
        : _records.Where(r =>
            (r.DisplayTitle?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.BranchName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private string? _loadedForCategory;
    private System.Security.Claims.ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _user = state.User;
            _pfNo = state.User.FindFirst("emplid")?.Value ?? "";
        }
        await LoadForCurrentCategoryAsync();
    }

    // Blazor reuses this component instance (rather than recreating it) when navigating
    // between two categories of the same page type — e.g. /svc/vendor/BC -> /svc/vendor/
    // CONCURRENT_AUDITOR — so OnInitializedAsync alone would leave the old category's data on
    // screen. OnParametersSetAsync fires on every such navigation; only reload when
    // CategoryCode actually changed (it also fires, harmlessly, right after OnInitializedAsync
    // on first load, which _loadedForCategory guards against re-querying twice).
    protected override async Task OnParametersSetAsync()
    {
        if (CategoryCode != _loadedForCategory)
            await LoadForCurrentCategoryAsync();
    }

    private async Task LoadForCurrentCategoryAsync()
    {
        _loading = true;
        _search = "";
        _category = await SvcService.GetCategoryAsync(CategoryCode);
        _crumbs = new() { new("Assurance 360°", "assurance-360"), new("Staff and Vendor Connect", "svc/hub"), new("Vendor Records", "svc/vendor/categories"), new(_category?.CategoryName ?? CategoryCode) };
        _canManage = _user is not null && await SvcService.CanManageCategoryAsync(_user, CategoryCode);
        await ReloadAsync();
        _loadedForCategory = CategoryCode;
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _records = await SvcService.GetVendorRecordsAsync(CategoryCode, null, null, null);
    }

    private async Task DeactivateAsync(long recordId)
    {
        // Server-side re-check — a non-privileged user could otherwise invoke this even if the
        // delete icon were hidden client-side only (mirrors FormBuilder.razor's pattern).
        if (_user is null || !await SvcService.CanManageCategoryAsync(_user, CategoryCode))
        {
            Snackbar.Add("You are not authorized to deactivate records in this category.", Severity.Error);
            return;
        }
        await SvcService.SetVendorRecordStatusAsync(recordId, "INACTIVE", _pfNo);
        Snackbar.Add("Record deactivated.", Severity.Success);
        await ReloadAsync();
    }

    private async Task OpenSendDialog()
    {
        if (_user is null || !await SvcService.CanManageCategoryAsync(_user, CategoryCode))
        {
            Snackbar.Add("You are not authorized to send communications for this category.", Severity.Error);
            return;
        }
        var parameters = new DialogParameters<SendCommunicationDialog>
        {
            { x => x.TargetModule, "VENDOR" },
            { x => x.CategoryCode, CategoryCode },
            { x => x.ActorPfNo, _pfNo }
        };
        await DialogService.ShowAsync<SendCommunicationDialog>("Send Communication", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task OpenBulkUploadDialog()
    {
        if (_user is null || !await SvcService.CanManageCategoryAsync(_user, CategoryCode))
        {
            Snackbar.Add("You are not authorized to bulk upload records for this category.", Severity.Error);
            return;
        }
        var parameters = new DialogParameters<BulkUploadDialog>
        {
            { x => x.CategoryCode, CategoryCode },
            { x => x.CategoryName, _category?.CategoryName ?? CategoryCode },
            { x => x.ActorPfNo, _pfNo }
        };
        var dialog = await DialogService.ShowAsync<BulkUploadDialog>("Bulk Upload", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await ReloadAsync();
    }
}
