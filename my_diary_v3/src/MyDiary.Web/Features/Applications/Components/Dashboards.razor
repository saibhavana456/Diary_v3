            _ => "dashboard_new_1"
        };

        // Append the Title as a query parameter (e.g., /reports/sundry?title=Sundry Data - OAP)
        var uri = Nav.GetUriWithQueryParameters(targetRoute, new Dictionary<string, object?>
        {
            { "title", record.Name }
        });

        Nav.NavigateTo(uri);
    }
    // 🔍 Search text (Applications-like behavior)
    private string _searchText = string.Empty;

    // ✅ Filtered view similar to Applications page
    private IEnumerable<RecordData> FilteredRecords
    {
        get
        {
            if (Records is null || Records.Count == 0)
                return Enumerable.Empty<RecordData>();

            var query = Records.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var s = _searchText.Trim();

                query = query.Where(x =>
    (!string.IsNullOrWhiteSpace(x.Name) && x.Name.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
    (!string.IsNullOrWhiteSpace(x.OwnerVertical) && x.OwnerVertical.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
    (!string.IsNullOrWhiteSpace(x.Source) && x.Source.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
    (!string.IsNullOrWhiteSpace(x.FrequencyOfReportUpdation) && x.FrequencyOfReportUpdation.Contains(s, StringComparison.OrdinalIgnoreCase))
    );
            }

            // Keep a stable order
            return query.OrderBy(x => x.Name);
        }
    }
