    async void HandleGoClick(AppModel app)
    {
        // -- Internal migrated pages � navigate within the app ------------------
        // Add a new case here whenever a new page is migrated from the old site.
        string appKey = !string.IsNullOrWhiteSpace(app.ShortName)
            ? app.ShortName.Trim()
            : app.FullName.Trim();

        switch (appKey)
        {
            case "Codes & Policy":
                await JS.InvokeVoidAsync("window.open", "code_policy", "_blank");
                return;
            case "Executive Attendance":
                Nav.NavigateTo("attendance/home");
                return;
            case "Back Dated Deposits":
                Nav.NavigateTo("deposits/hub");
                return;
            case "Recon Certificates":
                Nav.NavigateTo("recon/hub");
                return;
            case "Mediation of Nation":
                Nav.NavigateTo("mediation/hub");
                return;
            case "UHV Launch":
                // Union Hub Video Launch is now reached from the Notifications sidebar (under
                // "Union Hub"), not the Applications grid — this case stays only as a safety net
                // in case the APPLICATION_LIST row is ever re-added. Without this case it fell
                // through to the "default: Standard SSO redirect" branch below, which calls
                // EncryptionService.EncryptStringAES for an app that has no SSO login at all
                // (APP_SSO_LOGIN_FLG='N') — that threw "Encryption service is unavailable" inside
                // this method's `async void`, an exception with nowhere to go, so the Go click
                // just silently did nothing ("page getting stuck").
                Nav.NavigateTo("union-hub/video-launch");
                return;
            // case "NextMigratedPage":
            //     Nav.NavigateTo("next-migrated-page");
            //     return;
        }

        // External or Mobile-Only: show popup instead of redirect
        if (app.Type == "EXTERNAL")
        {            var parameters = new DialogParameters<AppAccessDialog>
            {
                { x => x.AccessType, "External" },
                { x => x.AppName, app.FullName },
                { x => x.AppUrl, app.LoginUrl }
            };
            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                NoHeader = true
            };
            await DialogService.ShowAsync<AppAccessDialog>(null, parameters, options);
            return;
        }

        if (app.Type == "Mobile App")
        {
            var parameters = new DialogParameters<AppAccessDialog>
            {
                { x => x.AccessType, "MobileOnly" },
                { x => x.AppName, app.FullName },
                { x => x.AppUrl, app.LoginUrl },
                { x => x.AndroidUrl, app.LoginUrl },
                { x => x.IOSUrl, app.IOSStoreUrl }
            };
            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                NoHeader = true
            };
            await DialogService.ShowAsync<AppAccessDialog>(null, parameters, options);
            return;
        }

        // -- App-specific redirect logic --
        // Match on ShortName (APP_SHORT_NAME); falls back to FullName if ShortName is empty.
        switch (appKey)
        {
            case "VCard":
                _userIdf = await SessionStorage.GetAsync<string>("UserId");
                string vcardUrl = await VCardService.BuildVCardUrlAsync(app.LoginUrl, _userIdf ?? "");
                await JS.InvokeVoidAsync("window.open", vcardUrl, "_blank");
                break;

            case "EKAM":
                _userIdf = await SessionStorage.GetAsync<string>("UserId");
                string ekamUrl = EkamSsoService.BuildEkamUrl(app.LoginUrl, _userIdf ?? "", "lp");
                await JS.InvokeVoidAsync("window.open", ekamUrl, "_blank");
                break;

            case "Executive Branch Visit":
                {
                    var executiveBranchVisitState = await AuthStateProvider.GetAuthenticationStateAsync();
                    string bvUrl =
                        EoiSsoService.BuildExecutiveBranchVisitUrl(
                            app.LoginUrl,
                            executiveBranchVisitState.User);

                    await JS.InvokeVoidAsync(
                        "window.open",
                        bvUrl,
                        "_blank");

                    break;
                }

            case "Corporate EOI":
                // CCP needs more than a bare employee id — branch/zone scoping and role-gated queues
                // (BranchMaker/BranchHead/ZonalHead/CoLcv/CoMcv) depend on the full profile + resolved
                // EoiRole being in the payload. BuildCcpLaunchUrl reads both from the current claims
                // principal (already populated at login by CustomAuthenticationStateProvider) plus
                // CcpRbacService's role resolution (attribute-derived Branch/Zone roles + explicit
                // CoLcv/CoMcv assignment) — see EoiSsoService.BuildCcpLaunchUrl's own doc comment.
                _userIdf = await SessionStorage.GetAsync<string>("UserId");
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var eoiRole = await CcpRbacService.ResolveEoiRoleAsync(_userIdf ?? "");
                string ccpUrl = EoiSsoService.BuildCcpLaunchUrl(app.LoginUrl, authState.User, eoiRole);
                await JS.InvokeVoidAsync("window.open", ccpUrl, "_blank");
                break;

            case "Union Youth":
                // Standalone microservice ("Yuva Banking Mitra" registration portal) launched via the same
                // encrypted-token SSO handoff as CCP, but with its own launch-url builder (no EoiRole —
                // see EoiSsoService.BuildUnionYouthLaunchUrl's own doc comment for why). IsSuperAdmin is
                // resolved here with a real await, mirroring CCP's ResolveEoiRoleAsync call just below —
                // it used to be resolved with a blocking .GetAwaiter().GetResult() inside the builder
                // itself, which deadlocked the Blazor Server circuit (the click just hung forever).
                var uyAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
                var uyEmpId = uyAuthState.User.FindFirst("emplid")?.Value ?? "";
                var uyIsSuperAdmin = await EoiSsoService.ResolveUnionYouthIsSuperAdminAsync(uyEmpId);
                string uyUrl = EoiSsoService.BuildUnionYouthLaunchUrl(app.LoginUrl, uyAuthState.User, uyIsSuperAdmin);
                await JS.InvokeVoidAsync("window.open", uyUrl, "_blank");
                break;

            case "IFCO":
            case "ifco":
                {
                    _userIdf = await SessionStorage.GetAsync<string>("UserId");

                    string ifcoFormattedDateTime =
                        AppTime.Now.ToString(
                            "MM/dd/yyyy hh:mm:ss tt",
                            CultureInfo.InvariantCulture);

                    string ifcoData =
                        EncryptionService.EncryptStringAES(
                            $"{_userIdf}|{ifcoFormattedDateTime}");

                    string ifcoUrlWithData =
                        $"{app.LoginUrl}?data={Uri.EscapeDataString(ifcoData)}";

                    await JS.InvokeVoidAsync("window.open", ifcoUrlWithData,"_blank");

                    break;
                }

            // Add cases for other apps here as needed, e.g.:
            // case "SomeOtherApp":
            //     await HandleSomeOtherAppRedirectAsync(app.LoginUrl);
            //     break;

            default:
                // -- Standard SSO redirect --
                _userIdf = await SessionStorage.GetAsync<string>("UserId");
                _pwdf = await SessionStorage.GetAsync<string>("Pwd");
                string formattedDateTime = AppTime.Now.ToString("MM/dd/yyyy hh:mm:ss tt", CultureInfo.InvariantCulture);
                string data = EncryptionService.EncryptStringAES(_userIdf + "|" + _pwdf + "|" + formattedDateTime);
                string urlWithData = app.LoginUrl + "?data=" + data;
                await JS.InvokeVoidAsync("window.open", urlWithData, "_blank");
                break;
        }
    }

