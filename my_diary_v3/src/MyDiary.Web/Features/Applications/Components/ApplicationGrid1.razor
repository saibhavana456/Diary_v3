@page "/app-portal1"
@layout MyDiary.Web.Components.Layout.MainLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using Oracle.ManagedDataAccess.Client
@using System.Data
@using MyDiary.Web.Core.Services.Authentication
@using MyDiary.Web.Core.Services.Storage
@inject IConfiguration Configuration
@inject SSOService SSOService
@inject IJSRuntime JS
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@using System.Globalization
@using System.Text
@inject ISessionStorageService SessionStorage
@inject MyDiary.Web.Services.IEncryptionService EncryptionService
@inject MyDiary.Web.Services.EkamSsoService EkamSsoService
@inject IDialogService DialogService
@inject MyDiary.Web.Features.Shared.Services.IVCardService VCardService
@inject MyDiary.Web.Services.EoiSsoService EoiSsoService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject global::RequestPortal.Core.Abstractions.ICcpRbacService CcpRbacService

<PageTitle>Applications — My Diary | Union Bank of India</PageTitle>

<PageHeader PageKey="applications" Title="Applications"
            Crumbs="@(new List<PageHeader.Crumb>{ new("Applications") })"
            Subtitle="Browse and launch applications" />

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudPaper Elevation="0" Style="background-color: #ffffff;">

            @* --- Header Section --- *@
            @* <MudCard Elevation="2" Style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <MudCardHeader Class="justify-center text-white" Style="height:50px; font-weight:800; background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
                    <h2 class="ma-0" style="font-size:1.25rem; font-weight:800; color:white;">Applications</h2>
                </MudCardHeader>
            </MudCard> *@

            <div class="application-component-root pa-4">
                <div class="filter-container">
                    @* Filter row: categories wrap freely on the left; search+toggle stay pinned top-right *@
                    <div style="display:grid; grid-template-columns:1fr auto; align-items:start;
                                gap:8px; padding:16px; border-bottom:1px solid #f1f5f9;">
                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("All")" OnClick='() => SetFilterMode("All")' UserAttributes="@AriaBtn("All")">All</MudButton>
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("Category")" OnClick='() => SetFilterMode("Category")' UserAttributes="@AriaBtn("Category")">Category</MudButton>
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("Department")" OnClick='() => SetFilterMode("Department")' UserAttributes="@AriaBtn("Department")">Department</MudButton>
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("Type")" OnClick='() => SetFilterMode("Type")' UserAttributes="@AriaBtn("Type")">Type</MudButton>
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("InHouse Software")" OnClick='() => SetFilterMode("InHouse Software")' UserAttributes="@AriaBtn("InHouse Software")">InHouse Software</MudButton>
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("Fast Access")" OnClick='() => SetFilterMode("Fast Access")' UserAttributes="@AriaBtn("Fast Access")">Fast Access</MudButton>
                            <MudButton Variant="Variant.Filled" Class="@GetButtonClass("Useful Links")" OnClick='() => SetFilterMode("Useful Links")' UserAttributes="@AriaBtn("Useful Links")">Useful Links</MudButton>
                        </div>

                        @* Search + toggle � always top-right, never wraps *@
                        <div class="d-flex align-center gap-2" style="white-space:nowrap;">
                            <MudTextField @bind-Value="_searchText"
                                          PlaceHolder="Search Applications"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Margin="Margin.Dense"
                                          Class="search-bar"
                                          Immediate="true" />
                            <MudToggleGroup T="string" Value="@_viewMode" ValueChanged="v => _viewMode = v"
                                            Delimiter="false" Color="Color.Info" Rounded="true"
                                            aria-label="View mode">
                                <MudToggleItem Value='@("List")' Icon="@Icons.Material.Filled.List" aria-label="List view" />
                                <MudToggleItem Value='@("Grid")' Icon="@Icons.Material.Filled.GridView" aria-label="Grid view" />
                            </MudToggleGroup>
                        </div>
                    </div>
                    @if (_activeFilter != "All")
                    {
                        <div class="dropdown-row pt-3" style="border-top: 1px solid #f1f5f9;">
                            @if (_activeFilter == "Category")
                            {
                                <div role="combobox" aria-label="Select Category" aria-haspopup="listbox" aria-expanded="false">
                                <MudSelect T="string" Label="Select Category" @bind-Value="SelectedCat" Variant="Variant.Outlined" Margin="Margin.Dense" Class="large-select"
                                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                           UserAttributes="@(new Dictionary<string, object>{ ["aria-label"] = "Select Category" })">
                                    <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                                    @foreach (var cat in GetFilteredCategories())
                                    {
                                        <MudSelectItem Value="@cat">@cat</MudSelectItem>
                                    }
                                </MudSelect>
                                </div>
                            }
                            else if (_activeFilter == "Department")
                            {
                                <div role="combobox" aria-label="Select Department" aria-haspopup="listbox" aria-expanded="false">
                                <MudSelect T="string" Label="Select Department" @bind-Value="SelectedDept" Variant="Variant.Outlined" Margin="Margin.Dense" Class="large-select"
                                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                           UserAttributes="@(new Dictionary<string, object>{ ["aria-label"] = "Select Department" })">
                                    <MudSelectItem Value="@("All")">All Departments</MudSelectItem>
                                    @foreach (var dept in GetFilteredDepartments())
                                    {
                                        <MudSelectItem Value="@dept">@dept</MudSelectItem>
                                    }
                                </MudSelect>
                                </div>
                            }
                            else if (_activeFilter == "Type")
                            {
                                <div role="combobox" aria-label="Select Application Type" aria-haspopup="listbox" aria-expanded="false">
                                <MudSelect T="string" Label="Select Application Type" @bind-Value="SelectedType" Variant="Variant.Outlined" Margin="Margin.Dense" Class="large-select"
                                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                           UserAttributes="@(new Dictionary<string, object>{ ["aria-label"] = "Select Application Type" })">
                                    <MudSelectItem Value="@("All")">All Types</MudSelectItem>
                                    @foreach (var type in _allApps?.Select(x => x.Type).Distinct().OrderBy(x => x) ?? Enumerable.Empty<string>())
                                    {
                                        <MudSelectItem Value="@type">@type</MudSelectItem>
                                    }
                                </MudSelect>
                                </div>
                            }
                            else if (_activeFilter == "Useful Links")
                            {
                                <div role="combobox" aria-label="Select Useful Link Group" aria-haspopup="listbox" aria-expanded="false">
                                <MudSelect T="string" Label="Select Useful Link Group" @bind-Value="SelectedUsefulSub" Variant="Variant.Outlined" Margin="Margin.Dense" Class="large-select"
                                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                           UserAttributes="@(new Dictionary<string, object>{ ["aria-label"] = "Select Useful Link Group" })">
                                    <MudSelectItem Value="@("All")">All Useful Links</MudSelectItem>
                                    @foreach (var sub in GetUsefulSubCategories())
                                    {
                                        <MudSelectItem Value="@sub">@sub</MudSelectItem>
                                    }
                                </MudSelect>
                                </div>
                            }
                            else if (_activeFilter == "InHouse Software")
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <MudButton Variant="Variant.Filled"
                                               Class="@(_inHouseSubFilter == "All" ? "tab-btn active" : "tab-btn")"
                                               OnClick='() => _inHouseSubFilter = "All"'
                                               UserAttributes="@(new Dictionary<string, object>{ ["aria-current"] = _inHouseSubFilter == "All" ? "true" : "false" })">All</MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Class="@(_inHouseSubFilter == "SSO" ? "tab-btn active" : "tab-btn")"
                                               OnClick='() => _inHouseSubFilter = "SSO"'
                                               UserAttributes="@(new Dictionary<string, object>{ ["aria-current"] = _inHouseSubFilter == "SSO" ? "true" : "false" })">SSO Applications</MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Class="@(_inHouseSubFilter == "Non-SSO" ? "tab-btn active" : "tab-btn")"
                                               OnClick='() => _inHouseSubFilter = "Non-SSO"'
                                               UserAttributes="@(new Dictionary<string, object>{ ["aria-current"] = _inHouseSubFilter == "Non-SSO" ? "true" : "false" })">Non-SSO Applications</MudButton>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* --- Main Content Grid --- *@
                <div aria-live="polite" class="visually-hidden">
                    @if (!_isLoading && _allApps != null)
                    {
                        <span>Showing @_activeFilter filter. @FilteredApps.Count() applications found. Content updated below the filter section.</span>
                    }
                </div>
                <div class="@(_viewMode == "Grid" ? "cards-grid mt-2" : "mt-2")">
                    @if (_isLoading)
                    {
                        <div class="d-flex justify-center pa-10 w-100">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                            <MudText Class="ml-3">Loading Applications...</MudText>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_loadError))
                    {
                        <div class="w-100">
                            <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
                        </div>
                    }
                    else if (_allApps == null || !FilteredApps.Any())
                    {
                        <div class="d-flex justify-center pa-10 w-100">
                            <MudAlert Severity="Severity.Info">No applications found matching your criteria.</MudAlert>
                        </div>
                    }
                    else if (_viewMode == "Grid")
                    {
                        @foreach (var app in FilteredApps)
                        {
                            <div class="app-card">
                                <div class="d-flex align-start gap-4">
                                    <div class="icon-badge-container" style="background: #f1f5f9; border-radius: 12px; padding: 12px; border: 1px solid #e2e8f0;">
                                        <MudIcon Icon="@GetMudIcon(app.IconName)" Color="Color.Success" Style="font-size: 2.5rem;" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="app-info-text card-title"><b>@app.FullName</b></div>
                                        <div class="app-info-text">@app.Type</div>
                                        @if (app.Type == "EXTERNAL")
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Style="font-size: 0.7rem; height: 22px;">External</MudChip>
                                        }
                                        else if (app.Type == "Mobile App")
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.7rem; height: 22px;">Mobile Only</MudChip>
                                        }
                                    </div>
                                </div>
                                <div class="app-divider my-3" style="height: 1px; background-color: #d1d5db;"></div>
                                <div class="d-flex justify-space-between align-end">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="app-info-text"><b>Department:</b> @app.Department</div>
                                        <div class="app-info-text"><b>Category:</b> @app.Category</div>
                                        <div class="app-info-text"><b>SubCategory:</b> @app.SubCategory</div>
                                        <div class="mt-3">
                                            <MudButton Variant="Variant.Text" Class="tab-btn active go-btn"
                                                       OnClick="@(() => HandleGoClick(app))"
                                                       EndIcon="@Icons.Material.Filled.ArrowRightAlt"
                                                       aria-label="@($"Open {app.FullName}")">GO</MudButton>
                                        </div>
                                    </div>
                                    <MudMenu ActivationEvent="@MouseEvent.MouseOver" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight">
                                        <ActivatorContent>
                                            <div class="tab-btn active info-btn-circle">
                                                <span class="custom-i-icon">i</span>
                                            </div>
                                        </ActivatorContent>
                                        <ChildContent>
                                            <div class="styled-popup-content">@app.Description</div>
                                        </ChildContent>
                                    </MudMenu>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <MudTable Items="FilteredApps" Dense="true" Hover="true" Striped="true" Bordered="true">
                            <HeaderContent>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Application Name</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Type</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Department</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Category</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">SubCategory</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white; width:80px;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><b>@context.FullName</b></MudTd>
                                <MudTd>@context.Type</MudTd>
                                <MudTd>@context.Department</MudTd>
                                <MudTd>@context.Category</MudTd>
                                <MudTd>@context.SubCategory</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Launch" Color="Color.Primary"
                                                   OnClick="@(() => HandleGoClick(context))"
                                                   aria-label="@($"Open {context.FullName}")" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<style>
