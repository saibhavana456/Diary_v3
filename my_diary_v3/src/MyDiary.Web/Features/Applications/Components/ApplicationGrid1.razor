@code {
    private List<AppModel> _allApps = new();
    private string SelectedType { get; set; } = "All";
    private string SelectedDept { get; set; } = "All";
    private string SelectedCat { get; set; } = "All";
    private string SelectedUsefulSub { get; set; } = "All";
    private string _activeFilter = "All";
    private string _searchText = "";
    private string? _userIdf;
    private string? _pwdf;
    private string _inHouseSubFilter = "All";
    private string _viewMode = "Grid";
    private bool _isLoading = true;
    private string? _loadError;

    private string GetButtonClass(string mode) => _activeFilter == mode ? "tab-btn active" : "tab-btn";

    private Dictionary<string, object> AriaBtn(string mode) => new()
    {
        ["aria-current"] = _activeFilter == mode ? "true" : "false"
    };

    private void SetFilterMode(string mode)
    {
        _activeFilter = mode;
        SelectedType = "All";
        SelectedDept = "All";
        SelectedCat = "All";
        SelectedUsefulSub = "All";
        _inHouseSubFilter = "All";
        _searchText = "";
        StateHasChanged();
    }

    private IEnumerable<AppModel> FilteredApps
    {
        get
        {
            if (_allApps == null) return Enumerable.Empty<AppModel>();
            var query = _allApps.AsEnumerable();

            // Handle Standard Logic
            if (_activeFilter == "Type" && SelectedType != "All") query = query.Where(x => x.Type == SelectedType);
            else if (_activeFilter == "Department" && SelectedDept != "All") query = query.Where(x => x.Department == SelectedDept);
            else if (_activeFilter == "Category" && SelectedCat != "All") query = query.Where(x => x.Category == SelectedCat);

            // Handle Tag-based InHouse Logic
            else if (_activeFilter == "InHouse Software")
            {
                query = query.Where(x => x.AppAccessTag.Contains("In-house Software", StringComparison.OrdinalIgnoreCase));

                if (_inHouseSubFilter == "SSO")
                    query = query.Where(x => x.SSOFlag == "Y");
                else if (_inHouseSubFilter == "Non-SSO")
                    query = query.Where(x => x.SSOFlag != "Y");
            }
            else if (_activeFilter == "Fast Access")
                query = query.Where(x => x.AppAccessTag.Contains("Fast Access", StringComparison.OrdinalIgnoreCase));
            else if (_activeFilter == "Useful Links")
            {
                query = query.Where(x => x.AppAccessTag.Contains("Useful Links", StringComparison.OrdinalIgnoreCase));
                if (SelectedUsefulSub != "All")
                {
                    query = query.Where(x => x.AppAccessTag.Contains($"{SelectedUsefulSub}", StringComparison.OrdinalIgnoreCase));
                }
            }

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                query = query.Where(x => x.ShortName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                                       x.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderBy(x => x.ShortName);
        }
    }

    private IEnumerable<string> GetUsefulSubCategories()
    {
        var subs = new List<string>();
        if (_allApps == null) return subs;

        foreach (var app in _allApps)
        {
            if (string.IsNullOrWhiteSpace(app.AppAccessTag)) continue;
            var parts = app.AppAccessTag.Split('|', StringSplitOptions.TrimEntries).ToList();
            int index = parts.FindIndex(p => p.Equals("Useful Links", StringComparison.OrdinalIgnoreCase));
            if (index != -1 && index + 1 < parts.Count)
            {
                subs.Add(parts[index + 1]);
            }
        }
        return subs.Distinct().OrderBy(x => x);
    }

    private IEnumerable<string> GetFilteredDepartments() => _allApps?.Select(x => x.Department).Distinct().OrderBy(x => x) ?? Enumerable.Empty<string>();
    private IEnumerable<string> GetFilteredCategories() => _allApps?.Select(x => x.Category).Distinct().OrderBy(x => x) ?? Enumerable.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        _allApps = new List<AppModel>();
        try
        {
            _isLoading = true;
            _loadError = null;

            using var con = new OracleConnection(Configuration.GetConnectionString("MyDiaryDBConnection"));
            await con.OpenAsync();
            using var cmd = new OracleCommand("SELECT * FROM APPLICATION_LIST ORDER BY APP_NAME", con);
            using var r = await cmd.ExecuteReaderAsync();
            while (await r.ReadAsync())
            {
                _allApps.Add(new AppModel
                    {
                        FullName = r["APP_NAME"]?.ToString()?.Trim() ?? "",
                        //Type = r["APP_TYPE"]?.ToString() ?? "",
                        Type = !string.IsNullOrWhiteSpace(r["APP_TYPE"]?.ToString()) ?
                                            r["APP_TYPE"]!.ToString() : "Others",
                        //Department = r["APP_BUSINESS_OWNER_DEPT_NAME"]?.ToString() ?? "",
                        //Category = r["APP_CATEGORY"]?.ToString() ?? "",
                        Department = !string.IsNullOrWhiteSpace(r["APP_BUSINESS_OWNER_DEPT_NAME"]?.ToString())
                                           ? r["APP_BUSINESS_OWNER_DEPT_NAME"]!.ToString()
                                           : (r["APP_SHORT_NAME"]?.ToString()?
                                                  .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                  .FirstOrDefault() ?? ""),
                        Category = !string.IsNullOrWhiteSpace(r["APP_CATEGORY"]?.ToString())
                                   ? r["APP_CATEGORY"]!.ToString()
                                   : !string.IsNullOrWhiteSpace(r["APP_BUSINESS_OWNER_DEPT_NAME"]?.ToString())
                                       ? r["APP_BUSINESS_OWNER_DEPT_NAME"]!.ToString()
                                       : (r["APP_SHORT_NAME"]?.ToString()?
                                              .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                              .FirstOrDefault() ?? ""),
                        SubCategory = !string.IsNullOrWhiteSpace(r["APP_SUBCATEGORY"]?.ToString())
                                       ? r["APP_SUBCATEGORY"]!.ToString()
                                       : !string.IsNullOrWhiteSpace(r["APP_BUSINESS_OWNER_DEPT_NAME"]?.ToString())
                                           ? r["APP_BUSINESS_OWNER_DEPT_NAME"]!.ToString()
                                           : (r["APP_SHORT_NAME"]?.ToString()?
                                                  .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                  .FirstOrDefault() ?? ""),
                        ShortName = r["APP_SHORT_NAME"]?.ToString()?.Trim() ?? "",
                        LoginUrl = r["APP_URL"]?.ToString() ?? "",
                        Description = !string.IsNullOrWhiteSpace(GetString(r["APP_BRIEF"]))
                                    ? GetString(r["APP_BRIEF"])
                                    : GenerateBrief(
                                        GetString(r["APP_SHORT_NAME"]),
                                        GetString(r["APP_CATEGORY"]),
                                        GetString(r["APP_BUSINESS_OWNER_DEPT_NAME"]),
                                        GetString(r["APP_TYPE"])
                                      ),
                        AppAccessTag = r["APP_ACCESS_TAG"]?.ToString() ?? "",
                        SSOFlag = r["APP_SSO_LOGIN_FLG"]?.ToString() ?? "",
                        IOSStoreUrl = r["APP_IOS_URL"]?.ToString() ?? ""
                        // IconName = r["ICON_NAME"]?.ToString() ?? ""
                    });

                _allApps = _allApps.OrderBy(x => x.FullName).ToList();
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "ApplicationGrid1: failed to load applications");
            _loadError = UserFacingError.Generic;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetString(object value) => value == null || value is DBNull ? "" : (value.ToString()?.Trim() ?? "");

    private static string FirstWord(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        var first = input.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return first ?? "";
    }

    private static string GenerateBrief(string shortName, string category, string dept, string type)
    {
        var sentences = new List<string>();
        if (!string.IsNullOrWhiteSpace(shortName) && !string.IsNullOrWhiteSpace(type))
            sentences.Add($"{shortName} is a {type} application used across the organization.");
        else if (!string.IsNullOrWhiteSpace(shortName))
            sentences.Add($"{shortName} is an application used across the organization.");
        else if (!string.IsNullOrWhiteSpace(type))
            sentences.Add($"This is a {type} application used across the organization.");
        else
            sentences.Add("This application supports business needs across the organization.");

        if (!string.IsNullOrWhiteSpace(category))
            sentences.Add($"It focuses on {category} to support day-to-day operations.");
        else
            sentences.Add("It supports common business processes and daily operations.");

        if (!string.IsNullOrWhiteSpace(dept))
            sentences.Add($"The {dept} team oversees ownership and provides guidance and support.");
        else
            sentences.Add("Ownership and support are provided by the responsible business team.");

        sentences.Add("Designed for reliability and ease of use, it helps standardize workflows, improve efficiency, and deliver consistent outcomes for employees and stakeholders.");
        return string.Join(" ", sentences);
    }

