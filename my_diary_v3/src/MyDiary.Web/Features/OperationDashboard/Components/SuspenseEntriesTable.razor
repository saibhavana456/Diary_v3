@using System.Data
@using MyDiary.Web.Core.Extensions
@using MyDiary.Web.Features.OperationDashboard.Models
@using MyDiary.Web.Features.OperationDashboard.Services

<div class="card mb-2 shadow-sm">
    <div class="card-header text-white py-1 px-2"
         style="min-height:28px;
            background: #1E3A8A;">
        <h6 class="mb-0" style="font-size:13px;">Suspense Entries</h6>
    </div>

    <div class="card-body p-1">
        @if (isLoading)
        {
            <div class="p-2 text-center">
                <div class="spinner-border text-primary" style="width:18px;height:18px;"></div>
            </div>
        }
        else if (data == null || hasError)
        {
            <div class="p-3 text-center text-muted small">
                <i class="fa-solid fa-folder-open mb-1"></i><br />
                <strong>No record present currently.</strong>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0 text-center align-middle compact-table">

                    <thead>
                        <tr>
                            <th colspan="2">Previous Month</th>
                            <th colspan="2">Previous Day</th>
                            <th colspan="2" class="text-primary">Present Day</th>
                        </tr>

                        <tr>
                            <th colspan="2">
                                <small>(@data.PrevMonthDt.ToString("dd/MM/yyyy"))</small>
                            </th>
                            <th colspan="2">
                                <small>(@data.PrevDay2Dt.ToString("dd/MM/yyyy"))</small>
                            </th>
                            <th colspan="2" class="text-primary">
                                <small>(@data.PrevDayDt.ToString("dd/MM/yyyy"))</small>
                            </th>
                        </tr>

                        <tr class="bg-light">
                            <th>No.</th>
                            <th>Amt</th>
                            <th>No.</th>
                            <th>Amt</th>
                            <th>No.</th>
                            <th>Amt</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>@data.PrevMonthEntries.ToString("N0")</td>
                            <td>@data.PrevMonthTotal.ToString("N2")</td>

                            <td>@data.PrevDay2Entries.ToString("N0")</td>
                            <td>@data.PrevDay2Total.ToString("N2")</td>

                            <td class="bg-light fw-bold">@data.PrevDayEntries.ToString("N0")</td>
                            <td class="bg-light fw-bold">@data.PrevDayTotal.ToString("N2")</td>
                        </tr>

                        <tr>
                            <td colspan="4" class="text-end text-muted small">90 Days:</td>
                            <td class="text-danger">@data.PrevDayEntries90Days.ToString("N0")</td>
                            <td class="text-danger">@data.PrevDayTotal90Days.ToString("N2")</td>
                        </tr>

                        <tr>
                            <td colspan="4" class="text-end text-muted small">180 Days:</td>
                            <td class="text-danger">@data.PrevDayEntries180Days.ToString("N0")</td>
                            <td class="text-danger">@data.PrevDayTotal180Days.ToString("N2")</td>
                        </tr>

                        <tr class="table-warning">
                            <td colspan="4" class="text-end fw-bold small">Var:</td>
                            <td>@RenderVariation(data.PrevDayEntries, data.PrevDay2Entries, "N0")</td>
                            <td>@RenderVariation(data.PrevDayTotal, data.PrevDay2Total, "N2")</td>
                        </tr>
                    </tbody>

                </table>
            </div>
        }
    </div>
</div>

<style>
    .compact-table {
        font-size: 10.5px;
        border-collapse: collapse;
    }

        .compact-table th,
        .compact-table td {
            padding: 2px 4px !important;
            line-height: 1 !important;
            height: 18px !important;
            min-height: 18px !important;
        }

        .compact-table thead th {
            font-size: 10px;
        }

        .compact-table small {
            font-size: 9px;
        }
</style>

@code {
    [Parameter] public DataSet DashboardData { get; set; }

    private bool isLoading = true;
    private bool hasError = false;
    private SuspenseOSReportDto data;

    protected override void OnParametersSet()
    {
        isLoading = true;
        hasError = false;

        try
        {
            if (DashboardData != null)
            {
                data = ExtractSuspense(DashboardData);
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[SuspenseEntriesTable] Error: " + ex.Message);
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private SuspenseOSReportDto ExtractSuspense(DataSet ds)
    {
        foreach (DataTable table in ds.Tables)
        {
            if (table.Rows.Count > 0 && table.Columns.Contains("TableName"))
            {
                var row = table.Rows[0];

                if (row["TableName"]?.ToString() == "SuspenseOSReport")
                {
                    return new SuspenseOSReportDto
                        {
                            PrevDayDt = Convert.ToDateTime(row["PrevDayDt"]),
                            PrevDayEntries = Convert.ToInt32(row["PrevDayEntries"]),
                            PrevDayTotal = Convert.ToDecimal(row["PrevDayTotal"]),

                            PrevDayEntries90Days = Convert.ToInt32(row["PrevDayEntries90Days"]),
                            PrevDayTotal90Days = Convert.ToDecimal(row["PrevDayTotal90Days"]),

                            PrevDayEntries180Days = Convert.ToInt32(row["PrevDayEntries180Days"]),
                            PrevDayTotal180Days = Convert.ToDecimal(row["PrevDayTotal180Days"]),

                            PrevDay2Dt = Convert.ToDateTime(row["PrevDay2Dt"]),
                            PrevDay2Entries = Convert.ToInt32(row["PrevDay2Entries"]),
                            PrevDay2Total = Convert.ToDecimal(row["PrevDay2Total"]),

                            PrevMonthDt = Convert.ToDateTime(row["PrevMonthDt"]),
                            PrevMonthEntries = Convert.ToInt32(row["PrevMonthEntries"]),
                            PrevMonthTotal = Convert.ToDecimal(row["PrevMonthTotal"]),

                            TableName = "SuspenseOSReport"
                        };
                }
            }
        }

        return null;
    }

    private RenderFragment RenderVariation(decimal current, decimal previous, string format) => __builder =>
    {
        var metrics = VariationMetrics.Calculate(current, previous);

        string colorClass = metrics.AbsoluteChange <= 0 ? "text-success" : "text-danger";
        string sign = metrics.AbsoluteChange > 0 ? "+" : "";

        <span class="@colorClass fw-bold small">
            @sign@metrics.AbsoluteChange.ToString(format)
        </span>
        ;
    };
}