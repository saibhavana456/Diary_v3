@using System.Data
@using MyDiary.Web.Core.Extensions
@using MyDiary.Web.Features.Focus360.Models

<div class="f360-ops-panel">
    <div class="f360-ops-subheader" style="background:#204060;color:#fff;font-weight:700;">
        Customer Complaints
    </div>

    @if (_error)
    {
        <div class="pa-2" role="alert"><small class="text-warning">Data unavailable for this panel.</small></div>
    }
    else if (_data == null)
    {
        <div class="text-center pa-2"><small class="text-muted">No data available</small></div>
    }
    else
    {
        <table class="f360-ops-table">
            <thead>
                <tr style="background:#c6e0b4;">
                    <th></th>
                    <th>Previous Month<br/><small>(@_data.PrevMonthDt)</small></th>
                    <th>Previous Day<br/><small>(@_data.PrevDayDt)</small></th>
                    <th class="today-col">Present Day<br/><small>(@_data.TodayDt)</small></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="lbl">Number of Complaints</td>
                    <td>@FmtD(_data.ComplaintsPrevMonth)</td>
                    <td>@FmtD(_data.ComplaintsPrevDay)</td>
                    <td class="today-col fw-bold">@FmtD(_data.ComplaintsToday)</td>
                </tr>
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public DataSet? DashboardData { get; set; }

    private F360CustomerComplaintsModel? _data;
    private bool _error;

    protected override void OnParametersSet()
    {
        if (DashboardData == null) return;
        try { _data = Extract(DashboardData); _error = false; }
        catch (Exception ex) { AppLogger.LogError(ex, "[F360CustomerComplaintsPanel] Extract failed"); _error = true; }
    }

    private F360CustomerComplaintsModel? Extract(DataSet ds)
    {
        var m = new F360CustomerComplaintsModel();
        foreach (DataTable table in ds.Tables)
        {
            if (table.Rows.Count == 0 || !table.Columns.Contains("TableName")) continue;
            var name = table.Rows[0]["TableName"]?.ToString();
            var r = table.Rows[0];

            if (name == "BOComplaintReport")
            {
                m.PrevMonthDt = SafeDate(r, "PrevMonthDt");
                m.PrevDayDt = SafeDate(r, "PrevDay2Dt");
                m.TodayDt = SafeDate(r, "PrevDayDt");
                m.ComplaintsPrevMonth = SafeDec(r, "PrevMonthNoOfComplaints");
                m.ComplaintsPrevDay = SafeDec(r, "PrevDay2NoOfComplaints");
                m.ComplaintsToday = SafeDec(r, "PrevDayNoOfComplaints");
                break;
            }
        }
        return m;
    }

    private static string SafeDate(DataRow r, string col) { try { return r.Table.Columns.Contains(col) && r[col] != DBNull.Value ? Convert.ToDateTime(r[col]).ToString("dd/MM/yyyy") : "—"; } catch { return "—"; } }
    private static decimal SafeDec(DataRow r, string col) { try { return r.Table.Columns.Contains(col) && r[col] != DBNull.Value ? Convert.ToDecimal(r[col]) : 0m; } catch { return 0m; } }
    private static string FmtD(decimal v) => v.ToString("N2");
}
