                           OnClick="@GoToGold">GO</MudButton>
            </div>
        </div>
    </div>
</MudItem> *@
</MudGrid>

@code {
    private bool _handoverLoading = true;
    private ActiveChargeContextDto? _handoverContext;
    private string? _outgoingOfficer;
    private string? _incomingOfficer;
    private DateTime? _handoverDate;
    private string _handoverStatus = "—";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var employeeNo = user.FindFirst("emplid")?.Value ?? "";

            if (!string.IsNullOrEmpty(employeeNo))
            {
                _handoverContext = await ChargeReportService.GetActiveChargeForUserAsync(employeeNo);

                if (_handoverContext != null && _handoverContext.ReportID > 0)
                {
                    // Load Part A draft to get officer names and date
                    var partA = await ChargeReportService.LoadDraftPartAAsync(_handoverContext.ReportID ?? 0);
                    if (partA != null)
                    {
                        _outgoingOfficer = partA.OfficerName;
                        _incomingOfficer = partA.IncomingOfficerName;
                        _handoverDate = partA.DeclarationDate ?? partA.ChargeTakenDate;
                    }

                    // Determine status
                    if (_handoverContext.IsSubmitted && _handoverContext.IsTakenOver)
                        _handoverStatus = "Completed";
                    else if (_handoverContext.IsSubmitted && !_handoverContext.IsTakenOver)
                        _handoverStatus = "Pending Takeover (Part B)";
                    else if (!_handoverContext.IsSubmitted)
                        _handoverStatus = "Draft (Part A)";
                }
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "OthersModule: Failed to load handover/takeover summary");
        }
        finally
        {
            _handoverLoading = false;
        }
    }

    private async Task GoToHandoverTakeover()
    {
        var userId = await SessionStorage.GetAsync<string>("UserId") ?? "";
        var pwd = await SessionStorage.GetAsync<string>("Pwd") ?? "";

        var baseUrl = Configuration["ApiEndpoints:HandoverTakeoverUrl"] ?? "#";
        string finalUrl = baseUrl;

        if (!string.IsNullOrEmpty(userId))
        {
            string formattedDateTime = AppTime.Now.ToString("MM/dd/yyyy hh:mm:ss tt", CultureInfo.InvariantCulture);
            string plainText = $"{userId}|{pwd}|{formattedDateTime}";
            string ssoData = EncryptionService.EncryptStringAES(plainText);
            finalUrl = $"{baseUrl}?data={ssoData}";
        }

        await JS.InvokeVoidAsync("window.open", finalUrl, "_blank");
    }

    // private async Task GoToGold()
    // {
    //     Navigation.NavigateTo("MonthlyGoldSurpriseVisit");
    // }
}
