@using MudBlazor
@using System.Globalization
@using MyDiary.Web.Core.Extensions
@using MyDiary.Web.Features.Business.Models
@using MyDiary.Web.Features.Business.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject IConfiguration Configuration
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject MyDiary.Web.Core.Services.Storage.ISessionStorageService SessionStorage
@inject MyDiary.Web.Services.IEncryptionService EncryptionService
@inject NavigationManager Navigation
@inject IChargeReportService ChargeReportService
@inject AuthenticationStateProvider AuthStateProvider

<MudGrid GutterSize="24px">
    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex">
        <div class="app-card-btn" style="width:100%;">
            <div class="card-content-wrapper">
                <div class="d-flex align-start gap-4">
                    <div class="icon-badge">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Style="font-size:2rem; color:#2E7D32;" />
                    </div>
                    <div class="flex-grow-1">
                        <div class="card-title">Handover / Takeover</div>
                    </div>
                </div>
                <MudDivider Class="my-3" />
                <div style="font-size:0.85rem; color:#444; flex-grow:1;">
                    @if (_handoverLoading)
                    {
                        <div class="d-flex align-center gap-2">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span>Loading...</span>
                        </div>
                    }
                    else if (_handoverContext == null)
                    {
                        <div class="mb-1"><b>Last Handover Date:</b> —</div>
                        <div class="mb-1"><b>Outgoing Officer:</b> —</div>
                        <div class="mb-1"><b>Incoming Officer:</b> —</div>
                        <div class="mb-1"><b>Status:</b> —</div>
                    }
                    else
                    {
                        <div class="mb-1"><b>Last Handover Date:</b> @(_handoverDate?.ToString("dd-MMM-yyyy") ?? "—")</div>
                        <div class="mb-1"><b>Outgoing Officer:</b> @(_outgoingOfficer ?? "—")</div>
                        <div class="mb-1"><b>Incoming Officer:</b> @(_incomingOfficer ?? "—")</div>
                        <div class="mb-1"><b>Status:</b> @_handoverStatus</div>
                    }
                </div>
                <div class="d-flex justify-end mt-4">
                    <MudButton Class="rounded-pill px-4 go-btn-style"
                               EndIcon="@Icons.Material.Filled.ArrowRightAlt"
                               OnClick="@GoToHandoverTakeover">GO</MudButton>
                </div>
            </div>
        </div>
    </MudItem>
    @* <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex">
    <div class="app-card-btn" style="width:100%;">
        <div class="card-content-wrapper">
            <div class="d-flex align-start gap-4">
                <div class="icon-badge">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Style="font-size:2rem; color:#2E7D32;" />
                </div>
                <div class="flex-grow-1">
                    <div class="card-title">Monthly Gold Surprise Visit</div>
                </div>
            </div>
            <MudDivider Class="my-3" />
            <div style="font-size:0.85rem; color:#444; flex-grow:1;">
                <div class="mb-1"><b>Status:</b> View / Submit Monthly Report</div>
            </div>
            <div class="d-flex justify-end mt-4">
                <MudButton Class="rounded-pill px-4 go-btn-style"
