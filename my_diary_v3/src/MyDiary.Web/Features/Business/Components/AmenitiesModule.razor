@using MyDiary.Web.Core.Extensions
@using MudBlazor
@using MyDiary.Web.Features.Business.Models
@using MyDiary.Web.Features.Business.Services
@inject IAmenitiesService AmenitiesService

@if (_isLoading)
{
    <div class="d-flex justify-center pa-10">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Class="ml-3">Loading Amenities...</MudText>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else if (!_amenities.Any())
{
    @* Empty state — no amenities with both image and text *@
    <MudPaper Elevation="0" Class="pa-6">
        <div class="d-flex flex-column align-center justify-center text-center gap-3" style="min-height: 200px;">
            <MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" Size="Size.Large" Style="color: #94a3b8; font-size: 3rem;" />
            <MudText Typo="Typo.h6" Style="color: #334155; font-weight: 700;">No amenities available</MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b; max-width: 400px;">
                Amenities with photos have not been set up for this branch yet. Please visit the CSEC portal to add or update branch amenities.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Class="rounded-pill px-6 mt-2"
                       Style="background: linear-gradient(135deg, #1E3A8A 0%, #EF4444 100%); color: white; font-weight: 700;"
                       EndIcon="@Icons.Material.Filled.OpenInNew"
                       Href="@(_csecPortalUrl)"
                       Target="_blank">
                Go to CSEC Portal
            </MudButton>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Elevation="0" Class="pa-4">
        <div class="d-flex flex-column gap-3">
            @foreach (var amenity in _amenities)
            {
                <MudPaper Class="pa-0 rounded-lg overflow-hidden" Elevation="1"
                          Style="border: 1px solid #e2e8f0;">
                    <div class="d-flex" style="min-height: 100px;">

                        @* Left: text content *@
                        <div class="d-flex flex-column justify-center pa-4 flex-grow-1" style="min-width: 0;">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@(amenity.AgendaStatus?.Equals("Yes", StringComparison.OrdinalIgnoreCase) == true
                                                ? Icons.Material.Filled.CheckCircle
                                                : Icons.Material.Filled.Cancel)"
                                         Size="Size.Small"
                                         Style="@("color:" + GetStatusColor(amenity))" />
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Style="@(amenity.AgendaStatus?.Equals("Yes", StringComparison.OrdinalIgnoreCase) == true
                                                  ? "background: #dcfce7; color: #166534; font-weight: 600;"
                                                  : "background: #fee2e2; color: #991b1b; font-weight: 600;")">
                                    @(amenity.AgendaStatus?.Equals("Yes", StringComparison.OrdinalIgnoreCase) == true ? "Available" : "Unavailable")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.body1" Style="font-weight: 700; color: #1f2937; line-height: 1.4;">
                                @amenity.AgendaDescription
                            </MudText>
                        </div>

                        @* Right: fixed-size image thumbnail *@
                        <MudButton OnClick="@(() => OpenPreview(amenity))"
                                   Style="padding:0; margin:0; min-width:0; width:120px; flex-shrink:0; text-transform:none; display:flex; position:relative; overflow:hidden; background:#f1f5f9; border-radius:0; border-left:1px solid #e2e8f0;">
                            <img src="@amenity.PreviewBase64"
                                 alt="@amenity.AgendaDescription"
                                 style="width:120px; height:100%; object-fit:cover; display:block; min-height:100px;" />
                            <MudIcon Icon="@Icons.Material.Filled.ZoomIn"
                                     Size="Size.Small"
                                     Style="position:absolute; top:6px; right:6px; color:white; background:rgba(0,0,0,0.45); border-radius:50%; padding:3px; pointer-events:none;" />
                        </MudButton>
                    </div>
                </MudPaper>
            }
        </div>

        <MudDivider Class="my-4" />

        <div class="d-flex align-center justify-space-between pa-3 rounded-lg"
             style="background: #f1f5f9; border: 1px dashed #94a3b8;">
            <div>
                <MudText Typo="Typo.body2" Style="color: #334155; font-weight: 600;">
                    Manage branch amenities on the CSEC portal
                </MudText>
                <MudText Typo="Typo.caption" Style="color: #64748b;">
                    Update photos, add new amenities, or modify existing records.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       Size="MudBlazor.Size.Small"
                       Class="rounded-pill px-5"
                       Style="background: linear-gradient(135deg, #1E3A8A 0%, #EF4444 100%); color: white; font-weight: 700;"
                       EndIcon="@Icons.Material.Filled.OpenInNew"
                       Href="@(_csecPortalUrl)"
                       Target="_blank">
                Go
            </MudButton>
        </div>
    </MudPaper>
}

@* Image Preview Overlay *@
@* --- Image Preview Overlay (Refactored) --- *@
<MudOverlay Visible="@(_previewAmenity != null)"
            OnClick="ClosePreview"
            DarkBackground="true"
            AutoClose="true"
            ZIndex="9999"
            LockScroll="true"
            Style="backdrop-filter: blur(4px);">

    @* No stopPropagation needed; MudOverlay handles this automatically *@
    <div style="position:relative; max-width:90vw; max-height:90vh; display:flex; flex-direction:column; align-items:center;">

        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Medium"
                       Style="position:absolute; top:-48px; right:0; background:rgba(255,255,255,0.15); color:white; border:1px solid rgba(255,255,255,0.3); z-index:10001;"
                       OnClick="ClosePreview" />

        <img src="@_previewAmenity?.PreviewBase64"
             alt="@_previewAmenity?.AgendaDescription"
             style="max-width:100%; max-height:75vh; border-radius:12px; border: 2px solid rgba(255,255,255,0.2); box-shadow: 0 8px 32px rgba(0,0,0,0.6);" />

        <div style="margin-top:16px; text-align:center;">
            <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:700;">
                @_previewAmenity?.AgendaDescription
            </MudText>
            @if (_previewAmenity != null)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Class="mt-2"
                         Style="@(_previewAmenity.AgendaStatus?.Equals("Yes", StringComparison.OrdinalIgnoreCase) == true
                                  ? "background: #dcfce7; color: #166534; font-weight: 600;"
                                  : "background: #fee2e2; color: #991b1b; font-weight: 600;")">
                    @(_previewAmenity.AgendaStatus?.Equals("Yes", StringComparison.OrdinalIgnoreCase) == true ? "Available" : "Unavailable")
                </MudChip>
            }
        </div>
    </div>
</MudOverlay>

@code {
    [Parameter] public string BranchCode { get; set; } = "812153";
    [Parameter] public string AgendaHeader { get; set; } = "Branch Ambience and amenities";

    private List<AmenityItem> _amenities = new();
    private bool _isLoading = true;
    private string? _error;
    private AmenityItem? _previewAmenity;
    private string _csecPortalUrl = "https://app4.unionbankofindia.co.in/csec/#/login"; // Need to fetch from app settings.

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _amenities = await AmenitiesService.GetAmenitiesAsync(BranchCode, AgendaHeader);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[AmenitiesModule] Error: " + ex.Message);
            _error = UserFacingError.Generic;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenPreview(AmenityItem amenity) => _previewAmenity = amenity;
    private void ClosePreview() => _previewAmenity = null;

    private string GetStatusColor(AmenityItem amenity)
    {
        return string.Equals(amenity.AgendaStatus, "Yes", StringComparison.OrdinalIgnoreCase)
            ? "#2E7D32"
            : "#C62828";
    }
}