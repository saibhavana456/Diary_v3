    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // ✅ Incoming Officer Name
            Model.OfficerName =
                user.FindFirst("employee_name")?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? "";

            // ✅ Employee No = PF Number
            Model.EmployeeNo =
                user.FindFirst("emplid")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? "";

            // ✅ Designation
            Model.Designation =
                user.FindFirst("employee_designation")?.Value
                ?? "";

            Model.BranchName =
    user.FindFirst("branch_name")?.Value ?? "";

            Model.RegionName =
                user.FindFirst("region_name")?.Value ?? "";

            Model.ZoneName =
                user.FindFirst("zone_name")?.Value ?? "";
        }

        // ✅ EXISTING INITIALIZATION (keep this)
        Model.Documents = new()
    {
        new() { DocumentName = "Book of RBI office’s specimen signature" },
        new() { DocumentName = "Lease deed – Branch Premises" },
        new() { DocumentName = "Lease deed – ATM (offsite) Premises" },
        new() { DocumentName = "Power of Attorney of all officers working in the branch" },
        new() { DocumentName = "Property Records in the name of the Bank" }
    };

        Model.CustomerComplaints = new();
        Model.ConsumerCases = new();
        Model.TimeBarredAccounts = new();
        Model.CapitalAssets = new();
        Model.SundryBalances = new();
        Model.GodownKeysVerification = new();
        Model.GoldDiscrepancies = new();
        Model.RandomJLDiscrepancies = new();
    }

    protected override void OnInitialized()
    {
        // ✅ SECTION 1 – Documents
        Model.Documents = new()
        {
