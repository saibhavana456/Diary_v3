    private async Task UploadGoldDiscrepanciesPdf(IBrowserFile file)
    {
        if (file == null || file.Size > 5 * 1024 * 1024)
            return;

        using var ms = new MemoryStream();
        await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);

        Model.GoldDiscrepanciesPdfFileName = file.Name;
        Model.GoldDiscrepanciesPdfContentType = file.ContentType;
        Model.GoldDiscrepanciesPdfData = ms.ToArray();
    }

    private async Task DownloadGoldDiscrepanciesPdf()
    {
        if (Model.GoldDiscrepanciesPdfData == null)
            return;

        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            Model.GoldDiscrepanciesPdfFileName ?? "Gold_Discrepancies.pdf",
            Model.GoldDiscrepanciesPdfContentType ?? "application/pdf",
            Convert.ToBase64String(Model.GoldDiscrepanciesPdfData)
        );
    }

