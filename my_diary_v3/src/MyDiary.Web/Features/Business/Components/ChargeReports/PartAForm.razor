        Model.KycPendingPdfContentType = file.ContentType;
        Model.KycPendingPdfData = ms.ToArray();
    }

    private async Task DownloadKycPendingPdf()
    {
        if (Model.KycPendingPdfData == null)
            return;

        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            Model.KycPendingPdfFileName ?? "KYC_Pending_Accounts.pdf",
            Model.KycPendingPdfContentType ?? "application/pdf",
            Convert.ToBase64String(Model.KycPendingPdfData)
        );
    }

