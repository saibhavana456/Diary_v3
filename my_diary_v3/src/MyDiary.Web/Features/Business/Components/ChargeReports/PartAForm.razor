    private async Task UploadReviewPendingPdf(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);

        Model.ReviewPendingPdfFileName = file.Name;
        Model.ReviewPendingPdfContentType = file.ContentType;
        Model.ReviewPendingPdfData = ms.ToArray();
    }

    private async Task DownloadReviewPendingPdf()
    {
        if (Model.ReviewPendingPdfData == null) return;

        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            Model.ReviewPendingPdfFileName,
            Model.ReviewPendingPdfContentType,
            Convert.ToBase64String(Model.ReviewPendingPdfData)
        );
    }


    private async Task UploadPartAPdf(IBrowserFile file)
    {
        try
        {
            if (file == null)
                return;

            if (file.Size > 5 * 1024 * 1024)
            {
                StatusMessageAdhoc = "File size exceeds 5 MB limit.";
                MessageColor = Color.Error;
                return;
            }

            using var ms = new MemoryStream();
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);

            Model.AdhocPdfFileName = file.Name;
            Model.AdhocPdfContentType = file.ContentType;
            Model.AdhocPdfData = ms.ToArray();

            UploadedFileName = file.Name;
            StatusMessageAdhoc = "PDF uploaded successfully.";
            MessageColor = Color.Success;
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[PartAForm] Unhandled error: " + ex.Message);
            StatusMessageAdhoc = "Error uploading PDF.";
            MessageColor = Color.Error;
        }
    }

    private async Task DownloadPartAPdf()
    {
        var bytes = PdfService.ExportPartAToPdf(Model);

        var fileName = $"HANDOVER_{Model.EmployeeNo}.pdf";

        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            fileName,
            "application/pdf",
            Convert.ToBase64String(bytes)
        );
    }

    private async Task FetchIncomingOfficerName()
    {
        Model.IncomingOfficerName = null;

        if (string.IsNullOrWhiteSpace(Model.IncomingEmployeeNo))
            return;

        var name = await ChargeReportService
                        .GetStaffNameByEmplIdAsync(Model.IncomingEmployeeNo.Trim());

        Model.IncomingOfficerName = name;
    }

    private async Task FetchFirstKeyHolderName()
    {
        Model.FirstKeyHolderName = null;

        if (string.IsNullOrWhiteSpace(Model.FirstKeyHolder))
            return;

        var name = await ChargeReportService
                        .GetStaffNameByEmplIdAsync(Model.FirstKeyHolder.Trim());

        Model.FirstKeyHolderName = name;
    }

    private async Task FetchSecondKeyHolderName()
    {
        Model.SecondKeyHolderName = null;

        if (string.IsNullOrWhiteSpace(Model.SecondKeyHolder))
            return;

        var name = await ChargeReportService
                        .GetStaffNameByEmplIdAsync(Model.SecondKeyHolder.Trim());

        Model.SecondKeyHolderName = name;
    }

    private async Task FetchRelievedByName()
    {
        Model.RelievedByName = null;

        if (string.IsNullOrWhiteSpace(Model.RelievedBy))
            return;

        var name = await ChargeReportService
                        .GetStaffNameByEmplIdAsync(Model.RelievedBy.Trim());

        Model.RelievedByName = name;
    }

    protected override Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Model.AdhocPdfFileName))
        {
            UploadedFileName = Model.AdhocPdfFileName;
            StatusMessageAdhoc = IsDisabled
                ? "PDF uploaded (read-only)"
                : "PDF already uploaded";
            MessageColor = Color.Info;
        }

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // ✅ Employee Name
            Model.OfficerName =
                user.FindFirst("employee_name")?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? "";

            Model.OutgoingOfficerSignature =
            user.FindFirst("employee_name")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? "";

            // ✅ Employee No = PF Number
            Model.EmployeeNo =
                user.FindFirst("emplid")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? "";

            // ✅ Designation
            Model.Designation =
                user.FindFirst("employee_designation")?.Value
                ?? "";

            Model.BranchName =
    user.FindFirst("branch_name")?.Value ?? "";

            Model.RegionName =
                user.FindFirst("region_name")?.Value ?? "";

            Model.ZoneName =
                user.FindFirst("zone_name")?.Value ?? "";

        }
    }
