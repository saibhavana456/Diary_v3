    // Dynamic Scope Updater
    private void UpdateScopeVariables()
    {
        // This dynamically updates the variables used by all your API fetch calls!
        if (!string.IsNullOrEmpty(_selectedBranch))
        {
            _userRole = "BRANCH";
            _brSolid = _selectedBranch;
            _regionSolid = _selectedRegion;
            _zoneSolid = _selectedZone;
        }
        else if (!string.IsNullOrEmpty(_selectedRegion))
        {
            _userRole = "REGION";
            _brSolid = null;
            _regionSolid = _selectedRegion;
            _zoneSolid = _selectedZone;
        }
        else if (!string.IsNullOrEmpty(_selectedZone))
        {
            _userRole = "ZONE";
            _brSolid = null;
            _regionSolid = null;
            _zoneSolid = _selectedZone;
        }
        else
        {
            _userRole = "CO";
            _brSolid = null;
            _regionSolid = null;
            _zoneSolid = null;
        }
    }

    // Dropdown Change Events
    private async Task OnZoneChangedAsync(string newValue)
    {
        _selectedZone = newValue;
        _selectedRegion = null;
        _selectedBranch = null;
        _regions.Clear();
        _branches.Clear();

        if (!string.IsNullOrEmpty(_selectedZone))
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);

        await LoadDashboardDataAsync();
    }

    private async Task OnRegionChangedAsync(string newValue)
    {
        _selectedRegion = newValue;
        _selectedBranch = null;
        _branches.Clear();

        if (!string.IsNullOrEmpty(_selectedRegion))
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);

        await LoadDashboardDataAsync();
    }

    private async Task OnBranchChangedAsync(string newValue)
    {
        _selectedBranch = newValue;
        await LoadDashboardDataAsync();
    }
    private async Task LoadDashboardDataAsync()
    {
        // FIRST: Calculate what parameters the DB needs based on the dropdowns
        UpdateScopeVariables();

        _chartKey = Guid.NewGuid();

        await LoadAllGraphs();

        StateHasChanged(); // Force UI redraw after new data arrives
    }
