    private async Task UpdateDashboard(string subCategory)
    {
        ActiveSubCategory = subCategory;

        if (subCategory == "Total Advances")
        {
            _selectedKpi = _kpiList.FirstOrDefault(x => x.ParameterName == "GROSS ADVANCE");
            CalculatePortfolioForTotalAdvances();
        }
        else
        {
            List<string> targetParams = new();
            if (subCategory == "Retail") targetParams = _retailParams;
            else if (subCategory == "MSME") targetParams = _msmeParams;
            else if (subCategory == "Agriculture") targetParams = _agriParams;
            else if (subCategory == "Corporate Loans") targetParams = _corporateParams;

            _selectedKpi = AggregateKpiData(targetParams);
            CalculatePortfolioForSubCategory(targetParams);
        }

        CalculateOutstandingBook();
        EnsurePlaceholderData();
        await InvokeAsync(StateHasChanged);
        if (_donutChart != null) await _donutChart.UpdateSeriesAsync(true);
        if (_barChart != null) await _barChart.UpdateSeriesAsync(true);
        if (_growthChart != null) await _growthChart.UpdateSeriesAsync(true);
    }

    private KpiItem? AggregateKpiData(List<string> paramNames)
    {
        var items = _kpiList.Where(k => k.ParameterName != null && paramNames.Contains(k.ParameterName.Trim())).ToList();
        if (!items.Any()) return null;
        var t = items.First();
        return new KpiItem
        {
            ActualAsOnDate = items.Sum(x => x.ActualAsOnDate),
            TargetNextMar = items.Sum(x => x.TargetNextMar),
            KPIDate = t.KPIDate,
            NextFYDt = t.NextFYDt,
            LastFYDt = t.LastFYDt,
            LastToLastFYDt = t.LastToLastFYDt,
            ActualLastFY = items.Sum(x => x.ActualLastFY),
            ActualLastQtr = items.Sum(x => x.ActualLastQtr),
            ActualLastToLastFY = items.Sum(x => x.ActualLastToLastFY)
        };
    }

    private void CalculatePortfolioForTotalAdvances()
    {
        decimal GetCr(List<string> p) => Math.Round(_kpiList.Where(k => k.ParameterName != null && p.Contains(k.ParameterName.Trim())).Sum(x => x.ActualAsOnDate) / 10000000m, 2);
        decimal r = GetCr(_retailParams), m = GetCr(_msmeParams), a = GetCr(_agriParams);
        decimal g = Math.Round((_selectedKpi?.ActualAsOnDate ?? 0) / 10000000m, 2);
        _portfolioData = new List<PortfolioItem> {
            new() { Category = "Retail", AmountInCrores = r },
            new() { Category = "MSME", AmountInCrores = m },
            new() { Category = "Agriculture", AmountInCrores = a },
            new() { Category = "Corporate", AmountInCrores = Math.Max(0, g - (r + m + a)) }
        };
    }

    private void CalculatePortfolioForSubCategory(List<string> p)
    {
        _portfolioData = _kpiList
            .Where(k => k.ParameterName != null && p.Contains(k.ParameterName.Trim()))
            .Select(i => new PortfolioItem { Category = i.ParameterName, AmountInCrores = Math.Round(i.ActualAsOnDate / 10000000m, 2) })
            .ToList();
    }

    private void CalculateOutstandingBook()
    {
        if (_selectedKpi == null) return;
        decimal Cr(decimal? v) => Math.Round((v ?? 0) / 10000000m, 2);
        _outstandingData = new List<OutstandingItem> {
            new() { Label = _selectedKpi.LastToLastFYDt.ToString("dd-MMM-yy"), AmountInCrores = Cr(_selectedKpi.ActualLastToLastFY) },
            new() { Label = _selectedKpi.LastFYDt.ToString("dd-MMM-yy"), AmountInCrores = Cr(_selectedKpi.ActualLastFY) },
            new() { Label = "LQ " + _selectedKpi.LastFYDt.ToString("dd-MMM-yy"), AmountInCrores = Cr(_selectedKpi.ActualLastQtr) },
            new() { Label = _selectedKpi.KPIDate.ToString("dd-MMM-yy"), AmountInCrores = Cr(_selectedKpi.ActualAsOnDate) }
        };
    }

    private string FormatIndianNumber(decimal? v) => ((v ?? 0) / 10000000m).ToString("N2", _indianCulture);
    private double GetProgressValue() => _selectedKpi?.TargetNextMar > 0 ? (double)((_selectedKpi.ActualAsOnDate / _selectedKpi.TargetNextMar) * 100) : 0;

