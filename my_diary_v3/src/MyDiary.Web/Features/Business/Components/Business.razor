@code {
    private string ActiveCategory { get; set; } = "Advances";
    private string ActiveSubCategory { get; set; } = "Total Advances";
    private string? _loadError;

    private List<string> _categories = new() { "Advances", "Deposits", "NPA", "Profitability", "Staff Details", "IT Assets", /* "ATM/CRM", */ "Amenities"/* , "Advances Bifurcation" */, "Assurance Function", "Others" };
    private List<string> _subCategories = new() { "Total Advances", "Retail", "MSME", "Agriculture", "Corporate Loans" };

    private async Task OpenQlikLink(string configKey)
    {
        var url = Configuration[$"QlikLinks:{configKey}"] ?? "";
        if (string.IsNullOrEmpty(url)) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await QlikNavService.NavigateAsync(userId, url);
    }

    private Task OpenQlikFeeBaseIncome() => OpenQlikLink("FeeBaseIncome");
    private Task OpenQlikOtherCoreFeeIncome() => OpenQlikLink("OtherCoreFeeIncome");
    private Task OpenQlikMiscIncome() => OpenQlikLink("MiscIncome");
    private Task OpenQlikRemainingIncome() => OpenQlikLink("RemainingIncome");

    // Categories that use the KPI sub-category row
    private readonly HashSet<string> _kpiCategories = new() { "Advances", "Deposits", "NPA", "Profitability" };

    private readonly Dictionary<string, List<string>> _subCategoryMap = new()
    {
        { "Advances",      new() { "Total Advances", "Retail", "MSME", "Agriculture", "Corporate Loans" } },
        { "Deposits",      new() { "Total Deposits", "Term Deposits", "Savings", "Current" } },
        { "NPA",           new() { "Total NPA" } },
        { "Profitability", new() { "Income", "Expense", "Fee Based Income (Others Core)" }}
    };

    private List<KpiItem> _kpiList = new();
    private KpiItem? _selectedKpi;
    private string _currentSolId = "00000";
    private bool _isLoading = true;
    private bool _rolesLoaded = false;
    private bool _graphsLoaded = false;
    private CultureInfo _indianCulture = new CultureInfo("en-IN");

    private ApexChart<PortfolioItem>? _donutChart;
    private ApexChart<OutstandingItem>? _barChart;
    private ApexChart<OutstandingItem>? _growthChart;

    private List<PortfolioItem> _portfolioData = new();
    private List<OutstandingItem> _outstandingData = new();

    private readonly List<string> _retailParams = new() { "UNION MILES", "UNION MORTGAGE", "UNION HOME" };
    private readonly List<string> _msmeParams = new() { "SMALL ADVANCES", "MICRO ADVANCES", "MEDIUM ADVANCES" };
