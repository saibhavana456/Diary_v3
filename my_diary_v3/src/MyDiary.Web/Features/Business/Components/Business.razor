    protected override async Task OnInitializedAsync()
    {
        // Read user claims for staff data API
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("Role")?.Value ?? "";
            _brSolid = user.FindFirst("br_solid")?.Value ?? "";
            _regionSolid = user.FindFirst("region_solid")?.Value ?? "";
            _zoneSolid = user.FindFirst("zone_solid")?.Value ?? "";
            _branchCode = user.FindFirst("branch_code")?.Value ?? "";
            _regionCode = user.FindFirst("region_code")?.Value ?? "";
            _zoneCode = user.FindFirst("zone_code")?.Value ?? "";
        }

        #region Filters
        // 1. Fetch Master List of Zones
        _zones = await LandingDashboardService.GetZonesAsync();

        _loggedInRole = user.FindFirst(ClaimTypes.Role)?.Value?.ToUpper() ?? user.FindFirst("Role")?.Value?.ToUpper() ?? "CO";
        _loggedInZoneSolid = user.FindFirst("zone_solid")?.Value;
        _loggedInRegionSolid = user.FindFirst("region_solid")?.Value;
        _loggedInBranchSolid = user.FindFirst("branch_solid")?.Value;

        // 2. Apply Role-Based Security Rules
        if (_loggedInRole == "ZONE")
        {
            _selectedZone = _loggedInZoneSolid;
            _isZoneDisabled = true;
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
        }
        else if (_loggedInRole == "REGION")
        {
            _selectedZone = _loggedInZoneSolid;
            _selectedRegion = _loggedInRegionSolid;
            _isZoneDisabled = true;
            _isRegionDisabled = true;
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
        }
        else if (_loggedInRole == "BRANCH")
        {
            _selectedZone = _loggedInZoneSolid;
            _selectedRegion = _loggedInRegionSolid;
            _selectedBranch = _loggedInBranchSolid;
            _isZoneDisabled = true;
            _isRegionDisabled = true;
            _isBranchDisabled = true;
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
        }

        // Show Branch Profile only for branch users
        if (_loggedInRole == "BRANCH")
        {
            _categories.Add("Branch Profile");
        }
        _rolesLoaded = true;

        // 3. Load the Dashboard for the first time
        await LoadDashboardDataAsync();
        #endregion

        // Parse ?tab= parameter FIRST so the correct tab renders immediately
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tabParam = query["tab"];
        if (!string.IsNullOrEmpty(tabParam))
        {
            if (tabParam.Equals("BranchMgmt", StringComparison.OrdinalIgnoreCase))
            {
                ActiveCategory = "Branch Profile";
                _subCategories = new();
                _isLoading = false;
                return;
            }

            if (tabParam.Equals("staffdetails", StringComparison.OrdinalIgnoreCase))
            {
                ActiveCategory = "Staff Details";
                _subCategories = new();
                _isLoading = false;
                return;
            }
            else
            {
                var match = _categories.FirstOrDefault(c => c.Replace(" ", "").Replace("/", "").Equals(tabParam, StringComparison.OrdinalIgnoreCase));
                if (match != null && _moduleCategories.Contains(match))
                {
                    ActiveCategory = match;
                    _subCategories = new();
                    _isLoading = false;
                    return;
                }
            }
        }

        try
        {
            await LoadAllGraphs();
            _graphsLoaded = true;
            await LoadKpiData();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"Error loading dashboard data: {ex.Message}");
            _isLoading = false;
            _loadError = "An error occurred while loading dashboard data.";
        }
    }

    private string _srAnnouncement = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Enhance MudSelect dropdowns for screen reader accessibility
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    var observer = new MutationObserver(function(mutations) {
                        var popovers = document.querySelectorAll('.zone-dropdown-popover .mud-list, .region-dropdown-popover .mud-list, .branch-dropdown-popover .mud-list');
                        popovers.forEach(function(list) {
                            if (!list.getAttribute('role')) {
                                list.setAttribute('role', 'listbox');
                            }
                            list.querySelectorAll('.mud-list-item').forEach(function(item) {
                                if (!item.getAttribute('role')) {
                                    item.setAttribute('role', 'option');
                                }
                            });
                        });
                    });
                    observer.observe(document.body, { childList: true, subtree: true });
                })()
            ");
        }
    }

    private async void OnCategoryChanged(string category)
    {
        try
        {
            ActiveCategory = category;
            _srAnnouncement = $"{category} section loaded.";
            StateHasChanged();

            if (category == "Staff Details")
            {
                _subCategories = new();
                StateHasChanged();
                return;
            }

            // Module card tabs — no sub-categories, no KPI loading needed
            if (_moduleCategories.Contains(category))
            {
                _subCategories = new();
                StateHasChanged();
                return;
            }

            _subCategories = _subCategoryMap.ContainsKey(category) ? _subCategoryMap[category] : new();
            if (_subCategories.Any())
            {
                if (!_graphsLoaded)
                {
                    _isLoading = true;
                    StateHasChanged();
                    await LoadAllGraphs();
                    await LoadKpiData();
                    _graphsLoaded = true;
                }
                else
                {
                    await UpdateDashboard(_subCategories.First());
                }
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"Error switching category: {ex.Message}");
            _isLoading = false;
            _loadError = "An error occurred while loading data. Please try again.";
            StateHasChanged();
        }
    }

