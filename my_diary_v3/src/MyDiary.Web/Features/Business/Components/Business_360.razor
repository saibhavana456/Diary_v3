    private string _srAnnouncement = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Enhance MudSelect dropdowns for JAWS screen reader accessibility.
            // MudSelect renders its dropdown in MudPopoverProvider (top of DOM).
            // We add role="combobox" to the input so JAWS uses arrow keys (not Tab) to navigate options.
            // This is the correct ARIA combobox interaction pattern.
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    function enhanceMudSelects() {
                        var selects = document.querySelectorAll('.a11y-combobox');
                        selects.forEach(function(wrapper) {
                            var input = wrapper.querySelector('input.mud-input-slot') || wrapper.querySelector('input') || wrapper.querySelector('.mud-select-input');
                            if (input && !input.dataset.a11yEnhanced) {
                                input.setAttribute('role', 'combobox');
                                input.setAttribute('aria-haspopup', 'listbox');
                                input.setAttribute('aria-autocomplete', 'list');
                                input.setAttribute('aria-expanded', 'false');
                                input.dataset.a11yEnhanced = 'true';

                                var label = wrapper.querySelector('label');
                                if (label) {
                                    input.setAttribute('aria-label', label.textContent.trim());
                                }

                                // Keyboard handler for arrow key navigation
                                input.addEventListener('keydown', function(e) {
                                    var popover = document.querySelector('.mud-popover-open');
                                    if (!popover) {
                                        // Open the dropdown on ArrowDown/ArrowUp if closed
                                        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                                            e.preventDefault();
                                            input.click();
                                        }
                                        return;
                                    }

                                    var items = popover.querySelectorAll('.mud-list-item');
                                    if (!items.length) return;

                                    var active = popover.querySelector('.mud-list-item-highlighted, .mud-list-item:focus');
                                    var index = active ? Array.from(items).indexOf(active) : -1;

                                    if (e.key === 'ArrowDown') {
                                        e.preventDefault();
                                        index = Math.min(index + 1, items.length - 1);
                                        items[index].focus();
                                        items[index].scrollIntoView({ block: 'nearest' });
                                    } else if (e.key === 'ArrowUp') {
                                        e.preventDefault();
                                        index = Math.max(index - 1, 0);
                                        items[index].focus();
                                        items[index].scrollIntoView({ block: 'nearest' });
                                    } else if (e.key === 'Enter' && index >= 0) {
                                        e.preventDefault();
                                        items[index].click();
                                    } else if (e.key === 'Escape') {
                                        e.preventDefault();
                                        input.click();
                                    }
                                });
                            }
                        });
                    }

                    function enhancePopovers() {
                        var popovers = document.querySelectorAll('.mud-popover-open');
                        popovers.forEach(function(popover) {
                            var list = popover.querySelector('.mud-list');
                            if (list && list.getAttribute('role') !== 'listbox') {
                                list.setAttribute('role', 'listbox');
                                list.querySelectorAll('.mud-list-item').forEach(function(item) {
                                    item.setAttribute('role', 'option');
                                    item.setAttribute('tabindex', '-1');
                                });
                            }
                        });

                        // Update aria-expanded on inputs
                        document.querySelectorAll('.a11y-combobox').forEach(function(wrapper) {
                            var input = wrapper.querySelector('input.mud-input-slot') || wrapper.querySelector('input');
                            if (input) {
                                var isOpen = document.querySelector('.mud-popover-open') !== null;
                                input.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                            }
                        });
                    }

                    enhanceMudSelects();

                    if (!window._bizNewA11yObserver) {
                        window._bizNewA11yObserver = new MutationObserver(function() {
                            enhanceMudSelects();
                            enhancePopovers();
                        });
                        window._bizNewA11yObserver.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'style'] });
                    }
                })()
            ");
        }
    }

    private async void OnCategoryChanged(string category)
    {
        try
        {
            ActiveCategory = category;
            _srAnnouncement = $"{category} section loaded.";
            StateHasChanged();

            if (category == "Staff Details")
            {
                _subCategories = new();
                StateHasChanged();
                return;
            }

            // Module card tabs — no sub-categories, no KPI loading needed
            if (_moduleCategories.Contains(category))
            {
                _subCategories = new();
                StateHasChanged();
                return;
            }

            _subCategories = _subCategoryMap.ContainsKey(category) ? _subCategoryMap[category] : new();
            if (_subCategories.Any())
            {
                if (!_graphsLoaded)
                {
                    _isLoading = true;
                    StateHasChanged();
                    await LoadDashboardDataAsync();
                    await LoadKpiData();
                    _graphsLoaded = true;
                }
                else
                {
                    // Set the first sub-category as active so the correct content renders.
                    // For Advances, UpdateDashboard handles legacy KPI chart logic.
                    // For other tabs, just setting ActiveSubCategory is sufficient since
                    // their chart data is already populated by the background load.
                    ActiveSubCategory = _subCategories.First();
                    if (category == "Advances")
                    {
                        await UpdateDashboard(ActiveSubCategory);
                    }
                    else
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"Error switching category: {ex.Message}");
            _isLoading = false;
            _loadError = "An error occurred while loading data. Please try again.";
            StateHasChanged();
        }
    }

