    #region Business_New — Total Advances (SP_PAGETWO_DASHBOARD_ADVANCES)
    // ── These variables are prefixed _bn_ to avoid any collision with the
    //    existing Business.razor variables that are preserved above.

    private decimal _bn_actualTotal = 0m;
    private decimal _bn_currentFy   = 0m;
    private decimal _bn_targetFy    = 0m;
    private double  _bn_advancesProgress = 0;
    private string  _bn_scaleText   = "Crores";

    private List<MetricData> _bn_portfolioItems    = new();
    private List<MetricData> _bn_outstandingItems  = new();

    private bool             _bn_isDisbAmt         = false;
    private List<MetricData> _bn_disbNoaTrend       = new();
    private List<MetricData> _bn_disbAmtTrend       = new();
    private List<MetricData> _bn_disbCurrentTrend   = new();

    /// <summary>
    /// Calls SP_PAGETWO_DASHBOARD_ADVANCES and populates the _bn_ variables
    /// used exclusively by the Total Advances section in Business_New.
    /// </summary>
    private async Task LoadBusinessNewTotalAdvancesAsync()
    {
        try
        {
            var data = await BusinessNewService.GetAdvancesDashboardAsync(
                _userRole, _brSolid, _regionSolid, _zoneSolid);

            // Card 1 — Performance (already scaled by SP)
            _bn_scaleText        = data.Performance.ScaleText;
            _bn_actualTotal      = data.Performance.ActualTotal;
            _bn_currentFy        = data.Performance.CurrentFy;
            _bn_targetFy         = data.Performance.TargetFy;
            _bn_advancesProgress = (_bn_targetFy - _bn_currentFy) > 0
                ? (double)(((_bn_actualTotal - _bn_currentFy) / (_bn_targetFy - _bn_currentFy)) * 100m)
                : 0;

            // Card 2 — Portfolio (raw INR → Crores)
            _bn_portfolioItems = new List<MetricData>
            {
                new() { Category = "MSME",        Value = data.Portfolio.MsmeAdvances        / 10_000_000m },
                new() { Category = "Retail",      Value = data.Portfolio.RetailAdvances      / 10_000_000m },
                new() { Category = "Agriculture", Value = data.Portfolio.AgricultureAdvances / 10_000_000m },
                new() { Category = "Corporate",   Value = data.Portfolio.CorporateAdvances   / 10_000_000m }
            };

            // Card 3 — Outstanding Book (raw INR → Crores)
            _bn_outstandingItems = new List<MetricData>
            {
                new() { Category = "Base",         Value = data.OutstandingBook.Base        / 10_000_000m },
                new() { Category = "Last FY",      Value = data.OutstandingBook.LastFy      / 10_000_000m },
                new() { Category = "Last Quarter", Value = data.OutstandingBook.LastQuarter / 10_000_000m },
                new() { Category = "Last Month",   Value = data.OutstandingBook.LastMonth   / 10_000_000m },
                new() { Category = "As On",        Value = data.OutstandingBook.AsOn        / 10_000_000m }
            };

            // Card 4 — Disbursements: NOA = Sanctions (count), AMT = disbursements (raw INR → Crores)
            // Rows are sorted chronologically; X-axis label = month of AS_ON_DATE.
            var sorted = data.Disbursements
                .Where(r => r.AsOnDate != DateTime.MinValue)
                .OrderBy(r => r.AsOnDate)
                .ToList();

            _bn_disbNoaTrend = sorted.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM yy"),
                Value    = r.Noa                        // count — no scaling
            }).ToList();

            _bn_disbAmtTrend = sorted.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM yy"),
                Value    = r.Amt / 10_000_000m          // raw INR → Crores
            }).ToList();

            _bn_disbCurrentTrend = _bn_isDisbAmt ? _bn_disbAmtTrend : _bn_disbNoaTrend;
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"[Business_New] LoadBusinessNewTotalAdvancesAsync error: {ex.Message}");
        }
    }

    private void BnToggleDisb(bool isAmt)
    {
        _bn_isDisbAmt        = isAmt;
        _bn_disbCurrentTrend = isAmt ? _bn_disbAmtTrend : _bn_disbNoaTrend;
        // _chartKey            = Guid.NewGuid(); // force chart redraw
        StateHasChanged();
    }
