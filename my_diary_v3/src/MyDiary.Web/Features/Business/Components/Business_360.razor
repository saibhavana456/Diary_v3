    // Dynamic Scope Updater
    private void UpdateScopeVariables()
    {
        // This dynamically updates the variables used by all your API fetch calls!
        if (_selectedBranch != "ALL" && !string.IsNullOrEmpty(_selectedBranch))
        {
            _userRole = "BRANCH";
            _brSolid = _selectedBranch;
            _regionSolid = _selectedRegion;
            _zoneSolid = _selectedZone;
        }
        else if (_selectedRegion != "ALL" && !string.IsNullOrEmpty(_selectedRegion))
        {
            _userRole = "REGION";
            _brSolid = null;
            _regionSolid = _selectedRegion;
            _zoneSolid = _selectedZone;
        }
        else if (_selectedZone != "ALL" && !string.IsNullOrEmpty(_selectedZone))
        {
            _userRole = "ZONE";
            _brSolid = null;
            _regionSolid = null;
            _zoneSolid = _selectedZone;
        }
        else
        {
            _userRole = "CO";
            _brSolid = _loggedInBranchSolid;
            _regionSolid = null;
            _zoneSolid = null;
        }
    }

    // Dropdown Change Events
    private async Task OnZoneChangedAsync(string newValue)
    {
        _selectedZone = newValue ?? "ALL";
        _selectedRegion = "ALL";
        _selectedBranch = "ALL";
        _regions.Clear();
        _branches.Clear();

        if (_selectedZone != "ALL")
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);

        await LoadDashboardDataAsync();
    }

    private async Task OnRegionChangedAsync(string newValue)
    {
        _selectedRegion = newValue ?? "ALL";
        _selectedBranch = "ALL";
        _branches.Clear();

        if (_selectedRegion != "ALL")
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);

        await LoadDashboardDataAsync();
    }

    private async Task OnBranchChangedAsync(string newValue)
    {
        _selectedBranch = newValue ?? "ALL";
        await LoadDashboardDataAsync();
    }
    private async Task LoadDashboardDataAsync()
    {
        // Cancel any in-progress background load from a previous filter change
        _backgroundLoadCts?.Cancel();
        _backgroundLoadCts = new CancellationTokenSource();

        // FIRST: Calculate what parameters the DB needs based on the dropdowns
        UpdateScopeVariables();

        _chartKey = Guid.NewGuid();

        // Reset section loading flags
        _advancesLoaded = false;
        _depositsLoaded = false;
        _npaLoaded = false;
        _profitabilityLoaded = false;
        _isLoading = true;

        // LoadAllGraphs loads Advances first (renders immediately),
        // then loads Deposits/NPA/Profitability in the background.
        await LoadAllGraphs();
    }

    private CancellationTokenSource? _backgroundLoadCts;
