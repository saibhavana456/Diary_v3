    #region Advances sub-tabs — SP_PAGETWO_DASHBOARD_ADVANCES

    /// <summary>
    /// Generic loader for all Advances sub-tabs.
    /// scope: "retail" | "msme" | "agri" | "corporate"
    /// Populates the existing _retail*, _msme*, _agri*, _corp* variables so the
    /// existing UI markup continues to work without any changes.
    /// </summary>
    private async Task LoadBusinessNewAdvancesAsync(string scope)
    {
        try
        {
            var data = await BusinessNewService.GetAdvancesDashboardAsync(
                _userRole, _brSolid, _regionSolid, _zoneSolid, scope);

            // ── Performance ──────────────────────────────────────────────────
            decimal actualTotal = data.Performance.ActualTotal;
            decimal currentFy   = data.Performance.CurrentFy;
            decimal targetFy    = data.Performance.TargetFy;

            // ── Outstanding Book (raw INR → Crores) ──────────────────────────
            var ob = data.OutstandingBook;
            var outstandingItems = new List<MetricData>
            {
                new() { Category = "Base",         Value = ob.Base        / 10_000_000m },
                new() { Category = "Last FY",      Value = ob.LastFy      / 10_000_000m },
                new() { Category = "Last Quarter", Value = ob.LastQuarter / 10_000_000m },
                new() { Category = "Last Month",   Value = ob.LastMonth   / 10_000_000m },
                new() { Category = "As On",        Value = ob.AsOn        / 10_000_000m }
            };

            // ── Disbursements ────────────────────────────────────────────────
            var sorted = data.Disbursements
                .Where(r => r.AsOnDate != DateTime.MinValue)
                .OrderBy(r => r.AsOnDate)
                .ToList();

            var disbNoa = sorted.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM yy"),
                Value    = r.Noa
            }).ToList();

            var disbAmt = sorted.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM yy"),
                Value    = r.Amt / 10_000_000m
            }).ToList();

            // ── Map to scope-specific variables ─────────────────────────────
            switch (scope)
            {                
                case "total":
                    _advancesActualTotal = actualTotal;
                    _advancesCurrent   = currentFy;
                    _advancesTarget = targetFy;

                    _advancesProgress = (targetFy - currentFy) > 0
                        ? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m)
                        : 0;
                    _advancesPerformanceScaleText = data.Performance.ScaleText; 

                    // ── Portfolio (same as old TOTAL logic) ─────────────────────────
                    _advancesPortfolioItems = new List<MetricData>
                    {
                        new() { Category = "MSME",        Value = data.Portfolio.MsmeAdvances        / 10_000_000m },
                        new() { Category = "Retail",      Value = data.Portfolio.RetailAdvances      / 10_000_000m },
                        new() { Category = "Agriculture", Value = data.Portfolio.AgricultureAdvances / 10_000_000m },
                        new() { Category = "Corporate",   Value = data.Portfolio.CorporateAdvances   / 10_000_000m }
                    };
                    _advancesPortfolioScaleText = data.Portfolio.ScaleText;


                    // ── Outstanding Book ───────────────────────────────────────────
                    _advancesGrowthTrend = outstandingItems;
                    _advancesGrowthTrendScaleText = data.OutstandingBook.ScaleText;

                    // ── Disbursements ──────────────────────────────────────────────
                    _advDisbNoaTrend = disbNoa;
                    _advDisbAmtTrend = disbAmt;
                    _advDisbCurrentTrend = _isAdvDisbAmt ? disbAmt : disbNoa; ;

                    break;

                case "retail":
                    _retailActualTotal  = actualTotal;
                    _retailCurrent      = currentFy;
                    _retailTarget       = targetFy;
                    _retailProgress     = (targetFy - currentFy) > 0 ? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m) : 0;
                    _retailPerformanceScaleText = data.Performance.ScaleText; 

                    _retailPortfolioItems = new List<MetricData>
                    {
                        new() { Category = "Vehicle",  Value = data.Portfolio.VehicleAdvances  / 10_000_000m },
                        new() { Category = "Mortgage", Value = data.Portfolio.MortgageAdvances / 10_000_000m },
                        new() { Category = "Home",     Value = data.Portfolio.HomeAdvances     / 10_000_000m }
                    };
                    _retailPortfolioScaleText = data.Portfolio.ScaleText;

                    _retailGrowthTrend      = outstandingItems;
                    _retailGrowthTrendScaleText = data.OutstandingBook.ScaleText;

                    _retailDisbNoaTrend     = disbNoa;
                    _retailDisbAmtTrend     = disbAmt;
                    _retailDisbCurrentTrend = _isRetailDisbAmt ? disbAmt : disbNoa;
                    break;

                case "msme":
                    _msmeActualTotal  = actualTotal;
                    _msmeCurrent      = currentFy;
                    _msmeTarget       = targetFy;
                    _msmeProgress     = (targetFy - currentFy) > 0 ? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m) : 0;
                    _msmePerformanceScaleText = data.Performance.ScaleText;

                    _msmePortfolioItems = new List<MetricData>
                    {
                        new() { Category = "Micro",  Value = data.Portfolio.MicroAdvances  / 10_000_000m },
                        new() { Category = "Small",  Value = data.Portfolio.SmallAdvances  / 10_000_000m },
                        new() { Category = "Medium", Value = data.Portfolio.MediumAdvances / 10_000_000m }
                    };
                    _msmePortfolioScaleText = data.Portfolio.ScaleText;

                    _msmeGrowthTrend      = outstandingItems;
                    _msmeGrowthTrendScaleText = data.OutstandingBook.ScaleText;

                    _msmeDisbNoaTrend     = disbNoa;
                    _msmeDisbAmtTrend     = disbAmt;
                    _msmeDisbCurrentTrend = _isMsmeDisbAmt ? disbAmt : disbNoa;
                    break;

                case "agri":
                    _agriActualTotal  = actualTotal;
                    _agriCurrent      = currentFy;
                    _agriTarget       = targetFy;
                    _agriProgress     = (targetFy - currentFy) > 0 ? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m) : 0;
                    _agriPerformanceScaleText = data.Performance.ScaleText;

                    // Agriculture has no portfolio chart in the SP
                    _agriGrowthTrend      = outstandingItems;
                    _agriGrowthTrendScaleText = data.OutstandingBook.ScaleText;

                    _agriDisbNoaTrend     = disbNoa;
                    _agriDisbAmtTrend     = disbAmt;
                    _agriDisbCurrentTrend = _isAgriDisbAmt ? disbAmt : disbNoa;
                    break;

                case "corporate":
                    _corpActualTotal  = actualTotal;
                    _corpCurrent      = currentFy;
                    _corpTarget       = targetFy;
                    _corpProgress     = (targetFy - currentFy) > 0 ? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m) : 0;
                    _corpPerformanceScaleText = data.Performance.ScaleText;

                    // Corporate has no portfolio or disbursements chart in the SP
                    _corpGrowthTrend = outstandingItems;
                    _corpGrowthTrendScaleText = data.OutstandingBook.ScaleText;
                    break;
            }
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"[Business_New] LoadBusinessNewAdvancesAsync({scope}) error: {ex.Message}");
        }
    }
    #endregion

    // ═══════════════════════════════════════════════════════════════════════════
    //  SP-BASED LOADERS — Deposits tab (total / td / savings / current)
    // ═══════════════════════════════════════════════════════════════════════════

    #region Deposits — SP_PAGETWO_DASHBOARD_DEPOSITS

    /// <summary>
	/// Generic loader for all Deposits sub-tabs.
	/// scope: "total" | "td" | "savings" | "current"
	/// Populates the existing _deposits*, _td*, _savings*, _currDep* variables.
	/// </summary>
	private async Task LoadBusinessNewDepositsAsync(string scope)
	{
		try
		{
			var data = await BusinessNewService.GetDepositsDashboardAsync(
				_userRole, _brSolid, _regionSolid, _zoneSolid, scope);

			// ── Performance ───────────────────────────────────────────────
			decimal actualTotal = data.Performance?.ActualTotal ?? 0;
			decimal currentFy = data.Performance?.CurrentFy ?? 0;
			decimal targetFy = data.Performance?.TargetFy ?? 0;
			string performanceScaleText = data.Performance?.ScaleText ?? "";

			// ── Portfolio (safe reference) ────────────────────────────────
			var p = data.Portfolio ?? new DepositsPortfolio();
			string portfolioScaleText = p?.ScaleText ?? "";

			// ── Outstanding Book (raw INR → Crores) ───────────────────────
			var ob = data.OutstandingBook ?? new BusinessOutstandingBook();
			string growthTrendScaleText = ob?.ScaleText ?? "";

			var outstandingItems = new List<MetricData>
			{
				new() { Category = "Base",         Value = ob.Base        / 10_000_000m },
				new() { Category = "Last FY",      Value = ob.LastFy      / 10_000_000m },
				new() { Category = "Last Quarter", Value = ob.LastQuarter / 10_000_000m },
				new() { Category = "Last Month",   Value = ob.LastMonth   / 10_000_000m },
				new() { Category = "As On",        Value = ob.AsOn        / 10_000_000m }
			};

			// ── Opened (Disbursement Trend) ──────────────────────────────
			var sorted = (data.Opened ?? new List<BusinessDisbursementRow>())
				.Where(r => r.AsOnDate != DateTime.MinValue)
				.OrderBy(r => r.AsOnDate)
				.ToList();

			var openedNoa = sorted.Select(r => new MetricData
				{
					Category = r.AsOnDate.ToString("MMM yy"),
					Value = r.Noa
				}).ToList();

			var openedAmt = sorted.Select(r => new MetricData
				{
					Category = r.AsOnDate.ToString("MMM yy"),
					Value = r.Amt / 10_000_000m
				}).ToList();

			// ── Scope Mapping ────────────────────────────────────────────
			switch (scope)
			{
				case "total":
					_depositsActualTotal = actualTotal;
					_depositsCurrent = currentFy;
					_depositsTarget = targetFy;
					_depositsProgress = (targetFy - currentFy) > 0
						? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m)
						: 0;
					_depositsPerformanceScaleText = performanceScaleText;

					_depositsPortfolioItems = new List<MetricData>
					{
						new() { Category = "CA",  Value = p.CdDeposits         / 10_000_000m },
						new() { Category = "SB",  Value = p.SbDeposits         / 10_000_000m },
						new() { Category = "TD",  Value = p.TdDeposits         / 10_000_000m },
						new() { Category = "RTD", Value = p.RetailTermDeposits / 10_000_000m }
					};

					// Optional: remove zero segments
					_depositsPortfolioItems = _depositsPortfolioItems
						.Where(x => x.Value > 0)
						.ToList();
					_depositsPortfolioScaleText = portfolioScaleText;

					_depositsGrowthTrend = outstandingItems;
					_depositsGrowthTrendScaleText = growthTrendScaleText;

					_depositsOpenedNoaTrend = openedNoa;
					_depositsOpenedAmtTrend = openedAmt;
					_depositsOpenedCurrentTrend = _isDepositsOpenedAmt ? openedAmt : openedNoa;
					break;

				case "td":
					_tdActualTotal = actualTotal;
					_tdCurrent = currentFy;
					_tdTarget = targetFy;
					_tdProgress = (targetFy - currentFy) > 0
						? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m)
						: 0;
					_tdPerformanceScaleText = performanceScaleText;

					// Retail TD & Bulk TD
					_tdPortfolioItems = new List<MetricData>
					{
						new() { Category = "Retail TD", Value = p.RetailTd / 10_000_000m },
						new() { Category = "Bulk TD",   Value = p.BulkTd   / 10_000_000m }
					};

					_tdPortfolioItems = _tdPortfolioItems
						.Where(x => x.Value > 0)
						.ToList();
					_tdPortfolioScaleText = portfolioScaleText;

					_tdGrowthTrend = outstandingItems;
                    _tdGrowthTrendScaleText = growthTrendScaleText;

					_tdOpenedNoaTrend = openedNoa;
					_tdOpenedAmtTrend = openedAmt;
					_tdOpenedCurrentTrend = _isTdOpenedAmt ? openedAmt : openedNoa;
					break;

				case "savings":
					_savingsActualTotal = actualTotal;
					_savingsCurrent = currentFy;
					_savingsTarget = targetFy;
					_savingsProgress = (targetFy - currentFy) > 0
						? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m)
						: 0;
					_savingsPerformanceScaleText = performanceScaleText;
					// ✅ NO Portfolio for savings

					_savingsGrowthTrend = outstandingItems;
					_savingsGrowthTrendScaleText = growthTrendScaleText;
					_savingsOpenedNoaTrend = openedNoa;
					_savingsOpenedAmtTrend = openedAmt;
					_savingsOpenedCurrentTrend = _isSavingsOpenedAmt ? openedAmt : openedNoa;
					break;

				case "current":
					_currDepActualTotal = actualTotal;
					_currDepCurrent = currentFy;
					_currDepTarget = targetFy;
					_currDepProgress = (targetFy - currentFy) > 0
						? (double)(((actualTotal - currentFy) / (targetFy - currentFy)) * 100m)
						: 0;
					_currPerformanceScaleText = performanceScaleText;
					// ✅ NO Portfolio for current

					_currDepGrowthTrend = outstandingItems;
					_currGrowthTrendScaleText = growthTrendScaleText;
					_currDepOpenedNoaTrend = openedNoa;
					_currDepOpenedAmtTrend = openedAmt;
					_currDepOpenedCurrentTrend = _isCurrDepOpenedAmt ? openedAmt : openedNoa;
					break;
			}
		}
		catch (Exception ex)
		{
			AppLogger.LogError(ex, $"[Business_New] LoadBusinessNewDepositsAsync({scope}) error: {ex.Message}");
		}
	}
    #endregion

    // ═══════════════════════════════════════════════════════════════════════════
    //  SP-BASED LOADER — NPA tab
    // ═══════════════════════════════════════════════════════════════════════════

    #region NPA — SP_PAGETWO_DASHBOARD_NPA

    /// <summary>
	/// Calls SP_PAGETWO_DASHBOARD_NPA and populates the _npa* variables
	/// used by the Total NPA section in Business_New.
	/// </summary>
	private async Task LoadBusinessNewNpaAsync()
	{
		try
		{
			var data = await BusinessNewService.GetNpaDashboardAsync(
				_userRole, _brSolid, _regionSolid, _zoneSolid);

			// ── Card 1 — Performance ─────────────────────────────────────

			_npaTotal = Math.Abs(data.Performance.Npa / 10_000_000m);

			_npaAdvancesTotal = Math.Abs(data.Performance.Advances / 10_000_000m);

			// ✅ NPA %
			if (_npaAdvancesTotal > 0)
				_npaProgress = (double)((_npaTotal / _npaAdvancesTotal) * 100m);
			else
				_npaProgress = 0;

			_npaPerformanceScaleText = data.Performance.ScaleText;


		    // ── Card 2 — NPA Portfolio ───────────────────────────────────

		    var p = data.Portfolio;

			_npaPortfolioItems = new List<MetricData>
			{
				new() { Category = "MSME",      Value = Math.Abs(p.MsmeNpa      / 10_000_000m) },
				new() { Category = "Retail",    Value = Math.Abs(p.RetailNpa    / 10_000_000m) },
				new() { Category = "Agri",      Value = Math.Abs(p.AgriNpa      / 10_000_000m) },
				new() { Category = "Corporate", Value = Math.Abs(p.CorporateNpa / 10_000_000m) },
			};

			// ✅ Prevent empty donut / chart crash
			_npaPortfolioItems = _npaPortfolioItems
				.Where(x => x.Value > 0)
				.ToList();

			_npaPortfolioScaleText = p.ScaleText;

			// ── Card 3 — NPA Book / Growth ───────────────────────────────

			var ob = data.OutstandingBook;

			_npaBookTrend = new List<MetricData>
			{
				// new() { Category = "Base",         Value = Math.Abs(ob.Base        / 10_000_000m) },
				new() { Category = "Last FY",      Value = Math.Abs(ob.LastFy      / 10_000_000m) },
				new() { Category = "Last Quarter", Value = Math.Abs(ob.LastQuarter / 10_000_000m) },
				new() { Category = "Last Month",   Value = Math.Abs(ob.LastMonth   / 10_000_000m) },
				new() { Category = "As On",        Value = Math.Abs(ob.AsOn        / 10_000_000m) }
			};

			_npaBookScaleText = data.OutstandingBook.ScaleText;
		}
		catch (Exception ex)
		{
			AppLogger.LogError(ex, $"[Business_New] LoadBusinessNewNpaAsync error: {ex.Message}");
		}
	}
    #endregion
}
