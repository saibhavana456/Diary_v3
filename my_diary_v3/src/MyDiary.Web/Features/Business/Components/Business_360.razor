    protected override async Task OnInitializedAsync()
    {
        // Read user claims and zones in parallel (independent)
        var authTask = AuthStateProvider.GetAuthenticationStateAsync();
        var zonesTask = LandingDashboardService.GetZonesAsync();
        await Task.WhenAll(authTask, zonesTask);

        var authState = authTask.Result;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("Role")?.Value ?? "";
            _brSolid = user.FindFirst("br_solid")?.Value ?? "";
            _regionSolid = user.FindFirst("region_solid")?.Value ?? "";
            _zoneSolid = user.FindFirst("zone_solid")?.Value ?? "";
            _branchCode = user.FindFirst("branch_code")?.Value ?? "";
            _regionCode = user.FindFirst("region_code")?.Value ?? "";
            _zoneCode = user.FindFirst("zone_code")?.Value ?? "";
            int.TryParse(user.FindFirst("employee_scale_code")?.Value, out scaleCode);
            CanViewAll = _userRole.Equals("co", StringComparison.OrdinalIgnoreCase) && scaleCode < 6;
        }

        #region Filters
        // 1. Fetch Master List of Zones
        _zones = zonesTask.Result;

        _loggedInRole = user.FindFirst(ClaimTypes.Role)?.Value?.ToUpper() ?? user.FindFirst("Role")?.Value?.ToUpper() ?? "CO";
        _loggedInZoneSolid = user.FindFirst("zone_solid")?.Value;
        _loggedInRegionSolid = user.FindFirst("region_solid")?.Value;
        _loggedInBranchSolid = user.FindFirst("branch_solid")?.Value;

        // 2. Apply Role-Based Security Rules
        if (_loggedInRole == "ZONE")
        {
            _selectedZone = _loggedInZoneSolid;
            _isZoneDisabled = true;
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
        }
        else if (_loggedInRole == "REGION")
        {
            _selectedZone = _loggedInZoneSolid;
            _selectedRegion = _loggedInRegionSolid;
            _isZoneDisabled = true;
            _isRegionDisabled = true;
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
        }
        else if (_loggedInRole == "BRANCH")
        {
            _selectedZone = _loggedInZoneSolid;
            _selectedRegion = _loggedInRegionSolid;
            _selectedBranch = _loggedInBranchSolid;
            _isZoneDisabled = true;
            _isRegionDisabled = true;
            _isBranchDisabled = true;
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
            _branches = await LandingDashboardService.GetBranchesByRegionAsync(_selectedRegion);
        }
        else if (!CanViewAll && _zones.Count > 0)
        {
            // CO user with scale >= 6: no "ALL" option in zone, auto-select first zone
            _selectedZone = _zones.First().zone_solid;
            _selectedRegion = "ALL";
            _selectedBranch = "ALL";
            _regions = await LandingDashboardService.GetRegionsByZoneAsync(_selectedZone);
        }

        // Show Branch Profile only for branch users
        if (_loggedInRole == "BRANCH")
        {
            _categories.Add("Branch Profile");
        }
        _rolesLoaded = true;

        // 3. Load the Dashboard for the first time
        await LoadDashboardDataAsync();
        #endregion

        // Parse ?tab= parameter FIRST so the correct tab renders immediately
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tabParam = query["tab"];
        if (!string.IsNullOrEmpty(tabParam))
        {
            if (tabParam.Equals("BranchMgmt", StringComparison.OrdinalIgnoreCase))
            {
                ActiveCategory = "Branch Profile";
                _subCategories = new();
                _isLoading = false;
                return;
