    public class MetricData { public string Category { get; set; } = ""; public decimal Value { get; set; } }

    // ── Section loading state flags ──────────────────────────────────────────
    private bool _advancesLoaded = false;
    private bool _depositsLoaded = false;
    private bool _npaLoaded = false;
    private bool _profitabilityLoaded = false;

    /// <summary>
    /// Returns true if the data for the given category tab has been loaded.
    /// Module categories (IT Assets, Amenities, etc.) and Staff Details don't need SP data.
    /// </summary>
    private bool IsSectionLoaded(string category)
    {
        return category switch
        {
            "Advances" => _advancesLoaded,
            "Deposits" => _depositsLoaded,
            "NPA" => _npaLoaded,
            "Profitability" => _profitabilityLoaded,
            // Module categories and Staff Details don't depend on the SP data
            _ => true
        };
    }

    private async Task LoadAllGraphs()
    {
        try
        {
            #region Date labels
            DateTime now = AppTime.Now;
            string lblAsOn = now.ToString("MMM yy");
            string lblLastMonth = now.AddMonths(-1).ToString("MMM yy");

            int currentQuarter = (now.Month - 1) / 3 + 1;
            int lastQuarterMonth = (currentQuarter - 1) * 3;
            int lastQuarterYear = now.Year;
            if (lastQuarterMonth == 0) { lastQuarterMonth = 12; lastQuarterYear--; }
            string lblLastQtr = new DateTime(lastQuarterYear, lastQuarterMonth, 1).ToString("MMM yy");

            int lastFyYear = now.Month <= 3 ? now.Year - 1 : now.Year;
            string lblLastFy = new DateTime(lastFyYear, 3, 1).ToString("MMM yy");

            string lblLast1_Adv = now.AddMonths(-1).ToString("MMM yy");
            string lblLast2_Adv = now.AddMonths(-2).ToString("MMM yy");
            string lblLast3_Adv = now.AddMonths(-3).ToString("MMM yy");
            #endregion

            // ═══════════════════════════════════════════════════════════════════
            //  PHASE 1: Load only Total Advances — render immediately
            // ═══════════════════════════════════════════════════════════════════
            await LoadBusinessNewAdvancesAsync("total");

            _advancesLoaded = true;
            _isLoading = false;
            await InvokeAsync(StateHasChanged); // Render Total Advances immediately

            // ═══════════════════════════════════════════════════════════════════
            //  PHASE 2: Load remaining Advances scopes + other sections in background
            // ═══════════════════════════════════════════════════════════════════
            var cts = _backgroundLoadCts;
            _ = LoadRemainingDataAsync(lblLast1_Adv, lblLast2_Adv, lblLast3_Adv, lblAsOn, cts?.Token ?? CancellationToken.None);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"Error loading graphs: {ex.Message}");
            _isLoading = false;
        }
    }

    /// <summary>
    /// Loads remaining Advances scopes, Deposits, NPA, and Profitability data in the background.
    /// Each section triggers a StateHasChanged when complete so the UI updates progressively.
    /// </summary>
    private async Task LoadRemainingDataAsync(string lblLast1, string lblLast2, string lblLast3, string lblAsOn, CancellationToken ct)
    {
        try
        {
            // ── Remaining Advances scopes (retail, msme, agri, corporate) ────
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewAdvancesAsync("retail");
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewAdvancesAsync("msme");
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewAdvancesAsync("agri");
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewAdvancesAsync("corporate");
            await InvokeAsync(StateHasChanged);

            // ── Deposits ─────────────────────────────────────────────────────
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewDepositsAsync("total");
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewDepositsAsync("savings");
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewDepositsAsync("current");
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewDepositsAsync("td");
            _depositsLoaded = true;
            await InvokeAsync(StateHasChanged);

            // ── NPA ──────────────────────────────────────────────────────────
            if (ct.IsCancellationRequested) return;
            await LoadBusinessNewNpaAsync();
            _npaLoaded = true;
            await InvokeAsync(StateHasChanged);

            // ── Profitability ────────────────────────────────────────────────
            if (ct.IsCancellationRequested) return;
            _feeMomOptions       = CreateMomColumnOptions("fee-mom-chart");
            _interestMomOptions  = CreateMomColumnOptions("interest-mom-chart");
            _feeDonutOptions     = CreateDonutOptions("fee-portfolio-chart");
            _interestDonutOptions= CreateDonutOptions("interest-portfolio-chart");

            var profitData = await BusinessNewService.GetProfitabilityDashboardAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
            if (ct.IsCancellationRequested) return;

            // Fee MOM — use the last rows (most recent months) for the bar chart
            var feeMomRows = profitData.FeeMom.OrderBy(r => r.AsOnDate).ToList();
            _feeMomTrend = feeMomRows.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM-yy"),
                Value = Math.Abs(r.Data / 10000000m)
            }).ToList();

            // Fee Portfolio (donut) — Interest vs Fee
            _feePortfolioItems = new List<MetricData>
            {
                new MetricData { Category = "Fee", Value = Math.Abs(profitData.Portfolio.Fee / 10000000m) },
                new MetricData { Category = "Interest", Value = Math.Abs(profitData.Portfolio.Interest / 10000000m) }
            };

            // Interest MOM — bar chart
            var intMomRows = profitData.InterestMom.OrderBy(r => r.AsOnDate).ToList();
            _interestMomTrend = intMomRows.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM-yy"),
                Value = Math.Abs(r.Data / 10000000m)
            }).ToList();

            // Expense MOM — bar chart (4th result set)
            var expMomRows = profitData.ExpenseMom.OrderBy(r => r.AsOnDate).ToList();
            _expenseMomTrend = expMomRows.Select(r => new MetricData
            {
                Category = r.AsOnDate.ToString("MMM-yy"),
                Value = Math.Abs(r.Data / 10000000m)
            }).ToList();

            _profitabilityLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Expected when user changes filters — silently stop
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"Error loading background data: {ex.Message}");
        }
    }
