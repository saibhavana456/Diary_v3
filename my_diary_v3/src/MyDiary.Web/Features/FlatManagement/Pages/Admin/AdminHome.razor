@page "/flatmgmt/admin/home"
@attribute [Authorize(Policy = "AppAdmin")]
@using System.Security.Claims
@using MyDiary.Web.Features.FlatManagement.Models.DTO
@using MyDiary.Web.Features.FlatManagement.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IAdminFlatService AdminFlatService
@inject MyDiary.Core.Abstractions.ICurrentUser CurrentUser
@using global::RequestPortal.Web.Shared

<PageTitle>Flat Management - Flat Management System</PageTitle>

<div class="ah-page">
    <PageHeader Title="All Flat Details" Crumbs="_crumbs" PageKey="flatmgmt-admin-admin-home" />

    <MudCard Class="ah-card mt-4" Elevation="2">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="8" md="6">
                    <MudTextField @bind-Value="searchText" Label="Search (Location / Flat No.)" Variant="Variant.Outlined"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await HandleSearch(); })" />
                </MudItem>
                <MudItem xs="12" sm="4" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSearch" FullWidth="true" Disabled="@isLoading">
                        Search
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard Class="ah-card mt-4" Elevation="2">
        <MudCardContent Class="pa-0">
            <MudTable Items="@rows" Hover="true" Bordered="true" Dense="true" Class="ah-table"
                      Loading="@isLoading" RowsPerPage="20">
                <HeaderContent>
                    <MudTh>S.No.</MudTh>
                    <MudTh>Details</MudTh>
                    <MudTh>Location</MudTh>
                    <MudTh>Flat No</MudTh>
                    <MudTh>Purchased Date</MudTh>
                    <MudTh>Flat Details</MudTh>
                    <MudTh>Managed By</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="S.No.">@(rows.IndexOf(row) + 1)</MudTd>
                    <MudTd DataLabel="Details">
                        <MudLink Href="@($"flatmgmt/admin/flat-details?username={row.EmplId}")">View</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Location">@row.UbiCenter</MudTd>
                    <MudTd DataLabel="Flat No">@row.RoomNbr</MudTd>
                    <MudTd DataLabel="Purchased Date">@(row.PurchasedDate?.ToString("dd-MM-yyyy") ?? "-")</MudTd>
                    <MudTd DataLabel="Flat Details">@row.RoomType</MudTd>
                    <MudTd DataLabel="Managed By">@row.UbiRegionOfc</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No flats found.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private readonly List<PageHeader.Crumb> _crumbs = new() { new("Flat Management", "flatmgmt/my"), new("All Flat Details") };
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string pfNo = string.Empty;
    private string searchText = string.Empty;
    private bool isLoading = true;
    private List<AdminFlatRow> rows = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            pfNo = CurrentUser.EmplId ?? string.Empty;
        }

        await LoadAsync();
    }

    private async Task HandleSearch() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        rows = await AdminFlatService.GetAllFlatsAsync(pfNo, searchText);
        isLoading = false;
    }
}
