    }

    private async Task HandleTransferSocietyChanged()
    {
        transferFlatId = "";
        transferFlats = string.IsNullOrEmpty(transferSocietyId) ? new() : await AssetService.GetFlatsBySocietyAsync(transferSocietyId);
    }

    private async Task HandleTransfer()
    {
        message = null;
        if (string.IsNullOrEmpty(transferAssetRef)) { ShowError("Select Asset"); return; }
        if (string.IsNullOrEmpty(transferLocationId)) { ShowError("Choose Location"); return; }
        if (string.IsNullOrEmpty(transferSocietyId)) { ShowError("Choose Society"); return; }
        if (string.IsNullOrEmpty(transferFlatId)) { ShowError("Choose Flat"); return; }
        if (transferDate is null) { ShowError("Choose Date"); return; }

        isBusy = true;
        try
        {
            var targetFlatNo = transferFlats.FirstOrDefault(f => f.FlatId == transferFlatId)?.FlatNo ?? "";
            var targetSocietyName = transferSocieties.FirstOrDefault(s => s.SocietyId == transferSocietyId)?.SocietyName ?? "";
            var targetLocationName = transferLocations.FirstOrDefault(s => s.SocietyId == transferLocationId)?.SocietyName ?? "";

            var result = await AssetService.TransferAssetAsync(new AssetTransferRequest(
                transferAssetRef, flat!.FlatNo ?? "", flat.SocietyName ?? "", flat.LocationName ?? "",
                transferFlatId, targetFlatNo, targetSocietyName, targetLocationName, transferDate.Value.ToString("dd/MM/yyyy"), transferRemark));

            if (!result.Success) { ShowError(result.Error ?? "Some Error Occured. Please try later..."); return; }

            await LoadAllAsync();
            transferAssetRef = ""; transferDetail = null; transferDate = null;
            transferLocationId = ""; transferSocietyId = ""; transferFlatId = ""; transferRemark = "";
            ShowSuccess("Asset Transferred SuccessFully..");
        }
        finally { isBusy = false; }
    }

