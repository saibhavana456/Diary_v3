            var name when name.Contains("Mandatory Report ATR MIS", StringComparison.OrdinalIgnoreCase) => "reports/ATRMISReport",
            var name when name.Contains("ATM Working Daily Dashboard", StringComparison.OrdinalIgnoreCase) => "reports/ATMWorkingDailyDashboard",
            var name when name.Contains("ATM Working Dashboard", StringComparison.OrdinalIgnoreCase) => "reports/ATMWorkingDashboard",
            var name when name.Contains("Dashboard SB RBI Observations", StringComparison.OrdinalIgnoreCase) => "reports/RBISBObservations",
            var name when name.Contains("Dashboard CA RBI Observations", StringComparison.OrdinalIgnoreCase) => "reports/SBCARbiObservations",
            var name when name.Contains("Dashboard CA RBI Observations Cust ID Wise", StringComparison.OrdinalIgnoreCase) => "reports/RBICAObservationDashboardNew",
            var name when name.Contains("Dashboard SB RBI Observations Cust ID Wise(Active)", StringComparison.OrdinalIgnoreCase) => "reports/RBISBCAObservationsDashBoard_Active",
            var name when name.Contains("Dashboard SB RBI Observations Cust ID Wise(Inactive)", StringComparison.OrdinalIgnoreCase) => "reports/RBISBCAObservationsDashBoard_InActive",

            // New Reports
            var name when name.Contains("BC Master", StringComparison.OrdinalIgnoreCase) => "reports/bc-master",
            var name when name.Contains("Blood Donation", StringComparison.OrdinalIgnoreCase) => "reports/blood-donation",
            var name when name.Contains("Login Report", StringComparison.OrdinalIgnoreCase) => "reports/login-report",
            var name when name.Contains("Job Master", StringComparison.OrdinalIgnoreCase) => "reports/job-master",
            var name when name.Contains("Job Admin", StringComparison.OrdinalIgnoreCase) => "reports/job-master",
            var name when name.Contains("TPPD Dashboard", StringComparison.OrdinalIgnoreCase) => "reports/tppd-dashboard",
            var name when name.Contains("Third Party Product Distribution Dashboard", StringComparison.OrdinalIgnoreCase) => "reports/tppd-dashboard",
            var name when name.Contains("LCR Position", StringComparison.OrdinalIgnoreCase) => "reports/lcr-display",
            var name when name.Contains("LCR", StringComparison.OrdinalIgnoreCase) => "reports/lcr-display",

            // Default (fallback)
            _ => "dashboard_new_1"
        };

        // Append the Title as a query parameter (e.g., /reports/sundry?title=Sundry Data - OAP)
        var uri = Nav.GetUriWithQueryParameters(targetRoute, new Dictionary<string, object?>
        {
            { "title", record.Name }
        });

        Nav.NavigateTo(uri);
    }
}
