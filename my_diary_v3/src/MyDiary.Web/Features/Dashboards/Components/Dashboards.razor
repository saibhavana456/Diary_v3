                @*  <div class="d-flex align-center justify-space-between mb-6 border-bottom">
                <MudTabs Elevation="0" MinimumWidth="50px" ActivePanelIndexChanged="OnSubTabChanged" Class="sub-nav-tabs" SliderColor="MudBlazor.Color.Transparent">
                @foreach (var sub in _subCategories)
                {
                <MudTabPanel Text="@sub" />
                }
                </MudTabs>
                <div class="minimal-toggle-container">
                <MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" @bind-Value="_currentView" Color="MudBlazor.Color.Dark" CheckMark="false" Class="custom-toggle">
                <MudToggleItem Value="@("Terminal")" Text="Terminal" />
                <MudToggleItem Value="@("Avg")" Text="Avg" />
                </MudToggleGroup>
                </div>
                </div> *@
                <MudCard Class="overflow-hidden h-100" Elevation="2" Style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 0; border-bottom-right-radius: 0;">
                    <MudCardHeader Class="d-flex align-center justify-center text-white"
                                   Style="height:50px; font-weight:800; letter-spacing:.3px;
                          background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
                        @DisplayName
                    </MudCardHeader>
                </MudCard>
                @* --- 2x2 Balanced Grid --- *@

                <MudGrid Class="mb-2 p-2">
                    <MudItem xs="12" Class="d-flex justify-end align-end">
                        <MudToggleGroup T="string"
                                        Value="@viewMode"
                                        ValueChanged="OnViewModeChanged"
                                        Delimiter="false"
                                        Color="MudBlazor.Color.Info"
                                        Rounded="true"
                                        CheckIcon="@Icons.Material.Filled.ViewModule">
                            <MudToggleItem Value="@("List")" Icon="@Icons.Material.Filled.List" />
                            <MudToggleItem Value="@("Grid")" Icon="@Icons.Material.Filled.GridView" />
                        </MudToggleGroup>
                    </MudItem>
                </MudGrid>



                <MudGrid Spacing="1" Class="p-3 mb-5 pl-9">

                    @if (viewMode == "Grid")
                    {
                        <MudGrid>
                            @foreach (var subChild in Records)
                            {
                                @* Wrap the card in a div with the click handler *@
                                <div class="col-sm-6 col-md-4 col-lg-3 pa-3" @onclick="() => RedirectTo(subChild)" style="cursor:pointer;">
                                    <div class="menu-card">
                                        <div class="vertical-card menu-trigger rounded-lg shadow-sm" tabindex="0" role="button">
                                            <div class="card-body p-3 card-height">
                                                <div class="d-flex align-items-center">
                                                    <div class="icon-wrapper me-3">
                                                        <MudIcon Icon="@subChild.icons" Color="MudBlazor.Color.Inherit" Size="MudBlazor.Size.Medium" />
                                                    </div>
                                                    <div class="content-wrapper">
                                                        <p class="vertical-title mb-0" style="color:black;">
                                                            @subChild.Name
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @* Details Popover *@
                                        <div class="vertical-card detail-card rounded-lg shadow-sm">
                                            <div class="card-body p-3">
                                                Data Reloaded : @subChild.DateOfData<br />
                                                Location : @subChild.Location<br />
                                                Owner : @subChild.Owner
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </MudGrid>
                    }
                    else
                    {

                        <MudTable T="RecordData" Items="@Records" Dense="true" Hover="true" Striped="true" Bordered="true">
                            <HeaderContent>
                                <MudTh Style="background-color:#2a2f5b; color:white;">
                                    <MudTableSortLabel SortBy="new Func<RecordData, object>(x => x.Name)">Name</MudTableSortLabel>
                                </MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Date</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Location</MudTh>
                                <MudTh Style="background-color:#2a2f5b; color:white;">Owner</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    @* Dynamic click handler for the list view *@
                                    <a @onclick="() => RedirectTo(context)" style="color:#0b4ea2; cursor:pointer; text-decoration:none;">
                                        @context.Name
                                    </a>
                                </MudTd>
                                <MudTd>@context.DateOfData</MudTd>
                                <MudTd>@context.Location</MudTd>
                                <MudTd>@context.Owner</MudTd>
                            </RowTemplate>
                        </MudTable>


                        @* <MudTable T="string">
                    <RowTemplate>
                    @foreach (var subChild in Records)
                    {
                    @* <MudListItem Text="@subChild.Name" Icon="@Icons.Material.Filled.Label" />
                    <MudTd Style="text-align:right;">@subChild.Name</MudTd>
                    <MudTd Style="text-align:right;">@subChild.DateOfData</MudTd>
                    <MudTd Style="text-align:right;">@subChild.Location</MudTd>
                    <MudTd Style="text-align:right;">@subChild.Owner</MudTd>
                    }
                    </RowTemplate>
                    </MudTable> *@
                    }


                    @* Total Business, Total Advances, Business, Advances, Deposits, Total Deposits *@

                    @* 3. Total Advances Growth : Line Chart *@




                    @* @foreach (var subChild in @menus)
                    {
                    <div class="col-sm-6 col-md-4 col-lg-3 pa-2">

                    <div class="vertical-card card-primary rounded-lg shadow-sm">
                    <div class="card-body p-3">
                    <div class="d-flex align-items-center">

                    <div class="icon-wrapper me-3">
                    <MudIcon Icon="@MudBlazor.Icons.Material.Outlined.MenuOpen"
                    Color="MudBlazor.Color.Inherit"
                    Size="MudBlazor.Size.Medium" />

                    </div>
                    <div class="content-wrapper">
                    <p class="vertical-title mb-0">
                    @subChild
                    </p>
                    </div>
                    </div>
                    </div>

                    </div>
                    <div class="vertical-card rounded-lg shadow-sm">
                    <div class="card-body p-3">
                    Lorem ipsum
                    </div>
                    </div>
                    </div>
                    } *@
                </MudGrid>
            </MudPaper>

        </div>
    </MudItem>

</MudGrid>


@code {

    private string viewMode = "Grid";
    private string _userPrivilege = "CO", _userSolid = "00000";
    [Parameter] public string? menu { get; set; }

    // Friendly display name mapping
    private string DisplayName => menu switch
    {
        "AppDashboard" => "Application Dashboard",
        "Dash" => "Assurance Corner",
        "Alerts" => "Alerts",
        "Leads" => "Leads",
        "Reports" => "Reports",
        "business" => "Business Analytics",
        _ => menu ?? "Dashboard" // Fallback to raw value or default
    };

    protected override async Task OnParametersSetAsync()
    {
        // menu will be "Alerts", "AppDashboard", "business", "Landing_Dashboard_V2", etc.
        try
        {
            isLoading = true;
            loadError = null;
            await LoadUserClaims();
            Records = await DashboardsServices.GetRecordDataAsync(menu);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "Dashboards: failed to load dashboards data");
            loadError = UserFacingError.Generic;
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task LoadUserClaims()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userPrivilege = user.FindFirst("privilege")?.Value?.ToUpper() ?? "CO";
            if (_userPrivilege == "ZONE") _userSolid = user.FindFirst("zone_solid")?.Value ?? "00000";
            else if (_userPrivilege == "REGION") _userSolid = user.FindFirst("region_solid")?.Value ?? "00000";
            else if (_userPrivilege == "BRANCH") _userSolid = user.FindFirst("branch_solid")?.Value ?? "00000";
        }
    }
    void Go(string name)
    {
        NavState.ClickedName = name;
        Nav.NavigateTo("dashboard_new_1");
    }

