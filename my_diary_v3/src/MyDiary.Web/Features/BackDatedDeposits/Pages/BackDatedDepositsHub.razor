@page "/deposits/hub"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using global::RequestPortal.Core.Abstractions
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IDmdRbacService DmdRbacService

<PageTitle>Back-Dated Deposit Approvals - My Diary</PageTitle>

<PageHeader Title="Back-Dated Deposit Approvals" Subtitle="Raise, track and approve back-dated Retail/Bulk Deposit opening & renewal proposals — Branch to RO to ZO to DMD CO." Crumbs="_crumbs" PageKey="bdd-hub" />

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (_isBranch)
    {
        <div class="fm-hub-section-heading">BRANCH</div>
        <div class="fm-hub-grid mb-6">
            <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/new"))">
                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="fm-hub-card-icon" />
                <div class="fm-hub-card-title">New Proposal</div>
                <div class="fm-hub-card-desc">Raise a Retail or Bulk back-dated deposit opening/renewal proposal.</div>
            </div>
            <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/my"))">
                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Class="fm-hub-card-icon" />
                <div class="fm-hub-card-title">My Proposals</div>
                <div class="fm-hub-card-desc">Track proposals you've submitted, resubmit after a return/clarification.</div>
            </div>
        </div>
    }

    @if (_isRo)
    {
        <div class="fm-hub-section-heading">REGIONAL OFFICE</div>
        <div class="fm-hub-grid mb-6">
            <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/ro-queue"))">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="fm-hub-card-icon" />
                <div class="fm-hub-card-title">Pending at RO</div>
                <div class="fm-hub-card-desc">Recommend, seek clarification, or return proposals from your branches.</div>
            </div>
        </div>
    }

    @if (_isZo)
    {
        <div class="fm-hub-section-heading">ZONAL OFFICE</div>
        <div class="fm-hub-grid mb-6">
            <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/zo-queue"))">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="fm-hub-card-icon" />
                <div class="fm-hub-card-title">Pending at ZO</div>
                <div class="fm-hub-card-desc">Recommend/sanction, seek clarification, or return/reject.</div>
            </div>
        </div>
    }

    @if (_isDmd)
    {
        <div class="fm-hub-section-heading">DMD CORPORATE OFFICE</div>
        <div class="fm-hub-grid mb-6">
            <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/dmd-queue"))">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="fm-hub-card-icon" />
                <div class="fm-hub-card-title">Pending at DMD</div>
                <div class="fm-hub-card-desc">Final decision — approve, reject, return, or seek clarification.</div>
            </div>
        </div>
    }

    <div class="fm-hub-section-heading">COMMON</div>
    <div class="fm-hub-grid mb-6">
        <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/audit-trail"))">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="fm-hub-card-icon" />
            <div class="fm-hub-card-title">Audit Trail</div>
            <div class="fm-hub-card-desc">Full immutable action history across every proposal.</div>
        </div>
        <div class="fm-hub-card" @onclick="@(() => Nav.NavigateTo("deposits/dashboard"))">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="fm-hub-card-icon" />
            <div class="fm-hub-card-title">Dashboard / MIS</div>
            <div class="fm-hub-card-desc">Pending, Approved, Rejected counts and ageing at each stage.</div>
        </div>
    </div>

    <AuthorizeView Policy="AppAdmin">
        <Authorized>
            <MudDivider Class="mb-6" />
            <div class="fm-hub-section-heading fm-hub-section-admin">
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Class="mr-1" />
                ADMINISTRATION
            </div>
            <div class="fm-hub-grid">
                <div class="fm-hub-card fm-hub-card-admin" @onclick="@(() => Nav.NavigateTo("deposits/admin/dmd-approvers"))">
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="fm-hub-card-icon" />
                    <div class="fm-hub-card-title">DMD Approver Allocation</div>
                    <div class="fm-hub-card-desc">Assign/revoke the DMD Approver desk role and the DMD Vertical Admin.</div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
}

<style>
    .fm-hub-section-heading { font-size: .8rem; font-weight: 700; letter-spacing: .06em; color: var(--mud-palette-text-secondary); margin-bottom: 12px; }
    .fm-hub-section-admin { color: var(--rp-navy, #1E3A8A); display: flex; align-items: center; }
    .fm-hub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
    .fm-hub-card { cursor: pointer; border-radius: 12px; padding: 20px; background: #fff; border: 1px solid rgba(0,0,0,.08); transition: transform .15s, box-shadow .15s; }
    .fm-hub-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.15); }
    .fm-hub-card-admin { border-left: 3px solid var(--rp-navy, #1E3A8A); }
    .mud-theme-dark .fm-hub-card, .cc-dark .fm-hub-card { background: #1c1f24; border-color: #2a2e35; }
    .fm-hub-card-icon { font-size: 2rem; color: var(--mud-palette-primary); margin-bottom: 8px; }
    .fm-hub-card-title { font-weight: 600; font-size: 1rem; margin-bottom: 4px; }
    .fm-hub-card-desc { font-size: .82rem; opacity: .75; }
</style>

@code {
    private readonly List<PageHeader.Crumb> _crumbs = new() { new("Applications", "app-portal1"), new("Back-Dated Deposit Approvals") };
    private bool _loading = true;
    private bool _isBranch, _isRo, _isZo, _isDmd;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var roles = state.User
              .FindFirst("privilege")?.Value?
              .ToUpper() ?? "CO";


        _isBranch = roles.Contains("BRANCH") || roles.Contains("BranchHead");
        _isRo = roles.Contains("REGION") || roles.Contains("RoHead");
        _isZo = roles.Contains("ZONE") || roles.Contains("ZoHead");

        var empId = user.FindFirst("emplid")?.Value ?? "";
        _isDmd = !string.IsNullOrWhiteSpace(empId) && await DmdRbacService.IsDmdApproverAsync(empId);

        // Fall back: if none of the attribute-derived roles matched (e.g. a Developer-Bypass test user
        // with no HRMS row), show the Branch cards so the feature is still reachable for a smoke test.
        if (!_isBranch && !_isRo && !_isZo && !_isDmd) _isBranch = true;

        _loading = false;
    }
}
