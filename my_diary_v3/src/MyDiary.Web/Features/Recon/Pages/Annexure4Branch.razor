@page "/recon/annexure4/branch"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using System.Globalization
@using global::RequestPortal.Core.Models
@using global::RequestPortal.Core.Services
@using MyDiary.Web.Features.Recon.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IReconAnnexure4Service ReconService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Annexure 4 — Branch Reconciliation Certificate</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">Annexure 4 — Inter-Branch / Sundry / Suspense / POB Reconciliation</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @_entry.BranchName (@_entry.BranchCode) — @_entry.ReportMonth @_entry.ReportYear
    </MudText>

    @if (_isLocked)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
            Submitted. This report is locked — it can only be edited again if RO Operations returns it.
        </MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Branch Details</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_entry.BranchHead" Label="Branch Head" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_entry.MobileNo" Label="Mobile Number" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_entry.IpNo" Label="IP Number" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
        </MudGrid>
    </MudPaper>

    @foreach (var g in _groups)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@g.Title</MudText>
            <MudGrid>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.Upto3MEntries" Label="Upto 3M — Entries" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.Upto3MAmount" Label="Upto 3M — Amount" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.Three6MEntries" Label="3-6M — Entries" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.Three6MAmount" Label="3-6M — Amount" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.Over6MEntries" Label="Over 6M — Entries" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.Over6MAmount" Label="Over 6M — Amount" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.NewOver6MEntries" Label="New Over 6M — Entries" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="g.NewOver6MAmount" Label="New Over 6M — Amount" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="g.Reason" Label="Reason" Lines="2" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="g.Efforts" Label="Efforts Taken" Lines="2" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-2">
            <MudText Typo="Typo.subtitle1">Inter-Bank Breakup</MudText>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Disabled="_isLocked"
                       OnClick="@(() => _entry.BreakupEntries.Add(new ReconA4InterbankBreakup()))">Add Row</MudButton>
        </div>
        @foreach (var row in _entry.BreakupEntries.ToList())
        {
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="2"><MudTextField @bind-Value="row.BranchName" Label="Branch" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="2"><MudTextField @bind-Value="row.InterBankName" Label="Inter-Bank" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="2"><MudNumericField @bind-Value="row.OurDebitAmount" Label="Our Debit" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="2"><MudNumericField @bind-Value="row.OurCreditAmount" Label="Our Credit" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="2"><MudNumericField @bind-Value="row.TheirDebitAmount" Label="Their Debit" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="1"><MudNumericField @bind-Value="row.TheirCreditAmount" Label="Their Credit" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="_isLocked" OnClick="@(() => _entry.BreakupEntries.Remove(row))" />
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    @RenderOsGt3MonSection("Sundry — Outstanding > 3 Months", _entry.SundryEntries)
    @RenderOsGt3MonSection("Suspense — Outstanding > 3 Months", _entry.SuspenseEntries)
    @RenderOsGt3MonSection("POB — Outstanding > 3 Months", _entry.PobEntries)

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-2">
            <MudText Typo="Typo.subtitle1">Books Not Tallied</MudText>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Disabled="_isLocked"
                       OnClick="@(() => _entry.BooksNotTallied.Add(new ReconA4BooksNotTallied()))">Add Row</MudButton>
        </div>
        @foreach (var row in _entry.BooksNotTallied.ToList())
        {
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="row.BranchName" Label="Branch" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="row.HeadsNotTallied" Label="Heads Not Tallied" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="6" sm="2"><MudNumericField @bind-Value="row.DifferenceAmountRupees" Label="Difference (₹)" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="row.Reason" Label="Reason" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="_isLocked" OnClick="@(() => _entry.BooksNotTallied.Remove(row))" />
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Inter-Bank Reconciliation — Account Position</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.body1">Reconciled</MudText>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Disabled="_isLocked"
                               OnClick="@(() => _entry.BrPositionReconciled.Add(new ReconA4IbReconBrPosition { ReconciliationStatus = "Reconciled" }))">Add</MudButton>
                </div>
                @foreach (var row in _entry.BrPositionReconciled.ToList())
                {
                    <MudGrid Class="mb-1">
                        <MudItem xs="5"><MudTextField @bind-Value="row.IbrAccountBank" Label="Bank" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                        <MudItem xs="5"><MudTextField @bind-Value="row.IbrAccountBankBranch" Label="Branch" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                        <MudItem xs="2"><MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="_isLocked" OnClick="@(() => _entry.BrPositionReconciled.Remove(row))" /></MudItem>
                    </MudGrid>
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.body1">Not Reconciled</MudText>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Disabled="_isLocked"
                               OnClick="@(() => _entry.BrPositionNotReconciled.Add(new ReconA4IbReconBrPosition { ReconciliationStatus = "Not Reconciled" }))">Add</MudButton>
                </div>
                @foreach (var row in _entry.BrPositionNotReconciled.ToList())
                {
                    <MudGrid Class="mb-1">
                        <MudItem xs="5"><MudTextField @bind-Value="row.IbrAccountBank" Label="Bank" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                        <MudItem xs="5"><MudTextField @bind-Value="row.IbrAccountBankBranch" Label="Branch" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                        <MudItem xs="2"><MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="_isLocked" OnClick="@(() => _entry.BrPositionNotReconciled.Remove(row))" /></MudItem>
                    </MudGrid>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudStack Row="true" Spacing="3">
        @if (!_isLocked)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_saving" OnClick="SaveDraft">Save Draft</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="_saving" OnClick="SubmitFinal">Submit</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Disabled="_downloading" OnClick="DownloadPdf">
                @(_downloading ? "Generating..." : "Download PDF")
            </MudButton>
        }
    </MudStack>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _isLocked;
    private string _empId = "", _branchSolId = "", _branchName = "", _regionName = "";
    private bool _downloading;
    private ReconAnnexure4 _entry = new();

    private sealed class FieldGroup
    {
        public string Title { get; set; } = "";
        public long? Upto3MEntries { get; set; }
        public decimal? Upto3MAmount { get; set; }
        public long? Three6MEntries { get; set; }
        public decimal? Three6MAmount { get; set; }
        public long? Over6MEntries { get; set; }
        public decimal? Over6MAmount { get; set; }
        public long? NewOver6MEntries { get; set; }
        public decimal? NewOver6MAmount { get; set; }
        public string? Reason { get; set; }
        public string? Efforts { get; set; }
    }

    private List<FieldGroup> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _empId = user.FindFirst("emplid")?.Value ?? "";
        _branchSolId = user.FindFirst("branch_solid")?.Value ?? "";
        _branchName = user.FindFirst("branch_name")?.Value ?? "";
        _regionName = user.FindFirst("region_name")?.Value ?? "";

        // Same target period as the source app: previous calendar month.
        var targetMonth = DateTime.Now.AddMonths(-1).ToString("MMMM", CultureInfo.InvariantCulture);
        var targetYear = DateTime.Now.AddMonths(-1).ToString("yyyy", CultureInfo.InvariantCulture);

        var existing = await ReconService.GetBranchEntryAsync(_empId, _branchSolId, targetMonth, targetYear);
        if (existing is not null)
        {
            _entry = existing;
            // Only lock if actually submitted, not if returned (105) — same rule as source.
            _isLocked = _entry.Status == "101";
        }
        else
        {
            _entry.ReportMonth = targetMonth;
            _entry.ReportYear = targetYear;
            _entry.BranchCode = _branchSolId;
            _entry.BranchName = _branchName;
        }

        BindGroups();
        _loading = false;
    }

    private void BindGroups()
    {
        _groups = new List<FieldGroup>
        {
            new() { Title = "Sundry", Upto3MEntries = _entry.SunUpto3MEntries, Upto3MAmount = _entry.SunUpto3MAmount,
                    Three6MEntries = _entry.SunThree6MEntries, Three6MAmount = _entry.SunThree6MAmount,
                    Over6MEntries = _entry.SunOver6MEntries, Over6MAmount = _entry.SunOver6MAmount,
                    NewOver6MEntries = _entry.SunNewOver6MEntries, NewOver6MAmount = _entry.SunNewOver6MAmount,
                    Reason = _entry.SunReason, Efforts = _entry.SunEfforts },
            new() { Title = "Suspense", Upto3MEntries = _entry.SusUpto3MEntries, Upto3MAmount = _entry.SusUpto3MAmount,
                    Three6MEntries = _entry.SusThree6MEntries, Three6MAmount = _entry.SusThree6MAmount,
                    Over6MEntries = _entry.SusOver6MEntries, Over6MAmount = _entry.SusOver6MAmount,
                    NewOver6MEntries = _entry.SusNewOver6MEntries, NewOver6MAmount = _entry.SusNewOver6MAmount,
                    Reason = _entry.SusReason, Efforts = _entry.SusEfforts },
            new() { Title = "POB", Upto3MEntries = _entry.PobUpto3MEntries, Upto3MAmount = _entry.PobUpto3MAmount,
                    Three6MEntries = _entry.PobThree6MEntries, Three6MAmount = _entry.PobThree6MAmount,
                    Over6MEntries = _entry.PobOver6MEntries, Over6MAmount = _entry.PobOver6MAmount,
                    NewOver6MEntries = _entry.PobNewOver6MEntries, NewOver6MAmount = _entry.PobNewOver6MAmount,
                    Reason = _entry.PobReason, Efforts = _entry.PobEfforts },
            new() { Title = "Inter-Bank (IBK)", Upto3MEntries = _entry.IbkUpto3MEntries, Upto3MAmount = _entry.IbkUpto3MAmount,
                    Three6MEntries = _entry.IbkThree6MEntries, Three6MAmount = _entry.IbkThree6MAmount,
                    Over6MEntries = _entry.IbkOver6MEntries, Over6MAmount = _entry.IbkOver6MAmount,
                    NewOver6MEntries = _entry.IbkNewOver6MEntries, NewOver6MAmount = _entry.IbkNewOver6MAmount,
                    Reason = _entry.IbkReason, Efforts = _entry.IbkEfforts },
        };
    }

    private void ApplyGroupsBack()
    {
        var sun = _groups[0]; var sus = _groups[1]; var pob = _groups[2]; var ibk = _groups[3];

        _entry.SunUpto3MEntries = sun.Upto3MEntries; _entry.SunUpto3MAmount = sun.Upto3MAmount;
        _entry.SunThree6MEntries = sun.Three6MEntries; _entry.SunThree6MAmount = sun.Three6MAmount;
        _entry.SunOver6MEntries = sun.Over6MEntries; _entry.SunOver6MAmount = sun.Over6MAmount;
        _entry.SunNewOver6MEntries = sun.NewOver6MEntries; _entry.SunNewOver6MAmount = sun.NewOver6MAmount;
        _entry.SunReason = sun.Reason; _entry.SunEfforts = sun.Efforts;

        _entry.SusUpto3MEntries = sus.Upto3MEntries; _entry.SusUpto3MAmount = sus.Upto3MAmount;
        _entry.SusThree6MEntries = sus.Three6MEntries; _entry.SusThree6MAmount = sus.Three6MAmount;
        _entry.SusOver6MEntries = sus.Over6MEntries; _entry.SusOver6MAmount = sus.Over6MAmount;
        _entry.SusNewOver6MEntries = sus.NewOver6MEntries; _entry.SusNewOver6MAmount = sus.NewOver6MAmount;
        _entry.SusReason = sus.Reason; _entry.SusEfforts = sus.Efforts;

        _entry.PobUpto3MEntries = pob.Upto3MEntries; _entry.PobUpto3MAmount = pob.Upto3MAmount;
        _entry.PobThree6MEntries = pob.Three6MEntries; _entry.PobThree6MAmount = pob.Three6MAmount;
        _entry.PobOver6MEntries = pob.Over6MEntries; _entry.PobOver6MAmount = pob.Over6MAmount;
        _entry.PobNewOver6MEntries = pob.NewOver6MEntries; _entry.PobNewOver6MAmount = pob.NewOver6MAmount;
        _entry.PobReason = pob.Reason; _entry.PobEfforts = pob.Efforts;

        _entry.IbkUpto3MEntries = ibk.Upto3MEntries; _entry.IbkUpto3MAmount = ibk.Upto3MAmount;
        _entry.IbkThree6MEntries = ibk.Three6MEntries; _entry.IbkThree6MAmount = ibk.Three6MAmount;
        _entry.IbkOver6MEntries = ibk.Over6MEntries; _entry.IbkOver6MAmount = ibk.Over6MAmount;
        _entry.IbkNewOver6MEntries = ibk.NewOver6MEntries; _entry.IbkNewOver6MAmount = ibk.NewOver6MAmount;
        _entry.IbkReason = ibk.Reason; _entry.IbkEfforts = ibk.Efforts;
    }

    private RenderFragment RenderOsGt3MonSection(string title, List<ReconA4OsGt3MonBreakup> list) => __builder =>
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1">@title</MudText>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Disabled="_isLocked"
                           OnClick="@(() => list.Add(new ReconA4OsGt3MonBreakup()))">Add Row</MudButton>
            </div>
            @foreach (var row in list.ToList())
            {
                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="row.NatureOfEntry" Label="Nature of Entry" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                    <MudItem xs="6" sm="2"><MudNumericField @bind-Value="row.OutstandingAmountRupees" Label="Outstanding (₹)" Format="N3" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="row.StatusReasonPendency" Label="Status / Reason for Pendency" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                    <MudItem xs="12" sm="2"><MudDatePicker @bind-Date="row.ExpectedReversalDate" Label="Expected Reversal" Variant="Variant.Outlined" Disabled="_isLocked" /></MudItem>
                    <MudItem xs="12" sm="1"><MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="_isLocked" OnClick="@(() => list.Remove(row))" /></MudItem>
                </MudGrid>
            }
        </MudPaper>
    };

    private async Task SaveDraft()
    {
        ApplyGroupsBack();
        _saving = true;
        try
        {
            await ReconService.SaveDraftAsync(_empId, _entry);
            Snackbar.Add("Draft saved successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SubmitFinal()
    {
        ApplyGroupsBack();
        _saving = true;
        try
        {
            await ReconService.SubmitAsync(_empId, _entry);
            Snackbar.Add("Report submitted successfully!", Severity.Success);
            _isLocked = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadPdf()
    {
        _downloading = true;
        try
        {
            var bytes = ReconPdfExportService.GenerateAnnexure4Pdf(_entry, _regionName);
            var fileName = $"Annexure4_{_entry.BranchCode}_{_entry.ReportMonth}{_entry.ReportYear}.pdf";
            await JS.InvokeVoidAsync("appDownloadFile", fileName, Convert.ToBase64String(bytes), "application/pdf");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloading = false;
        }
    }
}
