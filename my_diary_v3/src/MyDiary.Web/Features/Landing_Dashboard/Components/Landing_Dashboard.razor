<style>
    .category-nav-wrapper {
        display: flex;
        gap: 12px;
        overflow-x: auto;
    }

    .nav-item {
        padding: 10px 22px;
        background-color: #d1e3ff;
        color: #1e3a8a;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 700;
        white-space: nowrap;
        font-size: 0.9rem;
        transition: 0.2s;
    }

        .nav-item.active {
            background-color: #1b4a98;
            color: #ffffff;
        }

    .sub-nav-tabs .mud-tab {
        color: #666 !important;
        font-size: 0.85rem !important;
        font-weight: 600 !important;
        text-transform: none !important;
        border-bottom: 3px solid transparent;
    }

        .sub-nav-tabs .mud-tab.mud-tab-active {
            color: #1b4a98 !important;
            border-bottom: 3px solid #1b4a98 !important;
        }

    .sub-nav-tabs .mud-tabs-slider {
        display: none !important;
    }

    .custom-toggle {
        background: #eee;
        border-radius: 6px;
        padding: 2px;
    }

        .custom-toggle .mud-toggle-item {
            font-size: 0.75rem !important;
            padding: 4px 12px !important;
            border: none !important;
        }

        .custom-toggle .mud-toggle-item-selected {
            background: #1a2035 !important;
            color: white !important;
            border-radius: 4px !important;
        }

    .border-bottom {
        border-bottom: 2px solid #f0f0f0;
    }

    .border-left {
        border-left: 1px solid #e0e0e0;
    }

    .fw-bold {
        font-weight: 700 !important;
    }

    .uppercase {
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>

@code {
    private string ActiveCategory = "Advances";
    private string ActiveSubCategory = "Total Advances";
    private string _currentView = "Terminal";

    private List<string> _categories = new() { "Advances", "Deposits", "Income", "Operating Profit", "Compliance", "Digital Banking", "Customer Satisfaction" };
    private List<string> _subCategories = new() { "Total Advances", "Retail", "MSME", "Agriculture", "Corporate Loans" };

    public class MetricData { public string Category { get; set; } = ""; public decimal Value { get; set; } }

    private List<MetricData> _portfolioItems = new() {
        new MetricData { Category = "Corporate", Value = 50 },
        new MetricData { Category = "Retail", Value = 76 },
        new MetricData { Category = "Agri", Value = 69 },
        new MetricData { Category = "MSME", Value = 75 }
    };

    private List<MetricData> _bookData = new() {
        new MetricData { Category = "Mar 23", Value = 221043 },
        new MetricData { Category = "Jun 23", Value = 234241 },
        new MetricData { Category = "Sep 23", Value = 250544 },
        new MetricData { Category = "Nov 23", Value = 273798 }
    };

    private List<MetricData> _growthTrend = new() {
        new MetricData { Category = "Jan", Value = 2.1m },
        new MetricData { Category = "Feb", Value = 3.4m },
        new MetricData { Category = "Mar", Value = 4.0m },
        new MetricData { Category = "Apr", Value = 3.8m }
    };

    private ApexChartOptions<MetricData> _donutOptions = new()
    {
        Legend = new Legend { Position = LegendPosition.Bottom },
        Colors = new List<string> { "#507CA2", "#518CBF", "#89B1D3", "#6294C1" }
    };

    private ApexChartOptions<MetricData> _columnOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "#147ad6" }
    };

    private ApexChartOptions<MetricData> _lineOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Stroke = new Stroke { Curve = Curve.Smooth },
        Colors = new List<string> { "#2a9d5c" }
    };

    private List<BreadcrumbItem> _breadcrumbs => new() {
        new BreadcrumbItem("Business", href: "#"),
        new BreadcrumbItem(ActiveCategory, href: null, disabled: true)
    };

    private void SelectCategory(string category) { ActiveCategory = category; StateHasChanged(); }
    private void OnSubTabChanged(int index)
    {
        if (index >= 0 && index < _subCategories.Count)
        {
            ActiveSubCategory = _subCategories[index];
            StateHasChanged();
        }
    }
}