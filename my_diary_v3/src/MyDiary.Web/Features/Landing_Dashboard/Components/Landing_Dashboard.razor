@page "/Landing_Dashboard"
@using ApexCharts
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())

<MudGrid Spacing="3">
        <!-- LEFT: 9 columns -->
        <MudItem xs="12" md="10">

<div id="business-page-root" class="pa-4">
    @* --- Breadcrumbs & Filters --- *@
    <div class="d-flex align-center justify-space-between mb-4">
        <MudBreadcrumbs Items="_breadcrumbs" Separator="/" />
        <div class="d-flex gap-2">
            <MudSelect T="string" Label="Entity" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 150px; background: white;">
                <MudSelectItem Value="@("All Units")" />
            </MudSelect>
            <MudSelect T="string" Label="Period" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 150px; background: white;">
                <MudSelectItem Value="@("FY 2024-25")" />
            </MudSelect>
        </div>
    </div>

    @* --- LEVEL 1: Navigation --- *@
    <div class="category-nav-wrapper mb-6">
        @foreach (var cat in _categories)
        {
            <div class="nav-item @(ActiveCategory == cat ? "active" : "")" @onclick="() => SelectCategory(cat)">
                @cat
            </div>
        }
    </div>

    <MudPaper Elevation="0" Class="pa-6 rounded-lg border" Style="background-color: #ffffff;">
        @* --- LEVEL 2: Sub-Navigation --- *@
        <div class="d-flex align-center justify-space-between mb-6 border-bottom">
            <MudTabs Elevation="0" MinimumWidth="50px" ActivePanelIndexChanged="OnSubTabChanged" Class="sub-nav-tabs" SliderColor="MudBlazor.Color.Transparent">
                @foreach (var sub in _subCategories)
                {
                    <MudTabPanel Text="@sub" />
                }
            </MudTabs>
            <div class="minimal-toggle-container">
                <MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" @bind-Value="_currentView" Color="MudBlazor.Color.Dark" CheckMark="false" Class="custom-toggle">
                    <MudToggleItem Value="@("Terminal")" Text="Terminal" />
                    <MudToggleItem Value="@("Avg")" Text="Avg" />
                </MudToggleGroup>
            </div>
        </div>

        @* --- 2x2 Balanced Grid --- *@
        <MudGrid Spacing="4">

            @* 1. Refined Performance Card *@
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-5 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
                    <div class="d-flex justify-space-between align-center mb-auto">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">@ActiveSubCategory Performance</MudText>
                        <MudText Typo="Typo.caption" Style="color: #1572e8; font-weight: 600;">Amt (Crores)</MudText>
                    </div>

                    <div class="d-flex align-center justify-space-around flex-grow-1">
                        @* Left Side: Big Number *@
                        <div class="text-center">
                            <MudText Typo="Typo.h2" Style="color: #1572e8;" Class="fw-bold">273.80</MudText>
                            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Actual Total</MudText>
                        </div>

                        @* Right Side: Mini Stats Vertical *@
                        <div class="d-flex flex-column gap-4 border-left pl-6">
                            <div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Current (FY 23)</MudText>
                                <MudText Typo="Typo.h6" Class="fw-bold">238.86</MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Target (FY 25)</MudText>
                                <MudText Typo="Typo.h6" Class="fw-bold">297.85</MudText>
                            </div>
                        </div>
                    </div>

                    @* Bottom: Progress Bar *@
                    <div class="mt-auto">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="fw-bold">Progress to Target</MudText>
                            <MudText Typo="Typo.caption" Class="fw-bold">92%</MudText>
                        </div>
                        <MudProgressLinear Color="MudBlazor.Color.Primary" Value="92" Height="12" Class="rounded-pill" />
                    </div>
                </MudPaper>
            </MudItem>

            @* 2. Portfolio Overview *@
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2" Style="color: #1b4a98;">Portfolio Overview</MudText>
                    <ApexChart TItem="MetricData" Options="_donutOptions" Height="240">
                        <ApexPointSeries TItem="MetricData" Items="_portfolioItems" Name="Advances" SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>

            @* 3. Outstanding Book *@
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Outstanding Book</MudText>
                        <MudToggleGroup T="string" Size="MudBlazor.Size.Small" Value="@("Amt")" Color="MudBlazor.Color.Primary">
                            <MudToggleItem Value="@("NOA")" />
                            <MudToggleItem Value="@("Amt")" />
                        </MudToggleGroup>
                    </div>
                    <ApexChart TItem="MetricData" Options="_columnOptions" Height="220">
                        <ApexPointSeries TItem="MetricData" Items="_bookData" Name="Amount" SeriesType="SeriesType.Bar" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>

            @* 4. Total Advances Growth *@
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2" Style="color: #1b4a98;">Total Advances Growth</MudText>
                    <ApexChart TItem="MetricData" Options="_lineOptions" Height="220">
                        <ApexPointSeries TItem="MetricData" Items="_growthTrend" Name="Growth %" SeriesType="SeriesType.Area" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>
</div>
