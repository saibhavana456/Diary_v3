@page "/Landing_Dashboard_V2"
@using ApexCharts
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using MyDiary.Web.Features.Landing_Dashboard_V2.Services
@using MyDiary.Web.Features.Landing_Dashboard_V2.Models
@inject MyDiary.Web.Features.Landing_Dashboard_V2.Services.ILandingDashboardV2Service DashboardService
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDialogService DialogService
@using MyDiary.Web.Components.Dialogs
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())

<PageTitle>Home Dashboard — My Diary | Union Bank of India</PageTitle>

<MudGrid Spacing="3">
    <!-- LEFT: 9 columns -->
    <MudItem xs="12" md="10">

        <div id="business-page-root" class="mb-4">

            <MudPaper Elevation="0" Class="rounded-lg border" Style="background-color: #ffffff;">
                <MudCard Class="overflow-hidden h-100" Elevation="2" Style="border-radius:12px;">

                    <MudCardHeader Class="d-flex align-center justify-center text-white"
                                   Style="height:48px; font-weight:800; letter-spacing:.2px;
                                  background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
                        Home - Dashboard
                    </MudCardHeader>
                    @* As on Date *@
                    <div class="px-4 py-2 d-flex justify-end" style="border-bottom:1px solid #f1f5f9;">
                        <MudText Typo="Typo.caption" Style="color:#1b4a98; font-weight:700; font-style:italic;">
                            As on Date: @AppTime.Now.AddDays(-1).ToString("dd-MMM-yyyy")
                        </MudText>
                    </div>
                    @* --- 2x2 Balanced Grid --- *@
                    <MudGrid Spacing="2" Class="p-3">


                        @* 1. Outstanding Book *@
                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">

                                <div class="d-flex justify-space-between align-start mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Business KPIs</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #1572e8; font-weight: 500;">(% Target Achieved)</MudText>
                                </div>

                                <div class="flex-grow-1 d-flex align-center justify-center">
                                    @if (_kpiRadial != null && _kpiRadial.Any())
                                    {
                                        <ApexChart TItem="MetricData" Options="_radialOptions" Height="240" Width="@("100%")">
                                            <ApexPointSeries TItem="MetricData"
                                                             Items="_kpiRadial"
                                                             Name="Achievement %"
                                                             SeriesType="SeriesType.RadialBar"
                                                             XValue="e => e.Category"
                                                             YValue="e => e.Value" />
                                        </ApexChart>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">Calculating KPIs...</MudText>
                                    }
                                </div>

                            </MudPaper>
                        </MudItem>

                        @* 2. Refined Performance Card *@
                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
                                <div class="d-flex justify-space-between align-center mb-auto">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Advances Performance</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in @_advancesUnit)</MudText>
                                    </div>

                                    <div class="d-flex align-center justify-space-around flex-grow-1">
                                        @* Left Side: Big Number *@
                                        <div class="text-center">
                                            @* Bind to our dynamic Actual variable *@
                                            <MudText Typo="Typo.h3" Style="color: #1572e8;" Class="fw-bold">@_advancesActualTotal.ToString("0.00")</MudText>
                                            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Actual Total</MudText>
                                        </div>

                                        @* Right Side: Mini Stats Vertical *@
                                        <div class="d-flex flex-column gap-4 border-left pl-6">
                                            <div>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Current (@_currentFY)</MudText>
                                                @* Bind to our dynamic Current variable *@
                                                <MudText Typo="Typo.h5" Class="fw-bold">@_advancesCurrent.ToString("0.00")</MudText>
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Target (@_targetFY)</MudText>
                                                @* Bind to our dynamic Target variable *@
                                                <MudText Typo="Typo.h5" Class="fw-bold">@_advancesTarget.ToString("0.00")</MudText>
                                            </div>
                                        </div>
                                    </div>

                                    @* Bottom: Progress Bar *@
                                    <div class="mt-auto">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.caption" Class="fw-bold">Progress to Target</MudText>
                                            @* Bind to our safely calculated percentage *@
                                            <MudText Typo="Typo.caption" Class="fw-bold">@_advancesProgress.ToString("0")%</MudText>
                                        </div>

                                        <div class="d-flex justify-space-between mt-5 mb-5">
                                            <MudProgressLinear Color="MudBlazor.Color.Primary" Value="@_advancesProgress" Height="50" Class="rounded-pill" />
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>



                            @* 3. Total Advances Growth : Line Chart *@
                            <MudItem xs="12" md="3">
                                <MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Advances Growth</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
                                    </div>

                                    @* Added a quick null check to prevent chart rendering before data arrives *@
                                    @if (_growthTrend != null && _growthTrend.Any())
                                {
                                    <ApexChart TItem="MetricData" Options="_lineOptions" Height="240">
                                        <ApexPointSeries TItem="MetricData"
                                                         Items="_growthTrend"
                                                         Name="Advances (Cr)"
                                                         SeriesType="SeriesType.Area"
                                                         XValue="@(e => e.Category)"
                                                         YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                            </MudPaper>
                        </MudItem>

                        @* 4. Advances Portfolio Overview : Donut Chart *@
                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">

                                @* Header Section *@
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Advances Portfolio</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
                                </div>

                                @* ApexChart Section *@
                                <div class="flex-grow-1 d-flex align-center justify-center">
                                    @if (_advancesPortfolioItems != null && _advancesPortfolioItems.Any())
                                    {
                                        @* We bind directly to your existing _donutOptions2 for identical colors! *@
                                        <ApexChart TItem="MetricData" Options="_donutOptions" Height="240" Width="@("100%")">
                                            <ApexPointSeries TItem="MetricData"
                                                             Items="_advancesPortfolioItems"
                                                             Name="Advances"
                                                             SeriesType="SeriesType.Donut"
                                                             XValue="@(e => e.Category)"
                                                             YValue="@(e => e.Value)" />
                                        </ApexChart>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">Loading chart data...</MudText>
                                    }
                                </div>

                            </MudPaper>
                        </MudItem>

                        @* 5. Total Business *@
                        <MudItem xs="12" md="3">
                            @* Adjust md size based on your layout space! *@
                            <MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">

                                @* Flex header matching your previous charts *@
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Business</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
                                </div>

                                @* Render Column Chart *@
                                @if (_totalBusinessTrend != null && _totalBusinessTrend.Any())
                                {
                                    <ApexChart TItem="MetricData" Options="_columnOptions" Height="240">
                                        <ApexPointSeries TItem="MetricData"
                                                         Items="_totalBusinessTrend"
                                                         Name="Business (Cr)"
                                                         SeriesType="SeriesType.Bar"
                                                         XValue="@(e => e.Category)"
                                                         YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">Loading business data...</MudText>
                                }
                            </MudPaper>
                        </MudItem>

                        @* 6. Refined Performance Card *@
                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
                                <div class="d-flex justify-space-between align-center mb-auto">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Deposits Performance</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in @_depositsUnit)</MudText>
                                    </div>

                                    <div class="d-flex align-center justify-space-around flex-grow-1">
                                        @* Left Side: Big Number *@
                                        <div class="text-center">
                                            <MudText Typo="Typo.h3" Style="color: #1572e8;" Class="fw-bold">@_depositsActualTotal.ToString("0.00")</MudText>
                                            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Actual Total</MudText>
                                        </div>

                                        @* Right Side: Mini Stats Vertical *@
                                        <div class="d-flex flex-column gap-4 border-left pl-6">
                                            <div>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Current (@_currentFY)</MudText>
                                                <MudText Typo="Typo.h5" Class="fw-bold">@_depositsCurrent.ToString("0.00")</MudText>
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Target (@_targetFY)</MudText>
                                                <MudText Typo="Typo.h5" Class="fw-bold">@_depositsTarget.ToString("0.00")</MudText>
                                            </div>
                                        </div>
                                    </div>

                                    @* Bottom: Progress Bar *@
                                    <div class="mt-auto">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.caption" Class="fw-bold">Progress to Target</MudText>
                                            <MudText Typo="Typo.caption" Class="fw-bold">@_depositsProgress.ToString("0")%</MudText>
                                        </div>

                                        <div class="d-flex justify-space-between mt-5 mb-5">
                                            <MudProgressLinear Color="MudBlazor.Color.Primary" Value="@_depositsProgress" Height="50" Class="rounded-pill" />
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>

                            @* 7. Total Deposits Growth : Line Chart *@

                            <MudItem xs="12" md="3">
                                <MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Deposits Growth</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
                                    </div>

                                    @* Quick null check to ensure smooth loading *@
                                    @if (_depositsGrowthTrend != null && _depositsGrowthTrend.Any())
                                {
                                    <ApexChart TItem="MetricData" Options="_lineOptions2" Height="240">
                                        <ApexPointSeries TItem="MetricData"
                                                         Items="_depositsGrowthTrend"
                                                         Name="Deposits (Cr)"
                                                         SeriesType="SeriesType.Area"
                                                         XValue="@(e => e.Category)"
                                                         YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                            </MudPaper>
                        </MudItem>


                        @* 8. Deposits Portfolio  *@

                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">

                                @* Header Section with Crores indicator *@
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Deposits Portfolio</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
                                </div>

                                @* ApexChart Section *@
                                <div class="flex-grow-1 d-flex align-center justify-center">
                                    @if (_portfolioItems != null && _portfolioItems.Any())
                                    {
                                        <ApexChart TItem="MetricData" Options="_donutOptions2" Height="240" Width="@("100%")">
                                            <ApexPointSeries TItem="MetricData"
                                                             Items="_portfolioItems"
                                                             Name="Deposits"
                                                             SeriesType="SeriesType.Donut"
                                                             XValue="@(e => e.Category)"
                                                             YValue="@(e => e.Value)" />
                                        </ApexChart>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">Loading chart data...</MudText>
                                    }
                                </div>

                            </MudPaper>
                        </MudItem>


                    </MudGrid>
                </MudCard>
            </MudPaper>
        </div>

    </MudItem>
    <MudItem xs="12" md="2" Style="display: flex; flex-direction: column; max-height: 740px;">

        <MudCard Class="card-profile mb-2" Elevation="1" Style="overflow:hidden; flex: 0 0 auto;">
            <!-- Header with background image -->
            <div class="card-header"
                 style="
            background-image: url('images/blogpost1.png');
            background-repeat: no-repeat;
            background-size: 120% 120%;
            height: 46px;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;">
                <div class="profile-picture text-center">
                    <div class="avatar avatar-xl">

                        <MudAvatar Size="MudBlazor.Size.Large" Style="background-color: #1b4a98; color: white;">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="MudBlazor.Size.Large" />
                        </MudAvatar>

@*                         <MudAvatar Size="MudBlazor.Size.Large"
                                   Style="@($"background-color:{_avatarBg}; color:white; font-weight:700; font-size:1.1rem;")">
                            @_initials
                        </MudAvatar> *@
                    </div>
                </div>
            </div>

            <!-- Body -->
            <MudCardContent Class="mt-7 mb-1 text-center" Style="padding-top:8px; padding-bottom:4px;">
                <MudText Typo="Typo.body2">
                    <div class="name">@_userName</div>
                    <div class="job">@_userDesignation</div>
                    <div class="job">(@_userDeptExtraDesc)</div>
                </MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Class="card-profile mb-2" Elevation="1" Style="overflow:hidden; flex: 0 0 auto;">
            <div class="card-header"
                 style="background-image: url('images/Blogpost_2.png');
                background-repeat: no-repeat;
                background-size: 120% 120%;
                height: 46px;
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: 700;
                font-size: 16px;
                text-align: center;
                position: relative;">
                <h2 style="margin:0; font-size:16px; font-weight:700; color:white;">Staff Details</h2>
            </div>

            <MudCardContent Class="pt-3 pb-3" Style="min-height:0;">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-space-between align-center border-bottom pb-1">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="MudBlazor.Size.Small" Style="color: #1b4a98;" />
                            <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #666;">Officers</MudText>
                        </div>
                        <MudChip T="string" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" Style="font-weight:700;">
                            @_staffSummary.OfficerCount
                        </MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center border-bottom pb-1">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="MudBlazor.Size.Small" Style="color: #2a9d5c;" />
                            <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #666;">CSA</MudText>
                        </div>
                        <MudChip T="string" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small" Style="font-weight:700;">
                            @_staffSummary.CSACount
                        </MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center border-bottom pb-1">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Engineering" Size="MudBlazor.Size.Small" Style="color: #e65100;" />
                            <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #666;">Sub Staff</MudText>
                        </div>
                        <MudChip T="string" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" Style="font-weight:700;">
                            @_staffSummary.SubStaffCount
                        </MudChip>
                    </div>
                </div>
                <div class="mt-2 text-center">
                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               Size="MudBlazor.Size.Small"
                               Class="rounded-pill px-5"
                               OnClick="NavigateToStaffDetails"
                               Style="font-weight: 600;">
                        View Details
                    </MudButton>
                </div>

                <MudDivider Class="my-3" />

                <div class="d-flex flex-column gap-4 mt-1">
                    <div class="d-flex align-center justify-space-between border-bottom pb-1">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Cake" Size="MudBlazor.Size.Small" Style="color: #1565C0;" />
                            <MudText Typo="Typo.caption" Style="color: #666; font-weight: 600;">Date of Birth</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="color: #1E3A8A; font-weight: 700;">
                            @(_dob.HasValue ? _dob.Value.ToString("dd-MMM-yyyy") : "—")
                        </MudText>
                    </div>
                    <div class="d-flex align-center justify-space-between pb-1">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="MudBlazor.Size.Small" Style="color: #E65100;" />
                            <MudText Typo="Typo.caption" Style="color: #666; font-weight: 600;">Retirement</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="color: #1E3A8A; font-weight: 700;">
                            @(_retirementDate.HasValue ? _retirementDate.Value.ToString("dd-MMM-yyyy") : "—")
                        </MudText>
                    </div>
                </div>
            </MudCardContent>
        </MudCard>

        <MudCard Class="card-profile mb-0" Elevation="1" Style="overflow:hidden; flex: 0 0 auto;">
            <div class="card-header"
                 style="background: linear-gradient(180deg, #c8102e 0%, #a00d25 100%);
                background-repeat: no-repeat;
                background-size: 120% 120%;
                height: 46px;
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: 700;
                font-size: 16px;
                text-align: center;
                position: relative;">
                <h2 style="margin:0; font-size:16px; font-weight:700; color:white;">@(IsCOUser ? "Network Overview" : "Branch Profile")</h2>
            </div>

            <MudCardContent Class="pa-4" Style="min-height: 220px;">
                @if (IsCOUser)
                {
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex align-center">
                            <div style="background: linear-gradient(135deg, #E3F2FD, #BBDEFB); border-radius: 10px; width: 42px; height: 42px;"
                                 class="d-flex align-center justify-center mr-3">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="MudBlazor.Size.Small" Style="color: #1565C0;" />
                            </div>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.caption" Style="color: #64748b; font-weight: 600;">Zones</MudText>
                                <MudText Typo="Typo.h5" Style="color: #1E3A8A; font-weight: 800; line-height: 1.2;">@_entityCounts.ZoneCount</MudText>
                                </div>
                            </div>

                            <div class="d-flex align-center">
                                <div style="background: linear-gradient(135deg, #FFF3E0, #FFE0B2); border-radius: 10px; width: 42px; height: 42px;"
                                     class="d-flex align-center justify-center mr-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Map" Size="MudBlazor.Size.Small" Style="color: #E65100;" />
                                </div>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.caption" Style="color: #64748b; font-weight: 600;">Regions</MudText>
                                    <MudText Typo="Typo.h5" Style="color: #1E3A8A; font-weight: 800; line-height: 1.2;">@_entityCounts.RegionCount</MudText>
                                </div>
                            </div>

                            <div class="d-flex align-center">
                                <div style="background: linear-gradient(135deg, #FFEBEE, #FFCDD2); border-radius: 10px; width: 42px; height: 42px;"
                                     class="d-flex align-center justify-center mr-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Store" Size="MudBlazor.Size.Small" Style="color: #C62828;" />
                                </div>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.caption" Style="color: #64748b; font-weight: 600;">Branches</MudText>
                                    <MudText Typo="Typo.h5" Style="color: #1E3A8A; font-weight: 800; line-height: 1.2;">@_entityCounts.BranchCount</MudText>
                                </div>
                            </div>
                        </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex align-center">
                            <div style="background-color: #E3F2FD; border-radius: 8px; width: 36px; height: 36px;"
                                 class="d-flex align-center justify-center mr-3">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="MudBlazor.Size.Small" Style="color: #1565C0;" />
                            </div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color: #1b4a98; font-weight: 700;">Opening Date</MudText>
                                <MudText Typo="Typo.body2" Style="color: #594ae2; font-weight: 800; line-height: 1.2;">@_branchProfile.SolOpnDt?.ToString("dd-MMM-yy")</MudText>
                                </div>
                            </div>

                            <div class="d-flex align-center">
                                <div style="background-color: #FFF3E0; border-radius: 8px; width: 36px; height: 36px;"
                                     class="d-flex align-center justify-center mr-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="MudBlazor.Size.Small" Style="color: #E65100;" />
                                </div>
                                <div>
