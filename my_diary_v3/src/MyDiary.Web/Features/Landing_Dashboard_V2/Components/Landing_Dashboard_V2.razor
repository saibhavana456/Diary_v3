    private void CalculateFinancialYears()
    {
        var today = AppTime.Today;
        int startYear = today.Month >= 4 ? today.Year : today.Year - 1;

        _currentFY = $"FY {startYear % 100}";
        _targetFY = $"FY {(startYear + 1) % 100}";
    }

    private void CalculateProgress()
    {
        if (_performanceData.Target > 0)
        {
            _progressPercent = (double)((_performanceData.Current / _performanceData.Target) * 100);
            if (_progressPercent > 100) _progressPercent = 100;
        }
    }
    #endregion

    #region Prospective Business
    private List<ProspectiveBusinessSummary> _prospectiveData = new();
    private string _userRole = "";
    private string _brSolid = "";
    private string _regionSolid = "";
    private string _zoneSolid = "";
    // Helper method to safely lookup and convert the value to Lakhs
    private string GetValue(string dbParameterName)
    {
        if (_prospectiveData == null || !_prospectiveData.Any())
            return "0.00";

        var item = _prospectiveData.FirstOrDefault(x => x.Parameter.Equals(dbParameterName, StringComparison.OrdinalIgnoreCase));

        if (item != null)
        {
            // Divide by 100,000 to convert to Lakhs
            decimal amountInLakhs = item.Sanction_Amount / 100000m;

            // Format to 2 decimal places
            return amountInLakhs.ToString("N2");
        }

        return "0.00";
    }
    #endregion

    #region Financial Inclusion
    private List<FinancialInclusionSummary> _financialInclusionData = new();
    private string GetFIValue(string dbParameterName)
    {
        if (_financialInclusionData == null || !_financialInclusionData.Any())
            return "0";

        var item = _financialInclusionData.FirstOrDefault(x => x.Parameter.Equals(dbParameterName, StringComparison.OrdinalIgnoreCase));

        if (item != null)
        {
            // "N0" formats as integer with commas (e.g., 5,000). Use .ToString() if you just want "5000"
