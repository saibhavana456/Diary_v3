    protected override async Task OnInitializedAsync()
    {
        // Load user identity FIRST so role-based UI renders correctly from the start
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Test User";
            _userEmail = user.FindFirst("email")?.Value ?? "test@example.com";
            _userPhone = user.FindFirst("phone")?.Value ?? "";
            _userDesignation = user.FindFirst("employee_designation")?.Value ?? "";
            _userDeptDesc = user.FindFirst("department_desc")?.Value ?? "";
            _userDeptExtraDesc = user.FindFirst("department_extra")?.Value ?? "";

            if (DateTime.TryParse(user.FindFirst("date_of_birth")?.Value, out var dob))
                _dob = dob;
            if (DateTime.TryParse(user.FindFirst("expected_end_date")?.Value, out var ret))
                _retirementDate = ret;

            _userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("Role")?.Value ?? "";
            _brSolid = user.FindFirst("br_solid")?.Value ?? "";
            _regionSolid = user.FindFirst("region_solid")?.Value ?? "";
            _zoneSolid = user.FindFirst("zone_solid")?.Value ?? "";
        }

        // Render immediately with correct role-based card before data loads
        StateHasChanged();

        #region Total Advances Performance
        CalculateFinancialYears();
        string currentZone = "Mumbai";
        string currentRegion = "Mumbai";
        _performanceData = await DashboardService.GetAdvancesPerformanceAsync(currentZone, currentRegion);
        CalculateProgress();
        #endregion

        _prospectiveData = await DashboardService.GetProspectiveBusinessSummaryAsync(
            _userRole, _brSolid, _regionSolid, _zoneSolid);

        _financialInclusionData = await DashboardService.GetFinancialInclusionSummaryAsync(
            _userRole, _brSolid, _regionSolid, _zoneSolid);

        var portfolioData = await DashboardService.GetAdvancesPortfolioSummaryAsync(
            _userRole, _brSolid, _regionSolid, _zoneSolid);

        _advancesPortfolioItems = new List<MetricData>
        {
            new MetricData { Category = "Retail", Value = portfolioData.Retail_Amount / 10000000m },
            new MetricData { Category = "Agri", Value = portfolioData.Agri_Amount / 10000000m },
            new MetricData { Category = "MSME", Value = portfolioData.MSME_Amount / 10000000m },
            new MetricData { Category = "Corporate", Value = portfolioData.Corporate_Amount / 10000000m }
        };

        var depositData = await DashboardService.GetDepositPortfolioSummaryAsync(
            _userRole, _brSolid, _regionSolid, _zoneSolid);

        _portfolioItems = new List<MetricData>
        {
            new MetricData { Category = "CA", Value = depositData.CA_Amount / 10000000m },
            new MetricData { Category = "SB", Value = depositData.SB_Amount / 10000000m },
            new MetricData { Category = "TD", Value = depositData.TD_Amount / 10000000m },
            new MetricData { Category = "RTD", Value = depositData.RTD_Amount / 10000000m }
        };

        _digiBankingData = await DashboardService.GetDigitalBankingSummaryAsync(
            _userRole, _brSolid, _regionSolid, _zoneSolid);

        _operationsData = await DashboardService.GetOperationsSummaryAsync(
        _userRole, _brSolid, _regionSolid, _zoneSolid);

        var currentKpis = await DashboardService.GetBusinessKpiCurrentAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
        var targetKpis = await DashboardService.GetBusinessKpiTargetAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        // Map directly to percentages for the Radial Bar
        _kpiRadial = new List<MetricData>
        {
            new MetricData { Category = "Casa", Value = CalculateAchievement(currentKpis.Casa, targetKpis.Casa) },
            new MetricData { Category = "Deposits", Value = CalculateAchievement(currentKpis.Deposits, targetKpis.Deposits) },
            new MetricData { Category = "Advances", Value = CalculateAchievement(currentKpis.Advances, targetKpis.Advances) },
            new MetricData { Category = "Business", Value = CalculateAchievement(currentKpis.Business, targetKpis.Business) }
        };

        #region Total Advances Performance
        var actualAdvances = await DashboardService.GetTotalAdvancesActualAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
        var targetAdvances = await DashboardService.GetTotalAdvancesTargetAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        var actual = ScaleValue(actualAdvances.Actual_Total);
        var current = ScaleValue(targetAdvances.Last_Target);
        var target = ScaleValue(targetAdvances.Target);
        _advancesUnit = actual.unitLabel;

        _advancesActualTotal = actual.scaledValue;
        _advancesCurrent = current.scaledValue;
        _advancesTarget = target.scaledValue;

        _advancesProgress = (_advancesTarget - _advancesCurrent) > 0
            ? (double)(((_advancesActualTotal - _advancesCurrent) / (_advancesTarget - _advancesCurrent)) * 100m)
            : 0;
        #endregion
        #region Total Deposits Performance
        var actualDeposits = await DashboardService.GetTotalDepositsActualAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
        var targetDeposits = await DashboardService.GetTotalDepositsTargetAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);


        var depActual = ScaleValue(actualDeposits.Actual_Total);
        var depCurrent = ScaleValue(targetDeposits.Last_Target);
        var depTarget = ScaleValue(targetDeposits.Target);
        _depositsUnit = depActual.unitLabel;

        _depositsActualTotal = depActual.scaledValue;
        _depositsCurrent = depCurrent.scaledValue;
        _depositsTarget = depTarget.scaledValue;

        _depositsProgress = (_depositsTarget - _depositsCurrent) > 0
            ? (double)(((_depositsActualTotal - _depositsCurrent) / (_depositsTarget - _depositsCurrent)) * 100m)
            : 0;

        #endregion
        var currentData = await DashboardService.GetAdvancesGrowthCurrentAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
        var lastFyData = await DashboardService.GetAdvancesGrowthLastAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        // 3. Keep the Dynamic Date Labels (Last FY, Last Qtr, Last Month, As On)
        DateTime now = AppTime.Now;
        string lblAsOn = now.ToString("MMM yy");
        string lblLastMonth = now.AddMonths(-1).ToString("MMM yy");

        int currentQuarter = (now.Month - 1) / 3 + 1;
        int lastQuarterMonth = (currentQuarter - 1) * 3;
        int lastQuarterYear = now.Year;
        if (lastQuarterMonth == 0) { lastQuarterMonth = 12; lastQuarterYear--; }
        string lblLastQtr = new DateTime(lastQuarterYear, lastQuarterMonth, 1).ToString("MMM yy");

        int lastFyYear = now.Month <= 3 ? now.Year - 1 : now.Year;
        string lblLastFy = new DateTime(lastFyYear, 3, 1).ToString("MMM yy");

        _growthTrend = new List<MetricData>
        {
            new MetricData { Category = "Last FY", Value = lastFyData.Last_Year_Value / 10000000m },
            new MetricData { Category = "Last Quarter", Value = currentData.Last_Quater_Value / 10000000m },
            new MetricData { Category = "Last Month", Value = currentData.Last_Month_Value / 10000000m },
            new MetricData { Category = "As On", Value = currentData.Current_Value / 10000000m }
        };

        // --- NEW: Fetch Deposits Growth Data ---
        var currentDepData = await DashboardService.GetDepositsGrowthCurrentAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
        var lastFyDepData = await DashboardService.GetDepositsGrowthLastAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        // --- NEW: Map directly to your _depositsGrowthTrend list in Crores ---
        _depositsGrowthTrend = new List<MetricData>
        {
            new MetricData { Category = "Last FY", Value = lastFyDepData.Last_Year_Value / 10000000m },
            new MetricData { Category = "Last Quarter", Value = currentDepData.Last_Quater_Value / 10000000m },
            new MetricData { Category = "Last Month", Value = currentDepData.Last_Month_Value / 10000000m },
            new MetricData { Category = "As On", Value = currentDepData.Current_Value / 10000000m }
        };

        DateTime now_tb = AppTime.Now;
        string lblAsOn_tb = now_tb.ToString("MMM yy");                // e.g., "Mar 26"
        string lblLast1 = now_tb.AddMonths(-1).ToString("MMM yy"); // e.g., "Feb 26"
        string lblLast2 = now_tb.AddMonths(-2).ToString("MMM yy"); // e.g., "Jan 26"
        string lblLast3 = now_tb.AddMonths(-3).ToString("MMM yy"); // e.g., "Dec 25"

        // 3. --- FETCH DATA ---
        var tbData = await DashboardService.GetTotalBusinessSummaryAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        // 4. --- MAP TO CHART (Strict chronological order: Left to Right) ---
        _totalBusinessTrend = new List<MetricData>
        {
            new MetricData { Category = lblLast3, Value = tbData.Last_3_Month_Value / 10000000m },
            new MetricData { Category = lblLast2, Value = tbData.Last_2_Month_Value / 10000000m },
            new MetricData { Category = lblLast1, Value = tbData.Last_Month_Value / 10000000m },
            new MetricData { Category = lblAsOn_tb, Value = tbData.Current_Value / 10000000m }
        };

        var rawTppData = await DashboardService.GetThirdPartyProductsAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        // Convert to Crores
        _tppData = new ThirdPartyProductsSummary
            {
                GeneralInsurance = rawTppData.GeneralInsurance / 10000000m,
                HealthInsurance = rawTppData.HealthInsurance / 10000000m,
                LifeInsurance = rawTppData.LifeInsurance / 10000000m,
                MutualFunds = rawTppData.MutualFunds / 10000000m
            };

        _pendingData = await DashboardService.GetPendingPositionAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        try
        {
            _staffSummary = await DashboardService.GetStaffSummaryAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"Staff summary unavailable: {ex.Message}");
            // _staffSummary = new StaffSummary { OfficerCount = 2, CSACount = 2 };
        }

        _branchProfile = await DashboardService.GetBranchProfileAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

        if (IsCOUser)
        {
            _entityCounts = await DashboardService.GetEntityCountSummaryAsync();
        }

        _scatterOptions = new ApexChartOptions<XYPoint>
            {
                DataLabels = new DataLabels { Enabled = false },
                Markers = new Markers { Size = 5 },
                Title = new Title { Text = "Scatter (X vs Y)" }
            };


        _areaOptions = new ApexChartOptions<MetricData>
            {
                DataLabels = new DataLabels { Enabled = false },
                Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
                Fill = new Fill { Type = FillType.Solid, Opacity = 0.25 },
                Yaxis = new List<YAxis> {
                new() { Labels = new YAxisLabels { Formatter = "function(v){return v.toFixed(1)+'%'}" } }
            },
                // Title = new Title { Text = "Growth %" }
            };


        _candleOptions = new ApexChartOptions<StockPrice>
            {
                Xaxis = new XAxis { Type = XAxisType.Datetime }, // time-based OHLC axis
                // Title = new Title { Text = "Sample" }
            };
        StateHasChanged();
    }

