    private (decimal scaledValue, string unitLabel) ScaleValue(decimal valueInRupees)
    {
        if (valueInRupees >= 1_000_000_000_000m) // ≥ 1,000 Cr
            return (valueInRupees / 1_000_000_000_000m, "Thousand Cr");

        if (valueInRupees >= 10_000_000m) // ≥ 1 Cr
            return (valueInRupees / 10_000_000m, "Cr");

        if (valueInRupees >= 100_000m) // ≥ 1 Lakh
