@using Microsoft.JSInterop
@using MudBlazor
@using MyDiary.Web.Features.Shared.Models
@using MyDiary.Web.Features.Shared.Services
@inject DynamicReportService ReportService
@inject IJSRuntime JS

<style>
    .fixed-table {
        table-layout: fixed !important;
        width: 100% !important;
    }

    .mud-table-container {
        overflow-x: auto;
    }

    .mud-table-head {
        background-color: #2a2f5b;
    }

    /* 1. Display Sort Icon by default */
    .mud-table-sort-label .mud-button-root .mud-icon-root {
        opacity: 1 !important;
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .mud-table-sort-label.mud-table-sort-label-active .mud-button-root .mud-icon-root {
        color: white !important;
    }

    /* 2. Auto-assign S.No using CSS Counters so it stays sequential after sorting */
    .auto-index-table {
        counter-reset: rowNumber;
    }

        .auto-index-table tbody tr:has(td:nth-child(2)) {
            counter-increment: rowNumber;
        }

            .auto-index-table tbody tr:has(td:nth-child(2)) td:first-child::before {
                content: counter(rowNumber);
            }
</style>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <div id="report-page-root" class="mb-4">
            <MudPaper Elevation="0" Style="background-color: #ffffff;">

                @* --- LEVEL 1: Gradient Styled Header --- *@
@*                 <MudCard Class="overflow-hidden h-100" Elevation="2"
                         Style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 0; border-bottom-right-radius: 0;">
                    <MudCardHeader Class="d-flex align-center justify-center text-white"
                                   Style="height:50px; font-weight:800; letter-spacing:.3px;
                                          background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
                        <MudText Typo="Typo.h6">@Config.Title</MudText>
                    </MudCardHeader>
                </MudCard> *@

                @* --- LEVEL 2: Filters (Dropdowns Left, Export Right) --- *@
                <MudGrid Spacing="2" Class="pa-4 align-center">
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Zone" Value="SelectedZone" ValueChanged="HandleZoneChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   UserAttributes="@(new Dictionary<string, object> { { "aria-label", "Select Zone" } })">
                            <MudSelectItem Value="@("1")">All(Summary)</MudSelectItem>
                            <MudSelectItem Value="@("all")">All(Zonewise)</MudSelectItem>
                            <MudSelectItem Value="@("00000")">CENTRAL OFFICE</MudSelectItem>
                            @foreach (var z in _zones)
                            {
                                <MudSelectItem Value="@z["zone_solid"].ToString()">@z["zone_name_eng"].ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Region" Value="SelectedRegion" ValueChanged="HandleRegionChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Disabled="@(SelectedZone == "1" || SelectedZone == "all")"
                                   UserAttributes="@(new Dictionary<string, object> { { "aria-label", "Select Region" } })">
                            <MudSelectItem Value="@("1")">All(Summary)</MudSelectItem>
                            <MudSelectItem Value="@("all")">All(Regionwise)</MudSelectItem>
                            @foreach (var r in _regions)
                            {
                                <MudSelectItem Value="@r["region_solid"].ToString()">@r["region_name"].ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Branch" Value="SelectedBranch" ValueChanged="HandleBranchChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Disabled="@(SelectedRegion == "1" || SelectedRegion == "all")"
                                   UserAttributes="@(new Dictionary<string, object> { { "aria-label", "Select Branch" } })">
                            <MudSelectItem Value="@("1")">All(Summary)</MudSelectItem>
                            <MudSelectItem Value="@("all")">All(Branchwise)</MudSelectItem>
                            @foreach (var b in _branches)
                            {
                                <MudSelectItem Value="@b["SOL_ID"].ToString()">@b["Branch_Name"].ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudSpacer />

                    <MudItem xs="12" sm="2" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" StartIcon="@MudBlazor.Icons.Material.Filled.Download"
                                   Style="background-color: #000066; color: white; font-size: 11px;"
                                   OnClick="OnExportInternal">Export To Excel</MudButton>
                    </MudItem>
                </MudGrid>

                @* --- LEVEL 3: Filters (Products Filter) --- *@
                <MudGrid Spacing="2" Class="pa-4 align-center">
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="Nature of Product" Value="SelectedPdt" ValueChanged="HandleProductChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   UserAttributes="@(new Dictionary<string, object> { { "aria-label", "Select Nature of Product" } })">
                            <MudSelectItem Value="@("0")">General Insurance</MudSelectItem>
                            <MudSelectItem Value="@("1")">Life Insurance</MudSelectItem>
                            <MudSelectItem Value="@("2")">Health Insurance</MudSelectItem>
                            <MudSelectItem Value="@("3")">Mutual Fund</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                @* --- LEVEL 4: Table Section --- *@
                <div class="px-4 d-flex justify-end">
                    <MudText Typo="Typo.caption" Style="font-weight:bold; font-style:italic; color: #666;">@AsOnDateLabel</MudText>
                </div>

                <MudItem xs="12" Class="pa-4">
                    <MudTable Items="Data" Loading="IsLoading" Dense="true" Striped="true" Bordered="true" FixedHeader="true"
                              Height="750px" Elevation="2" Class="fixed-table auto-index-table" Style="font-size:12px;" RowsPerPage="25"
                              UserAttributes="@(new Dictionary<string, object>{ ["aria-label"] = "Third Party Product Distribution Dashboard Results Table. Values shown in Rupees in Crores." })">
                        <HeaderContent>
                            <MudTh Style="background-color:#2a2f5b; color:white; width: 60px; text-align: center;">S.No</MudTh>
                            @foreach (var col in Config.Columns)
                            {
                                <MudTh Style="@($"background-color:#2a2f5b; color:white; width: {col.Width}; text-align: center;")">
                                    <MudTableSortLabel SortBy="new Func<Dictionary<string, object>, object>(x => x.ContainsKey(col.PropertyName) ? x[col.PropertyName] : string.Empty)">
                                        @col.Header
                                    </MudTableSortLabel>
                                </MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            @* S.No is now auto-filled via CSS counter class *@
                            <MudTd Style="text-align: center;"></MudTd>
                            @foreach (var col in Config.Columns)
                            {
                                <MudTd Style="@(col.IsNumeric ? "text-align: right;" : "text-align: left;")">
                                    @FormatValue(context, col)
                                </MudTd>
                            }
                        </RowTemplate>
                        <NoRecordsContent>
                            <td colspan="@(Config.Columns.Count + 1)" style="text-align:center; padding: 40px;">
                                <MudText Typo="Typo.subtitle1" Color="Color.Error">No record found</MudText>
                            </td>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                        </PagerContent>
                    </MudTable>
                </MudItem>
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public ReportConfig Config { get; set; } = new();
    [Parameter] public List<Dictionary<string, object>> Data { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string AsOnDateLabel { get; set; }
    [Parameter] public string SelectedZone { get; set; } = "1";
    [Parameter] public string SelectedRegion { get; set; } = "1";
    [Parameter] public string SelectedBranch { get; set; } = "1";
    [Parameter] public string SelectedPdt { get; set; } = "0";
    [Parameter] public EventCallback<(string zone, string region, string branch, string pdt)> OnFilterChanged { get; set; }
    [Parameter] public EventCallback OnExportRequested { get; set; }

    private List<Dictionary<string, object>> _zones = new(), _regions = new(), _branches = new(), _pdts = new();

    protected override async Task OnInitializedAsync()
    {
        _zones = await ReportService.GetLookupDataAsync("zone_master", "*", "status='A'", "zone_name_eng");
    }

    private async Task HandleZoneChanged(string v)
    {
        SelectedZone = v; SelectedRegion = "1"; SelectedBranch = "1"; SelectedPdt = "0";
        if (v != "1" && v != "all")
            _regions = await ReportService.GetLookupDataAsync("region_master", "*", $"zone_solid='{v}'", "region_name");
        else
            _regions.Clear();
        _branches.Clear();
        await OnFilterChanged.InvokeAsync((SelectedZone, SelectedRegion, SelectedBranch, SelectedPdt));
    }

    private async Task HandleRegionChanged(string v)
    {
        SelectedRegion = v; SelectedBranch = "1"; SelectedPdt = "0";
        if (v != "1" && v != "all")
            _branches = await ReportService.GetLookupDataAsync("branch_master", "CONCAT(UPPER(branch_name),' (',branch_code,')') As Branch_Name, SOL_ID", $"region_solid='{v}'", "BRANCH_NAME");
        else
            _branches.Clear();
        await OnFilterChanged.InvokeAsync((SelectedZone, SelectedRegion, SelectedBranch, SelectedPdt));
    }

    private async Task HandleBranchChanged(string v)
    {
        SelectedBranch = v; SelectedPdt = "0";
        await OnFilterChanged.InvokeAsync((SelectedZone, SelectedRegion, SelectedBranch, SelectedPdt));
    }

    private async Task HandleProductChanged(string v)
    {
        SelectedPdt = v;
        await OnFilterChanged.InvokeAsync((SelectedZone, SelectedRegion, SelectedBranch, SelectedPdt));        
    }

    private async Task OnExportInternal() => await OnExportRequested.InvokeAsync();

    private string FormatValue(Dictionary<string, object> row, ColumnConfig col)
    {
        if (!row.TryGetValue(col.PropertyName, out var val) || val == DBNull.Value || val == null) return "—";
        if (col.IsDate && DateTime.TryParse(val.ToString(), out var dt)) return dt.ToString("dd/MM/yyyy");
        if (col.IsNumeric && decimal.TryParse(val.ToString(), out var d)) return d.ToString(col.Format);
        return val.ToString();
    }
}