        _deleting = true;
        try
        {
            await MomRepo.DeleteEntryAsync(_entryToDelete.Id);
            Snackbar.Add("MoM entry deleted.", Severity.Success);
            _deleteConfirmOpen = false;
            _entryToDelete = null;
            await ReloadEntriesAsync();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "MomEntries: delete failed");
