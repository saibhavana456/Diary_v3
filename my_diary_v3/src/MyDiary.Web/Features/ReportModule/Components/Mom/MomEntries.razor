        }
    }

    private void OnPrimaryFilePicked(IBrowserFile file)
    {
        _primaryFileError = null;
        if (!IsAllowedExt(file.Name)) { _primaryFileError = $"File type not allowed. Allowed: {_type?.AllowedFileTypes}"; return; }
        if (file.Size > MaxFileBytes) { _primaryFileError = "File exceeds 10 MB limit."; return; }
        _primaryFile = file;
    }

    private void OnSupportingFilePicked(IBrowserFile file)
    {
        if (_type?.MaxSupportingFiles is int max && _supportingFiles.Count >= max)
        {
            Snackbar.Add($"Maximum {max} supporting file(s) allowed.", Severity.Warning);
            return;
        }
        if (!IsAllowedExt(file.Name)) { Snackbar.Add($"File type not allowed. Allowed: {_type?.AllowedFileTypes}", Severity.Warning); return; }
        if (file.Size > MaxFileBytes) { Snackbar.Add("File exceeds 10 MB limit.", Severity.Warning); return; }
        _supportingFiles.Add(file);
    }

    private bool IsAllowedExt(string fileName)
    {
        if (_type is null) return false;
        var ext = Path.GetExtension(fileName).TrimStart('.').ToLowerInvariant();
        var allowed = _type.AllowedFileTypes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(a => a.TrimStart('.').ToLowerInvariant());
        return allowed.Contains(ext);
    }

    private async Task SubmitEntryAsync()
    {
        if (_type is null) return;

        if (_formDate is null)
        {
            Snackbar.Add("Meeting date is required.", Severity.Warning);
            return;
        }

        // Allow only 31-Jul-2026 and later
        var minimumAllowedDate = new DateTime(2026, 7, 31);

        if (_formDate < minimumAllowedDate)
        {
            Snackbar.Add(
                "Meeting date cannot be earlier than 31-Jul-2026.",
                Severity.Warning);

            return;
        }

        // Do not allow future dates
        if (_formDate > AppTime.Today)
        {
            Snackbar.Add(
                "Future meeting date is not allowed.",
                Severity.Warning);

            return;
        }
        if (_type.RequirePrimaryFile && _primaryFile is null && !_editingEntryId.HasValue) { Snackbar.Add("Primary MoM file is required.", Severity.Warning); return; }
        if (_type.EnableZoneRegionScope)
        {
            if (string.IsNullOrWhiteSpace(_form.ZoneName))
            {
                Snackbar.Add("Zone is required.", Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.RegionName) && _form.OfficeLevel != "ZO")
            {
                Snackbar.Add("Region is required.", Severity.Warning);
                return;
            }
        }
        if (_type.EnableQuarter && !_form.Quarter.HasValue)
        {
            Snackbar.Add("Please select Quarter.", Severity.Warning);
            return;
        }
        if (_formDate > AppTime.Today)
        {
            Snackbar.Add("Future meeting date is not allowed.", Severity.Warning);
            return;
        }
        
    //     if (_type.EnableQuarter && _form.Quarter.HasValue)
    //     {
    //         var existingEntries = await MomRepo.ListEntriesAsync(
    //             _type.Id,
    //             null,
    //             null,
    //             null,
    //             null,
    //             null,
    //             _form.Quarter,
    //             _form.MeetingYear);

    //         var duplicateExists = existingEntries.Any(x =>
    // x.MeetingTypeId == _form.MeetingTypeId &&
    // x.UnionId == _form.UnionId &&
    // x.Quarter == _form.Quarter &&
    // x.MeetingYear == _form.MeetingYear &&
    // x.OfficeLevel == _form.OfficeLevel &&
    // string.Equals(x.ZoneName ?? "", _form.ZoneName ?? "", StringComparison.OrdinalIgnoreCase) &&
    // string.Equals(x.RegionName ?? "", _form.RegionName ?? "", StringComparison.OrdinalIgnoreCase) &&
    // (!_editingEntryId.HasValue || x.Id != _editingEntryId.Value));

    //         if (duplicateExists)
    //         {
    //             Snackbar.Add(
    //                 $"Meeting already exists for the selected sub-category in Q{_form.Quarter} {_form.MeetingYear}.",
    //                 Severity.Warning);

    //             return;
    //         }
    //     }
        if (_type.EnableMeetingType && !_form.MeetingTypeId.HasValue)
        {
            Snackbar.Add("Please select Meeting Category.", Severity.Warning);
            return;
        }

        if (_formUnions.Count > 0 && !_form.UnionId.HasValue)
        {
            Snackbar.Add("Please select Sub-category.", Severity.Warning);
            return;
        }
        if (_type.EnableMeetingType && !_form.MeetingTypeId.HasValue)
        {
            Snackbar.Add("Please select Meeting Category.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.Remarks))
        {
            Snackbar.Add("Remarks are mandatory.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            var actor = CurrentUser.EmplId ?? "";
            _form.MeetingDate = _formDate.Value;

            if (_primaryFile is not null)
            {
                await using var stream = _primaryFile.OpenReadStream(MaxFileBytes);
                var (relPath, fileName) = await SaveFileAsync(stream, _primaryFile.Name);
                _form.PrimaryFilePath = relPath;
                _form.PrimaryFileName = fileName;
            }

            long entryId;
            if (_editingEntryId.HasValue)
            {
                entryId = _editingEntryId.Value;
                await MomRepo.UpdateEntryAsync(entryId, _form);
            }
            else
            {
                entryId = await MomRepo.InsertEntryAsync(_form, actor);
            }

            foreach (var sf in _supportingFiles)
            {
                await using var stream = sf.OpenReadStream(MaxFileBytes);
                var (relPath, fileName) = await SaveFileAsync(stream, sf.Name);
                await MomRepo.InsertAttachmentAsync(entryId, fileName, relPath, actor);
            }

            Snackbar.Add(_editingEntryId.HasValue ? "MoM entry updated." : "MoM entry saved.", Severity.Success);
            _newEntryOpen = false;
            await ReloadEntriesAsync();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "MomEntries: save failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

