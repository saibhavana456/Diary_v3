    // ── Consolidated Excel export (Task 1) ──────────────────────────────────
    // Exports whatever the current filters + RO/ZO/CO/CoScope visibility already
    // narrowed _entries down to (same rows the user sees on screen) — a Welfare
    // Cell CO user, an RO user, etc. never gets rows in the file they couldn't
    // already see in the list. One "All Entries" sheet plus one sheet per
    // meeting category present in the result set (Award Staff Union, Officers
    // Union, Welfare Association sub-types, ...).
    private async Task ExportToExcelAsync()
    {
        if (_type is null) return;
        _exporting = true;
        try
        {
            if (_entries.Count == 0)
            {
                Snackbar.Add("No entries to export for the current filters.", Severity.Warning);
                return;
            }

            using var package = new ExcelPackage();
            WriteEntriesSheet(package, "All Entries", _entries);

            foreach (var group in _entries.GroupBy(e => string.IsNullOrWhiteSpace(e.MeetingTypeName) ? "Uncategorized" : e.MeetingTypeName))
            {
                WriteEntriesSheet(package, SafeSheetName(group.Key), group.ToList());
            }

            var bytes = await package.GetAsByteArrayAsync();
            var fileName = $"{_type.TypeCode}_MoM_Export_{AppTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("BlazorDownloadFile", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "MomEntries: export failed");
            Snackbar.Add(UserFacingError.Generic, Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private static void WriteEntriesSheet(ExcelPackage package, string sheetName, List<MomEntry> rows)
    {
        var ws = package.Workbook.Worksheets.Add(sheetName);
        string[] headers = { "Meeting Date", "Office Level", "Zone", "Region", "Branch/SOL ID",
            "Meeting Category", "Sub-category", "Quarter", "Year", "Remarks", "Primary File", "Created By", "Created At" };
        for (int c = 0; c < headers.Length; c++)
        {
            ws.Cells[1, c + 1].Value = headers[c];
            ws.Cells[1, c + 1].Style.Font.Bold = true;
        }
        for (int r = 0; r < rows.Count; r++)
        {
            var e = rows[r];
            var row = r + 2;
            ws.Cells[row, 1].Value = e.MeetingDate.ToString("dd-MMM-yyyy");
            ws.Cells[row, 2].Value = e.OfficeLevel;
            ws.Cells[row, 3].Value = e.ZoneName;
            ws.Cells[row, 4].Value = e.RegionName;
            ws.Cells[row, 5].Value = e.BranchSolId;
            ws.Cells[row, 6].Value = e.MeetingTypeName;
            ws.Cells[row, 7].Value = e.UnionName;
            ws.Cells[row, 8].Value = e.Quarter;
            ws.Cells[row, 9].Value = e.MeetingYear;
            ws.Cells[row, 10].Value = e.Remarks;
            ws.Cells[row, 11].Value = e.PrimaryFileName;
            ws.Cells[row, 12].Value = e.CreatedByEmp;
            ws.Cells[row, 13].Value = e.CreatedAt.ToString("dd-MMM-yyyy HH:mm");
        }
        ws.Cells[1, 1, Math.Max(rows.Count + 1, 1), headers.Length].AutoFitColumns();
    }

    // Excel sheet names: max 31 chars, no \ / ? * [ ] :
    private static string SafeSheetName(string name)
    {
        var cleaned = new string(name.Where(ch => !"\\/?*[]:".Contains(ch)).ToArray());
        return cleaned.Length > 31 ? cleaned[..31] : (cleaned.Length == 0 ? "Sheet" : cleaned);
    }

