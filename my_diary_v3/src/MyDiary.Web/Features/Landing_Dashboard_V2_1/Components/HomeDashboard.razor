@page "/home-dashboard"
@using ApexCharts
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using MyDiary.Web.Features.Feedback.Components
@using MyDiary.Web.Features.Landing_Dashboard_V2_1.Services
@using MyDiary.Web.Features.Landing_Dashboard_V2_1.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Services
@using Microsoft.JSInterop
@inject ILandingDashboardV2_1Service DashboardService
@inject ILandingDashboardV2Service LegacyService
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@using MyDiary.Web.Features.Shared.Components
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@implements IAsyncDisposable

<PageTitle>Home Dashboard — My Diary | Union Bank of India</PageTitle>

<div class="hd-root">

    @* ══ Hero / greeting ══════════════════════════════════════════════════ *@
    <section class="hd-hero">
        <div class="hd-hero-glow" aria-hidden="true"></div>
        <div class="hd-hero-main">
            <div class="hd-hero-avatar">
                <UserAvatar Size="MudBlazor.Size.Large"
                            AvatarStyle="background:#ffffff;color:#1E3A8A;font-weight:800;"
                            Initials="@GetInitials(_userName)" />
            </div>
            <div class="hd-hero-text">
                <div class="hd-greeting">@Greeting, @_userName</div>
                <div class="hd-hero-sub">
                    @if (!string.IsNullOrWhiteSpace(_userDesignation)) { <span>@_userDesignation</span> }
                    @if (!string.IsNullOrWhiteSpace(_userDeptExtraDesc)) { <span class="hd-dot">•</span> <span>@_userDeptExtraDesc</span> }
                    @if (!string.IsNullOrWhiteSpace(_userRole)) { <span class="hd-role-chip">@_userRole</span> }
                </div>
            </div>
        </div>
        <div class="hd-hero-aside">
            <div class="hd-asof">
                <MudIcon Icon="@Icons.Material.Filled.Event" Size="MudBlazor.Size.Small" />
                <span>As on&nbsp;<b>@(_asOnDate.HasValue ? _asOnDate.Value.ToString("dd MMM yyyy") : "—")</b></span>
            </div>
            <div class="hd-fy">@_currentFY&nbsp;→&nbsp;@_targetFY</div>
        </div>
    </section>

    @* ══ KPI achievement strip ════════════════════════════════════════════ *@
    <section class="hd-kpi-strip" aria-label="Key performance indicators">
        @foreach (var k in _kpiTiles)
        {
            <div class="hd-kpi" style="--kpi:@k.Color">
                <div class="hd-kpi-top">
                    <span class="hd-kpi-ic"><MudIcon Icon="@k.Icon" Size="MudBlazor.Size.Small" /></span>
                    <span class="hd-kpi-label">@k.Label</span>
                </div>
                <div class="hd-kpi-val">@k.Value.ToString("0.0")<span class="hd-kpi-pct">%</span></div>
                <div class="hd-kpi-track"><div class="hd-kpi-fill" style="width:@(Math.Clamp((double)k.Value, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
            </div>
        }
    </section>

    @* ══ Main shell: content + right rail ═════════════════════════════════ *@
    <div class="hd-shell">
        <main class="hd-main">

            @* ── Overview ──────────────────────────────────────────────── *@
            <div class="hd-section-label"><span class="hd-bar"></span>Overview</div>
            <div class="hd-grid hd-grid-2">
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.DonutLarge" Size="MudBlazor.Size.Small" />Business KPIs</div>
                        <span class="hd-unit">% Growth-Target</span>
                    </header>
                    <div class="hd-card-body hd-chart-center" aria-hidden="true">
                        @if (_kpiRadial.Any())
                        {
                            <ApexChart @ref="_kpiChart" TItem="MetricData" Options="_radialOptions" Height="260" Width="@("100%")">
                                <ApexPointSeries TItem="MetricData" Items="_kpiRadial" Name="Achievement %"
                                                 SeriesType="SeriesType.RadialBar" XValue="e => e.Category" YValue="e => e.Value" />
                            </ApexChart>
                        }
                        else { <div class="hd-skeleton">Calculating KPIs…</div> }
                    </div>
                </article>

                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.BarChart" Size="MudBlazor.Size.Small" />Total Business</div>
                        <span class="hd-unit">Amt. in Crores</span>
                    </header>
                    <div class="hd-card-body" aria-hidden="true">
                        @if (_totalBusinessTrend.Any())
                        {
                            <ApexChart TItem="MetricData" Options="_columnOptions" Height="260">
                                <ApexPointSeries TItem="MetricData" Items="_totalBusinessTrend" Name="Business (Cr)"
                                                 SeriesType="SeriesType.Bar" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                            </ApexChart>
                        }
                        else { <div class="hd-skeleton">Loading business data…</div> }
                    </div>
                </article>
            </div>

            @* ── Advances ──────────────────────────────────────────────── *@
            <div class="hd-section-label"><span class="hd-bar hd-bar-green"></span>STD Advances</div>
            <div class="hd-grid hd-grid-3">
                @* Performance *@
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.Speed" Size="MudBlazor.Size.Small" />Advances Performance</div>
                        <span class="hd-unit">Amt. in @_advancesUnit</span>
                    </header>
                    <div class="hd-card-body hd-perf">
                        <div class="hd-perf-hero" style="--accent:#2a9d5c">
                            <span class="hd-perf-big">@_advancesActualTotal.ToString("0.00")</span>
                            <span class="hd-perf-cap">Actual Total</span>
                        </div>
                        <div class="hd-perf-side">
                            <div><span class="hd-perf-k">Current (@_currentFY)</span><span class="hd-perf-v">@_advancesCurrent.ToString("0.00")</span></div>
                            <div><span class="hd-perf-k">Target (@_targetFY)</span><span class="hd-perf-v">@_advancesTarget.ToString("0.00")</span></div>
                        </div>
                    </div>
                    <div class="hd-perf-foot">
                        <div class="hd-perf-foot-row">
                            <span>Progress to Target</span>
                            <span style="@ProgressColor(_advancesProgress)">@ProgressText(_advancesProgress)</span>
                        </div>
                        <MudProgressLinear Color="@ProgressBarColor(_advancesProgress)" Value="@ProgressBarValue(_advancesProgress)" Height="10" Class="rounded-pill" />
                    </div>
                </article>

                @* Growth *@
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="MudBlazor.Size.Small" />Advances Growth</div>
                        <span class="hd-unit">Crores</span>
                    </header>
                    <div class="hd-card-body" aria-hidden="true" id="lazy-advGrowth">
                        @if (!_visibleCharts.Contains("lazy-advGrowth")) { <div class="hd-skeleton">Scroll to load…</div> }
                        else if (_growthTrend.Any())
                        {
                            <ApexChart TItem="MetricData" Options="_lineOptions" Height="240">
                                <ApexPointSeries TItem="MetricData" Items="_growthTrend" Name="Advances (Cr)"
                                                 SeriesType="SeriesType.Area" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                            </ApexChart>
                        }
                        else { <div class="hd-skeleton">Loading…</div> }
                    </div>
                </article>

                @* Portfolio *@
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.PieChart" Size="MudBlazor.Size.Small" />Advances Portfolio</div>
                        <span class="hd-unit">Crores</span>
                    </header>
                    <div class="hd-card-body hd-chart-center" aria-hidden="true" id="lazy-advPortfolio">
                        @if (!_visibleCharts.Contains("lazy-advPortfolio")) { <div class="hd-skeleton">Scroll to load…</div> }
                        else if (_advancesPortfolioItems.Any())
                        {
                            <ApexChart TItem="MetricData" Options="_donutOptions" Height="240" Width="@("100%")">
                                <ApexPointSeries TItem="MetricData" Items="_advancesPortfolioItems" Name="Advances"
                                                 SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                            </ApexChart>
                        }
                        else { <div class="hd-skeleton">Loading…</div> }
                    </div>
                </article>
            </div>

            @* ── Deposits ──────────────────────────────────────────────── *@
            <div class="hd-section-label"><span class="hd-bar hd-bar-amber"></span>Deposits</div>
            <div class="hd-grid hd-grid-3">
                @* Performance *@
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.Speed" Size="MudBlazor.Size.Small" />Deposits Performance</div>
                        <span class="hd-unit">Amt. in @_depositsUnit</span>
                    </header>
                    <div class="hd-card-body hd-perf">
                        <div class="hd-perf-hero" style="--accent:#f39c12">
                            <span class="hd-perf-big">@_depositsActualTotal.ToString("0.00")</span>
                            <span class="hd-perf-cap">Actual Total</span>
                        </div>
                        <div class="hd-perf-side">
                            <div><span class="hd-perf-k">Current (@_currentFY)</span><span class="hd-perf-v">@_depositsCurrent.ToString("0.00")</span></div>
                            <div><span class="hd-perf-k">Target (@_targetFY)</span><span class="hd-perf-v">@_depositsTarget.ToString("0.00")</span></div>
                        </div>
                    </div>
                    <div class="hd-perf-foot">
                        <div class="hd-perf-foot-row">
                            <span>Progress to Target</span>
                            <span style="@ProgressColor(_depositsProgress)">@ProgressText(_depositsProgress)</span>
                        </div>
                        <MudProgressLinear Color="@ProgressBarColor(_depositsProgress)" Value="@ProgressBarValue(_depositsProgress)" Height="10" Class="rounded-pill" />
                    </div>
                </article>

                @* Growth *@
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="MudBlazor.Size.Small" />Deposits Growth</div>
                        <span class="hd-unit">Crores</span>
                    </header>
                    <div class="hd-card-body" aria-hidden="true" id="lazy-depGrowth">
                        @if (!_visibleCharts.Contains("lazy-depGrowth")) { <div class="hd-skeleton">Scroll to load…</div> }
                        else if (_depositsGrowthTrend.Any())
                        {
                            <ApexChart TItem="MetricData" Options="_lineOptions2" Height="240">
                                <ApexPointSeries TItem="MetricData" Items="_depositsGrowthTrend" Name="Deposits (Cr)"
                                                 SeriesType="SeriesType.Area" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                            </ApexChart>
                        }
                        else { <div class="hd-skeleton">Loading…</div> }
                    </div>
                </article>

                @* Portfolio *@
                <article class="hd-card">
                    <header class="hd-card-head">
                        <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.PieChart" Size="MudBlazor.Size.Small" />Deposits Portfolio</div>
                        <span class="hd-unit">Crores</span>
                    </header>
                    <div class="hd-card-body hd-chart-center" aria-hidden="true" id="lazy-depPortfolio">
                        @if (!_visibleCharts.Contains("lazy-depPortfolio")) { <div class="hd-skeleton">Scroll to load…</div> }
                        else if (_portfolioItems.Any())
                        {
                            <ApexChart TItem="MetricData" Options="_donutOptions2" Height="240" Width="@("100%")">
                                <ApexPointSeries TItem="MetricData" Items="_portfolioItems" Name="Deposits"
                                                 SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                            </ApexChart>
                        }
                        else { <div class="hd-skeleton">Loading…</div> }
                    </div>
                </article>
            </div>

            @* ── Operational metric cards ──────────────────────────────── *@
            <div class="hd-section-label"><span class="hd-bar hd-bar-red"></span>Business Snapshot</div>
            <div class="hd-ops-grid">
                @foreach (var o in _opCards)
                {
                    <article class="hd-op" style="--op:@o.Color">
                        <header class="hd-op-head">
                            <span class="hd-op-ic"><MudIcon Icon="@o.Icon" Size="MudBlazor.Size.Small" /></span>
                            <div class="hd-op-titles">
                                <span class="hd-op-title">@o.Title</span>
                                @if (!string.IsNullOrWhiteSpace(o.AsOn)) { <span class="hd-op-date">As on @o.AsOn</span> }
                            </div>
                        </header>
                        <div class="hd-op-body">
                            @foreach (var r in o.Rows)
                            {
                                <div class="hd-op-row"><span class="hd-op-k">@r.Label</span><span class="hd-op-v">@r.Value</span></div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(o.Unit)) { <div class="hd-op-foot">@o.Unit</div> }
                    </article>
                }
            </div>

            @* ── Accessible data tables (visually hidden) ──────────────── *@
            <div class="hd-sr">
                @foreach (var ds in _srDatasets)
                {
                    <table>
                        <caption>@ds.Caption</caption>
                        <thead><tr><th scope="col">@ds.C1</th><th scope="col">@ds.C2</th></tr></thead>
                        <tbody>
                            @foreach (var it in ds.Items) { <tr><td>@it.Category</td><td>@ds.Fmt(it.Value)</td></tr> }
                        </tbody>
                    </table>
                }
            </div>
        </main>       

        @* ══ Right rail ═══════════════════════════════════════════════════ *@
        <aside class="hd-rail">

             @* Feedback — above Staff Details *@
            @* <FeedbackHomeCard /> *@

            @* Staff Details *@
            <article class="hd-card hd-rail-card">
                <header class="hd-card-head">
                    <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="MudBlazor.Size.Small" />Staff Details</div>
                </header>
                <div class="hd-card-body">
                    @foreach (var s in _staffRows)
                    {
                        <div class="hd-staff-row">
                            <span class="hd-staff-l"><MudIcon Icon="@s.Icon" Size="MudBlazor.Size.Small" Style="@($"color:{s.Color}")" />@s.Label</span>
                            <span class="hd-staff-chip" style="@($"background:{s.Color}")">@s.Count</span>
                        </div>
                    }
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small"
                               FullWidth="true" Class="rounded-pill mt-3" OnClick="NavigateToStaffDetails">View Details</MudButton>
                    <div class="hd-rail-links">
                        <a class="hd-link" href="birthday-retirement/birthday">
                            <span><MudIcon Icon="@Icons.Material.Filled.Cake" Size="MudBlazor.Size.Small" Style="color:#1565C0;" /> Birthdays</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="MudBlazor.Size.Small" />
                        </a>
                        <a class="hd-link" href="birthday-retirement/retirement">
                            <span><MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="MudBlazor.Size.Small" Style="color:#E65100;" /> Retirements</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="MudBlazor.Size.Small" />
                        </a>
                    </div>
                </div>
            </article>

            @* Quick Actions *@
            @* <article class="hd-card hd-rail-card">
                <header class="hd-card-head">
                    <div class="hd-card-title"><MudIcon Icon="@Icons.Material.Filled.Bolt" Size="MudBlazor.Size.Small" />Quick Actions</div>
                </header>
                <div class="hd-card-body hd-actions">
                    <a class="hd-action hd-action-blue" href="requests/new">
                        <span class="hd-action-ic"><MudIcon Icon="@Icons.Material.Filled.AddCircle" /></span>
                        <span class="hd-action-tx"><b>New Request</b><small>Raise a new request</small></span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="MudBlazor.Size.Small" Class="hd-action-arrow" />
                    </a>
                    <a class="hd-action hd-action-green" href="requests/mine">
                        <span class="hd-action-ic"><MudIcon Icon="@Icons.Material.Filled.Inbox" /></span>
                        <span class="hd-action-tx"><b>My Requests</b><small>Track your requests</small></span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="MudBlazor.Size.Small" Class="hd-action-arrow" />
                    </a>
                    <a class="hd-action hd-action-red" href="requests/escalation-matrix">
                        <span class="hd-action-ic"><MudIcon Icon="@Icons.Material.Filled.AccountTree" /></span>
                        <span class="hd-action-tx"><b>Escalation Matrix</b><small>View escalation levels</small></span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="MudBlazor.Size.Small" Class="hd-action-arrow" />
                    </a>
                </div>
            </article> *@

            @* Branch Profile / Network Overview *@
            <article class="hd-card hd-rail-card">
                <header class="hd-card-head">
                    <div class="hd-card-title">
                        <MudIcon Icon="@(IsCOUser ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.Store)" Size="MudBlazor.Size.Small" />
                        @(IsCOUser ? "Network Overview" : "Branch Profile")
                    </div>
                </header>
                <div class="hd-card-body">
                    @foreach (var st in _statRows)
                    {
                        <div class="hd-stat-row">
                            <span class="hd-stat-ic" style="@($"background:{st.Bg};color:{st.Color}")"><MudIcon Icon="@st.Icon" Size="MudBlazor.Size.Small" /></span>
                            <div class="hd-stat-txt"><span class="hd-stat-k">@st.Label</span><span class="hd-stat-v">@st.Value</span></div>
                        </div>
                    }
                    @if (!IsCOUser)
                    {
                        <MudButton Variant="Variant.Filled" Size="MudBlazor.Size.Small" FullWidth="true"
                                   Class="rounded-pill mt-3" OnClick="NavigateToBranchMgmt"
                                   Style="background:#c8102e;color:#fff;">View Details</MudButton>
                    }
                </div>
            </article>
        </aside>
    </div>
</div>

<style>
    .hd-root {
        --hd-blue:#1E3A8A; --hd-red:#c8102e; --hd-ink:#1b2a4a; --hd-muted:#64748b;
        --hd-line:#e9edf5; --hd-radius:16px;
        --hd-shadow:0 1px 2px rgba(16,24,64,.04), 0 6px 20px rgba(16,24,64,.06);
        display:flex; flex-direction:column; gap:18px; padding:4px 2px 24px;
    }

    .hd-hero {
        position:relative; overflow:hidden; border-radius:20px; color:#fff;
        background:linear-gradient(120deg,#1E3A8A 0%,#3452b5 45%,#c8102e 130%);
        padding:22px 26px; display:flex; align-items:center; justify-content:space-between;
        gap:18px; flex-wrap:wrap; box-shadow:0 10px 30px rgba(30,58,138,.28);
    }
    .hd-hero-glow { position:absolute; inset:auto -60px -120px auto; width:320px; height:320px;
        background:radial-gradient(circle,rgba(255,255,255,.22),transparent 62%); pointer-events:none; }
    .hd-hero-main { display:flex; align-items:center; gap:16px; min-width:0; z-index:1; }
    .hd-hero-avatar .mud-avatar { width:60px; height:60px; box-shadow:0 4px 14px rgba(0,0,0,.18); }
    .hd-greeting { font-size:1.5rem; font-weight:800; letter-spacing:-.01em; line-height:1.15; }
    .hd-hero-sub { font-size:.85rem; opacity:.92; margin-top:3px; display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
    .hd-dot { opacity:.6; }
    .hd-role-chip { background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.28);
        padding:1px 10px; border-radius:999px; font-weight:700; font-size:.72rem; letter-spacing:.03em; }
    .hd-hero-aside { display:flex; flex-direction:column; align-items:flex-end; gap:8px; z-index:1; }
    .hd-asof { display:flex; align-items:center; gap:6px; background:rgba(255,255,255,.16);
        border:1px solid rgba(255,255,255,.25); padding:6px 12px; border-radius:999px; font-size:.8rem; }
    .hd-fy { font-size:.72rem; font-weight:700; letter-spacing:.06em; opacity:.85; }

    .hd-kpi-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
    .hd-kpi { background:#fff; border:1px solid var(--hd-line); border-radius:var(--hd-radius);
        padding:14px 16px; box-shadow:var(--hd-shadow); position:relative; overflow:hidden; }
    .hd-kpi::before { content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--kpi); }
    .hd-kpi-top { display:flex; align-items:center; gap:8px; color:var(--hd-muted); }
    .hd-kpi-ic { display:inline-flex; width:26px; height:26px; align-items:center; justify-content:center;
        border-radius:8px; background:color-mix(in srgb, var(--kpi) 12%, #fff); color:var(--kpi); }
    .hd-kpi-ic .mud-icon-root { font-size:16px; }
    .hd-kpi-label { font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
    .hd-kpi-val { font-size:1.9rem; font-weight:800; color:var(--hd-ink); line-height:1.1; margin-top:6px; }
    .hd-kpi-pct { font-size:1rem; font-weight:700; color:var(--hd-muted); margin-left:2px; }
    .hd-kpi-track { height:6px; border-radius:999px; background:#eef1f7; margin-top:10px; overflow:hidden; }
    .hd-kpi-fill { height:100%; border-radius:999px; background:var(--kpi); transition:width .6s ease; }

    .hd-shell { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:18px; align-items:start; }
    .hd-main { display:flex; flex-direction:column; gap:12px; min-width:0; }
    .hd-rail { display:flex; flex-direction:column; gap:16px; position:sticky; top:12px; }

    .hd-section-label { display:flex; align-items:center; gap:9px; font-size:.82rem; font-weight:800;
        text-transform:uppercase; letter-spacing:.06em; color:var(--hd-ink); margin:8px 2px 2px; }
    .hd-bar { width:5px; height:16px; border-radius:3px; background:var(--hd-blue); }
    .hd-bar-green { background:#2a9d5c; } .hd-bar-amber { background:#f39c12; } .hd-bar-red { background:var(--hd-red); }

    .hd-grid { display:grid; gap:14px; }
    .hd-grid-2 { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .hd-grid-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
    .hd-card { background:#fff; border:1px solid var(--hd-line); border-radius:var(--hd-radius);
        box-shadow:var(--hd-shadow); display:flex; flex-direction:column; overflow:hidden; }
    .hd-card-head { display:flex; align-items:center; justify-content:space-between; gap:10px;
        padding:13px 16px; border-bottom:1px solid var(--hd-line); }
    .hd-card-title { display:flex; align-items:center; gap:8px; font-weight:700; font-size:.92rem; color:var(--hd-ink); }
    .hd-card-title .mud-icon-root { color:var(--hd-blue); font-size:19px; }
    .hd-unit { font-size:.7rem; font-weight:600; color:var(--hd-muted); background:#f3f6fc;
