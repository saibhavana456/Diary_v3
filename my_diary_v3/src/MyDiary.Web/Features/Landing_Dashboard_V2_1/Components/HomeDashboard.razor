    private async Task WireKpiLegendInteractionsAsync()
    {
        if (_kpiLegendWired || _kpiRadial == null || !_kpiRadial.Any()) return;
        _kpiLegendWired = true;

        var labels = string.Join("','", _kpiRadial.Select(k => k.Category));
        var values = string.Join(",", _kpiRadial.Select(k => k.Value.ToString("0.0")));

        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                function wireKpiLegend() {{
                    var canvas = document.querySelector('.apexcharts-radialbar-area');
                    if (!canvas) return false;
                    var wrapper = canvas.closest('.apexcharts-canvas');
                    if (!wrapper) return false;
                    var legends = wrapper.parentElement.querySelectorAll('.apexcharts-legend-series');
                    if (!legends.length) return false;
                    var labels = ['{labels}'];
                    var values = [{values}];
                    legends.forEach(function(leg, idx) {{
                        function updateCenter() {{
                            var nameEl = wrapper.querySelector('.apexcharts-datalabel-label');
                            var valueEl = wrapper.querySelector('.apexcharts-datalabel-value');
                            if (nameEl && idx < labels.length) nameEl.textContent = labels[idx];
                            if (valueEl && idx < values.length) valueEl.textContent = values[idx].toFixed(1) + '%';
                        }}
                        leg.addEventListener('click', updateCenter);
                        leg.addEventListener('mouseenter', updateCenter);
                    }});
                    return true;
                }}
                if (!wireKpiLegend()) {{ setTimeout(wireKpiLegend, 500); }}
            }})()
        ");
