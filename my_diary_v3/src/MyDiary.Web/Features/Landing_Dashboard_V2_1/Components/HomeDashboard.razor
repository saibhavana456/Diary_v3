    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Wire the lazy-chart observer once the placeholder divs exist in the DOM
        // (i.e. after the main data load's StateHasChanged, not on the very first
        // empty-shell render) — below-the-fold charts only mount once scrolled near.
        if (!_lazyChartsWired && _growthTrend.Any())
        {
            _lazyChartsWired = true;
            _lazyChartsRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("wireLazyCharts", _lazyChartsRef, LazyChartIds);
        }
    }

    public ValueTask DisposeAsync()
    {
        _lazyChartsRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task LoadRailWidgetsAsync()
    {
        try { _staffSummary = await LegacyService.GetStaffSummaryAsync(_userRole, _brSolid, _regionSolid, _zoneSolid); }
        catch (Exception ex) { AppLogger.LogError(ex, $"Staff summary: {ex.Message}"); }

        _staffRows = new()
        {
            (Icons.Material.Filled.Badge, "#1b4a98", "Officers", _staffSummary.OfficerCount),
            (Icons.Material.Filled.SupportAgent, "#2a9d5c", "CSA", _staffSummary.CSACount),
            (Icons.Material.Filled.Engineering, "#e65100", "Sub Staff", _staffSummary.SubStaffCount),
        };
        await InvokeAsync(StateHasChanged);

        try { _branchProfile = await LegacyService.GetBranchProfileAsync(_userRole, _brSolid, _regionSolid, _zoneSolid); }
        catch (Exception ex) { AppLogger.LogError(ex, $"Branch profile: {ex.Message}"); _branchProfile = new(); }

        if (IsCOUser)
        {
            try { _entityCounts = await LegacyService.GetEntityCountSummaryAsync(); }
            catch (Exception ex) { AppLogger.LogError(ex, $"Entity counts: {ex.Message}"); _entityCounts = new(); }
            _statRows = new()
            {
                (Icons.Material.Filled.AccountTree, "#1565C0", "#E3F2FD", "Zones", _entityCounts.ZoneCount.ToString()),
                (Icons.Material.Filled.Map, "#E65100", "#FFF3E0", "Regions", _entityCounts.RegionCount.ToString()),
                (Icons.Material.Filled.Store, "#C62828", "#FFEBEE", "Branches", _entityCounts.BranchCount.ToString()),
            };
        }
        else
        {
            _statRows = new()
            {
                (Icons.Material.Filled.CalendarMonth, "#1565C0", "#E3F2FD", "Opening Date", _branchProfile.SolOpnDt?.ToString("dd-MMM-yy") ?? "—"),
                (Icons.Material.Filled.Badge, "#E65100", "#FFF3E0", "License Number", string.IsNullOrWhiteSpace(_branchProfile.LicenseNumber) ? "—" : _branchProfile.LicenseNumber),
                (Icons.Material.Filled.EventBusy, "#C62828", "#FFEBEE", "Lease Expiry", "31-Dec-2027"),
            };
        }

        await InvokeAsync(StateHasChanged);
    }

