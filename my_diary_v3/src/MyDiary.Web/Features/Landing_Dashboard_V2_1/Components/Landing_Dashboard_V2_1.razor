	// ── Lifecycle ─────────────────────────────────────────────────────────────
	protected override async Task OnInitializedAsync()
	{
		// 1. Load identity claims
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (user.Identity?.IsAuthenticated == true)
		{
			_userName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Test User";
			_userDesignation = user.FindFirst("employee_designation")?.Value ?? "";
			_userDeptExtraDesc = user.FindFirst("department_extra")?.Value ?? "";
			_userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("Role")?.Value ?? "";
			_brSolid = user.FindFirst("branch_solid")?.Value ?? "";
			_regionSolid = user.FindFirst("region_solid")?.Value ?? "";
			_zoneSolid = user.FindFirst("zone_solid")?.Value ?? "";

			if (DateTime.TryParse(user.FindFirst("date_of_birth")?.Value, out var dob)) _dob = dob;
			if (DateTime.TryParse(user.FindFirst("expected_end_date")?.Value, out var ret)) _retirementDate = ret;
		}

		// Calculate FY labels
		var today = AppTime.Today;
		int startYear = today.Month >= 4 ? today.Year : today.Year - 1;
		_currentFY = $"FY {startYear % 100}";
		_targetFY = $"FY {(startYear + 1) % 100}";

		StateHasChanged();

		// 2. Single SP call for all 8 charts
		var data = await DashboardService.GetPageOneDashboardAsync(_userRole, _brSolid, _regionSolid, _zoneSolid);

		_asOnDate = data.AsOnDate;
		_additionalData = data.AdditionalData;

		// ── Chart 1: KPI radial ───────────────────────────────────────────────
		_kpiRadial = new List<MetricData>
		{
			new() { Category = "Casa",     Value = data.Chart1.Casa },
			new() { Category = "Deposits", Value = data.Chart1.Deposits },
			new() { Category = "Advances", Value = data.Chart1.Advances },
			new() { Category = "Business", Value = data.Chart1.Business }
		};

		// Wire legend interactions after a brief delay (chart needs to render first)
		_ = Task.Run(async () =>
		{
			await Task.Delay(1500); // Wait for ApexCharts to render
			await InvokeAsync(WireKpiLegendInteractionsAsync);
		});

		// ── Chart 2: Advances Performance ────────────────────────────────────
		// SP already returns scaled values + scale text
		_advancesUnit = data.Chart2.ScaleText;
		_advancesActualTotal = data.Chart2.ActualTotal;
		_advancesCurrent = data.Chart2.CurrentFy;
		_advancesTarget = data.Chart2.TargetFy;
		_advancesProgress = (_advancesTarget - _advancesCurrent) > 0
			? (double)(((_advancesActualTotal - _advancesCurrent) / (_advancesTarget - _advancesCurrent)) * 100m) : 0;

		// ── Chart 3: Advances Growth (raw rupees → Crores) ────────────────────
		_growthTrend = new List<MetricData>
		{
			new() { Category = "Base",         Value = data.Chart3.Base        / 10_000_000m },
			new() { Category = "Last FY",      Value = data.Chart3.LastFy      / 10_000_000m },
			new() { Category = "Last Quarter", Value = data.Chart3.LastQuarter / 10_000_000m },
			new() { Category = "Last Month",   Value = data.Chart3.LastMonth   / 10_000_000m },
			new() { Category = "As On",        Value = data.Chart3.AsOn        / 10_000_000m }
		};

		// ── Chart 4: Advances Portfolio (raw rupees → Crores) ─────────────────
		_advancesPortfolioItems = new List<MetricData>
		{
			new() { Category = "MSME",        Value = data.Chart4.MsmeAdvances        / 10_000_000m },
			new() { Category = "Retail",      Value = data.Chart4.RetailAdvances      / 10_000_000m },
			new() { Category = "Agriculture", Value = data.Chart4.AgricultureAdvances / 10_000_000m },
			new() { Category = "Corporate",   Value = data.Chart4.CorporateAdvances   / 10_000_000m }
		};

		// ── Chart 5: Total Business (raw rupees → Crores) ─────────────────────
		DateTime now = AppTime.Now;
		string lblLast3 = now.AddMonths(-3).ToString("MMM yy");
		string lblLast2 = now.AddMonths(-2).ToString("MMM yy");
		string lblLast1 = now.AddMonths(-1).ToString("MMM yy");
		string lblAsOn = now.ToString("MMM yy");

		_totalBusinessTrend = new List<MetricData>
		{
			new() { Category = lblLast3, Value = data.Chart5.LastFy      / 10_000_000m },
			new() { Category = lblLast2, Value = data.Chart5.LastQuarter / 10_000_000m },
			new() { Category = lblLast1, Value = data.Chart5.LastMonth   / 10_000_000m },
			new() { Category = lblAsOn,  Value = data.Chart5.AsOn        / 10_000_000m }
		};

		// ── Chart 6: Deposits Performance ────────────────────────────────────
		_depositsUnit = data.Chart6.ScaleText;
		_depositsActualTotal = data.Chart6.ActualTotal;
		_depositsCurrent = data.Chart6.CurrentFy;
		_depositsTarget = data.Chart6.TargetFy;
		_depositsProgress = (_depositsTarget - _depositsCurrent) > 0
			? (double)(((_depositsActualTotal - _depositsCurrent) / (_depositsTarget - _depositsCurrent)) * 100m) : 0;

		// ── Chart 7: Deposits Growth (raw rupees → Crores) ────────────────────
		_depositsGrowthTrend = new List<MetricData>
		{
			new() { Category = "Base",         Value = data.Chart7.Base        / 10_000_000m },
			new() { Category = "Last FY",      Value = data.Chart7.LastFy      / 10_000_000m },
			new() { Category = "Last Quarter", Value = data.Chart7.LastQuarter / 10_000_000m },
			new() { Category = "Last Month",   Value = data.Chart7.LastMonth   / 10_000_000m },
			new() { Category = "As On",        Value = data.Chart7.AsOn        / 10_000_000m }
		};

		// ── Chart 8: Deposits Portfolio (raw rupees → Crores) ─────────────────
		_portfolioItems = new List<MetricData>
		{
			new() { Category = "CD",  Value = data.Chart8.CdDeposits         / 10_000_000m },
			new() { Category = "SB",  Value = data.Chart8.SbDeposits         / 10_000_000m },
			new() { Category = "TD",  Value = data.Chart8.TdDeposits         / 10_000_000m },
			new() { Category = "RTD", Value = data.Chart8.RetailTermDeposits / 10_000_000m }
		};

		// 3. Legacy calls for sidebar data (staff / branch / entity) — fire-and-forget
		// so the main charts render immediately while these secondary widgets load.
		StateHasChanged();
		_ = LoadSidebarDataAsync();
	}

	private async Task LoadSidebarDataAsync()
	{
		try { _staffSummary = await LegacyService.GetStaffSummaryAsync(_userRole, _brSolid, _regionSolid, _zoneSolid); }
		catch (Exception ex) { AppLogger.LogError(ex, $"Staff summary: {ex.Message}"); }

		try { _branchProfile = await LegacyService.GetBranchProfileAsync(_userRole, _brSolid, _regionSolid, _zoneSolid); }
		catch (Exception ex) { AppLogger.LogError(ex, "Landing Dashboard: failed to load branch profile"); _branchProfile = new(); }

		if (IsCOUser)
		{
			try { _entityCounts = await LegacyService.GetEntityCountSummaryAsync(); }
			catch (Exception ex) { AppLogger.LogError(ex, "Landing Dashboard: failed to load entity count summary"); _entityCounts = new(); }
		}

		await InvokeAsync(StateHasChanged);
	}

	private void NavigateToStaffDetails() => Nav.NavigateTo("business-new?tab=staffdetails");
	private void NavigateToBranchMgmt() => Nav.NavigateTo("business-new?tab=BranchMgmt");

	private static string GetInitials(string name)
	{
		if (string.IsNullOrWhiteSpace(name)) return "?";
		var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
		return parts.Length >= 2
			? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}"
			: char.ToUpper(parts[0][0]).ToString();
	}
