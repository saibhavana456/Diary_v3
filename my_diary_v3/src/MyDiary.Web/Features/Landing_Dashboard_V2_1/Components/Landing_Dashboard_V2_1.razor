@page "/Landing_Dashboard_V2_1"
@using ApexCharts
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using MyDiary.Web.Features.Feedback.Components
@using MyDiary.Web.Features.Landing_Dashboard_V2_1.Services
@using MyDiary.Web.Features.Landing_Dashboard_V2_1.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Services
@using Microsoft.JSInterop
@inject ILandingDashboardV2_1Service DashboardService
@inject ILandingDashboardV2Service LegacyService
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@using MyDiary.Web.Components.Dialogs
@using MyDiary.Web.Features.Shared.Components
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())

<PageTitle>Home Dashboard — My Diary | Union Bank of India</PageTitle>

<MudGrid Spacing="3">
	<!-- LEFT: 10 columns -->
	<MudItem xs="12" md="10">
		<div id="business-page-root" class="mb-4">
			<MudPaper Elevation="0" Class="rounded-lg border" Style="background-color: #ffffff;">
				<MudCard Class="overflow-hidden h-100" Elevation="2" Style="border-radius:12px;">

					<MudCardHeader Class="d-flex align-center justify-center text-white"
								   Style="height:48px; font-weight:800; letter-spacing:.2px;
                                          background: linear-gradient(180deg, #c8102e 0%, #0b4ea2 100%);">
						<h2 class="ma-0" style="font-size:1.25rem; font-weight:800; color:white;">Home - Dashboard</h2>
					</MudCardHeader>

					@* As on Date *@
					<div class="px-4 py-2 d-flex justify-end" style="border-bottom:1px solid #f1f5f9;">
						<MudText Typo="Typo.caption" Style="color:#1b4a98; font-weight:700; font-style:italic;">
							As on Date: @(_asOnDate.HasValue ? _asOnDate.Value.ToString("dd-MMM-yyyy") : "")
						</MudText>
					</div>

					@* --- 2x4 Chart Grid --- *@
					<MudGrid Spacing="2" Class="p-3">

						@* Chart 1 – Business KPIs *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-start mb-2">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Business KPIs</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8; font-weight: 500;">(% Growth-Target Achievement)</MudText>
								</div>
								<div class="flex-grow-1 d-flex align-center justify-center" aria-hidden="true">
									@if (_kpiRadial != null && _kpiRadial.Any())
									{
										<ApexChart @ref="_kpiChart" TItem="MetricData" Options="_radialOptions" Height="240" Width="@("100%")">
											<ApexPointSeries TItem="MetricData"
															 Items="_kpiRadial"
															 Name="Achievement %"
															 SeriesType="SeriesType.RadialBar"
															 XValue="e => e.Category"
															 YValue="e => e.Value" />
										</ApexChart>
									}
									else
									{
										<MudText Typo="Typo.body2">Calculating KPIs...</MudText>
									}
								</div>
								@if (_kpiRadial != null && _kpiRadial.Any())
								{
									<table class="sr-only" aria-label="Business KPIs percentage of Growth-Target Achievement">
										<caption>Business KPIs (% Growth-Target Achievement)</caption>
										<thead><tr><th scope="col">KPI</th><th scope="col">Achievement %</th></tr></thead>
										<tbody>
											@foreach (var item in _kpiRadial)
											{
												<tr><td>@item.Category</td><td>@item.Value.ToString("0.0")%</td></tr>
											}
										</tbody>
									</table>
								}
							</MudPaper>
						</MudItem>

						@* Chart 2 – Total Advances Performance *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-auto">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Advances Performance</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in @_advancesUnit)</MudText>
								</div>
								<div class="d-flex align-center justify-space-around flex-grow-1" aria-hidden="true">
									<div class="text-center">
										<MudText Typo="Typo.body1" Style="color: #1572e8; font-size:2rem;" Class="fw-bold">@_advancesActualTotal.ToString("0.00")</MudText>
										<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Actual Total</MudText>
									</div>
									<div class="d-flex flex-column gap-4 border-left pl-6">
										<div>
											<MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Current (@_currentFY)</MudText>
											<MudText Typo="Typo.body1" Class="fw-bold" Style="font-size:1.25rem;">@_advancesCurrent.ToString("0.00")</MudText>
										</div>
										<div>
											<MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Target (@_targetFY)</MudText>
											<MudText Typo="Typo.body1" Class="fw-bold" Style="font-size:1.25rem;">@_advancesTarget.ToString("0.00")</MudText>
										</div>
									</div>
								</div>
								@* Accessible data for screen readers *@
								<table class="sr-only" aria-label="Total Advances Performance">
									<caption>Total Advances Performance (Amt. in @_advancesUnit)</caption>
									<thead><tr><th scope="col">Metric</th><th scope="col">Value</th></tr></thead>
									<tbody>
										<tr><td>Actual Total</td><td>@_advancesActualTotal.ToString("0.00")</td></tr>
										<tr><td>Current (@_currentFY)</td><td>@_advancesCurrent.ToString("0.00")</td></tr>
										<tr><td>Target (@_targetFY)</td><td>@_advancesTarget.ToString("0.00")</td></tr>
										<tr><td>Progress to Target</td><td>@_advancesProgress.ToString("0")%</td></tr>
									</tbody>
								</table>
								<div class="mt-auto">
									<div class="d-flex justify-space-between mb-1">
										<MudText Typo="Typo.caption" Class="fw-bold">Progress to Target</MudText>
										<MudText Typo="Typo.caption" Class="fw-bold" Style="@ProgressColor(_advancesProgress)">@ProgressText(_advancesProgress)</MudText>
									</div>
									<div class="d-flex justify-space-between mt-5 mb-5">
										<MudProgressLinear Color="@ProgressBarColor(_advancesProgress)" Value="@ProgressBarValue(_advancesProgress)" Height="50" Class="rounded-pill" />
									</div>
								</div>
							</MudPaper>
						</MudItem>

						@* Chart 3 – Total Advances Growth *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-2">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Advances Growth</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
								</div>
								<div aria-hidden="true" style="display:contents;">
								@if (_growthTrend != null && _growthTrend.Any())
								{
									<ApexChart TItem="MetricData" Options="_lineOptions" Height="240">
										<ApexPointSeries TItem="MetricData"
														 Items="_growthTrend"
														 Name="Advances (Cr)"
														 SeriesType="SeriesType.Area"
														 XValue="@(e => e.Category)"
														 YValue="@(e => e.Value)" />
									</ApexChart>
								}
								</div>
								@if (_growthTrend != null && _growthTrend.Any())
								{
									<table class="sr-only" aria-label="Total Advances Growth in Crores">
										<caption>Total Advances Growth (Amt. in Crores)</caption>
										<thead><tr><th scope="col">Period</th><th scope="col">Amount (Crores)</th></tr></thead>
										<tbody>
											@foreach (var item in _growthTrend)
											{
												<tr><td>@item.Category</td><td>@item.Value.ToString("0.00")</td></tr>
											}
										</tbody>
									</table>
								}
							</MudPaper>
						</MudItem>

						@* Chart 4 – Advances Portfolio *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-2">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Advances Portfolio</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
								</div>
								<div class="flex-grow-1 d-flex align-center justify-center" aria-hidden="true">
									@if (_advancesPortfolioItems != null && _advancesPortfolioItems.Any())
									{
										<ApexChart TItem="MetricData" Options="_donutOptions" Height="240" Width="@("100%")">
											<ApexPointSeries TItem="MetricData"
															 Items="_advancesPortfolioItems"
															 Name="Advances"
															 SeriesType="SeriesType.Donut"
															 XValue="@(e => e.Category)"
															 YValue="@(e => e.Value)" />
										</ApexChart>
									}
									else
									{
										<MudText Typo="Typo.body2">Loading chart data...</MudText>
									}
								</div>
								@if (_advancesPortfolioItems != null && _advancesPortfolioItems.Any())
								{
									<table class="sr-only" aria-label="Advances Portfolio breakdown in Crores">
										<caption>Advances Portfolio (Amt. in Crores)</caption>
										<thead><tr><th scope="col">Segment</th><th scope="col">Amount (Crores)</th></tr></thead>
										<tbody>
											@foreach (var item in _advancesPortfolioItems)
											{
												<tr><td>@item.Category</td><td>@item.Value.ToString("0.00")</td></tr>
											}
										</tbody>
									</table>
								}
							</MudPaper>
						</MudItem>

						@* Chart 5 – Total Business *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-2">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Business</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
								</div>
								<div aria-hidden="true" style="display:contents;">
								@if (_totalBusinessTrend != null && _totalBusinessTrend.Any())
								{
									<ApexChart TItem="MetricData" Options="_columnOptions" Height="240">
										<ApexPointSeries TItem="MetricData"
														 Items="_totalBusinessTrend"
														 Name="Business (Cr)"
														 SeriesType="SeriesType.Bar"
														 XValue="@(e => e.Category)"
														 YValue="@(e => e.Value)" />
									</ApexChart>
								}
								else
								{
									<MudText Typo="Typo.body2">Loading business data...</MudText>
								}
								</div>
								@if (_totalBusinessTrend != null && _totalBusinessTrend.Any())
								{
									<table class="sr-only" aria-label="Total Business trend in Crores">
										<caption>Total Business (Amt. in Crores)</caption>
										<thead><tr><th scope="col">Period</th><th scope="col">Amount (Crores)</th></tr></thead>
										<tbody>
											@foreach (var item in _totalBusinessTrend)
											{
												<tr><td>@item.Category</td><td>@item.Value.ToString("0.00")</td></tr>
											}
										</tbody>
									</table>
								}
							</MudPaper>
						</MudItem>

						@* Chart 6 – Total Deposits Performance *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-auto">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Deposits Performance</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in @_depositsUnit)</MudText>
								</div>
								<div class="d-flex align-center justify-space-around flex-grow-1" aria-hidden="true">
									<div class="text-center">
										<MudText Typo="Typo.body1" Style="color: #1572e8; font-size:2rem;" Class="fw-bold">@_depositsActualTotal.ToString("0.00")</MudText>
										<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Actual Total</MudText>
									</div>
									<div class="d-flex flex-column gap-4 border-left pl-6">
										<div>
											<MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Current (@_currentFY)</MudText>
											<MudText Typo="Typo.body1" Class="fw-bold" Style="font-size:1.25rem;">@_depositsCurrent.ToString("0.00")</MudText>
										</div>
										<div>
											<MudText Typo="Typo.caption" Class="mud-text-secondary uppercase">Target (@_targetFY)</MudText>
											<MudText Typo="Typo.body1" Class="fw-bold" Style="font-size:1.25rem;">@_depositsTarget.ToString("0.00")</MudText>
										</div>
									</div>
								</div>
								@* Accessible data for screen readers *@
								<table class="sr-only" aria-label="Total Deposits Performance">
									<caption>Total Deposits Performance (Amt. in @_depositsUnit)</caption>
									<thead><tr><th scope="col">Metric</th><th scope="col">Value</th></tr></thead>
									<tbody>
										<tr><td>Actual Total</td><td>@_depositsActualTotal.ToString("0.00")</td></tr>
										<tr><td>Current (@_currentFY)</td><td>@_depositsCurrent.ToString("0.00")</td></tr>
										<tr><td>Target (@_targetFY)</td><td>@_depositsTarget.ToString("0.00")</td></tr>
										<tr><td>Progress to Target</td><td>@_depositsProgress.ToString("0")%</td></tr>
									</tbody>
								</table>
								<div class="mt-auto">
									<div class="d-flex justify-space-between mb-1">
										<MudText Typo="Typo.caption" Class="fw-bold">Progress to Target</MudText>
										<MudText Typo="Typo.caption" Class="fw-bold" Style="@ProgressColor(_depositsProgress)">@ProgressText(_depositsProgress)</MudText>
									</div>
									<div class="d-flex justify-space-between mt-5 mb-5">
										<MudProgressLinear Color="@ProgressBarColor(_depositsProgress)" Value="@ProgressBarValue(_depositsProgress)" Height="50" Class="rounded-pill" />
									</div>
								</div>
							</MudPaper>
						</MudItem>

						@* Chart 7 – Total Deposits Growth *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-2">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Total Deposits Growth</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
								</div>
								<div aria-hidden="true" style="display:contents;">
								@if (_depositsGrowthTrend != null && _depositsGrowthTrend.Any())
								{
									<ApexChart TItem="MetricData" Options="_lineOptions2" Height="240">
										<ApexPointSeries TItem="MetricData"
														 Items="_depositsGrowthTrend"
														 Name="Deposits (Cr)"
														 SeriesType="SeriesType.Area"
														 XValue="@(e => e.Category)"
														 YValue="@(e => e.Value)" />
									</ApexChart>
								}
								</div>
								@if (_depositsGrowthTrend != null && _depositsGrowthTrend.Any())
								{
									<table class="sr-only" aria-label="Total Deposits Growth in Crores">
										<caption>Total Deposits Growth (Amt. in Crores)</caption>
										<thead><tr><th scope="col">Period</th><th scope="col">Amount (Crores)</th></tr></thead>
										<tbody>
											@foreach (var item in _depositsGrowthTrend)
											{
												<tr><td>@item.Category</td><td>@item.Value.ToString("0.00")</td></tr>
											}
										</tbody>
									</table>
								}
							</MudPaper>
						</MudItem>

						@* Chart 8 – Deposits Portfolio *@
						<MudItem xs="12" md="3">
							<MudPaper Class="pa-4 border rounded-lg d-flex flex-column" Elevation="0" Style="height: 320px;">
								<div class="d-flex justify-space-between align-center mb-2">
									<MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1b4a98;">Deposits Portfolio</MudText>
									<MudText Typo="Typo.caption" Style="color: #1572e8;">(Amt. in Crores)</MudText>
								</div>
								<div class="flex-grow-1 d-flex align-center justify-center" aria-hidden="true">
									@if (_portfolioItems != null && _portfolioItems.Any())
									{
										<ApexChart TItem="MetricData" Options="_donutOptions2" Height="240" Width="@("100%")">
											<ApexPointSeries TItem="MetricData"
															 Items="_portfolioItems"
															 Name="Deposits"
															 SeriesType="SeriesType.Donut"
															 XValue="@(e => e.Category)"
															 YValue="@(e => e.Value)" />
										</ApexChart>
									}
									else
									{
										<MudText Typo="Typo.body2">Loading chart data...</MudText>
									}
								</div>
								@if (_portfolioItems != null && _portfolioItems.Any())
								{
									<table class="sr-only" aria-label="Deposits Portfolio breakdown in Crores">
										<caption>Deposits Portfolio (Amt. in Crores)</caption>
										<thead><tr><th scope="col">Segment</th><th scope="col">Amount (Crores)</th></tr></thead>
										<tbody>
											@foreach (var item in _portfolioItems)
											{
												<tr><td>@item.Category</td><td>@item.Value.ToString("0.00")</td></tr>
											}
										</tbody>
									</table>
								}
							</MudPaper>
						</MudItem>

					</MudGrid>
				</MudCard>
			</MudPaper>
		</div>
	</MudItem>

	<!-- RIGHT: 2 columns – profile / staff / branch (unchanged from V2) -->
	<MudItem xs="12" md="2" Style="display: flex; flex-direction: column; max-height: 740px;">

		<MudCard Class="card-profile mb-2" Elevation="1" Style="overflow:hidden; flex: 0 0 auto;">
			<div class="card-header"
				 style="background-image: url('images/blogpost1.png');
                        background-repeat: no-repeat; background-size: 120% 120%;
                        height: 46px; border-top-left-radius: 12px; border-top-right-radius: 12px;">
				<div class="profile-picture text-center">
					<div class="avatar avatar-xl">
						<UserAvatar Size="MudBlazor.Size.Large"
						            AvatarStyle="background-color: #1b4a98; color: white;"
						            Initials="@GetInitials(_userName)" />
					</div>
				</div>
			</div>
			<MudCardContent Class="mt-7 mb-1 text-center" Style="padding-top:8px; padding-bottom:4px;">
				<MudText Typo="Typo.body2">
					<div class="name">@_userName</div>
					<div class="job">@_userDesignation</div>
					<div class="job">(@_userDeptExtraDesc)</div>
				</MudText>
			</MudCardContent>
		</MudCard>

		@* Feedback — above Staff Details *@
		@* <FeedbackHomeCard /> *@

		<MudCard Class="card-profile mb-2" Elevation="1" Style="overflow:hidden; flex: 0 0 auto;">
			<div class="card-header"
				 style="background-image: url('images/Blogpost_2.png');
                        background-repeat: no-repeat; background-size: 120% 120%;
                        height: 46px; border-top-left-radius: 12px; border-top-right-radius: 12px;
                        display: flex; align-items: center; justify-content: center;
                        color: white; font-weight: 700; font-size: 16px; text-align: center; position: relative;">
				<h2 style="margin:0; font-size:16px; font-weight:700; color:white;">Staff Details</h2>
			</div>
			<MudCardContent Class="pt-3 pb-3" Style="min-height:0;">
				<div class="d-flex flex-column gap-3">
					<div class="d-flex justify-space-between align-center border-bottom pb-1">
						<div class="d-flex align-center gap-2">
							<MudIcon Icon="@Icons.Material.Filled.Badge" Size="MudBlazor.Size.Small" Style="color: #1b4a98;" />
							<MudText Typo="Typo.body2" Class="fw-bold" Style="color: #666;">Officers</MudText>
						</div>
						<MudChip T="string" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" Style="font-weight:700;">@_staffSummary.OfficerCount</MudChip>
					</div>
					<div class="d-flex justify-space-between align-center border-bottom pb-1">
						<div class="d-flex align-center gap-2">
							<MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="MudBlazor.Size.Small" Style="color: #2a9d5c;" />
							<MudText Typo="Typo.body2" Class="fw-bold" Style="color: #666;">CSA</MudText>
						</div>
						<MudChip T="string" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small" Style="font-weight:700;">@_staffSummary.CSACount</MudChip>
					</div>
					<div class="d-flex justify-space-between align-center border-bottom pb-1">
						<div class="d-flex align-center gap-2">
							<MudIcon Icon="@Icons.Material.Filled.Engineering" Size="MudBlazor.Size.Small" Style="color: #e65100;" />
							<MudText Typo="Typo.body2" Class="fw-bold" Style="color: #666;">Sub Staff</MudText>
						</div>
						<MudChip T="string" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" Style="font-weight:700;">@_staffSummary.SubStaffCount</MudChip>
					</div>
				</div>
				<div class="mt-2 text-center">
					<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small"
							   FullWidth="true" Class="rounded-pill" OnClick="NavigateToStaffDetails" Style="font-weight: 600;">
						View Details
					</MudButton>
				</div>
				<MudDivider Class="my-3" />
				<div class="d-flex flex-column gap-4 mt-1">

					@* Compact Birthday Link *@
					<MudLink Href="birthday-retirement/birthday" Underline="Underline.None" Class="d-flex align-center justify-space-between border-bottom pb-1 cursor-pointer">
						<div class="d-flex align-center gap-2">
							<MudIcon Icon="@Icons.Material.Filled.Cake" Size="MudBlazor.Size.Small" Style="color: #1565C0;" />
