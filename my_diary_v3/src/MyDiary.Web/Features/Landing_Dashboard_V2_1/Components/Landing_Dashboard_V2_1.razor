	private (decimal scaledValue, string unitLabel) ScaleValue(decimal valueInRupees)
	{
		if (valueInRupees >= 1_000_000_000_000m) return (valueInRupees / 1_000_000_000_000m, "Thousand Cr");
		if (valueInRupees >= 10_000_000m) return (valueInRupees / 10_000_000m, "Cr");
		if (valueInRupees >= 100_000m) return (valueInRupees / 100_000m, "Lakh");
		return (valueInRupees / 1_000m, "Thousand");
	}

