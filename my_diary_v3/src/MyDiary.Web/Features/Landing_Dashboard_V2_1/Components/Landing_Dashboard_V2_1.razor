<style>
	.fw-bold {
		font-weight: 700 !important;
	}

	.uppercase {
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.border-bottom {
		border-bottom: 2px solid #f0f0f0;
	}

	.border-left {
		border-left: 1px solid #e0e0e0;
	}

	/* Per-card wrapper — gives each Bootstrap-grid cell full height + vertical gutter
	   (the V2 dashboards.css that styled this isn't loaded in V3). */
	.card-cell {
		height: 100%;
		padding-bottom: 16px;
	}

	/* Profile / staff cards (kaiadmin classes — dashboards.css not loaded in V3).
	   Restore the rounded card, centred overlapping avatar, and name/role text. */
	.card-profile { border-radius: 12px; }
	.card-profile .card-header { position: relative; }
	.card-profile .profile-picture {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -24px;
		display: flex;
		justify-content: center;
