<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host config for My Diary V3 (ASP.NET Core 8 / Blazor Server, in-process).
  Mirrors the Project D (My_Diary_V2) production hosting model:
    * AspNetCoreModuleV2, hostingModel="InProcess"
    * ASPNETCORE_ENVIRONMENT selects appsettings.{Environment}.json
    * MD_CONN_ENCRYPTION_KEY supplies the AES-256-GCM key used to decrypt
      the ConnectionStrings at startup (ConnectionStringDecryptor).
  For UAT set ASPNETCORE_ENVIRONMENT to "UAT". For production keep "Production".
  Prefer setting MD_CONN_ENCRYPTION_KEY at the machine/App Pool level rather
  than in this file so the secret is not committed to source control.
-->
<configuration>
  <system.web>
    <httpCookies httpOnlyCookies="true" requireSSL="true" />
  </system.web>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\MyDiary.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Set the real 32-char AES key here or (preferred) at the App Pool level. -->
          <!-- <environmentVariable name="MD_CONN_ENCRYPTION_KEY" value="REPLACE-WITH-32-CHAR-KEY" /> -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
