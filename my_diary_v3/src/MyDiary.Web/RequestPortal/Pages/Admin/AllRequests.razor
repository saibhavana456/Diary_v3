@namespace RequestPortal.Web.Pages.Admin
@page "/admin/requests"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AppAdmin")]
@inject IRequestService Requests
@inject NavigationManager Nav

<PageTitle>All Requests · Admin</PageTitle>

<PageHeader PageKey="admin-all-requests" Title="All Requests" Crumbs="_crumbs" />

<AuthorizeView Policy="AppAdmin">
    <NotAuthorized>
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">You need Request Portal Admin rights to access this page.</MudAlert>
    </NotAuthorized>
    <Authorized Context="authContext">

<MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
    <MudGrid>
        <MudItem xs="6" md="3"><MudTextField Label="Status" @bind-Value="_status" /></MudItem>
        <MudItem xs="6" md="3"><MudCheckBox T="bool" Label="Breached only" @bind-Value="_breachedOnly" /></MudItem>
        <MudItem xs="6" md="3"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">Filter</MudButton></MudItem>
    </MudGrid>
</MudPaper>

<MudDataGrid T="RequestListItem" ServerData="@Load" Dense="true" Hover="true" @ref="_grid"
             Class="rp-data-table"
             RowClick="@(args => Nav.NavigateTo($"requests/{args.Item.Id}"))">
    <Columns>
        <PropertyColumn Property="x => x.ReqNo" Title="#" />
        <PropertyColumn Property="x => x.RequestTypeName" Title="Type" />
        <PropertyColumn Property="x => x.Subject" />
        <PropertyColumn Property="x => x.RaisedByName" Title="Raised by" />
        <PropertyColumn Property="x => x.UnitName" Title="Unit" />
        <PropertyColumn Property="x => x.CurrentLevel" Title="L" />
        <PropertyColumn Property="x => x.Status" />
        <PropertyColumn Property="x => x.SlaDueUtc" Title="SLA due" Format="g" />
        <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="g" />
    </Columns>
    <PagerContent><MudDataGridPager T="RequestListItem" /></PagerContent>
</MudDataGrid>

    </Authorized>
</AuthorizeView>

@code {
    private MudDataGrid<RequestListItem>? _grid;
    private string? _status;
    private bool _breachedOnly;

    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("Admin"),
        new("All Requests"),
    };

    private async Task Reload() { if (_grid is not null) await _grid.ReloadServerData(); }

    private async Task<GridData<RequestListItem>> Load(GridState<RequestListItem> state)
    {
        var sortBy = state.SortDefinitions.FirstOrDefault();
        var f = new FilterDto(
            Status: string.IsNullOrWhiteSpace(_status) ? null : _status,
            BreachedOnly: _breachedOnly ? true : null,
            Page: state.Page + 1,
            PageSize: state.PageSize,
            SortBy: sortBy?.SortBy,
            SortDesc: sortBy?.Descending ?? true);
        var (items, total) = await Requests.ListAsync(f, null, null);
        return new GridData<RequestListItem> { Items = items, TotalItems = total };
    }
}
