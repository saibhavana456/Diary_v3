@namespace RequestPortal.Web.Pages.Admin.Dialogs
@* Holiday calendar header \u2014 Code/Name *@

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Code" Label="Code" MaxLength="50" Required="true" Counter="50" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="Name" Label="Name" MaxLength="200" Required="true" Counter="200" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(!IsValid)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private bool IsValid => !string.IsNullOrWhiteSpace(Code) && !string.IsNullOrWhiteSpace(Name);

    private void Save() => Dialog.Close(DialogResult.Ok(new HolidayCalendarFormResult(Code.Trim(), Name.Trim())));
    private void Cancel() => Dialog.Cancel();

    public sealed record HolidayCalendarFormResult(string Code, string Name);
}
