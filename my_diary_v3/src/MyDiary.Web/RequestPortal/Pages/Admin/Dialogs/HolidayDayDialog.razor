@namespace RequestPortal.Web.Pages.Admin.Dialogs
@* Holiday day \u2014 Date + Description *@

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudDatePicker Label="Date" @bind-Date="HolidayDate" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Description" Label="Description (optional)" MaxLength="200" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(!IsValid)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public DateTime? HolidayDate { get; set; }
    [Parameter] public string? Description { get; set; }

    private bool IsValid => HolidayDate.HasValue;

    private void Save() => Dialog.Close(DialogResult.Ok(new HolidayDayFormResult(HolidayDate!.Value, Description)));
    private void Cancel() => Dialog.Cancel();

    public sealed record HolidayDayFormResult(DateTime HolidayDate, string? Description);
}
