@namespace RequestPortal.Web.Pages.Admin.Rbac
@page "/admin/rbac/admin-rights"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SuperAdmin")]
@inject IRbacRepo Repo
@inject IRbacService Rbac
@inject IUserRepo Users
@inject ICurrentUser Me
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Admin Rights</PageTitle>

<PageHeader PageKey="rbac-admin-rights" Title="Admin Rights" Subtitle="SuperAdmin can grant or revoke Application Admin rights" Crumbs="_crumbs" />

<MudTabs Outlined="true" Position="Position.Top" KeepPanelsAlive="true" Class="mt-2">
    <MudTabPanel Text="@($"Super Admins ({_supers.Count})")" Icon="@Icons.Material.Filled.Star">
        <MudPaper Elevation="1" Class="pa-3">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                SuperAdmins are locked to @RbacConstants.MaxSuperAdmins users and cannot be granted at runtime.
            </MudAlert>
            <MudList T="SuperAdminRow" Dense="true">
                @foreach (var row in _supers)
                {
                    <MudListItem T="SuperAdminRow" Value="@row" Icon="@Icons.Material.Filled.Star">
                        <ChildContent>
                            <MudText>@row.Name <small style="color:#888">@row.Sam</small></MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Assigned @AppTime.ToIndia(row.AssignedAt).ToString("yyyy-MM-dd") by @row.AssignedBy</MudText>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="@($"Application Admins ({_appAdmins.Count(a => a.IsActive)})")" Icon="@Icons.Material.Filled.AdminPanelSettings">
        <MudPaper Elevation="1" Class="pa-3">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.h6">Application Admins</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenGrantDialog">Grant AppAdmin</MudButton>
            </div>

            <MudTable Items="@_appAdmins" Dense="true" Hover="true" Striped="true" Class="rp-data-table">
                <HeaderContent>
                    <MudTh>User</MudTh>
                    <MudTh>SAM</MudTh>
                    <MudTh>Assigned</MudTh>
                    <MudTh>By</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.Sam</MudTd>
                    <MudTd>@AppTime.ToIndia(context.AssignedAt).ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd>@context.AssignedBy</MudTd>
                    <MudTd>
                        @if (context.IsActive)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Revoked</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsActive)
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                       OnClick="@(() => Revoke(context))">Revoke</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_appAdmins.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No Application Admins yet.</MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="@($"Feedback Admins ({_feedbackAdmins.Count(a => a.IsActive)})")" Icon="@Icons.Material.Filled.Feedback">
        <MudPaper Elevation="1" Class="pa-3">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.h6">Feedback Admins</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenGrantFeedbackDialog">Grant Feedback Admin</MudButton>
            </div>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Feedback Admins (plus SuperAdmin) can access the Feedback Dashboard and Feedback ticket list. This is separate from the broader Application Admin tier.
            </MudAlert>

            <MudTable Items="@_feedbackAdmins" Dense="true" Hover="true" Striped="true" Class="rp-data-table">
                <HeaderContent>
                    <MudTh>User</MudTh>
                    <MudTh>SAM</MudTh>
                    <MudTh>Assigned</MudTh>
                    <MudTh>By</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.Sam</MudTd>
                    <MudTd>@AppTime.ToIndia(context.AssignedAt).ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd>@context.AssignedBy</MudTd>
                    <MudTd>
                        @if (context.IsActive)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Revoked</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsActive)
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                       OnClick="@(() => RevokeFeedback(context))">Revoke</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_feedbackAdmins.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No Feedback Admins yet.</MudText>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private readonly List<PageHeader.Crumb> _crumbs = new()
    {
        new("Administration"),
        new("Admin Rights"),
    };

    private List<AppUser> _allUsers = new();
    private List<SuperAdminRow> _supers = new();
    private List<AppAdminRow> _appAdmins = new();
    private List<AppAdminRow> _feedbackAdmins = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        // Independent lookups — run concurrently; the name-join happens after
        // all four have completed.
        var usersTask = Users.SearchAsync(string.Empty, 1000);
        var superAdminsTask = Repo.ListSuperAdminsAsync();
        var appAdminsTask = Repo.ListAppAdminsAsync();
        var feedbackAdminsTask = Repo.ListFeedbackAdminsAsync();
        await Task.WhenAll(usersTask, superAdminsTask, appAdminsTask, feedbackAdminsTask);
        _allUsers = usersTask.Result.ToList();

        _supers = superAdminsTask.Result
            .Select(sa => {
                var u = _allUsers.FirstOrDefault(x => string.Equals(x.EmpCode, sa.EmpCode, StringComparison.OrdinalIgnoreCase));
                return new SuperAdminRow(
                    Name: u?.Name ?? sa.EmpCode,
                    Sam:  u?.AdSamAccountName ?? sa.EmpCode,
                    AssignedAt: sa.AssignedAtUtc,
                    AssignedBy: sa.AssignedBy);
            })
            .ToList();

        _appAdmins = appAdminsTask.Result
            .OrderByDescending(a => a.AssignedAtUtc)
            .Select(a =>
            {
                var u = _allUsers.FirstOrDefault(x => string.Equals(x.EmpCode, a.EmpCode, StringComparison.OrdinalIgnoreCase));
                var grantedByUser = _allUsers.FirstOrDefault(x => string.Equals(x.EmpCode, a.AssignedByEmp, StringComparison.OrdinalIgnoreCase));
                var grantedByName = grantedByUser?.Name ?? a.AssignedByEmp;
                return new AppAdminRow(a.EmpCode, u?.Name ?? a.EmpCode, u?.AdSamAccountName ?? "", a.AssignedAtUtc, grantedByName, a.IsActive);
            })
            .ToList();

        _feedbackAdmins = feedbackAdminsTask.Result
            .OrderByDescending(a => a.AssignedAtUtc)
            .Select(a =>
            {
                var u = _allUsers.FirstOrDefault(x => string.Equals(x.EmpCode, a.EmpCode, StringComparison.OrdinalIgnoreCase));
                var grantedByUser = _allUsers.FirstOrDefault(x => string.Equals(x.EmpCode, a.AssignedByEmp, StringComparison.OrdinalIgnoreCase));
                var grantedByName = grantedByUser?.Name ?? a.AssignedByEmp;
                return new AppAdminRow(a.EmpCode, u?.Name ?? a.EmpCode, u?.AdSamAccountName ?? "", a.AssignedAtUtc, grantedByName, a.IsActive);
            })
            .ToList();
    }

    private async Task OpenGrantDialog()
    {
        var superAdminsTask = Repo.ListSuperAdminsAsync();
        var appAdminsTask = Repo.ListAppAdminsAsync();
        await Task.WhenAll(superAdminsTask, appAdminsTask);
        var superEmpCodes = superAdminsTask.Result.Select(x => x.EmpCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var activeAdminEmpCodes = appAdminsTask.Result.Where(x => x.IsActive).Select(x => x.EmpCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var candidates = _allUsers
            .Where(u => u.IsActive && !superEmpCodes.Contains(u.EmpCode ?? "") && !activeAdminEmpCodes.Contains(u.EmpCode ?? ""))
            .OrderBy(u => u.Name)
            .ToList();

        var parameters = new DialogParameters { ["Candidates"] = candidates };
        var dlg = await Dialogs.ShowAsync<GrantAppAdminDialog>("Grant AppAdmin", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var res = await dlg.Result;
        if (res?.Canceled == false && res.Data is GrantAppAdminDialog.Result picked)
        {
            try
            {
                await Rbac.GrantAppAdminAsync(Me.EmpCode ?? "", picked.EmpCode, picked.Note);
                Snackbar.Add("AppAdmin granted", Severity.Success);
                await ReloadAsync();
            }
            catch (UnauthorizedAccessException)
            {
                Snackbar.Add("Only SuperAdmin can grant AppAdmin", Severity.Error);
            }
        }
    }

    private async Task Revoke(AppAdminRow row)
    {
        var ok = await Dialogs.ShowMessageBox("Revoke AppAdmin",
            $"Revoke AppAdmin rights from {row.Name}?", yesText: "Revoke", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Rbac.RevokeAppAdminAsync(Me.EmpCode ?? "", row.EmpCode);
            Snackbar.Add("AppAdmin revoked", Severity.Success);
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Snackbar.Add("Only SuperAdmin can revoke AppAdmin", Severity.Error);
        }
    }

    private async Task OpenGrantFeedbackDialog()
    {
        var superAdminsTask = Repo.ListSuperAdminsAsync();
        var feedbackAdminsTask = Repo.ListFeedbackAdminsAsync();
        await Task.WhenAll(superAdminsTask, feedbackAdminsTask);
        var superEmpCodes = superAdminsTask.Result.Select(x => x.EmpCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var activeFeedbackEmpCodes = feedbackAdminsTask.Result.Where(x => x.IsActive).Select(x => x.EmpCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var candidates = _allUsers
            .Where(u => u.IsActive && !superEmpCodes.Contains(u.EmpCode ?? "") && !activeFeedbackEmpCodes.Contains(u.EmpCode ?? ""))
            .OrderBy(u => u.Name)
            .ToList();

        var parameters = new DialogParameters { ["Candidates"] = candidates };
        var dlg = await Dialogs.ShowAsync<GrantAppAdminDialog>("Grant Feedback Admin", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var res = await dlg.Result;
        if (res?.Canceled == false && res.Data is GrantAppAdminDialog.Result picked)
        {
            try
            {
                await Rbac.GrantFeedbackAdminAsync(Me.EmpCode ?? "", picked.EmpCode, picked.Note);
                Snackbar.Add("Feedback Admin granted", Severity.Success);
                await ReloadAsync();
            }
            catch (UnauthorizedAccessException)
            {
                Snackbar.Add("Only SuperAdmin can grant Feedback Admin", Severity.Error);
            }
        }
    }

    private async Task RevokeFeedback(AppAdminRow row)
    {
        var ok = await Dialogs.ShowMessageBox("Revoke Feedback Admin",
            $"Revoke Feedback Admin rights from {row.Name}?", yesText: "Revoke", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Rbac.RevokeFeedbackAdminAsync(Me.EmpCode ?? "", row.EmpCode);
            Snackbar.Add("Feedback Admin revoked", Severity.Success);
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Snackbar.Add("Only SuperAdmin can revoke Feedback Admin", Severity.Error);
        }
    }

    private sealed record SuperAdminRow(string Name, string Sam, DateTime AssignedAt, string AssignedBy);
    private sealed record AppAdminRow(string EmpCode, string Name, string Sam, DateTime AssignedAt, string AssignedBy, bool IsActive);
}
