                Snackbar.Add($"Pushed to {sent} of {_audience.Count} recipients.", failed == 0 ? Severity.Success : Severity.Warning);
            }
            finally { _sending = false; } *@


            CloseComposer();

            _ = Task.Run(async () =>
        {
            try
            {
                var audience = await LandingDashboardService.GetBranchStaffDataAsync();

                var notification = new CreateNotificationRequest
                    {
                        Title = _poImages.FirstOrDefault()?.Name ?? "New Event Update",
                        Message = _poCaption ?? "New Event Update Posted",
                        Category = _poImages.FirstOrDefault()?.ContentType ?? "Events",
                        EventCode = "Events",
                        Source = NotificationSource.System,
                        RedirectUrl = "union-hub"
                    };

                int sent = 0;
                int failed = 0;

                foreach (var batch in audience.Chunk(1000))
                {
                    var tasks = batch.Select(async user =>
                    {
                        try
                        {
                            await NotificationApi.CreateAsync(
                                new CreateNotificationRequest
                                    {
                                        UserId = Convert.ToInt32(user.EmpCode),
                                        Title = notification.Title,
                                        Message = notification.Message,
                                        Category = notification.Category,
                                        EventCode = notification.EventCode,
                                        Source = notification.Source,
                                        RedirectUrl = notification.RedirectUrl
                                    });

                            Interlocked.Increment(ref sent);
                        }
                        catch (Exception ex)
                        {
                            AppLogger.LogWarning($"UnionHub Explore: notification send failed for user {user.EmpCode} — {ex.Message}");
                            Interlocked.Increment(ref failed);
                        }
                    });

                    await Task.WhenAll(tasks);
                }

                AppLogger.LogInfo($"Union Hub - Explore: Notifications Sent={sent}, Failed={failed}");
            }
            catch (Exception ex)
            {
                AppLogger.LogError(ex, "[Union Hub - Explore] Unhandled Notification error: " + ex.Message);
            }
        });
        }
      
        catch (Exception ex) { AppLogger.LogError(ex, "UnionHub Explore: failed to publish post"); Snackbar.Add(UserFacingError.Generic, Severity.Error); }
        finally { _busy = false; }
    }

