    private async Task AddTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;
        _busy = true;
        try
        {
            await EventsSvc.AddTagAsync(_newTagName, _empId ?? "");
            _allTags = (await EventsSvc.ListTagsAsync(false)).ToList();
            _tags = (await EventsSvc.ListTagsAsync(true)).ToList();
            _newTagName = "";
        }
        catch (Exception ex) { AppLogger.LogError(ex, "UnionHub Explore: failed to add tag"); Snackbar.Add(UserFacingError.Generic, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task ToggleTag(EventTag t)
    {
        await EventsSvc.SetTagEnabledAsync(t.Id, !t.IsEnabled, _empId ?? "");
        _allTags = (await EventsSvc.ListTagsAsync(false)).ToList();
        _tags = (await EventsSvc.ListTagsAsync(true)).ToList();
    }

    private static string InitialsOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string VerticalInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var words = name.Split(new[] { ' ', '-', '_', '/' }, StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 1) return words[0][..Math.Min(3, words[0].Length)].ToUpperInvariant();
        return (words[0][0].ToString() + words[1][0]).ToUpperInvariant();
    }
