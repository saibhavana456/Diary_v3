@namespace RequestPortal.Web.Pages.Masters
@page "/masters/employees"
@inject IServiceProvider SP
@inject ISnackbar Snackbar
@inject ModuleContext Module

<PageTitle>Employee Master</PageTitle>
<PageHeader PageKey="masters-employees" Title="Employee Master"
            Subtitle="Manage employees, their Sol ID assignments, positions and designations."
            Crumbs="@(new List<PageHeader.Crumb>{ new("Request Portal"), new("People & Access"), new("Employee Master") })" />

<SuperAdminOnly>
<MudPaper Elevation="1">
    <MudTable T="EmpRow" Items="@_rows" Dense="true" Hover="true" Striped="true" Class="rp-data-table"
              Filter="@(r => Filter(r, _search))">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" Class="mr-4"><b>@_rows.Count</b> employees</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_search" Placeholder="Search name / code / Sol ID…"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" Immediate="true" Style="max-width:300px" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Employee</MudTh>
            <MudTh>Emp Code</MudTh>
            <MudTh>Sol ID</MudTh>
            <MudTh>Sol ID Type</MudTh>
            <MudTh>Position</MudTh>
            <MudTh>Designation</MudTh>
            <MudTh>Derived Role</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div class="d-flex align-center gap-2">
                    <div class="rp-user-avatar">@Initials(context.Name)</div>
                    <div>
                        <div style="font-weight:600;font-size:13px">@context.Name</div>
                        <div style="font-size:11px;color:#59636e">@context.Email</div>
                    </div>
                </div>
            </MudTd>
            <MudTd><span style="font-family:monospace;font-size:12px">@context.EmpCode</span></MudTd>
            <MudTd>
                <div style="font-weight:600;font-size:12px">@context.SolCode</div>
                <div style="font-size:11px;color:#59636e">@context.SolName</div>
            </MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@SolTypeColor(context.SolType)" Variant="Variant.Outlined">@DemoStore.SolIdTypeLabel(context.SolType)</MudChip></MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@DemoStore.PositionLabel(context.Position)</MudChip></MudTd>
            <MudTd><MudText Typo="Typo.caption">@(context.Designation ?? "—")</MudText></MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@RoleColor(context.DerivedRole)" Variant="Variant.Filled">@DemoStore.RoleLabel(context.DerivedRole)</MudChip></MudTd>
            <MudTd>
                @if (context.IsActive)
                { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Active</MudChip> }
                else
                { <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Inactive</MudChip> }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4" Color="Color.Secondary">No employee records found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>
</SuperAdminOnly>

@code {
    private List<EmpRow> _rows = new();
    private string _search = "";

    protected override void OnInitialized()
    {
        Module.SwitchTo(PortalModule.AdminPortal);
        var demo = SP.GetService<DemoStore>();
        if (demo is null) return;

        _rows = demo.EmployeeMasters.Select(e =>
        {
            var sol  = demo.SolIds.FirstOrDefault(s => s.Id == e.SolId);
            var role = DemoStore.DeriveRole(e.SolIdType, e.Position);
            return new EmpRow(e.Id, e.EmpCode, e.Name, e.Email, sol?.Code ?? "—", sol?.Name ?? "—",
                e.SolIdType, e.Position, e.Designation, role, e.IsActive);
        }).OrderBy(r => r.SolType).ThenBy(r => r.Name).ToList();
    }

    private static bool Filter(EmpRow r, string s) =>
        string.IsNullOrWhiteSpace(s) ||
        r.Name.Contains(s, StringComparison.OrdinalIgnoreCase) ||
        r.EmpCode.Contains(s, StringComparison.OrdinalIgnoreCase) ||
        r.SolCode.Contains(s, StringComparison.OrdinalIgnoreCase) ||
        r.SolName.Contains(s, StringComparison.OrdinalIgnoreCase);

    private static string Initials(string n)
    {
        var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 1 ? p[0][..Math.Min(2, p[0].Length)].ToUpper() : $"{p[0][0]}{p[^1][0]}".ToUpper();
    }

    private static Color SolTypeColor(SolIdType t) => t switch
    {
        SolIdType.CoVertical     => Color.Error,
        SolIdType.ZonalOffice    => Color.Warning,
        SolIdType.RegionalOffice => Color.Info,
        _                        => Color.Success
    };

    private static Color RoleColor(RoleCode r) => r switch
    {
        RoleCode.AppAdmin or RoleCode.SuperAdmin => Color.Error,
        RoleCode.VertL5                          => Color.Info,
        RoleCode.VertL4 or RoleCode.VertL3      => Color.Warning,
        RoleCode.VertL2 or RoleCode.VertL1      => Color.Success,
        _                                        => Color.Default
    };

    private sealed record EmpRow(long Id, string EmpCode, string Name, string? Email,
        string SolCode, string SolName, SolIdType SolType, EmployeePosition Position,
        string? Designation, RoleCode DerivedRole, bool IsActive);
}
