@namespace MyDiary.Web.Shared
@inject AuthenticationStateProvider AuthStateProvider
@* ───────────────────────────────────────────────────────────────────────
   PageHeader — gradient breadcrumb + title banner
   WCAG 2.1 AA compliance:
     • nav[aria-label="Breadcrumb"] landmark (WCAG 2.4.1)
     • aria-current="page" on last crumb (WCAG 2.4.8)
     • aria-hidden separators — not read by screen readers (WCAG 1.3.1)
     • h1 with unique id — page region labelled via aria-labelledby (WCAG 2.4.6)
     • role="group" on action cluster
     • <p> for subtitle (not <div>) — correct semantic element
   ─────────────────────────────────────────────────────────────────────── *@

<div class="rp-page-header" role="region" aria-labelledby="ph-title">
    <div class="rp-page-header-row">
        <div style="flex:1; min-width:0;">

            @* ── Breadcrumb navigation ── *@
            <nav aria-label="Breadcrumb">
                <ol class="rp-breadcrumbs" style="list-style:none; margin:0; padding:0;">
                    @{ var crumbs = Crumbs ?? new List<Crumb>(); }

                    @if (ShowHome)
                    {
                        <li style="display:inline-flex; align-items:center; gap:4px;">
                            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small"
                                     aria-hidden="true" Style="font-size:15px;" />
                            <a href="@HomeRoute" style="color:rgba(255,255,255,.9)">Home</a>
                        </li>
                        @if (crumbs.Count > 0)
                        {
                            <li aria-hidden="true" class="rp-sep">&rsaquo;</li>
                        }
                    }

                    @for (var i = 0; i < crumbs.Count; i++)
                    {
                        var c     = crumbs[i];
                        var isLast = i == crumbs.Count - 1;

                        <li style="display:inline-flex; align-items:center; gap:4px;">
                            @if (isLast)
                            {
                                @* Current page — screen readers announce "current page" *@
                                <span class="rp-current" aria-current="page">@c.Text</span>
                            }
                            else if (!string.IsNullOrEmpty(c.Href))
                            {
                                <a href="@c.Href" style="color:rgba(255,255,255,.9)">@c.Text</a>
                            }
                            else
                            {
                                <span>@c.Text</span>
                            }
                        </li>

                        @if (!isLast)
                        {
                            <li aria-hidden="true" class="rp-sep">&rsaquo;</li>
                        }
                    }
                </ol>
            </nav>

            @* ── Page title — always an h1, id referenced by aria-labelledby ── *@
            <h1 class="rp-title" id="ph-title">@Title</h1>

            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="rp-subtitle" style="margin:4px 0 0;">@Subtitle</p>
            }
        </div>

        @* ── Optional action buttons ── *@
        @if (Actions is not null)
        {
            <div class="rp-actions" role="group" aria-label="Page actions">@Actions</div>
        }

        @* ── Page info ⓘ ── *@
        @if (!string.IsNullOrEmpty(PageKey))
        {
            <PageInfoIcon PageKey="@PageKey" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle  { get; set; }
    [Parameter] public string? PageKey   { get; set; }
    [Parameter] public List<Crumb>? Crumbs { get; set; }
    [Parameter] public bool ShowHome     { get; set; } = true;
    [Parameter] public RenderFragment? Actions { get; set; }

    public sealed record Crumb(string Text, string? Href = null);

    private bool _isCoUser;
    private int _userScale;
    private string HomeRoute => _isCoUser ? (_userScale >= 6 ? "home" : "home-dashboard") : "home-dashboard";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var privilege = user.FindFirst("privilege")?.Value ?? "";
        int.TryParse(user.FindFirst("employee_scale_code")?.Value, out _userScale);
        _isCoUser = privilege.Equals("CO", StringComparison.OrdinalIgnoreCase) || privilege.Equals("CORPORATE", StringComparison.OrdinalIgnoreCase);
    }
}
