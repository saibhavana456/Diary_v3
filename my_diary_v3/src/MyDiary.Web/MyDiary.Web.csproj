<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Suppress inherited warnings from migrated Project A/B code (nullable, MudBlazor
         analyzer, unused/obsolete). These were pre-existing in the source projects;
         not hand-fixing 1000+ across migrated files. Remove a code to surface it again. -->
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8600;CS8625;CS8620;CS8619;CS8669;CS8714;CS8622;MUD0002;CS0414;CS0649;CS0219;CS0168;CS0169;CS0618;CS0105;CS4014;CS8321;RZ10012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDiary.Core\MyDiary.Core.csproj" />
    <ProjectReference Include="..\MyDiary.Data\MyDiary.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="EPPlus" Version="8.6.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.Oracle.Core" Version="1.3.24" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Cannot be upgraded past 8.0.10 without moving the whole app to net9.0: this is a
         shared-framework package strictly pinned to its matching runtime major version — v9.0.20
         declares net9.0-only compatibility (confirmed via a failed NU1202 restore attempt).
         The two flagged advisories (GHSA-2p3q-h3hg-jcqq, GHSA-8prm-248r-h957) have no fix
         available within net8.0; tracked as a pre-existing, currently-unfixable finding. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
    <PackageReference Include="MudBlazor" Version="8.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.26000" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.3" />
    <PackageReference Include="Scriban.Signed" Version="7.2.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
  </ItemGroup>

  <!-- Direct overrides for transitive packages flagged by `dotnet list package -vulnerable`
       (security audit, 2026-09-12) — NuGet's "nearest wins" rule means these pins take effect
       over whatever PdfSharpCore/EPPlus/EF Core themselves request. System.Text.Json and
       System.Security.Cryptography.Xml are regular (non-shared-framework) BCL packages that
       support running ahead of the app's net8.0 TFM, so a 9.0.x pin here is standard practice.
       SixLabors.ImageSharp: an initial attempt jumped to 3.1.12, but that broke PDF generation
       at RUNTIME (confirmed via a standalone repro) — PdfSharpCore 1.3.67 calls the ImageSharp 2.x
       API `Image.Load(string, out IImageFormat)`, which was removed in ImageSharp 3.x, causing
       `MissingMethodException` the first time XImage.FromFile() ran. Pinned instead to 2.1.13,
       the latest 2.x release (same major line PdfSharpCore was built against, so it's binary
       compatible) and confirmed via `dotnet list package -vulnerable` to carry none of the
       advisories that flagged the original transitive 1.0.4; verified end-to-end with a
       standalone PdfSharpCore+ImageSharp 2.1.13 smoke test that loaded a real PNG and JPG via
       XImage.FromFile and saved a working PDF. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <!--<PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.20" />-->
    <PackageReference Include="System.Text.Json" Version="9.0.20" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyDiary.Web</RootNamespace>
    <!-- Server GC: better throughput for a multi-core server handling many concurrent
         circuits/requests (Workstation GC, the implicit default for some hosting
         scenarios, optimizes for low latency on a single core and does not scale well
         to 1000 concurrent users). Concurrent GC keeps background collections from
         pausing all threads. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Include App_Data folder in publish output -->
	<ItemGroup>
		<Content Include="App_Data\**" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="wwwroot\download\Master Direction\" />
	  <Folder Include="wwwroot\MyDiary\download\" />
	  <Folder Include="wwwroot\MyDiary\UBINET\" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="Features\SubsidiaryJv\Pages\SjvAdmin.razor" />
	  <None Include="Features\SubsidiaryJv\Pages\SjvEntityPage.razor" />
	  <None Include="Features\SubsidiaryJv\Pages\SjvLanding.razor" />
	</ItemGroup>

</Project>
