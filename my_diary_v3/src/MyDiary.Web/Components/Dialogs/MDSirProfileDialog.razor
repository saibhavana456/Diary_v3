@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using MudBlazor
@inject IJSRuntime JS

<MudDialog Class="image-dialog" Style="max-height:80vh; width:100%;" aria-labelledby="md-profile-dialog-title">
    <TitleContent>
        @if (!string.IsNullOrEmpty(Name))
        {
            <MudText Typo="Typo.h6" id="md-profile-dialog-title" Style="font-weight:700; color:#1E3A8A;">
                <span data-i18n="@Name"></span> — <span data-i18n="@Role"></span>
            </MudText>
        }
        else
        {
            <span id="md-profile-dialog-title" class="visually-hidden" data-i18n="ROLE_MD_CEO_TXT"></span>
        }
    </TitleContent>
    <DialogContent>
        <div style="max-height:65vh; overflow-y:auto;">
            @if (string.IsNullOrEmpty(BioI18nKey))
            {
                @* MD view — shows the PDF/image *@
                <MudImage Src="@(string.IsNullOrEmpty(ImageUrl) ? "MD_Sir_Intro/MD_Message.jpg" : ImageUrl)"
                          Alt="MD & CEO message and profile"
                          ObjectFit="ObjectFit.Contain"
                          Style="width:100%; max-height:60vh; border-radius:10px;" />
            }
            else
            {
                @* Board member view — photo + title + full bio *@
                <div style="display:flex; flex-direction:column; align-items:center; gap:16px; padding:10px;">
                    <div style="width:160px; height:200px; border-radius:16px; overflow:hidden;
                                box-shadow:0 8px 20px rgba(0,0,0,0.15); flex-shrink:0;">
                        <MudImage Src="@ImageUrl"
                                  Alt="@Name"
                                  ObjectFit="ObjectFit.Cover"
                                  Style="width:100%; height:100%;" />
                    </div>

                    <div style="text-align:center;">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1E3A8A;" data-i18n="@Name"></MudText>
                        <MudText Typo="Typo.body2" Style="color:#666;" data-i18n="@Role"></MudText>
                    </div>

                    <MudDivider />

                    <MudText Typo="Typo.body1"
                             Style="line-height:1.8; text-align:justify; color:#333; padding:0 10px;"
                             data-i18n="@BioI18nKey">
                    </MudText>
                </div>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close"
                   Color="MudBlazor.Color.Primary"
                   Variant="Variant.Filled">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Role { get; set; }
    [Parameter] public string? BioI18nKey { get; set; }

    [CascadingParameter] private MudBlazor.IMudDialogInstance? MudDialog { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Trigger i18n translation for data-i18n elements inside this dialog
            await Task.Delay(50);
            await JS.InvokeVoidAsync("loadLanguage");
        }
    }

    private void Close() => MudDialog?.Close();
}
