@using Microsoft.AspNetCore.Components
@using MudBlazor
@using MyDiary.Web.Features.Landing_Dashboard_V2.Models
@using MyDiary.Web.Features.Landing_Dashboard_V2.Services

<MudDialog Style="max-width: 95vw;" aria-labelledby="branch-staff-dialog-title">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="MudBlazor.Color.Primary" aria-hidden="true" />
            <MudText id="branch-staff-dialog-title" Typo="Typo.h6" Style="font-weight: 700; color: #1b4a98;">
                Staff Members — @BranchName
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (UseServerPaging)
        {
            <!-- Server-side paged table for large datasets (CO/Zone/Region users) -->
            <div class="d-flex justify-end mb-4">
                <MudTextField @bind-Value="_search"
                              Label="Search staff members"
                              Placeholder="Search by Name, Branch, Designation..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="MudBlazor.Size.Medium"
                              Immediate="true"
                              DebounceInterval="500"
                              Style="max-width:350px;"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              TextChanged="OnSearchChanged" />
            </div>

            <MudTable ServerData="ServerReload"
                      @ref="_table"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true"
                      Elevation="0"
                      RowsPerPage="50"
                      Style="border: 1px solid #e2e8f0;"
                      T="BranchStaffMember"
                      Loading="@_loading">
                <HeaderContent>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">S.No.</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Name</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Branch</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">SolID</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Region</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Zone</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Designation</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Contact No.</MudTh>
                    <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Email</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SNo</MudTd>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.Branch</MudTd>
                    <MudTd>@context.SolId</MudTd>
                    <MudTd>@context.Region</MudTd>
                    <MudTd>@context.Zone</MudTd>
                    <MudTd>@context.Designation</MudTd>
                    <MudTd>@context.ContactNo</MudTd>
                    <MudTd>@context.Email</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No staff members found.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        }
        else
        {
            <!-- Client-side table for small datasets (Branch users viewing their own staff) -->
            @if (!StaffMembers.Any())
            {
                <MudAlert Severity="Severity.Info">No staff member records found for this branch.</MudAlert>
            }
            else
            {
                <div class="d-flex justify-end mb-4">
                    <MudTextField @bind-Value="_search"
                                  Label="Search staff members"
                                  Placeholder="Search by Name, Branch, Designation..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="MudBlazor.Size.Medium"
                                  Immediate="true"
                                  Style="max-width:350px;"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </div>

                <MudTable Items="@FilteredMembers"
                          Dense="true"
                          Hover="true"
                          Bordered="true"
                          Striped="true"
                          Elevation="0"
                          RowsPerPage="25"
                          Style="border: 1px solid #e2e8f0;"
                          T="BranchStaffMember">
                    <HeaderContent>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">S.No.</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Name</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Branch</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">SolID</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Region</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Zone</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Designation</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Contact No.</MudTh>
                        <MudTh Style="background:#1b4a98; color:white; font-weight:700;">Email</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.SNo</MudTd>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Branch</MudTd>
                        <MudTd>@context.SolId</MudTd>
                        <MudTd>@context.Region</MudTd>
                        <MudTd>@context.Zone</MudTd>
                        <MudTd>@context.Designation</MudTd>
                        <MudTd>@context.ContactNo</MudTd>
                        <MudTd>@context.Email</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Class="rounded-pill px-5">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public string BranchName { get; set; } = "";
    [Parameter] public List<BranchStaffMember> StaffMembers { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; } = false;

    // Server-side paging parameters (set by StaffDetailsModule for CO/Zone/Region users)
    [Parameter] public bool UseServerPaging { get; set; } = false;
    [Parameter] public string UserRole { get; set; } = "";
    [Parameter] public string BranchSolId { get; set; } = "";
    [Parameter] public string RegionSolId { get; set; } = "";
    [Parameter] public string ZoneSolId { get; set; } = "";
    [Parameter] public ILandingDashboardV2Service? DashboardService { get; set; }

    private MudTable<BranchStaffMember>? _table;
    private string _search = "";
    private bool _loading = false;

    private IEnumerable<BranchStaffMember> FilteredMembers => string.IsNullOrWhiteSpace(_search)
        ? StaffMembers
        : StaffMembers.Where(m =>
            (m.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (m.Branch?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (m.Region?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (m.Zone?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (m.Designation?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task<TableData<BranchStaffMember>> ServerReload(TableState state, CancellationToken ct)
    {
        _loading = true;
        StateHasChanged();

        try
        {
            if (DashboardService == null)
                return new TableData<BranchStaffMember> { Items = new List<BranchStaffMember>(), TotalItems = 0 };

            var (items, total) = await DashboardService.GetBranchStaffMembersPagedAsync(
                UserRole, BranchSolId, RegionSolId, ZoneSolId,
                state.Page, state.PageSize, _search);

            return new TableData<BranchStaffMember> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, $"[BranchStaffDialog] Server paging error: {ex.Message}");
            return new TableData<BranchStaffMember> { Items = new List<BranchStaffMember>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        if (_table != null)
            await _table.ReloadServerData();
    }

    private void Close() => MudDialog.Close();
}
