@page "/about"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode())
@using MudBlazor
@layout MyDiary.Web.Components.Layout.LandingLayout

<PageTitle>About Us — My Diary | Union Bank of India</PageTitle>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #1E3A8A 0%, #EF4444 100%);
        --primary-color: #1E3A8A;
        --secondary-color: #EF4444;
    }

    /* Standard Background Container matching Departments and Documents */
    .main-content-container {
        padding: 25px;
        background: rgba(255,255,255,0.95);
        min-height: 85vh;
        background-image: url("images/Login_right_bg.jpeg");
        background-size: cover;
        background-position: center;
    }

    /* Tab Navigation Styling from AboutUs.aspx */
    .tabs-wrapper {
        display: flex;
        flex-wrap: nowrap;
        gap: 12px;
        padding: 12px 0;
        margin-bottom: 30px;
        overflow-x: auto;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
    }

    .tab-btn {
        background: white;
        border: 1px solid rgba(0,0,0,0.08);
        color: #1f2937;
        padding: 10px 22px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

        .tab-btn.active {
            background: var(--primary-gradient);
            color: #fff;
            box-shadow: 0 10px 26px rgba(30,58,138,0.45);
        }

    /* Main Content Card */
    .about-card {
        background: white;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        animation: fadeIn 0.35s ease-in-out;
    }
    /* Three-column logo row with left, center, right alignment */
    /* Three-column logo row with per-item caption */
.logo-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr; /* 3 equal columns */
    align-items: start;
    gap: 0; /* adjust if you want spacing between the three */
}

.logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;     /* center the image within its column */
    justify-content: start;
}

.logo-img {
    height: 100px;           /* match your current inline style */
    width: 300px;            /* match your current inline style */
    object-fit: contain;
}

.logo-caption {
    margin-top: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1f2937;          /* neutral dark */
    text-align: center;
}

/* Responsive: stack vertically on narrow screens */
@@media (max-width: 768px) {
    .logo-row {
        grid-template-columns: 1fr;
        row-gap: 12px;
        justify-items: center;
    }
}

    .section-title {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 25px;
        color: #111827;
        padding-left: 16px;
        position: relative;
    }

        .section-title::before {
            content: "";
            position: absolute;
            left: 0;
            top: 6px;
            height: 70%;
            width: 5px;
            background: var(--primary-gradient);
            border-radius: 6px;
        }

    /* Corporate Vision Styles */
    .vision-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 16px 30px rgba(0,0,0,0.12);
        border: 1px solid #e5e7eb;
    }

    .vision-wrapper {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 35px;
        align-items: center;
    }
    /* Vision quote styling */
    /* Container remains the same from earlier */
    .vision-quote-card {
        position: relative;
        background: #ffffff;
        border-radius: 24px;
        padding: 32px 36px; /* space inside the card */
        box-shadow: 0 16px 34px rgba(0,0,0,0.12);
        border: 1px solid #e5e7eb;
    }

    /* The paragraph itself is inline-block so ::after sits at true end */
    .vision-quote {
        display: inline-block; /* ensures ::after is at the end of last line */
        margin: 0;
        font-style: italic;
        font-weight: 700;
        font-size: clamp(1.4rem, 2.4vw + 0.6rem, 2.1rem);
        line-height: 1.7;
        color: #0f172a; /* slate-900 */
        letter-spacing: 0.2px;
        /* add breathing room so quotes don't collide with text */
        padding: 0 0.1em;
    }

    /* Gradient accent on selected words */
    .vision-quote-accent {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    /* Decorative opening and closing quotes injected inline */
    .vision-quote::before,
    .vision-quote::after {
        font-family: inherit;
        font-weight: 800;
        line-height: 1; /* crisp bounding box */
        color: #ef5350; /* red accent close to your gradient */
        /* Optional: gradient quotes – uncomment if you want gradient fill on the quotes too
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        */
    }

    /* Opening quote before the first character of the first line */
    .vision-quote::before {
        content: "“";
        font-size: 1.4em; /* bigger than text for emphasis */
        margin-right: 0.25em; /* spacing between quote and first word */
        vertical-align: baseline; /* sits on the first line baseline */
    }

    /* Closing quote after the last character of the last line */
    .vision-quote::after {
        content: "”";
        font-size: 1.4em;
        margin-left: 0.25em; /* spacing between text and quote */
        vertical-align: baseline; /* sits on the last line baseline */
    }

    /* Optional subtle bottom accent bar on the card */
    .vision-quote-card::after {
        content: "";
        position: absolute;
        left: 32px;
        right: 32px;
        bottom: 18px;
        height: 4px;
        background: linear-gradient(90deg, rgba(30,58,138,0.15) 0%, rgba(239,68,68,0.25) 100%);
        border-radius: 999px;
    }

    /* Responsive padding (Razor: use @@media) */
    @@media (max-width: 768px) {
        .vision-quote-card {
            padding: 24px 22px;
            border-radius: 20px;
        }
    }

    .vision-text {
        font-size: 1.15rem;
        line-height: 1.9;
        color: #1f2937;
        font-weight: 500;
        position: relative;
        padding-left: 30px;
    }


    .vision-image {
        display: flex;
        justify-content: flex-end; /* pushes image to right edge */
    }


        .vision-text::before {
            position: absolute;
            left: 0;
            top: -8px;
            font-size: 3.2rem;
            color: var(--secondary-color);
            font-weight: 700;
        }

    /* Award Styles */
    .awards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 26px;
    }

    .award-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 26px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 14px 30px rgba(0,0,0,0.12);
        position: relative;
        transition: transform 0.25s ease;
    }

        .award-card:hover {
            transform: translateY(-4px);
        }

        .award-card::before {
            content: "🏆";
            position: absolute;
            top: -16px;
            right: 22px;
            font-size: 1.6rem;
            background: #fff;
            padding: 6px 10px;
            border-radius: 50%;
            box-shadow: 0 6px 14px rgba(0,0,0,0.15);
        }

    .award-label {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--primary-color);
        margin-bottom: 6px;
    }

    .award-text {
        font-size: 0.98rem;
        font-weight: 500;
        color: #1f2937;
        margin-bottom: 14px;
    }

    .award-list {
        padding-left: 18px;
        margin-bottom: 14px;
        font-size: 0.95rem;
        color: #374151;
        line-height: 1.55;
    }

    /* Director Styles */
    .wtd-item {
        background: var(--primary-gradient);
        border-radius: 18px;
        padding: 18px 26px;
        margin-bottom: 18px;
        color: #fff;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 14px 32px rgba(30,58,138,0.35);
    }

    .wtd-name {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .wtd-role {
        font-size: 0.85rem;
        opacity: 0.9;
    }

    .wtd-content {
        margin-top: 22px;
        background: #ffffff;
        border-radius: 18px;
        padding: 26px;
        color: #1f2937;
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 26px;
        animation: fadeIn 0.35s ease-in-out;
    }

    .wtd-photo img {
        width: 100%;
        border-radius: 14px;
        box-shadow: 0 10px 22px rgba(0,0,0,0.2);
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@media (max-width: 991px) {
        .vision-wrapper, .wtd-content

    {
        grid-template-columns: 1fr;
    }

    }
</style>

