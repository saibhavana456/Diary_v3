@code {
    private string activeTab = "overview";
    private int expandedDirectorId = 0;

    private class TabItem { public string Id { get; set; } = ""; public string Label { get; set; } = ""; }

    private List<TabItem> tabItems = new()
    {
        new TabItem { Id = "overview", Label = "Overview" },
        new TabItem { Id = "vision", Label = "Corporate Vision" },
        new TabItem { Id = "mission", Label = "Corporate Mission" },
        new TabItem { Id = "orgchart", Label = "Organization Chart" },
        // new TabItem { Id = "cov", Label = "CO Verticals" },
        new TabItem { Id = "awards", Label = "Awards" },
        new TabItem { Id = "wholetime", Label = "Whole Time Directors" },
        new TabItem { Id = "nonexec", Label = "Non Executive Directors" },
        // new TabItem { Id = "related", Label = "Related Parties" },
        new TabItem { Id = "history", Label = "History Book" }
    };

    private void SetActiveTab(string tabId)
    {
        activeTab = tabId;
        expandedDirectorId = 0; // Reset director accordion when switching tabs
    }

    private void ToggleDirector(int id)
    {
        expandedDirectorId = (expandedDirectorId == id) ? 0 : id;
    }
}