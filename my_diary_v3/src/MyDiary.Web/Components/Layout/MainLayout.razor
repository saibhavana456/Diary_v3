    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Test User";
            _userEmail = user.FindFirst("email")?.Value ?? "test@example.com";
            _userPhone = user.FindFirst("phone")?.Value ?? "";
            _userDesignation = user.FindFirst("employee_designation")?.Value ?? "";
            _userBranch = user.FindFirst("br_code")?.Value ?? "";

            // Warm the Request Portal current-user resolution once per circuit, in
            // this async context. Pages then read the sync ICurrentUser getters
            // (EmpCode/UserId/Roles) safely from cache — avoiding a sync-over-async
            // session read that could block the circuit.
            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                await RpCurrentUser.RefreshAsync().WaitAsync(cts.Token);
            }
            catch (OperationCanceledException)
            {
                AppLogger.LogWarning("MainLayout: RpCurrentUser.RefreshAsync timed out after 10s — continuing with cached user state");
            }
            catch (Exception ex)
            {
                AppLogger.LogWarning($"MainLayout: RpCurrentUser.RefreshAsync failed — {ex.Message}");
            }
        }

        _authChecked = true;
        ModuleNav.Changed += OnModuleChanged;

        Navigation.LocationChanged += OnLocationChangedForInfo;
        UpdatePageInfoKey();

        if (user.Identity?.IsAuthenticated == true)
        {
            // Read straight off the "emplid" claim rather than RpCurrentUser.EmpCode —
            // the latter resolves via a DB round trip (RP_USER/effective-roles lookup)
            // that can fail independently of the session actually being valid (e.g. a
            // missing supporting table locally), silently leaving EmpCode null forever
            // after the first failed resolve. The claim is always present and cheap.
            _usageLogEmpCode = user.FindFirst("emplid")?.Value ?? RpCurrentUser.EmpCode ?? "";
            _usageLogBranchSolId = user.FindFirst("branch_solid")?.Value;
            _usageLogRegionSolId = user.FindFirst("region_solid")?.Value;
            _usageLogZoneSolId = user.FindFirst("zone_solid")?.Value;
            _usageLogBranchName = user.FindFirst("branch_name")?.Value;
            _usageLogRegionName = user.FindFirst("region_name")?.Value;
            _usageLogZoneName = user.FindFirst("zone_name")?.Value;
            Navigation.LocationChanged += OnLocationChangedForUsageLog;
            LogPageVisitFireAndForget(Navigation.Uri); // the page this circuit landed on

            // One login event per circuit (Adoption Dashboard's Logins tab) — a
            // fresh circuit is the closest reliable proxy for "a login happened"
            // available without duplicating this at both Login.razor success paths
            // (AD/OTP flow and Developer Bypass).
            if (!string.IsNullOrWhiteSpace(_usageLogEmpCode))
            {
                _ = PageUsageRepo.InsertLoginAsync(new global::RequestPortal.Core.Models.LoginEvent
                {
                    EmpCode = _usageLogEmpCode,
                    LoginAtUtc = AppTime.Now,
                    LoginMethod = "SESSION",
                    BranchSolId = _usageLogBranchSolId,
                    RegionSolId = _usageLogRegionSolId,
                    ZoneSolId = _usageLogZoneSolId,
                    BranchName = _usageLogBranchName,
                    RegionName = _usageLogRegionName,
                    ZoneName = _usageLogZoneName
                });
            }
        }
    }

    // ── Page/menu usage logging (Menu Access Dashboard) ─────────────────────
    // Fire-and-forget: never awaited on the render path, any failure is
    // swallowed after logging — a usage-tracking hiccup must never break
    // navigation. Only routes registered as an active/enabled RBAC menu item
    // are logged (matches the dashboard's "menu access" framing) — the menu
    // list is fetched once per circuit and cached, not re-queried per click.
    private string _usageLogEmpCode = "";
    private string? _usageLogBranchSolId;
    private string? _usageLogRegionSolId;
    private string? _usageLogZoneSolId;
    private string? _usageLogBranchName;
    private string? _usageLogRegionName;
    private string? _usageLogZoneName;
    private Dictionary<string, string>? _usageLogMenuRoutes; // route (lowercase, trimmed) -> menu code

    private void OnLocationChangedForUsageLog(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => LogPageVisitFireAndForget(e.Location);

    private void LogPageVisitFireAndForget(string absoluteOrRelativeUri)
        => _ = LogPageVisitAsync(absoluteOrRelativeUri);

    private async Task LogPageVisitAsync(string uri)
    {
        try
        {
            if (_usageLogMenuRoutes is null)
            {
                var menus = await RbacRepoForUsageLog.ListMenusAsync();
                _usageLogMenuRoutes = menus
                    .Where(m => m.IsEnabled && m.IsActive && !string.IsNullOrWhiteSpace(m.Route))
                    .GroupBy(m => m.Route.Trim('/').ToLowerInvariant())
                    .ToDictionary(g => g.Key, g => g.First().Code);
            }

            var rel = Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            if (!_usageLogMenuRoutes.TryGetValue(rel, out var menuCode)) return; // not an RBAC menu route — skip
            if (string.IsNullOrWhiteSpace(_usageLogEmpCode)) return;

            await PageUsageRepo.InsertVisitAsync(new global::RequestPortal.Core.Models.PageVisit
            {
                MenuCode = menuCode,
                Route = rel,
                EmpCode = _usageLogEmpCode,
                VisitedAtUtc = AppTime.Now,
                BranchSolId = _usageLogBranchSolId,
                RegionSolId = _usageLogRegionSolId,
                ZoneSolId = _usageLogZoneSolId,
                BranchName = _usageLogBranchName,
                RegionName = _usageLogRegionName,
                ZoneName = _usageLogZoneName
            });
        }
        catch (Exception ex)
        {
            AppLogger.LogWarning($"[MainLayout] Page-visit logging failed for {uri} — {ex.Message}");
        }
    }

