    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await SyncLanguageAsync();
            await JS.InvokeVoidAsync("loadLanguage");

        // Fix accessibility: use a MutationObserver to persistently label any unlabeled buttons
        // rendered by MudBlazor internals (e.g., MudDrawer overlay button).
        // The observer ensures labels survive re-renders.
        await JS.InvokeVoidAsync("eval", @"
            (function() {
                // Helper: label all unlabeled buttons currently in the DOM
                function labelUnlabeledButtons() {
                    var allButtons = document.querySelectorAll('button');
                    allButtons.forEach(function(btn) {
                        if (btn.getAttribute('aria-label') || btn.getAttribute('aria-labelledby') || btn.getAttribute('title')) return;
                        var text = (btn.textContent || '').trim();
                        if (text) return;
                        var img = btn.querySelector('img[alt]');
                        if (img && img.alt) return;
                        // Assign label based on context
                        if (btn.closest('.mud-drawer-overlay') || btn.classList.contains('mud-overlay-drawer')) {
                            btn.setAttribute('aria-label', 'Close navigation panel');
                        } else if (btn.closest('.mud-drawer') || btn.closest('.mud-nav')) {
                            btn.setAttribute('aria-label', 'Toggle navigation panel');
                        } else if (btn.closest('.mud-appbar')) {
                            btn.setAttribute('aria-label', 'Menu');
                        } else if (btn.closest('.mud-overlay')) {
                            btn.setAttribute('aria-label', 'Close overlay');
                        } else {
                            btn.setAttribute('aria-label', 'Toggle navigation panel');
                        }
                    });
                    // Also handle focusable overlays
                    var overlays = document.querySelectorAll('.mud-overlay');
                    overlays.forEach(function(el) {
                        if (el.tabIndex >= 0 && !el.getAttribute('aria-label')) {
                            el.setAttribute('aria-label', 'Close overlay');
                            el.setAttribute('role', 'button');
                        }
                    });
                }

                // Run immediately
                labelUnlabeledButtons();

                // Ensure Quick Links button activates with Enter key for JAWS users.
                // JAWS in browse mode may not trigger Blazor's @onclick on Enter.
                // This native listener guarantees activation.
                var qlBtn = document.getElementById('mainQuickLinksBtn');
                if (qlBtn && !qlBtn._a11yEnhanced) {
                    qlBtn._a11yEnhanced = true;
                    qlBtn.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            e.stopPropagation();
                            qlBtn.click();
                        }
                    });
                }

                // Set up MutationObserver to catch dynamically added/re-rendered buttons
                if (!window._mainLayoutA11yObserver) {
                    window._mainLayoutA11yObserver = new MutationObserver(function() {
                        labelUnlabeledButtons();
                        labelDropdownListboxes();
                    });
                    window._mainLayoutA11yObserver.observe(document.body, { childList: true, subtree: true });
                }

                // Fix Issue #17: MudSelect teleports its dropdown to MudPopoverProvider at the
                // bottom of the DOM. JAWS cannot associate the detached list with the trigger.
                // This adds role=listbox and stable IDs so aria-controls on the wrapper works.
                function labelDropdownListboxes() {
                    var mappings = [
                        { popoverClass: 'zone-dropdown-popover', listId: 'zone-listbox-ul' },
                        { popoverClass: 'region-dropdown-popover', listId: 'region-listbox-ul' },
                        { popoverClass: 'branch-dropdown-popover', listId: 'branch-listbox-ul' }
                    ];
                    mappings.forEach(function(m) {
                        var lists = document.querySelectorAll('.' + m.popoverClass + ' .mud-list');
                        lists.forEach(function(list) {
                            if (!list.id) list.id = m.listId;
                            if (!list.getAttribute('role')) list.setAttribute('role', 'listbox');
                            // Mark each item as an option
                            list.querySelectorAll('.mud-list-item').forEach(function(item) {
                                if (!item.getAttribute('role')) item.setAttribute('role', 'option');
                            });
                        });
                    });
                }

                labelDropdownListboxes();


            })()
        ");
        }
        catch (JSDisconnectedException) { /* Circuit disconnected — safe to ignore */ }
        catch (InvalidOperationException) { /* JS interop unavailable during prerender */ }
        catch (TaskCanceledException) { /* Circuit disposed during async call */ }
    }

