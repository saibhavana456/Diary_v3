private void ClearSearch()
{
    searchString = string.Empty;
    _results.Clear();
    _showResults = false;
    StateHasChanged();
}

private void SetResultsVisibility()
{
    var hasText = !string.IsNullOrWhiteSpace(searchString);
    _showResults = hasText && (_results?.Count > 0);
}

private async Task OpenResultAsync(SearchResult r)
{
    if (string.IsNullOrWhiteSpace(r.url))
        return;

    // Close search popup before navigating
    _showResults = false;
    searchString = string.Empty;
    _results.Clear();
    StateHasChanged();

    // Check if URL is internal (relative or contains base URI)
    if (IsInternalUrl(r.url))
    {
        Navigation.NavigateTo(r.url, forceLoad: false);
    }
    else
    {
        await JS.InvokeVoidAsync("window.open", r.url, "_blank");
    }
}

private bool IsInternalUrl(string url)
{
    if (string.IsNullOrWhiteSpace(url))
        return false;

    // Relative URL → internal
    if (!url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        return true;

    // Absolute URL → check if same domain
    var baseUri = new Uri(Navigation.BaseUri);
    var targetUri = new Uri(url, UriKind.Absolute);

    return baseUri.Host.Equals(targetUri.Host, StringComparison.OrdinalIgnoreCase);
}

private async Task OnSuggestionPickedByValue(string picked)
{
    if (string.IsNullOrWhiteSpace(picked)) return;

    searchString = picked.Trim();
    await RunSearchAsync();
}


public sealed class SearchResult
{
    public int id { get; set; }
    public string? name { get; set; }
    public string? url { get; set; }
    public string? category { get; set; }
    public string? subCategory { get; set; }
    public string? description { get; set; }
    public string? keywords { get; set; }
    public decimal score { get; set; }
}

static string BuildOracleTextQuery(string q)
{
    var tokens = Regex.Matches(q ?? "", @"[\p{L}\p{N}]+")
        .Select(m => m.Value)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    if (tokens.Length == 0) return "";

    var andGroup = string.Join(" & ", tokens.Select(t => $"({t} | {t}%)"));
    var fuzzies = string.Join(" | ", tokens.Select(t => $"fuzzy({t}, 70, 200, weight)"));

    return $"{andGroup} | {fuzzies}";
}

private async Task<IEnumerable<string>> SuggestAsync(string value, CancellationToken ct)
{
    if (string.IsNullOrWhiteSpace(value))
    {
        _results.Clear();
        _showResults = false;
        return Array.Empty<string>();
    }

    try
    {
            const string sql = @"
    SELECT term FROM (
        SELECT DISTINCT t.term
        FROM mydiarydb.mydiary_suggest_terms t
        JOIN mydiarydb.mydiary_landing_sitemap s ON t.link_id = s.id
        WHERE UPPER(t.term) LIKE UPPER(:pfx)||'%'
          AND s.SHOW_AFTER_LOGIN = 'Y'
        ORDER BY t.term
    )
    WHERE ROWNUM <= :take";

        using var con = new OracleConnection(Configuration.GetConnectionString("MyDiaryDBConnection"));
        await con.OpenAsync(ct);

        using var cmd = new OracleCommand(sql, con) { BindByName = true };
        cmd.Parameters.Add("pfx", value);
        cmd.Parameters.Add("take", 8);

        var list = new List<string>();
        using var r = await cmd.ExecuteReaderAsync(ct);

        while (await r.ReadAsync(ct))
            list.Add(r.GetString(0));

        // Hide results popover during suggestions
        _results.Clear();
        _showResults = false;

        return list;
    }
    catch (Exception ex)
    {
        AppLogger.LogError(ex, "[MainLayout] Unhandled error: " + ex.Message);
        return Array.Empty<string>();
    }
}

private async Task RunSearchAsync()
{
    _loading = true;
    _results.Clear();

    try
    {
        var textQuery = BuildOracleTextQuery(searchString);

            string sql = @"
    SELECT
        l.id, l.name, l.url, l.category, l.sub_category,
        ( NVL(SCORE(1),0) * 5
          + CASE WHEN UPPER(l.name) LIKE UPPER(:pfx)||'%' THEN 200 ELSE 0 END
        ) AS rank_score
    FROM mydiarydb.mydiary_landing_sitemap l
    WHERE l.SHOW_AFTER_LOGIN = 'Y'
      AND (
          CONTAINS(l.keywords, :textQuery, 1) > 0 OR
          UPPER(l.name) LIKE UPPER(:pfx)||'%'
      )
    ORDER BY rank_score DESC";

        using var con = new OracleConnection(Configuration.GetConnectionString("MyDiaryDBConnection"));
        await con.OpenAsync();

        using var cmd = new OracleCommand(sql, con) { BindByName = true };
        cmd.Parameters.Add("pfx", searchString ?? "");

        if (!string.IsNullOrWhiteSpace(textQuery))
            cmd.Parameters.Add("textQuery", textQuery);

        using var r = await cmd.ExecuteReaderAsync();

        var list = new List<SearchResult>();

        while (await r.ReadAsync())
        {
            list.Add(new SearchResult
            {
                id = r.GetInt32(0),
                name = r.GetString(1),
                url = r.GetString(2),
                category = r.IsDBNull(3) ? null : r.GetString(3),
                subCategory = r.IsDBNull(4) ? null : r.GetString(4),
                score = r.IsDBNull(5) ? 0 : Convert.ToDecimal(r.GetValue(5))
            });
        }

        _results = list;
        _results = list;
        SetResultsVisibility();
    }
    finally
    {
        _loading = false;
        StateHasChanged();
    }
}

private async Task OnSearchKeyDown(KeyboardEventArgs e)
{
    if (e.Key == "Escape")
    {
        _results.Clear();
        _showResults = false;
        StateHasChanged();
        return;
    }

    if (e.Key == "Enter")
        await RunSearchAsync();
}


