    private void OnLocationChangedForInfo(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Auto-recover from error boundary on navigation — prevents the error page
        // from persisting when the user navigates to a different URL.
        _bodyErrorBoundary?.Recover();

        UpdatePageInfoKey();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdatePageInfoKey()
    {
        var rel = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        if (PageInfoKeyByRoute.TryGetValue(rel, out var key)) { _pageInfoKey = key; return; }
        var match = PageInfoKeyByPrefix.FirstOrDefault(p => rel.StartsWith(p.Prefix, StringComparison.OrdinalIgnoreCase));
        _pageInfoKey = match.Key;   // null when no prefix matches
    }

    /// <summary>
    /// Opens the employee's VCard in a new browser tab.
    /// Reads the base URL from config, delegates URL construction to VCardService.
    /// </summary>
    private async Task HandleVCardClickAsync()
    {
        string baseUrl = Configuration["ApiEndpoints:VCardBaseUrl"] ?? "";

        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            Snackbar.Add("VCard URL is not configured. Please contact your administrator.", Severity.Warning);
            return;
        }

        string employeeId = await SessionStorage.GetAsync<string>("UserId") ?? "";
        if (string.IsNullOrWhiteSpace(employeeId))
        {
            Snackbar.Add("Unable to load Visiting Card — user session not found. Please log in again.", Severity.Warning);
            return;
        }

        string finalUrl = await VCardService.BuildVCardUrlAsync(baseUrl, employeeId);
        await JS.InvokeVoidAsync("window.open", finalUrl, "_blank");
    }

    async void HandleLogout()
    {
        try
        {
            // 1. Clear profile image cache
            await SessionStorage.RemoveAsync("ProfileImageSrc");
            await SessionStorage.RemoveAsync("ProfileImageUserId");

            // 2. Remove session tracking record from database
            var userId = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrWhiteSpace(userId))
                await SessionTracker.RemoveSessionAsync(userId);

            // 3. Clear authentication state
            await ((MyDiary.Web.Auth.CustomAuthenticationStateProvider)AuthStateProvider).MarkLoggedOutAsync();

            // 4. Force reload to clear all state and redirect to landing page
            Navigation.NavigateTo("", forceLoad: true);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[MainLayout] Error during logout: " + ex.Message);
            Navigation.NavigateTo("", forceLoad: true);
        }
    }
