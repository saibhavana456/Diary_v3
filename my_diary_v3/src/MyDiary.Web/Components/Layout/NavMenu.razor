    // also render as a section in v3.1's own sidebar here.
    private IEnumerable<global::RequestPortal.Core.Models.AppModule> OtherModules =>
    _modules.Where(m => m.Code != "NAV.MAIN" && !m.Code.StartsWith("NAV.CCP", StringComparison.Ordinal));

    private global::RequestPortal.Core.Models.AppModule? ActiveDbModule
    {
        get
        {
            var code = EnumForCode.FirstOrDefault(kv => kv.Value == ModuleNav.Active).Key;
            return code is null ? null : _modules.FirstOrDefault(m => m.Code == code);
        }
    }

    private IEnumerable<global::RequestPortal.Core.Models.AppMenu> MenuItemsFor(long moduleId) =>
    _menus.Where(x => x.ModuleId == moduleId);


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            int scaleCode = 0;
            if (user.Identity?.IsAuthenticated == true)
            {
                int.TryParse(
            user.FindFirst("employee_scale_code")?.Value,
            out scaleCode);
            }
            var allModules = await RbacRepo.ListModulesAsync();
            var allMenus = await RbacRepo.ListMenusAsync();
            _modules = allModules.Where(m => m.IsActive).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
            _menus = allMenus.Where(x => x.IsEnabled && x.IsActive).Where(x =>
            {
                // Scale < 6 => Home Dashboard
                if (x.Route.Equals("home-dashboard", StringComparison.OrdinalIgnoreCase))
                    return scaleCode < 6;
                // Scale >= 6 => Home
                if (x.Route.Equals("home", StringComparison.OrdinalIgnoreCase))
                    return scaleCode >= 6;
                return true;
            }).OrderBy(x => x.SortOrder).ThenBy(x => x.Label).ToList();

            // Load navigation menus from the database (includes RedirectUrl for SSO/External links)
            _navmenus = await NavigationService.GetMenusAsync();
        }
        catch (Exception ex)
        {
            MyDiary.Web.Core.Extensions.AppLogger.LogError(ex, "[NavMenu] Failed to load RBAC nav data.");
        }
    }


    // CO users: Scale 1-3 (emp_scale_code 8,7,6) → /home, Scale 4+ (emp_scale_code ≤5) → /home-dashboard
