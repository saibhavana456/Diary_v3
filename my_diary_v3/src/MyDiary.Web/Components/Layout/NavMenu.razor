    // Branch/Region/Zone users: always /home-dashboard
    private string HomeRoute => _isCoUser ? (_userScale >= 6 ? "home" : "home-dashboard") : "home-dashboard";

    private string HomeIcon => _isCoUser ? (_userScale >= 6 ? Icons.Material.Filled.Home : Icons.Material.Filled.Leaderboard) : Icons.Material.Filled.Leaderboard;

