    // Resolves a plain MudBlazor icon-field name (e.g. "TrackChanges") to its
    // actual SVG path string. "img:xxx" values are handled specially by the
    // caller (rendered as an <img>, not a MudIcon) — this only covers icons.
    private static string ResolveIcon(string? name)
    {
        if (string.IsNullOrWhiteSpace(name) || name.StartsWith("img:", StringComparison.OrdinalIgnoreCase))
            return Icons.Material.Filled.Circle;
        var field = typeof(Icons.Material.Filled).GetField(name);
        return field?.GetValue(null) as string ?? Icons.Material.Filled.Circle;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        Nav.LocationChanged += OnLocationChanged;
        ModuleNav.Changed   += OnModuleChanged;
        ModuleNav.SyncFromRoute(Nav.ToBaseRelativePath(Nav.Uri));
        InvokeAsync(StateHasChanged);
    }

    // No password is ever included in the SSO handoff, for either portal — this app
    // never stores the user's password client-side in the first place (only "UserId" is
    // persisted at login; there was previously a vestigial, always-empty "Pwd" session-
    // storage read here left over from an earlier migration — removed rather than left
    // dormant, since a dormant plaintext-password code path is exactly the kind of thing
    // someone could accidentally "complete" later by actually wiring a password into it).
    private async Task NavigateToSsoPortal(string portalKey)
    {
        var userId = await SessionStorage.GetAsync<string>("UserId") ?? "";
        var pwd    = await SessionStorage.GetAsync<string>("Pwd")    ?? "";

        // Find the menu item in the database to get its RedirectUrl
        var menuItem = _navmenus.FirstOrDefault(m =>
            m.MenuRoute.Equals(portalKey, StringComparison.OrdinalIgnoreCase));

        var baseUrl = menuItem?.RedirectUrl;

        // Fallback to config if not found in DB (backward compatibility)
        if (string.IsNullOrEmpty(baseUrl))
        {
            var configKey = portalKey switch
            {
                "SuggestionPortal" => "SuggestionPortalUrl",
                "AskUs"            => "AskUsPortalUrl",
                _                  => null
            };
            if (configKey is not null)
                baseUrl = Config[$"ApiEndpoints:{configKey}"];
        }

        if (string.IsNullOrEmpty(baseUrl) || baseUrl == "#")
        {
            Snackbar.Add($"{portalKey} URL is not configured. Please contact your administrator.", MudBlazor.Severity.Warning);
            return;
        }

        // Determine whether password is required in the SSO token
        bool includePassword = portalKey switch
        {
            "SuggestionPortal" => true,
            _ => false
        };

        string finalUrl = baseUrl;
        if (!string.IsNullOrEmpty(userId))
        {
            var ts      = AppTime.Now.ToString("MM/dd/yyyy hh:mm:ss tt", CultureInfo.InvariantCulture);
            var plain   = includePassword ? $"{userId}|{pwd}|{ts}" : $"{userId}|{ts}";
            var ssoData = EncryptionService.EncryptStringAES(plain);
            finalUrl    = $"{baseUrl}?data={Uri.EscapeDataString(ssoData)}";
        }

        await JS.InvokeVoidAsync("window.open", finalUrl, "_blank");
    }

    private async Task NavigateToQlik()
    {
        // Read Qlik URL from the database (QLIK menu type) — matching My_Diary_V2 implementation
        var qlikMenu = _navmenus.FirstOrDefault(m =>
            m.MenuType.Equals("QLIK", StringComparison.OrdinalIgnoreCase));

        var qlikUrl = qlikMenu?.RedirectUrl;

        // Fallback to config if not found in DB
        if (string.IsNullOrEmpty(qlikUrl))
            qlikUrl = Config["ApiEndpoints:QlikUrl"];

        if (string.IsNullOrEmpty(qlikUrl) || qlikUrl == "#")
        {
            Snackbar.Add("Qlik Dashboard URL is not configured. Please contact your administrator.", MudBlazor.Severity.Warning);
            return;
        }

        var auth   = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        await QlikNavService.NavigateAsync(userId, qlikUrl);
    }

    private async Task OpenEscalationMatrix()
    {
        // Read URL from database (EXTERNAL menu type)
        var escMenu = _navmenus.FirstOrDefault(m =>
            m.MenuType.Equals("EXTERNAL", StringComparison.OrdinalIgnoreCase));

        var url = escMenu?.RedirectUrl;

        // Fallback to config if not found in DB
        if (string.IsNullOrEmpty(url))
            url = Config["ApiEndpoints:EscalationMatrixUrl"] ?? "";

        if (string.IsNullOrEmpty(url))
        {
            Snackbar.Add("Escalation Matrix URL is not configured. Please contact your administrator.", MudBlazor.Severity.Warning);
            return;
        }
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            var path = Nav.ToBaseRelativePath(e.Location).Split('?')[0].Trim('/');
            _srAnnouncement = $"{path} page loaded.";
            ModuleNav.SyncFromRoute(path);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            AppLogger.LogWarning($"NavMenu: OnLocationChanged failed — {ex.Message}");
        }
    }

    private void SwitchModule(MyDiary.Web.Services.AppModule m)
    {
        ModuleNav.SwitchTo(m);
        Nav.NavigateTo(MyDiary.Web.Services.AppModuleNav.DefaultRoute(m));
    }
    
    private void BackToMain()
    {
        ModuleNav.SwitchTo(MyDiary.Web.Services.AppModule.Main);
        Nav.NavigateTo(HomeRoute);
    }

    private void OnModuleChanged() => InvokeAsync(StateHasChanged);

    private RenderFragment ModuleBtn(global::RequestPortal.Core.Models.AppModule dbMod, MyDiary.Web.Services.AppModule m) =>
    @<button type="button" class="md-module-btn" @onclick="@(() => SwitchModule(m))">
        <span class="md-module-btn-icon"><MudIcon Icon="@ResolveIcon(dbMod.Icon)" Size="MudBlazor.Size.Small" /></span>
        <span class="md-module-btn-label">@dbMod.Name</span>
        <span class="md-module-btn-arrow">›</span>
    </button>;

    private RenderFragment BackBtn() =>
    @<button type="button" class="md-back-btn" @onclick="BackToMain">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" Class="mr-2" />
        <span>Back to Main</span>
    </button>;

    private RenderFragment MiniModuleBtn(global::RequestPortal.Core.Models.AppModule dbMod, MyDiary.Web.Services.AppModule m) =>
    @<MudNavLink OnClick="@(() => SwitchModule(m))" Icon="@ResolveIcon(dbMod.Icon)" title="@dbMod.Name" />;

    private RenderFragment MiniBack() =>
    @<MudNavLink OnClick="BackToMain" Icon="@Icons.Material.Filled.ArrowBack" title="Back to Main" />;

    // ── Per-menu-item rendering (full sidebar — visible label text) ─────────
    private RenderFragment RenderFullMenuItem(global::RequestPortal.Core.Models.AppMenu item) => __builder =>
    {
        RenderFragment inner = @<text>
            @if (item.Route.StartsWith("heading:"))
            {
                <div class="md-module-heading">@item.Route["heading:".Length..]</div>
            }
            else if (string.Equals(item.Route, "sso:Qlik", StringComparison.OrdinalIgnoreCase))
            {
                <MudNavLink OnClick="NavigateToQlik" Class="qlik-nav-link">
                    <img src="images/qlik-icon.svg" alt="" class="qlik-nav-icon" />
                    <span>@item.Label</span>
                </MudNavLink>
            }
            else if (item.Route.StartsWith("sso:", StringComparison.OrdinalIgnoreCase))
            {
                var key = item.Route["sso:".Length..];
                <MudNavLink OnClick="@(() => NavigateToSsoPortal(key))" Icon="@ResolveIcon(item.Icon)">@item.Label</MudNavLink>
            }
            else if (string.Equals(item.Route, "ext:EscalationMatrix", StringComparison.OrdinalIgnoreCase))
            {
                <MudNavLink OnClick="OpenEscalationMatrix" Icon="@ResolveIcon(item.Icon)">@item.Label</MudNavLink>
            }
            else if (string.Equals(item.Route, "ext:cc", StringComparison.OrdinalIgnoreCase))
            {
                var key = item.Route["ext:".Length..];
                <MudNavLink OnClick="@(() => NavigateToEkam(key))" Icon="@ResolveIcon(item.Icon)">@item.Label</MudNavLink>
            }
            else
            {
                var match = ExactMatchRoutes.Contains(item.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix;
                <MudNavLink Href="@item.Route" Icon="@ResolveIcon(item.Icon)" Match="match">@item.Label</MudNavLink>
            }
        </text>;

        if (ItemPolicyOverride.TryGetValue(item.Code, out var policy))
        {
            RenderFragment wrapped = @<AuthorizeView Policy="@policy">@inner</AuthorizeView>;
            wrapped(__builder);
        }
        else
        {
            inner(__builder);
        }
    };

    // ── Per-menu-item rendering (mini/collapsed sidebar — icon + tooltip) ───
    private RenderFragment RenderMiniMenuItem(global::RequestPortal.Core.Models.AppMenu item) => __builder =>
    {
        // Section headings don't render in icon-only mode (nothing to show).
        if (item.Route.StartsWith("heading:")) return;

        RenderFragment inner = @<text>
            @if (string.Equals(item.Route, "sso:Qlik", StringComparison.OrdinalIgnoreCase))
            {
                <MudNavLink OnClick="NavigateToQlik" title="@item.Label" Class="qlik-nav-link">
                    <span class="nav-svg-icon" aria-hidden="true"><img src="images/qlik-icon.svg" alt="" class="qlik-nav-icon" /></span>
                </MudNavLink>
            }
            else if (item.Route.StartsWith("sso:", StringComparison.OrdinalIgnoreCase))
            {
                var key = item.Route["sso:".Length..];
                <MudNavLink OnClick="@(() => NavigateToSsoPortal(key))" Icon="@ResolveIcon(item.Icon)" title="@item.Label" />
            }
            else if (string.Equals(item.Route, "ext:EscalationMatrix", StringComparison.OrdinalIgnoreCase))
            {
                <MudNavLink OnClick="OpenEscalationMatrix" Icon="@ResolveIcon(item.Icon)" title="@item.Label" />
            }
            else
            {
                var match = ExactMatchRoutes.Contains(item.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix;
                <MudNavLink Href="@item.Route" Icon="@ResolveIcon(item.Icon)" Match="match" title="@item.Label" />
            }
        </text>;

        if (ItemPolicyOverride.TryGetValue(item.Code, out var policy))
        {
            RenderFragment wrapped = @<AuthorizeView Policy="@policy">@inner</AuthorizeView>;
            wrapped(__builder);
        }
        else
        {
            inner(__builder);
        }
    };

    private async Task CollapseSidebar()
    {
        _collapsed = true;
        await SideBarOpenChanged.InvokeAsync(true);
    }

    private async Task ExpandSidebar()
    {
        _collapsed = false;
        await SideBarOpenChanged.InvokeAsync(true);
    }

    /// <summary>
    /// Navigates to the target route only if the user is not already on that page.
    /// Prevents unnecessary page reloads when clicking the same nav link.
    /// </summary>
    private void NavigateIfNotCurrent(string route)
    {
        if (!IsCurrentPage(route))
            Nav.NavigateTo(route);
    }

    /// <summary>
    /// Returns true if the current URI matches the given route (case-insensitive).
    /// </summary>
    private bool IsCurrentPage(string route)
    {
        var currentPath = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        return currentPath.Equals(route.Trim('/'), StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ModuleNav.Changed   -= OnModuleChanged;
    }

    /// <summary>
    /// Navigates to EKAM SSO portal by encrypting employee number and url_path via CryptoService.
    /// MenuRoute stores the url_path code (e.g., "cc" for Community Connect, "lp" for landing page).
    /// RedirectUrl stores the EKAM base URL.
    /// </summary>
    private async Task NavigateToEkam(string key)
    {
        // Find the menu item in the database to get its RedirectUrl
        var menuItem = _navmenus.FirstOrDefault(m =>
            m.MenuRoute.Equals(key, StringComparison.OrdinalIgnoreCase));

        var baseUrl = menuItem?.RedirectUrl;
        if (string.IsNullOrEmpty(baseUrl))
        {
            AppLogger.LogWarning($"[NavMenu] EKAM RedirectUrl not configured in database for '{menuItem.MenuName}'.");
            return;
        }

        if (!EkamSsoService.IsAvailable)
        {
            AppLogger.LogWarning("[NavMenu] EkamSsoService is unavailable. Opening base URL without encryption.");
            await JS.InvokeVoidAsync("window.open", baseUrl, "_blank");
            return;
        }

        var userId = await SessionStorage.GetAsync<string>("UserId") ?? "";
        if (string.IsNullOrEmpty(userId))
        {
            AppLogger.LogWarning("[NavMenu] UserId not found in session. Cannot build EKAM URL.");
            return;
        }

        // MenuRoute stores the url_path code (e.g., "cc", "lp", "rct", "appraisal")
        var urlPath = menuItem.MenuRoute ?? "lp";
        var ekamUrl = EkamSsoService.BuildEkamUrl(baseUrl, userId, urlPath);

        await JS.InvokeVoidAsync("window.open", ekamUrl, "_blank");
    }
}
