    protected override void OnInitialized()
    {
        base.OnInitialized();
        Nav.LocationChanged += OnLocationChanged;
        UpdateActiveFromUri(Nav.Uri);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            // Auto-recover from error boundary on navigation
            _landingErrorBoundary?.Recover();

            UpdateActiveFromUri(e.Location);
            await InvokeAsync(StateHasChanged);

            await JS.InvokeVoidAsync("loadLanguage");
        }
        catch (Exception ex)
        {
            AppLogger.LogWarning($"LandingLayout: OnLocationChanged failed — {ex.Message}");
        }
    }

    private void UpdateActiveFromUri(string uri)
    {
        // Normalize path
        var baseUri = new Uri(Nav.BaseUri);
        var full = new Uri(uri, UriKind.Absolute);
        var path = full.AbsolutePath;

        if (baseUri.AbsolutePath != "/" && path.StartsWith(baseUri.AbsolutePath, StringComparison.OrdinalIgnoreCase))
            path = path.Substring(baseUri.AbsolutePath.Length);

        path = path.Trim('/').ToLowerInvariant();

        // Read querystring (?source=downloads|departments)
        var query = QueryHelpers.ParseQuery(full.Query);
        var source = query.TryGetValue("source", out var srcVals) ? srcVals.ToString().ToLowerInvariant() : null;

        // Decide active tab
        ActiveLink = path switch
        {
            "" => "HOME",
            "my_diary_v2" => "HOME",
            "network" => "NETWORK",
            "downloads" => "DOWNLOADS",
            "departments" => "DEPARTMENTS",
            "applications" => "APPLICATIONS",
            "rates-charges" => "RATES & CHARGES",
            "faq-sop" => "FAQ/SOP",
            "about" => "ABOUT US",
            _ when path.StartsWith("ip-directory") => "NETWORK",
            _ when path.StartsWith("documents") => source switch
            {
                "downloads" => "DOWNLOADS",
                "departments" => "DEPARTMENTS",
                _ => ActiveLink
            },
            _ => ActiveLink
        };
    }

    // good hygiene: unsubscribe

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }


    static string BuildOracleTextQuery(string q)
    {
        var tokens = Regex.Matches(q ?? string.Empty, @"[\p{L}\p{N}]+")
                          .Select(m => m.Value)
                          .Where(s => !string.IsNullOrWhiteSpace(s))
                          .Distinct(StringComparer.OrdinalIgnoreCase)
                          .ToArray();

        if (tokens.Length == 0) return string.Empty;

        var andGroup = string.Join(" & ", tokens.Select(t => $"({t} | {t}%)"));
        var fuzzies = string.Join(" | ", tokens.Select(t => $"fuzzy({t}, 70, 200, weight)"));
        return $"{andGroup} | {fuzzies}";
    }

    private void NavigateToLogin() => Nav.NavigateTo("login");

    /* Search handlers */
    private async Task OnSuggestionPickedByValue(string picked)
    {
        if (string.IsNullOrWhiteSpace(picked)) return;
        searchString = picked.Trim();
        await RunSearchAsync();
    }

    private async Task OpenResultAsync(SearchResult r)
    {
        if (!string.IsNullOrWhiteSpace(r.url))
        {
            // Close search popup before navigating
            _showResults = false;
            searchString = string.Empty;
            _results.Clear();
            StateHasChanged();

            await JS.InvokeVoidAsync("window.open", r.url, "_blank", "noopener,noreferrer");
        }
    }

    private void SetResultsVisibility()
    {
        var hasText = !string.IsNullOrWhiteSpace(searchString);
        _showResults = hasText && (_results?.Count > 0);
    }

    private async Task OnAutoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _results.Clear();
            _showResults = false;
            StateHasChanged();
            return;
        }

        if (e.Key == "Enter")
            await RunSearchAsync();
    }

    private void ClearSearch()
    {
        searchString = string.Empty;
        _results.Clear();
        _showResults = false;
        StateHasChanged();
    }

    private async Task<IEnumerable<string>> SuggestAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _results.Clear();
            _showResults = false;
            return Array.Empty<string>();
        }

        try
        {
            ct.ThrowIfCancellationRequested();

            // NOTE: In Oracle, avoid bind variable in FETCH FIRST; use ROWNUM <= :take
            const string sql = @"
    SELECT term FROM (
        SELECT DISTINCT t.term
        FROM mydiarydb.mydiary_suggest_terms t
        JOIN mydiarydb.mydiary_landing_sitemap s ON t.link_id = s.id
        WHERE UPPER(t.term) LIKE UPPER(:pfx)||'%'
          AND t.page_type='landing'
          AND s.SHOW_BEFORE_LOGIN = 'Y'
        ORDER BY t.term
    )
    WHERE ROWNUM <= :take";

            using var con = new OracleConnection(ConnStr());
            await con.OpenAsync(ct);

            using var cmd = new OracleCommand(sql, con) { BindByName = true };
            cmd.Parameters.Add("pfx", value);
            cmd.Parameters.Add("take", 8);

            var list = new List<string>();
            using var r = await cmd.ExecuteReaderAsync(ct);
            while (await r.ReadAsync(ct))
                list.Add(r.GetString(0));

            // Let MudAutocomplete show its own dropdown.
            // We do not show our popover for suggestions to avoid duplication.
            _results.Clear();
            _showResults = false;

            return list;
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[LandingLayout] Unhandled error: " + ex.Message);
            _results.Clear();
            _showResults = false;
            return Array.Empty<string>();
        }
    }

    private async Task RunSearchAsync()
    {
        _error = null;
        _loading = true;
        _results.Clear();
        StateHasChanged();

        try
        {
            var textQuery = BuildOracleTextQuery(searchString);

            var sb = new System.Text.StringBuilder();
            sb.Append(@"
    SELECT
        l.id, l.name, l.url, l.category, l.sub_category, l.description, l.keywords,
        ( NVL(SCORE(1),0) * 5
          + CASE WHEN UPPER(l.name)     LIKE UPPER(:pfx)||'%' THEN 200 ELSE 0 END
          + CASE WHEN UPPER(l.keywords) LIKE UPPER(:pfx)||'%' THEN 100 ELSE 0 END
        ) AS rank_score
    FROM mydiarydb.mydiary_landing_sitemap l
    WHERE l.SHOW_BEFORE_LOGIN = 'Y' AND (");

            if (!string.IsNullOrWhiteSpace(textQuery))
            {
                sb.Append(" CONTAINS(l.keywords, :textQuery, 1) > 0 OR ");
            }

            sb.Append(@" UPPER(l.name)      LIKE UPPER(:pfx)||'%'
             OR UPPER(l.keywords) LIKE UPPER(:pfx)||'%' )
    ORDER BY rank_score DESC, l.name ASC");

            using var con = new OracleConnection(ConnStr());
            await con.OpenAsync();

            using var cmd = new OracleCommand(sb.ToString(), con) { BindByName = true };
            cmd.Parameters.Add("pfx", searchString ?? "");

            if (!string.IsNullOrWhiteSpace(textQuery))
                cmd.Parameters.Add("textQuery", textQuery);

            var list = new List<SearchResult>();
            using (var r = await cmd.ExecuteReaderAsync())
            {
                while (await r.ReadAsync())
                {
                    list.Add(new SearchResult
                        {
                            id = r.GetInt32(0),
                            name = r.IsDBNull(1) ? string.Empty : r.GetString(1),
                            url = r.IsDBNull(2) ? string.Empty : r.GetString(2),
                            category = r.IsDBNull(3) ? null : r.GetString(3),
                            subCategory = r.IsDBNull(4) ? null : r.GetString(4),
                            description = r.IsDBNull(5) ? null : r.GetString(5),
                            keywords = r.IsDBNull(6) ? null : r.GetString(6),
                            score = r.IsDBNull(7) ? 0 : Convert.ToDecimal(r.GetValue(7))
                        });
                }
            }

            _results = list;
            SetResultsVisibility();
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[LandingLayout] Error: " + ex.Message);
            _error = UserFacingError.Generic;
            _results.Clear();
            _showResults = false;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public sealed class SearchResult
    {
        public int id { get; set; }
        public string? name { get; set; }
        public string? url { get; set; }
        public string? category { get; set; }
        public string? subCategory { get; set; }
        public string? description { get; set; }
        public string? keywords { get; set; }
        public decimal score { get; set; }
    }

    private async Task SyncLanguageAsync()
    {
        try
        {
            _currentLang = await JS.InvokeAsync<string>(
                "localStorage.getItem",
                "lang"
            ) ?? "en";
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await SyncLanguageAsync();
            await JS.InvokeVoidAsync("loadLanguage");

            if (firstRender)
            {
                // Hide the decorative search adornment button from screen readers and tab order.
                // It is a non-interactive visual indicator — the actual search is triggered by typing.
                await JS.InvokeVoidAsync("eval", @"
                    (function() {
                        var btn = document.querySelector('#searchBox')
                            ?.closest('.mud-input-control')
                            ?.querySelector('.mud-input-adornment-start button');
                        if (btn) {
                            btn.setAttribute('aria-hidden', 'true');
                            btn.setAttribute('tabindex', '-1');
                        }
                    })();
                ");

                // Show promotional banner popup if one is active
                if (!_bannerShown)
                {
                    _bannerShown = true;
                    await ShowBannerIfActiveAsync();
                }
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }


    private async Task ToggleLanguage()
    {
        var current = await JS.InvokeAsync<string>("localStorage.getItem", "lang");
        var next = current == "hi" ? "en" : "hi";

        await JS.InvokeVoidAsync("applyLanguage", next);

        _currentLang = next;
        LangState.SetLanguage(next);
        StateHasChanged();
    }
