<style>

    /* Visually hidden utility (accessible to screen readers) */
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .landing-wrapper {
        min-height: 100vh;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Header Styling */
    .custom-header {
        background-color: white;
        padding: 0 2rem;
        height: 130px;
        position: sticky;
        top: 0;
        z-index: 1000;
        flex-shrink: 0;
    }

    /* Navigation Link Styling */
    /* ---------- HEADER NAV BUTTONS ---------- */
    .mud-nav-link {
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.4px;
        text-transform: none !important;
        min-height: auto !important;
        height: auto !important;
        line-height: 1.2;
        padding: 8px 14px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        border-bottom: 3px solid transparent !important;
       /*  border-radius: 0 !important; */
        cursor: pointer;
        white-space: nowrap;
        text-align: center;
        position: relative;
       /*  overflow: visible !important;
        transition: color 0.2s, border-bottom-color 0.2s; */
    }

        .mud-nav-link:hover {
            color: #e31e24 !important;
            border-bottom-color: #e31e24 !important;
            /* background: none !important; */
        }

        .mud-nav-link.mud-button-root {
            min-height: 44px !important;
            height: auto !important;
            padding: 8px 14px !important;
            align-items: center !important;
            display: inline-flex !important;
            width: auto !important;
            flex-shrink: 0;
          /*   overflow: visible !important;
            border-radius: 0 !important; */
        }

        /* Inner label — keep text clean, underline is on the button itself */
        .mud-nav-link .mud-button-label {
            line-height: 1.3 !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            white-space: nowrap !important;
        }

    /* Active state — red underline on the button element */
    .nav-link-active,
    .nav-link-active.mud-button-root {
        color: #e31e24 !important;
        border-bottom: 3px solid #e31e24 !important;
        /* border-radius: 0 !important; */
    }

    .mud-nav-link:hover .mud-button-label {
        border-bottom-color: #e31e24;
    }

    /* Notification Bar (Banner) Styling */
    .notification-bar {
        background-color: #e9ecef;
        color: #1565c0;
        font-size: 1.25rem;
        text-align: left;
        padding: 10px 0;
        font-weight: 700;
        letter-spacing: 0.3px;
        border-radius: 15px 15px 0 0;
        margin: 0 2rem;
        border-bottom: none;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
        white-space: nowrap;
    }

    .my_dairy_logo {
        width: 15%;
    }

    .main-content-layout {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    /* The moving strip */
    .marquee-track {
        display: inline-block;
        padding-left: 100%;
        animation: marquee-scroll 60s linear infinite;
        will-change: transform;
    }

    /* Each item spaced with a divider */
    .marquee-item {
        display: inline-block;
        margin-right: 2rem;
    }

    /* Optional separator “|” between items */
    .marquee-sep {
        color: #9aa4af;
        margin: 0 1rem;
    }

    @@keyframes marquee-scroll {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-100%);
        }
    }

    /* Pause on hover (optional) */
    .notification-bar:hover .marquee-track {
        animation-play-state: paused;
    }

    .search-bar {
        width: 200px;
        flex-shrink: 0;
    }

    .search-bar ::deep .mud-input-outlined-border {
        border-radius: 15px !important;
    }


    /* -------- Quick Actions styles -------- */
    .quick-actions-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #d1d5db;
        border-radius: 999px;
        background: #f8fafc;
        padding: 6px 14px;
        cursor: pointer;
        font-size: 0.88rem;
        font-weight: 600;
        color: #334155;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
        flex-shrink: 0;
        text-transform: none;
    }

    .quick-actions-btn:hover {
        background: #1E3A8A;
        color: white;
        border-color: #1E3A8A;
    }

    .quick-actions-btn:hover .mud-icon-root {
        color: white;
    }

    .qa-popover .mud-popover-paper {
        background: transparent;
        box-shadow: none;
    }

    .qa-card {
        width: 320px;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .qa-header {
        background: linear-gradient(90deg, #1976d2 0%, #1e88e5 100%);
        color: #fff;
        padding: 22px 20px;
    }

    .qa-title {
        color: #fff;
        font-weight: 700;
        letter-spacing: .3px;
        margin: 0;
    }

    .qa-subtitle {
        color: rgba(255,255,255,.85);
        margin-top: -2px;
    }

    .qa-grid {
        padding: 12px 10px 14px 10px;
        background: #fff;
    }

    .qa-item {
        display: flex;
        justify-content: center;
        align-items: stretch;
        padding: 6px 2px;
    }

    .qa-tile {
        width: 86px;
        height: 86px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        border-radius: 12px;
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease, background-color .2s ease;
        background: #fafbfc;
        border: 1px solid rgba(0,0,0,.05);
        outline: none;
    }

        .qa-tile:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0,0,0,.12);
            background: #ffffff;
        }

        .qa-tile:focus {
            box-shadow: 0 0 0 3px rgba(25,118,210,.25);
            background: #ffffff;
        }

    .qa-avatar {
        box-shadow: 0 2px 6px rgba(0,0,0,.12);
    }

    .qa-label {
        color: #334155;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 72px;
        font-weight: 600;
        letter-spacing: .2px;
    }

    @@media (max-width: 600px) {
        .qa-card {
            width: 280px;
        }

        .qa-tile {
            width: 78px;
            height: 80px;
        }
    }

    /* Responsive header adjustments */
   @@media (max-width: 1600px) {
    .mud-nav-link {
        font-size: 0.85rem !important;
        padding: 6px 7px !important;
    }
}

@@media (max-width: 1400px) {
    .mud-nav-link {
        font-size: 0.8rem !important;
        padding: 5px 5px !important;
    }
}

    .lang-globe-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #d1d5db;
        border-radius: 999px;
        background: #f8fafc;
        padding: 6px 14px;
        cursor: pointer;
        font-size: 0.88rem;
        font-weight: 600;
        color: #334155;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
        flex-shrink: 0;
    }

        .lang-globe-btn:hover {
            background: #1E3A8A;
            color: white;
            border-color: #1E3A8A;
        }

        .lang-globe-btn:hover svg {
            stroke: white;
        }
</style>

