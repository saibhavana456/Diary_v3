        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="flex-shrink-0" Style="min-width:0; overflow:hidden;">
            @* <MudImage Src="images/My_Diary_Log-transparent_small.png" Height="90" Alt="My Diary — Union Bank of India" Class="flex-shrink-0" /> *@
            <MudImage Src="@(_currentLang == "en" ? "images/My_Diary_Log-transparent_small_2.png" : "images/My_Diary_Log-transparent_small_hindi.png")" Height="90" Alt="My Diary — Union Bank of India" Class="flex-shrink-0" />

            <MudStack Row="true" Spacing="3" Class="d-none d-lg-flex align-center" Style="flex-wrap: nowrap; overflow: hidden; gap: 4px;">

                <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("HOME", ""))"
                           Class="@GetLinkClass("HOME")"
