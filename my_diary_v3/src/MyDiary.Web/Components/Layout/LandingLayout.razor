                    HOME
                </MudButton>

                <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("NETWORK", "network"))"
                           Class="@GetLinkClass("NETWORK")"
                           data-i18n="NETWORK">
                    NETWORK
                </MudButton>

                @* <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("DOWNLOADS", "downloads"))"
                           Class="@GetLinkClass("DOWNLOADS")"
                           data-i18n="DOWNLOADS">
                    DOWNLOADS
                </MudButton>

                <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("DEPARTMENTS", "departments"))"
                           Class="@GetLinkClass("DEPARTMENTS")"
                           data-i18n="DEPARTMENTS">
                    DEPARTMENTS
                </MudButton> *@

                <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("APPLICATIONS", "applications"))"
                           Class="@GetLinkClass("APPLICATIONS")"
                           data-i18n="APPLICATIONS">
                    APPLICATIONS
                </MudButton>

                <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("RATES & CHARGES", "rates-charges"))"
                           Class="@GetLinkClass("RATES & CHARGES")"
                           data-i18n="RATES_CHARGES">
                    RATES &amp; CHARGES
                </MudButton>

                 @* <MudButton Variant="Variant.Text"
                            OnClick="@(() => SetActive("FAQ/SOP", "faq-sop"))"
                            Class="@GetLinkClass("FAQ/SOP")"
                            Style="white-space: nowrap;"
                            data-i18n="FAQ_SOP">
                     FAQ/SOP
                 </MudButton> *@

                <MudButton Variant="Variant.Text"
                           OnClick="@(() => SetActive("ABOUT US", "about"))"
                           Class="@GetLinkClass("ABOUT US")"
                           Style="white-space: nowrap;"
                           data-i18n="ABOUT_US">
                    ABOUT US
                </MudButton>

            </MudStack>
        </MudStack>       

        @* Commented by Kavita for Search *@
        @* <MudTextField @bind-Value="searchString"
        Placeholder="Search..."
        Variant="Variant.Text"
        Adornment="Adornment.Start"
        AdornmentIcon="@Icons.Material.Filled.Search"
        AdornmentColor="MudBlazor.Color.Default"
        Margin="Margin.None"
        Class="mt-0 flex-shrink-0"
        Style="width: 200px; font-style: italic;" /> *@

        @* Commented by Kavita for Search *@

        @* <MudImage Src="images/UBI_Logo.png" Height="70" Alt="Union Bank" Class="flex-shrink-0" /> *@



        <!-- RIGHT: search + bank logo -->
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="flex-shrink-0">

            @* SEARCH *@
            <div @onclick:stopPropagation="true" style="position:relative;">
            <MudAutocomplete T="string"
                             @ref="_auto"
                             Value="@searchString"
                             ValueChanged="OnSuggestionPickedByValue"
                             ValueExpression="() => searchString"
                             Id="searchBox"
                             Placeholder="Search..."
                             data-i18n-placeholder="SEARCH"
                             Variant="Variant.Outlined"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentAriaLabel=""
                             OnAdornmentClick="RunSearchAsync"
                             Margin="Margin.Dense"
                             Class="search-bar"
                             Style="font-style: italic;"
                             SearchFunc="SuggestAsync"
                             MinCharacters="1"
                             DebounceInterval="200"
                             Clearable="true"
                             CoerceText="true"
                             Strict="true"
                             OnClearButtonClick="ClearSearch"
                             OnKeyDown="OnAutoKeyDown" />
            </div>

            @* SEARCH RESULTS POPOVER *@
@*             <div role="status" aria-live="polite" aria-atomic="true" class="visually-hidden" id="search-results-announcement">
                @if (_showResults && _results != null)
                {
                    @($"{_results.Count} result{(_results.Count == 1 ? "" : "s")} found")
                }
            </div> *@
            <MudPopover Open="_showResults"
                        AnchorId="searchBox"
                        OverflowBehavior="OverflowBehavior.FlipAlways"
                        Elevation="6"
                        AnchorOrigin="Origin.BottomLeft"
                        TransformOrigin="Origin.TopLeft">
                <MudPaper Class="qa-card" @onkeydown="OnQuickActionsKeyDown" @onclick:stopPropagation="true" tabindex="0">
                    <MudList T="SearchResult" Dense="true">
                        @if ((_results?.Count ?? 0) == 0)
                        {
                            <MudListItem Disabled="true">
                                <MudText Typo="Typo.caption" Class="px-3 py-2 text-secondary" data-i18n="NO_RESULTS">
                                    No results
                                </MudText>
                            </MudListItem>
                        }
                        else
                        {
                            @foreach (var r in _results)
                            {
                                <MudListItem T="SearchResult" Value="@r" Class="px-3 py-2" @onclick="() => OpenResultAsync(r)">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                                            @(!string.IsNullOrWhiteSpace(r.name) ? r.name : "(no name)")
                                        </MudText>

                                        @if (!string.IsNullOrWhiteSpace(r.category) || !string.IsNullOrWhiteSpace(r.subCategory))
                                        {
                                            <MudText Typo="Typo.caption" Class="text-secondary">
                                                @r.category
                                                @if (!string.IsNullOrWhiteSpace(r.subCategory))
                                                {
                                                    <text> / @r.subCategory</text>
                                                }
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudListItem>
                            }
                        }
                    </MudList>
                </MudPaper>
            </MudPopover>

            @* QUICK ACTIONS BUTTON *@
            <MudButton Variant="Variant.Text"
                       Class="quick-actions-btn"
                       Title="Quick Actions"
                       OnClick="ToggleQuickActionsWithStop"
                       Id="quickActionsBtn">

                <MudIcon Icon="@Icons.Material.Filled.GridView"
                         Style="font-size:28px;" />

                <span class="ml-1" aria-hidden="true" lang="@_currentLang">
                    @(_currentLang == "en" ? "Quick Links" : "त्वरित लिंक")
                </span>

            </MudButton>


            @* QUICK ACTIONS POPOVER — uses shared QuickLinksPanel component *@
            <MudPopover @bind-Open="_showQuickActions"
                        AnchorId="quickActionsBtn"
                        OverflowBehavior="OverflowBehavior.FlipAlways"
                        Elevation="8"
                        AnchorOrigin="Origin.BottomCenter"
                        TransformOrigin="Origin.TopCenter"
                        Class="qa-popover">
                <QuickLinksPanel OnClose="CloseQuickActions" />
            </MudPopover>

            <MudButton Variant="Variant.Text"
                       Class="lang-globe-btn"
                       OnClick="ToggleLanguage"                     
                       UserAttributes="@(new Dictionary<string, object>
                               {
                                   ["title"] = _currentLang == "en" ? "हिंदी में देखें" : "View in English",
                                   ["aria-label"] = _currentLang == "en" ? "Hindi" : "English"
                               })">


                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     width="20"
                     height="20"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true"
                     focusable="false">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10
                 15.3 15.3 0 0 1-4 10
                 15.3 15.3 0 0 1-4-10
                 15.3 15.3 0 0 1 4-10z" />
                </svg>

                <span class="ml-1" aria-hidden="true" lang="@(_currentLang == "en" ? "hi" : "en")">
                    @(_currentLang == "en" ? "हिंदी" : "English")
                </span>

            </MudButton>


            @* Bank logo — far right *@
            <MudImage Src="images/UBI_Logo.png" Height="50" Alt="Union Bank of India" Class="flex-shrink-0" />
        </MudStack>
    </MudPaper>

    <div class="notification-bar">
        @if (_marqueeLoading)
        {
            <span class="px-3" data-i18n="LOADING">Loading announcements…</span>
        }
        else if (!string.IsNullOrWhiteSpace(_marqueeError))
        {
            <span class="px-3">@_marqueeError</span>
        }
        else if (_marqueeItems?.Count > 0)
        {
            <div class="marquee-track">
                @* Repeat twice for continuous scrolling *@
                @for (int repeat = 0; repeat < 2; repeat++)
                {
                    @foreach (var item in _marqueeItems)
                    {
                        <span class="marquee-item">
                            @(_currentLang == "hi" ? item.Hi : item.En)
                        </span>

                        <span class="marquee-sep">|</span>
                    }
                }
            </div>
        }
        else
        {
            <span class="marquee-item px-3" data-i18n="NO_ANNOUNCEMENTS">No active announcements at this time.</span>
        }
    </div>

    <MudLayout Class="main-content-layout">
        <ErrorBoundary @ref="_landingErrorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 text-center">
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                        An error occurred while loading this page.
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                               Class="rounded-pill"
                               OnClick="RecoverLandingError">
                        Try Again
                    </MudButton>
                </MudContainer>
            </ErrorContent>
        </ErrorBoundary>
    </MudLayout>

</div>

@code {
    private ErrorBoundary? _landingErrorBoundary;
    private string searchString = "";
    private string ActiveLink = "HOME";
    private bool _isExpanded = false;
    private string _query = string.Empty;
    private int _take = 15;
    private bool _loading = false;
    private string? _error;
    private List<SearchResult> _results = new();
    private bool _showResults = false;
    private MudAutocomplete<string>? _auto;
    private string ConnStr() => Configuration.GetConnectionString("MyDiaryDBConnection") ?? "";
    private string SqlConnStr() => Configuration.GetConnectionString("SQLServerConnection") ?? "";

    private List<(string En, string Hi)> _marqueeItems = new();
    private bool _marqueeLoading = true;
    private string? _marqueeError;
    private string _currentLang = "en";

    private void RecoverLandingError()
    {
        _landingErrorBoundary?.Recover();
    }

    /* Quick Actions state & model */
    private bool _showQuickActions = false; 
    private void GoToAllApplications()
    {
        _showQuickActions = false;
        Nav.NavigateTo("applications");
    }

    private async Task OnLanguageToggle(string lang)
    {
        _currentLang = lang;
        await JS.InvokeVoidAsync("applyLanguage", lang);

        StateHasChanged();
    }

    public sealed class QuickAction
    {
        public string Label { get; set; } = "";
        public string? Url { get; set; }
        public string? Route { get; set; }   // for internal routes if needed
        public MColor Color { get; set; } = MColor.Primary;
        public string Icon { get; set; } = Icons.Material.Filled.Link;
        public bool External { get; set; } = true;

    }
    private void OnQuickActionsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showQuickActions = false;
            StateHasChanged();
        }
    }


    private readonly List<QuickAction> _quickActions = new()
    {
        new QuickAction { Label="Finacle", Url="https://finacle.ubi.com/SSO/ui/SSOLogin.jsp", Icon=Icons.Material.Filled.AccountBalance, Color=MColor.Error },
        new QuickAction { Label="Parivaar", Url="https://unionparivar.unionbankofindia.co.in/psp/pshrprd/?cmd=login", Icon=Icons.Material.Filled.Groups, Color=MColor.Warning },
        new QuickAction { Label="LAS", Url="https://las.example.com", Icon=Icons.Material.Filled.TableChart, Color=MColor.Info },
        new QuickAction { Label="IT Konnect", Url="https://ubiitsm-dwp.unionbankofindia.co.in/", Icon=Icons.Material.Filled.Public, Color=MColor.Success },
        new QuickAction { Label="CRM Edge", Url="https://ucrm.unionbankofindia.co.in/", Icon=Icons.Material.Filled.SupportAgent, Color=MColor.Secondary },
        new QuickAction { Label="Circular & Policies", Url="https://dms.unionbankofindia.co.in/webdesktop/CustomJobs/eCircular/Circular.jsp", Icon=Icons.Material.Filled.Description, Color=MColor.Primary },
    };

    private void ToggleQuickActionsWithStop(MouseEventArgs e)
    {
        _showQuickActions = !_showQuickActions;
    }

    private void StopPropagation(MouseEventArgs e)
    {
        // This method exists solely to stop event propagation - By handling the click here, it won't bubble up to the wrapper
    }

    private void HandleWrapperClick()
    {
        // Close popover when clicking anywhere on the page
        if (_showQuickActions)
        {
            _showQuickActions = false;
        }

        // Close search results when clicking outside
        if (_showResults)
        {
            _showResults = false;
            _results.Clear();
        }

        StateHasChanged();
    }

    private async Task OpenQuickActionAsync(QuickAction qa)
    {
        _showQuickActions = false;

        if (!string.IsNullOrWhiteSpace(qa.Url))
        {
            if (qa.External)
            {
                await JS.InvokeVoidAsync("window.open", qa.Url, "_blank", "noopener,noreferrer");
            }
            else
            {
                Nav.NavigateTo(qa.Url, forceLoad: false);
            }
        }
        else if (!string.IsNullOrWhiteSpace(qa.Route))
        {
            Nav.NavigateTo(qa.Route, forceLoad: false);
        }
    }

    private async Task OnTileKeyDown(KeyboardEventArgs e, QuickAction qa)
    {
        if (e.Key is "Enter" or " ")
            await OpenQuickActionAsync(qa);
    }

    /* Lifecycle */
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = LoadActiveMarqueesAsync();   // fire-and-forget — page renders immediately while marquee loads in background
    }

    private bool _bannerShown = false;

    private async Task ShowBannerIfActiveAsync()
    {
        try
        {
            var banner = await BannerService.GetActiveBannerAsync();
            if (banner == null) return;

            var options = new DialogOptions
                {
                    MaxWidth = MaxWidth.Large,
                    FullWidth = true,
                    CloseButton = false,
                    NoHeader = true,
                    BackdropClick = true
                };

            var parameters = new DialogParameters<BannerDialog>
            {
                { x => x.Banner, banner }
            };

            await DialogService.ShowAsync<BannerDialog>(null, parameters, options);
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[LandingLayout] Failed to show banner dialog.");
        }
    }

    private Task CloseQuickActions()
    {
        _showQuickActions = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /* Marquee */
    private async Task LoadActiveMarqueesAsync(CancellationToken ct = default)
    {
        _marqueeLoading = true;
        _marqueeError = null;
        _marqueeItems.Clear();

        try
        {
            const string sql = @"
    SELECT [Text], [Text_HI]
    FROM dbo.MarqueeAnnouncements
    WHERE IsActive = 1
      AND GETDATE() BETWEEN StartDate AND EndDate
    ORDER BY DisplayOrder, StartDate DESC;";

            using var con = new SqlConnection(SqlConnStr());
            await con.OpenAsync(ct);

            using var cmd = new SqlCommand(sql, con);
            cmd.CommandType = CommandType.Text;
            cmd.CommandTimeout = 5; // bounded timeout — slow/unreachable DB won't hang the background load

            var list = new List<(string En, string Hi)>();

            using var r = await cmd.ExecuteReaderAsync(ct);
            while (await r.ReadAsync(ct))
            {
                var en = r.IsDBNull(0) ? string.Empty : r.GetString(0);
                var hi = r.IsDBNull(1) ? en : r.GetString(1); // fallback to EN if HI missing
                list.Add((en, hi));
            }

            _marqueeItems = list;
        }
        catch (Exception ex)
        {
            AppLogger.LogError(ex, "[LandingLayout] Unhandled error: " + ex.Message);
            _marqueeError = "Failed to load announcements.";
        }
        finally
        {
            _marqueeLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshMarqueeAsync()
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        await LoadActiveMarqueesAsync(cts.Token);
    }

